From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Tue, 3 Nov 2026 00:21:56 +0000
Subject: [PATCH] dt-bindings: display: allwinner: Allow an IOMMU for the DE33
 planes

The DE33 planes block fetches all layer data through the display engine
master of the H616 IOMMU, the same master the DE2/DE3 mixers describe
with their iommus property. Allow it on the planes node too.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 .../bindings/display/allwinner,sun50i-h616-de33-planes.yaml    | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-de33-planes.yaml b/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-de33-planes.yaml
index 0a07cb8a5..d7838a9c0 100644
--- a/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-de33-planes.yaml
+++ b/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-de33-planes.yaml
@@ -22,6 +22,9 @@ properties:
   reg:
     maxItems: 1
 
+  iommus:
+    maxItems: 1
+
   allwinner,plane-mapping:
     $ref: /schemas/types.yaml#/definitions/phandle
     description:
