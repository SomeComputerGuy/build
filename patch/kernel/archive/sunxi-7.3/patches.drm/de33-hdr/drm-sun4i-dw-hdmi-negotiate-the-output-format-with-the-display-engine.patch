From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Tue, 10 Nov 2026 02:02:04 +0000
Subject: [PATCH 16/16] drm/sun4i: dw-hdmi: Negotiate the output format with
 the display engine

dw-hdmi is the first bridge of the encoder, so it picks its input bus
format alone and the display engine is always asked for 8-bit RGB.

Put a bridge of the sun8i HDMI glue in front of dw-hdmi, so that bus
format negotiation only offers dw-hdmi the formats the display engine
can produce. dw-hdmi stays the last bridge and keeps creating its own
connector, so the max bpc, Colorspace and HDR output metadata
properties, CEC and the hotplug handling stay unchanged.

The glue bridge stores the negotiated format, the format on the HDMI
link (dw-hdmi subsamples YUV 4:4:4 to 4:2:2 itself) and the YCbCr
encoding that follows from the Colorspace property in the CRTC state,
and adds all planes to the commit when they change, as their CSC units
depend on them. The TMDS clock now follows the link format: 5/4 of the
pixel clock for 10-bit, half of it for YUV 4:2:0, and the pixel clock
for YUV 4:2:2.

Allow deep colour up to 594 MHz on H6 and later, and YUV 4:2:0 modes
on the H616, whose display engine can produce them, through its own
compatible. Enable the YUV 4:4:4 video mapping and PHY clock quirks of
the controller. Also deinit the PHY when probing the controller fails.

Based on the DE3/DE33 HDMI output series by Jernej Skrabec in
LibreELEC, which converts the glue to a bridge with a bridge connector
instead.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c | 231 +++++++++++++++++++++++---
 drivers/gpu/drm/sun4i/sun8i_dw_hdmi.h |   5 +
 2 files changed, 217 insertions(+), 19 deletions(-)

diff --git a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
index 5d1938b68..1bbd63e7c 100644
--- a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
+++ b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
@@ -8,28 +8,170 @@
 #include <linux/of.h>
 #include <linux/platform_device.h>
 
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_state_helper.h>
+#include <drm/drm_bridge.h>
 #include <drm/drm_modeset_helper_vtables.h>
 #include <drm/drm_encoder.h>
 #include <drm/drm_of.h>
 
+#include "sun4i_crtc.h"
 #include "sun8i_dw_hdmi.h"
 #include "sun8i_tcon_top.h"
+#include "sunxi_engine.h"
 
-static void sun8i_dw_hdmi_encoder_mode_set(struct drm_encoder *encoder,
-					   struct drm_display_mode *mode,
-					   struct drm_display_mode *adj_mode)
+#define bridge_to_sun8i_dw_hdmi(x) \
+	container_of(x, struct sun8i_dw_hdmi, bridge)
+
+static int sun8i_hdmi_enc_attach(struct drm_bridge *bridge,
+				 struct drm_encoder *encoder,
+				 enum drm_bridge_attach_flags flags)
+{
+	struct sun8i_dw_hdmi *hdmi = bridge_to_sun8i_dw_hdmi(bridge);
+
+	/* dw-hdmi creates and owns the connector, as with dw_hdmi_bind() */
+	return drm_bridge_attach(encoder, hdmi->next_bridge, bridge, flags);
+}
+
+static int sun8i_hdmi_enc_atomic_check(struct drm_bridge *bridge,
+				       struct drm_bridge_state *bridge_state,
+				       struct drm_crtc_state *crtc_state,
+				       struct drm_connector_state *conn_state)
+{
+	struct sun8i_dw_hdmi *hdmi = bridge_to_sun8i_dw_hdmi(bridge);
+	struct sun4i_crtc_state *scrtc_state =
+		drm_crtc_state_to_sun4i_crtc_state(crtc_state);
+	const struct sun4i_crtc_state *old_scrtc_state;
+	struct drm_bridge_state *hdmi_state;
+
+	switch (conn_state->colorspace) {
+	case DRM_MODE_COLORIMETRY_SMPTE_170M_YCC:
+	case DRM_MODE_COLORIMETRY_XVYCC_601:
+	case DRM_MODE_COLORIMETRY_SYCC_601:
+	case DRM_MODE_COLORIMETRY_OPYCC_601:
+	case DRM_MODE_COLORIMETRY_BT601_YCC:
+		scrtc_state->encoding = DRM_COLOR_YCBCR_BT601;
+		break;
+
+	case DRM_MODE_COLORIMETRY_BT2020_CYCC:
+	case DRM_MODE_COLORIMETRY_BT2020_YCC:
+	case DRM_MODE_COLORIMETRY_BT2020_RGB:
+	case DRM_MODE_COLORIMETRY_DCI_P3_RGB_D65:
+	case DRM_MODE_COLORIMETRY_DCI_P3_RGB_THEATER:
+		scrtc_state->encoding = DRM_COLOR_YCBCR_BT2020;
+		break;
+
+	default:
+		scrtc_state->encoding = DRM_COLOR_YCBCR_BT709;
+		break;
+	}
+
+	scrtc_state->format = bridge_state->output_bus_cfg.format;
+
+	/*
+	 * The TMDS rate depends on what goes over the link, which differs
+	 * from the engine output when dw-hdmi subsamples YUV 4:4:4 to 4:2:2.
+	 * Bus formats are already negotiated here, and the atomic state is
+	 * not available anymore in atomic_mode_set().
+	 */
+	hdmi_state = drm_atomic_get_new_bridge_state(crtc_state->state,
+						     hdmi->next_bridge);
+	scrtc_state->link_format = hdmi_state ?
+				   hdmi_state->output_bus_cfg.format :
+				   scrtc_state->format;
+
+	/*
+	 * The channel CSC units depend on the output format and encoding, so
+	 * planes that are not part of this commit must be updated as well.
+	 */
+	old_scrtc_state = drm_crtc_state_to_sun4i_crtc_state(
+		drm_atomic_get_old_crtc_state(crtc_state->state, crtc_state->crtc));
+	if (scrtc_state->format != old_scrtc_state->format ||
+	    scrtc_state->encoding != old_scrtc_state->encoding)
+		return drm_atomic_add_affected_planes(crtc_state->state,
+						      crtc_state->crtc);
+
+	return 0;
+}
+
+static u32 *
+sun8i_hdmi_enc_get_input_bus_fmts(struct drm_bridge *bridge,
+				  struct drm_bridge_state *bridge_state,
+				  struct drm_crtc_state *crtc_state,
+				  struct drm_connector_state *conn_state,
+				  u32 output_fmt,
+				  unsigned int *num_input_fmts)
+{
+	struct sun4i_crtc *scrtc = drm_crtc_to_sun4i_crtc(crtc_state->crtc);
+	u32 *input_fmt;
+
+	*num_input_fmts = 0;
+
+	if (!sunxi_engine_format_valid(scrtc->engine, output_fmt))
+		return NULL;
+
+	input_fmt = kmalloc_obj(*input_fmt);
+	if (!input_fmt)
+		return NULL;
+
+	*num_input_fmts = 1;
+	*input_fmt = output_fmt;
+
+	return input_fmt;
+}
+
+static const struct drm_bridge_funcs sun8i_hdmi_enc_bridge_funcs = {
+	.attach = sun8i_hdmi_enc_attach,
+	.atomic_check = sun8i_hdmi_enc_atomic_check,
+	.atomic_get_input_bus_fmts = sun8i_hdmi_enc_get_input_bus_fmts,
+	.atomic_duplicate_state = drm_atomic_helper_bridge_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_bridge_destroy_state,
+	.atomic_create_state = drm_atomic_helper_bridge_create_state,
+};
+
+static void
+sun8i_dw_hdmi_encoder_atomic_mode_set(struct drm_encoder *encoder,
+				      struct drm_crtc_state *crtc_state,
+				      struct drm_connector_state *conn_state)
 {
+	struct sun4i_crtc_state *scrtc_state =
+		drm_crtc_state_to_sun4i_crtc_state(crtc_state);
 	struct sun8i_dw_hdmi *hdmi = encoder_to_sun8i_dw_hdmi(encoder);
+	struct drm_display_mode *mode = &crtc_state->adjusted_mode;
+	unsigned long rate = mode->crtc_clock * 1000UL;
 
-	clk_set_rate(hdmi->clk_tmds, mode->crtc_clock * 1000);
+	/*
+	 * The TMDS character rate is derived from the pixel clock: deep
+	 * color multiplies it (10-bit: 5/4), except for YUV 4:2:2, which
+	 * always uses 12-bit containers at the pixel rate, and YUV 4:2:0
+	 * halves it again since two horizontal samples share one TMDS
+	 * period.
+	 */
+	switch (scrtc_state->link_format) {
+	case MEDIA_BUS_FMT_RGB101010_1X30:
+	case MEDIA_BUS_FMT_YUV10_1X30:
+		rate = rate * 5 / 4;
+		break;
+	case MEDIA_BUS_FMT_UYYVYY10_0_5X30:
+		rate = rate * 5 / 4 / 2;
+		break;
+	case MEDIA_BUS_FMT_UYYVYY8_0_5X24:
+		rate = rate / 2;
+		break;
+	default:
+		break;
+	}
+
+	clk_set_rate(hdmi->clk_tmds, rate);
 }
+
 static const struct drm_encoder_funcs sun8i_dw_hdmi_encoder_funcs = {
 	.destroy = drm_encoder_cleanup,
 };
 
 static const struct drm_encoder_helper_funcs
 sun8i_dw_hdmi_encoder_helper_funcs = {
-	.mode_set = sun8i_dw_hdmi_encoder_mode_set,
+	.atomic_mode_set = sun8i_dw_hdmi_encoder_atomic_mode_set,
 };
 
 static enum drm_mode_status
@@ -124,9 +266,10 @@ static int sun8i_dw_hdmi_bind(struct device *dev, struct device *master,
 	if (!pdev->dev.of_node)
 		return -ENODEV;
 
-	hdmi = devm_kzalloc(&pdev->dev, sizeof(*hdmi), GFP_KERNEL);
-	if (!hdmi)
-		return -ENOMEM;
+	hdmi = devm_drm_bridge_alloc(&pdev->dev, struct sun8i_dw_hdmi,
+				     bridge, &sun8i_hdmi_enc_bridge_funcs);
+	if (IS_ERR(hdmi))
+		return PTR_ERR(hdmi);
 
 	plat_data = &hdmi->plat_data;
 	hdmi->dev = &pdev->dev;
@@ -196,31 +339,66 @@ static int sun8i_dw_hdmi_bind(struct device *dev, struct device *master,
 	if (ret)
 		goto err_disable_clk_tmds;
 
-	drm_encoder_helper_add(encoder, &sun8i_dw_hdmi_encoder_helper_funcs);
-	drm_encoder_init(drm, encoder, &sun8i_dw_hdmi_encoder_funcs,
-			 DRM_MODE_ENCODER_TMDS, NULL);
-
 	plat_data->mode_valid = hdmi->quirks->mode_valid;
 	plat_data->use_drm_infoframe = hdmi->quirks->use_drm_infoframe;
+	plat_data->ycbcr_420_allowed = hdmi->quirks->ycbcr_420_allowed;
+	plat_data->deep_color_max_tmds_clock =
+		hdmi->quirks->deep_color_max_tmds_clock;
+	/*
+	 * The controller shares the same distinct video mapping code for
+	 * packed YUV 4:4:4 across all sun8i variants, even where YUV
+	 * output is never negotiated in practice.
+	 */
+	plat_data->ycbcr444_alt_vmap = true;
+	plat_data->phy_max_tmds_msm_ctrl_quirk = true;
 	sun8i_hdmi_phy_set_ops(hdmi->phy, plat_data);
 
 	platform_set_drvdata(pdev, hdmi);
 
-	hdmi->hdmi = dw_hdmi_bind(pdev, encoder, plat_data);
-
 	/*
-	 * If dw_hdmi_bind() fails we'll never call dw_hdmi_unbind(),
-	 * which would have called the encoder cleanup.  Do it manually.
+	 * dw-hdmi is the last bridge and creates the connector. The sun8i
+	 * bridge in front of it takes part in bus format negotiation, so
+	 * that dw-hdmi only picks formats the display engine can output.
 	 */
+	hdmi->hdmi = dw_hdmi_probe(pdev, plat_data);
 	if (IS_ERR(hdmi->hdmi)) {
 		ret = PTR_ERR(hdmi->hdmi);
-		goto cleanup_encoder;
+		goto err_deinit_phy;
 	}
 
+	hdmi->next_bridge = of_drm_find_and_get_bridge(dev->of_node);
+	if (!hdmi->next_bridge) {
+		ret = -ENODEV;
+		goto err_remove_dw_hdmi;
+	}
+
+	hdmi->bridge.type = DRM_MODE_CONNECTOR_HDMIA;
+	hdmi->bridge.interlace_allowed = true;
+	hdmi->bridge.ycbcr_420_allowed = hdmi->quirks->ycbcr_420_allowed;
+
+	drm_bridge_add(&hdmi->bridge);
+
+	drm_encoder_helper_add(encoder, &sun8i_dw_hdmi_encoder_helper_funcs);
+	ret = drm_encoder_init(drm, encoder, &sun8i_dw_hdmi_encoder_funcs,
+			       DRM_MODE_ENCODER_TMDS, NULL);
+	if (ret)
+		goto err_remove_bridge;
+
+	ret = drm_bridge_attach(encoder, &hdmi->bridge, NULL, 0);
+	if (ret)
+		goto err_cleanup_encoder;
+
 	return 0;
 
-cleanup_encoder:
+err_cleanup_encoder:
 	drm_encoder_cleanup(encoder);
+err_remove_bridge:
+	drm_bridge_remove(&hdmi->bridge);
+	drm_bridge_put(hdmi->next_bridge);
+err_remove_dw_hdmi:
+	dw_hdmi_remove(hdmi->hdmi);
+err_deinit_phy:
+	sun8i_hdmi_phy_deinit(hdmi->phy);
 err_disable_clk_tmds:
 	clk_disable_unprepare(hdmi->clk_tmds);
 err_assert_ctrl_reset:
@@ -236,7 +414,9 @@ static void sun8i_dw_hdmi_unbind(struct device *dev, struct device *master,
 {
 	struct sun8i_dw_hdmi *hdmi = dev_get_drvdata(dev);
 
-	dw_hdmi_unbind(hdmi->hdmi);
+	drm_bridge_remove(&hdmi->bridge);
+	drm_bridge_put(hdmi->next_bridge);
+	dw_hdmi_remove(hdmi->hdmi);
 	sun8i_hdmi_phy_deinit(hdmi->phy);
 	clk_disable_unprepare(hdmi->clk_tmds);
 	reset_control_assert(hdmi->rst_ctrl);
@@ -269,6 +449,15 @@ static const struct sun8i_dw_hdmi_quirks sun9i_a80_quirks = {
 static const struct sun8i_dw_hdmi_quirks sun50i_h6_quirks = {
 	.mode_valid = sun8i_dw_hdmi_mode_valid_h6,
 	.use_drm_infoframe = true,
+	.deep_color_max_tmds_clock = 594000,
+};
+
+/* Only the H616 display engine can output YUV 4:2:0. */
+static const struct sun8i_dw_hdmi_quirks sun50i_h616_quirks = {
+	.mode_valid = sun8i_dw_hdmi_mode_valid_h6,
+	.use_drm_infoframe = true,
+	.ycbcr_420_allowed = true,
+	.deep_color_max_tmds_clock = 594000,
 };
 
 static const struct of_device_id sun8i_dw_hdmi_dt_ids[] = {
@@ -284,6 +473,10 @@ static const struct of_device_id sun8i_dw_hdmi_dt_ids[] = {
 		.compatible = "allwinner,sun50i-h6-dw-hdmi",
 		.data = &sun50i_h6_quirks,
 	},
+	{
+		.compatible = "allwinner,sun50i-h616-dw-hdmi",
+		.data = &sun50i_h616_quirks,
+	},
 	{ /* sentinel */ },
 };
 MODULE_DEVICE_TABLE(of, sun8i_dw_hdmi_dt_ids);
diff --git a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.h b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.h
index df94f8347..f31aa443b 100644
--- a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.h
+++ b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.h
@@ -7,6 +7,7 @@
 #define _SUN8I_DW_HDMI_H_
 
 #include <drm/bridge/dw_hdmi.h>
+#include <drm/drm_bridge.h>
 #include <drm/drm_encoder.h>
 #include <linux/clk.h>
 #include <linux/regmap.h>
@@ -176,12 +177,16 @@ struct sun8i_dw_hdmi_quirks {
 					   const struct drm_display_info *info,
 					   const struct drm_display_mode *mode);
 	unsigned int use_drm_infoframe : 1;
+	unsigned int ycbcr_420_allowed : 1;
+	unsigned int deep_color_max_tmds_clock;
 };
 
 struct sun8i_dw_hdmi {
 	struct clk			*clk_tmds;
 	struct device			*dev;
+	struct drm_bridge		bridge;
 	struct dw_hdmi			*hdmi;
+	struct drm_bridge		*next_bridge;
 	struct drm_encoder		encoder;
 	struct sun8i_hdmi_phy		*phy;
 	struct dw_hdmi_plat_data	plat_data;
