+/*
+ * The YCbCr to R'G'B' conversion of the channel CSC as a matrix in Q2.17
+ * and the magnitudes subtracted from Y, Cb and Cr before it.
+ */
+void sun8i_de33_csc_yuv2rgb(enum drm_color_encoding encoding,
+			    enum drm_color_range range, s64 m[3][3], u32 d[3])
+{
+	const u32 *table = yuv2rgb_de3[range][encoding];
+	int r, c;
+
+	for (r = 0; r < 3; r++) {
+		for (c = 0; c < 3; c++)
+			m[r][c] = (s32)table[r * 4 + c];
+		d[r] = -(s16)(table[r * 4 + 3] >> 16);
+	}
+}
