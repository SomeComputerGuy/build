From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Mon, 20 Jul 2026 13:41:36 +0200
Subject: [PATCH 07/16] drm/bridge: dw-hdmi: Re-assert PHY clock select at max
 TMDS rate

Above the HDMI 1.4 TMDS rate limit of 340 MHz, some PHY instances need
HDMI_3D_TX_PHY_MSM_CTRL's clock select written again together with the
override bit already used by the sibling HDMI_3D_TX_PHY_CKCALCTRL
register, for the earlier write at the same offset to actually take
effect. This was first seen at 594 MHz, but a 592.5 MHz mode, just
below the 1000/1001 variant of 594 MHz, shows the same striped picture
until the next mode set. Lower rates configure correctly with a single
write.

Gate this behind a plat_data flag rather than applying it
unconditionally, since other platforms sharing this PHY configure
function can also legitimately reach these rates and have not been
verified to need or tolerate the extra write.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
[aiyengar: dropped the sun8i_dw_hdmi.c hunk, the platform data is set
 where the sun4i HDMI driver gets its bridge front-end]
Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/gpu/drm/bridge/synopsys/dw-hdmi.c | 12 ++++++++++++
 drivers/gpu/drm/bridge/synopsys/dw-hdmi.h |  1 +
 include/drm/bridge/dw_hdmi.h              |  9 +++++++++
 3 files changed, 22 insertions(+)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
index 454ac7042..f8b43b794 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
@@ -1657,6 +1657,18 @@ static int hdmi_phy_configure_dwc_hdmi_3d_tx(struct dw_hdmi *hdmi,
 	dw_hdmi_phy_i2c_write(hdmi, HDMI_3D_TX_PHY_MSM_CTRL_CKO_SEL_FB_CLK,
 			      HDMI_3D_TX_PHY_MSM_CTRL);
 
+	/*
+	 * Above the HDMI 1.4 TMDS rate limit, some instances need the clock
+	 * select re-asserted together with the override bit for it to
+	 * actually latch.
+	 */
+	if (pdata->phy_max_tmds_msm_ctrl_quirk &&
+	    mtmdsclock > HDMI_1_3_TMDS_CHAR_RATE_MAX_HZ)
+		dw_hdmi_phy_i2c_write(hdmi,
+				      HDMI_3D_TX_PHY_MSM_CTRL_OVERRIDE |
+				      HDMI_3D_TX_PHY_MSM_CTRL_CKO_SEL_FB_CLK,
+				      HDMI_3D_TX_PHY_MSM_CTRL);
+
 	dw_hdmi_phy_i2c_write(hdmi, phy_config->term, HDMI_3D_TX_PHY_TXTERM);
 	dw_hdmi_phy_i2c_write(hdmi, phy_config->sym_ctr,
 			      HDMI_3D_TX_PHY_CKSYMTXCTRL);
diff --git a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.h b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.h
index b16cf6efb..6a6a6195d 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.h
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.h
@@ -1150,6 +1150,7 @@ enum {
 #define HDMI_3D_TX_PHY_CKCALCTRL_OVERRIDE		BIT(15)
 
 /* HDMI_3D_TX_PHY_MSM_CTRL values */
+#define HDMI_3D_TX_PHY_MSM_CTRL_OVERRIDE		BIT(15)
 #define HDMI_3D_TX_PHY_MSM_CTRL_MPLL_PH_SEL_CK		BIT(13)
 #define HDMI_3D_TX_PHY_MSM_CTRL_CKO_SEL_CLK_REF_MPLL	(0 << 1)
 #define HDMI_3D_TX_PHY_MSM_CTRL_CKO_SEL_OFF		(1 << 1)
diff --git a/include/drm/bridge/dw_hdmi.h b/include/drm/bridge/dw_hdmi.h
index d029a32c0..791e9f261 100644
--- a/include/drm/bridge/dw_hdmi.h
+++ b/include/drm/bridge/dw_hdmi.h
@@ -148,6 +148,15 @@ struct dw_hdmi_plat_data {
 	 */
 	bool ycbcr444_alt_vmap;
 
+	/*
+	 * Some controller instances need an extra HDMI_3D_TX_PHY_MSM_CTRL
+	 * write at the highest supported TMDS rate (594 MHz), on top of
+	 * the one hdmi_phy_configure_dwc_hdmi_3d_tx() already does for
+	 * every rate. Leave this unset unless verified against the
+	 * specific instance.
+	 */
+	bool phy_max_tmds_msm_ctrl_quirk;
+
 	/*
 	 * Private data passed to all the .mode_valid() and .configure_phy()
 	 * callback functions.
