+++ b/drivers/gpu/drm/sun4i/sun50i_wb.c
@@ -448,15 +448,26 @@ static void sun50i_wb_job_scaler(struct sun50i_wb_job *job,
 }
 
 /*
- * The blender works in RGB, or in BT.601 limited-range YCbCr on the TV
- * encoder path (sun50i_mixer_set_output_yuv()). Convert when the output
- * format is in the other space.
+ * The blender works in RGB, in BT.601 limited-range YCbCr on the TV encoder
+ * path (sun50i_mixer_set_output_yuv()), or in limited-range YCbCr of the
+ * engine's encoding when a YUV output format was negotiated with the HDMI
+ * bridge. Convert when the output format is in the other space: RGB capture
+ * converts the blender output back to full range RGB, and YUV capture of
+ * RGB blender output is BT.601 limited range, as before. YUV capture of YUV
+ * blender output is stored verbatim, in the blender output encoding.
  */
 static void sun50i_wb_job_csc(struct sun50i_wb_job *job,
 			      const struct drm_format_info *format)
 {
+	struct sunxi_engine *engine = &job->mixer->engine;
+	enum drm_color_encoding encoding = DRM_COLOR_YCBCR_BT601;
 	bool in_yuv = job->mixer->output_yuv;
 
+	if (!in_yuv && sunxi_engine_format_is_yuv(engine->format)) {
+		in_yuv = true;
+		encoding = engine->encoding;
+	}
+
 	if (format->format == DRM_FORMAT_XRGB2101010 ||
 	    in_yuv == format->is_yuv)
 		return;
@@ -464,7 +475,7 @@ static void sun50i_wb_job_csc(struct sun50i_wb_job *job,
 	job->csc = true;
 	sun8i_de33_csc_get_table(format->is_yuv ? SUN8I_CSC_MODE_RGB2YUV :
 						  SUN8I_CSC_MODE_YUV2RGB,
-				 job->csc_coeff);
+				 encoding, job->csc_coeff);
 }
 
 /* Stop and reset the unit (vendor de_wb_stop) and detach it from the mux. */
diff --git a/drivers/gpu/drm/sun4i/sun8i_csc.c b/drivers/gpu/drm/sun4i/sun8i_csc.c
