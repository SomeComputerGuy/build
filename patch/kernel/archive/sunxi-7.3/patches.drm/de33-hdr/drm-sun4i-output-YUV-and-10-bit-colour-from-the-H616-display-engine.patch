diff --git a/drivers/gpu/drm/sun4i/sun50i_fmt.c b/drivers/gpu/drm/sun4i/sun50i_fmt.c
new file mode 100644
index 000000000..25b40cfbe
--- /dev/null
+++ b/drivers/gpu/drm/sun4i/sun50i_fmt.c
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Copyright (C) 2026 Jernej Skrabec <jernej.skrabec@gmail.com>
+ */
+
+#include <linux/regmap.h>
+
+#include "sun50i_fmt.h"
+#include "sunxi_engine.h"
+
+static u32 sun50i_fmt_get_colorspace(u32 format)
+{
+	switch (format) {
+	case MEDIA_BUS_FMT_UYYVYY8_0_5X24:
+	case MEDIA_BUS_FMT_UYYVYY10_0_5X30:
+		return SUN50I_FMT_CS_YUV420;
+	default:
+		return SUN50I_FMT_CS_YUV444RGB;
+	}
+}
+
+static bool sun50i_fmt_is_10bit(u32 format)
+{
+	return format == MEDIA_BUS_FMT_UYYVYY10_0_5X30 ||
+	       format == MEDIA_BUS_FMT_RGB101010_1X30 ||
+	       format == MEDIA_BUS_FMT_YUV10_1X30;
+}
+
+void sun50i_fmt_setup(struct sun8i_mixer *mixer, u16 width,
+		      u16 height, u32 format)
+{
+	struct regmap *regs = mixer->engine.regs;
+	u32 colorspace = sun50i_fmt_get_colorspace(format);
+	bool yuv = sunxi_engine_format_is_yuv(format);
+	bool is_10bit = sun50i_fmt_is_10bit(format);
+	u32 base = SUN50I_FMT_DE33;
+
+	regmap_write(regs, base + SUN50I_FMT_SIZE,
+		     SUN8I_MIXER_SIZE(width, height));
+	regmap_write(regs, base + SUN50I_FMT_SWAP, 0);
+	regmap_write(regs, base + SUN50I_FMT_DEPTH, is_10bit);
+	regmap_write(regs, base + SUN50I_FMT_FORMAT, colorspace);
+	regmap_write(regs, base + SUN50I_FMT_COEF, 0);
+
+	/* Like the vendor driver, only clamp when subsampling chroma. */
+	if (colorspace == SUN50I_FMT_CS_YUV444RGB) {
+		regmap_write(regs, base + SUN50I_FMT_LMT_Y,
+			     SUN50I_FMT_LIMIT_BYPASS);
+		regmap_write(regs, base + SUN50I_FMT_LMT_C0,
+			     SUN50I_FMT_LIMIT_BYPASS);
+		regmap_write(regs, base + SUN50I_FMT_LMT_C1,
+			     SUN50I_FMT_LIMIT_BYPASS);
+	} else {
+		regmap_write(regs, base + SUN50I_FMT_LMT_Y,
+			     SUN50I_FMT_LIMIT_Y);
+		regmap_write(regs, base + SUN50I_FMT_LMT_C0,
+			     SUN50I_FMT_LIMIT_C);
+		regmap_write(regs, base + SUN50I_FMT_LMT_C1,
+			     SUN50I_FMT_LIMIT_C);
+	}
+
+	/*
+	 * 8-bit RGB bypasses the formatter, which keeps the upper 8 bits of
+	 * the 10-bit pipeline. YUV and deep color output go through it.
+	 */
+	regmap_write(regs, base + SUN50I_FMT_CTRL, yuv || is_10bit);
+}
diff --git a/drivers/gpu/drm/sun4i/sun50i_fmt.h b/drivers/gpu/drm/sun4i/sun50i_fmt.h
new file mode 100644
index 000000000..b94cc2de2
--- /dev/null
+++ b/drivers/gpu/drm/sun4i/sun50i_fmt.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Copyright (C) 2026 Jernej Skrabec <jernej.skrabec@gmail.com>
+ */
+
+#ifndef _SUN50I_FMT_H_
+#define _SUN50I_FMT_H_
+
+#include "sun8i_mixer.h"
+
+/* offset of the formatter in the per-display register region of DE33 */
+#define SUN50I_FMT_DE33		0x5000
+
+#define SUN50I_FMT_CTRL		0x00
+#define SUN50I_FMT_SIZE		0x04
+#define SUN50I_FMT_SWAP		0x08
+#define SUN50I_FMT_DEPTH	0x0c
+#define SUN50I_FMT_FORMAT	0x10
+#define SUN50I_FMT_COEF		0x14
+#define SUN50I_FMT_LMT_Y	0x20
+#define SUN50I_FMT_LMT_C0	0x24
+#define SUN50I_FMT_LMT_C1	0x28
+
+#define SUN50I_FMT_CS_YUV444RGB	0
+#define SUN50I_FMT_CS_YUV422	1
+#define SUN50I_FMT_CS_YUV420	2
+
+/*
+ * Clamp values for the RGB/YUV444 bypass case and the YUV422/YUV420
+ * subsampling case, taken verbatim from the vendor driver. They are
+ * the same for 8-bit and 10-bit output, so the formatter clamps in a
+ * fixed 12-bit internal precision rather than the output width.
+ */
+#define SUN50I_FMT_LIMIT_BYPASS	0x0fff0000
+#define SUN50I_FMT_LIMIT_Y	0x0eb00100
+#define SUN50I_FMT_LIMIT_C	0x0f000100
+
+void sun50i_fmt_setup(struct sun8i_mixer *mixer, u16 width,
+		      u16 height, u32 format);
+
+#endif /* _SUN50I_FMT_H_ */
diff --git a/drivers/gpu/drm/sun4i/sun50i_wb.c b/drivers/gpu/drm/sun4i/sun50i_wb.c
index 82fb2ec02..a7de6eb55 100644
