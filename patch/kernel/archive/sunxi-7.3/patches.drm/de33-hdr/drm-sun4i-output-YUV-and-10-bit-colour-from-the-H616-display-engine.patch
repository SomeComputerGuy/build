+		0xFFFFC133, 0xFFFF5DEC, 0x0000E0E1, 0x00000200,
+		0x0000E0E1, 0xFFFF3135, 0xFFFFEDEA, 0x00000200,
+	},
 };
 
-static const u32 yuv2yuv_de3[2][3][12] = {
+/*
+ * YCbCr encoding and range conversions, always into limited range.
+ * Indexed by input range, input encoding and output encoding.
+ */
+static const u32 yuv2yuv_de3[2][3][3][12] = {
