 	val |= SUN8I_MIXER_CHAN_UI_LAYER_ATTR_EN;
 
 	regmap_write(layer->regs,
-		     SUN8I_MIXER_CHAN_UI_LAYER_ATTR(ch_base, layer->overlay), val);
+		     SUN8I_MIXER_CHAN_UI_LAYER_ATTR(ch_base, slot), val);
 }
 
