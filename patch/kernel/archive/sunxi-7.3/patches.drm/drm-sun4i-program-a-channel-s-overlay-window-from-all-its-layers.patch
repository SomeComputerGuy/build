+++ b/drivers/gpu/drm/sun4i/sun8i_mixer.h
@@ -16,6 +16,8 @@
 #include "sunxi_engine.h"
 #include "sun55i_de.h"
 
+struct drm_atomic_commit;
+struct drm_crtc;
 struct sun50i_cdc;
 struct sun50i_shadow;
 struct sun50i_wb;
@@ -118,6 +120,12 @@ struct sun50i_wb;
 #define SUN50I_MIXER_BLEND_CSC_CTL_EN(ch)	BIT(ch)
 #define SUN50I_MIXER_BLEND_CSC_CONST_VAL(d, c)	(((d) << 16) | ((c) & 0xffff))
 
+/* layer attribute bits 17:16, the same on VI and UI channels */
+#define SUN8I_MIXER_LAYER_ATTR_PREMUL(x)	((x) << 16)
+#define SUN8I_MIXER_LAYER_PREMUL_NONE		0
+#define SUN8I_MIXER_LAYER_PREMUL_CONVERT	1	/* to pre-multiplied */
+#define SUN8I_MIXER_LAYER_PREMUL_INPUT		2	/* is pre-multiplied */
+
 #define SUN8I_MIXER_FBFMT_ARGB8888	0
 #define SUN8I_MIXER_FBFMT_ABGR8888	1
 #define SUN8I_MIXER_FBFMT_RGBA8888	2
@@ -327,12 +335,17 @@ enum {
 	SUN8I_LAYER_TYPE_VI,
 };
 
+/* overlay layers of a channel; layer 3 is on top */
+#define SUN8I_LAYER_OVERLAYS		4
+
 struct sun8i_layer {
 	struct drm_plane		plane;
 	int				type;
 	int				index;
 	int				channel;
 	int				overlay;
+	/* all layers of the channel, NULL when only overlay 0 is a plane */
+	struct sun8i_layer		**chan_layers;
 	struct regmap			*regs;
 	u32				afbc_base;
 	struct sun50i_cdc		*cdc;
@@ -345,6 +358,31 @@ plane_to_sun8i_layer(struct drm_plane *plane)
 	return container_of(plane, struct sun8i_layer, plane);
 }
 
+/**
+ * struct sun8i_ovl - visible layers of a channel
+ * @state: their plane states, bottom (overlay slot 0) first
+ * @num: number of visible layers
+ * @dst: union of their CRTC rectangles, the channel's blender input
+ * @w: overlay window width in source pixels
+ * @h: overlay window height in source pixels
+ */
+struct sun8i_ovl {
+	struct drm_plane_state	*state[SUN8I_LAYER_OVERLAYS];
+	unsigned int		num;
+	struct drm_rect		dst;
+	u32			w, h;
+};
+
+int sun8i_layer_get_ovl(struct sun8i_layer *layer,
+			struct drm_atomic_commit *state,
+			struct drm_crtc *crtc, struct sun8i_ovl *ovl);
+u32 sun8i_ovl_coord(const struct sun8i_ovl *ovl,
+		    const struct drm_plane_state *state);
+u32 sun8i_ovl_premul_ctl(const struct sun8i_ovl *ovl,
+			 const struct drm_plane_state *state);
+int sun8i_ovl_check(struct sun8i_layer *layer, struct drm_atomic_commit *state,
+		    struct drm_crtc *crtc);
+
 /* Blend modes offered by planes that support per-pixel alpha. */
 #define SUN8I_LAYER_BLEND_MODES		(BIT(DRM_MODE_BLEND_PREMULTI) | \
 					 BIT(DRM_MODE_BLEND_COVERAGE) | \
