+/*
+ * The visible layers of @layer's channel on @crtc, in the new state of
+ * @state where it has one. They take the overlay slots bottom up in zpos
+ * order (slot 3 is on top). Returns the slot of @layer, -1 when it is not
+ * visible.
+ */
+int sun8i_layer_get_ovl(struct sun8i_layer *layer,
+			struct drm_atomic_commit *state,
+			struct drm_crtc *crtc, struct sun8i_ovl *ovl)
+{
+	struct sun8i_layer **layers = layer->chan_layers ?: &layer;
+	unsigned int n = layer->chan_layers ? SUN8I_LAYER_OVERLAYS : 1;
+	struct drm_plane_state *first;
+	int i, j, slot = -1;
+
+	memset(ovl, 0, sizeof(*ovl));
+	if (!crtc)
+		return -1;
+
+	for (i = 0; i < n; i++) {
+		struct drm_plane *plane = &layers[i]->plane;
+		struct drm_plane_state *st;
+
+		st = drm_atomic_get_new_plane_state(state, plane) ?: plane->state;
+		if (st->crtc != crtc || !st->visible)
+			continue;
+
+		for (j = ovl->num; j > 0 &&
+		     ovl->state[j - 1]->normalized_zpos > st->normalized_zpos; j--)
+			ovl->state[j] = ovl->state[j - 1];
+		ovl->state[j] = st;
+		ovl->num++;
+	}
+
+	for (i = 0; i < ovl->num; i++) {
+		struct drm_plane_state *st = ovl->state[i];
+
+		if (st->plane == &layer->plane)
+			slot = i;
+		if (!i) {
+			ovl->dst = st->dst;
+			continue;
+		}
+		ovl->dst.x1 = min(ovl->dst.x1, st->dst.x1);
+		ovl->dst.y1 = min(ovl->dst.y1, st->dst.y1);
+		ovl->dst.x2 = max(ovl->dst.x2, st->dst.x2);
+		ovl->dst.y2 = max(ovl->dst.y2, st->dst.y2);
+	}
+
+	if (ovl->num) {
+		/* the layers share one scale factor (sun8i_ovl_check()) */
+		first = ovl->state[0];
+		ovl->w = div_u64((u64)drm_rect_width(&ovl->dst) *
+				 (drm_rect_width(&first->src) >> 16),
+				 drm_rect_width(&first->dst));
+		ovl->h = div_u64((u64)drm_rect_height(&ovl->dst) *
+				 (drm_rect_height(&first->src) >> 16),
+				 drm_rect_height(&first->dst));
+	}
+
+	return slot;
+}
+
+/* position of a layer in the overlay window, in source pixels */
+u32 sun8i_ovl_coord(const struct sun8i_ovl *ovl,
+		    const struct drm_plane_state *state)
+{
+	u32 x, y;
+
+	x = div_u64((u64)(state->dst.x1 - ovl->dst.x1) *
+		    (drm_rect_width(&state->src) >> 16),
+		    drm_rect_width(&state->dst));
+	y = div_u64((u64)(state->dst.y1 - ovl->dst.y1) *
+		    (drm_rect_height(&state->src) >> 16),
+		    drm_rect_height(&state->dst));
+
+	return SUN8I_MIXER_COORD(x, y);
+}
+
+/*
+ * Layer pre-multiply control. A single layer passes its data as is and the
+ * blender pipe is told the blend mode. Several layers are blended inside
+ * the overlay: each is brought to pre-multiplied form and so is the pipe.
+ */
+u32 sun8i_ovl_premul_ctl(const struct sun8i_ovl *ovl,
+			 const struct drm_plane_state *state)
+{
+	if (ovl->num < 2)
+		return SUN8I_MIXER_LAYER_PREMUL_NONE;
+
+	return state->pixel_blend_mode == DRM_MODE_BLEND_PREMULTI ?
+	       SUN8I_MIXER_LAYER_PREMUL_INPUT :
+	       SUN8I_MIXER_LAYER_PREMUL_CONVERT;
+}
+
+/*
+ * The layers of a channel share its overlay window, scaler, CSC, colour
+ * pipeline and decompressor: reject what they cannot show together.
+ */
+int sun8i_ovl_check(struct sun8i_layer *layer, struct drm_atomic_commit *state,
+		    struct drm_crtc *crtc)
+{
+	const struct drm_format_info *f0;
+	struct drm_plane_state *first;
+	struct sun8i_ovl ovl;
+	u32 sw0, sh0, dw0, dh0;
+	const char *why;
+	int i;
+
+	sun8i_layer_get_ovl(layer, state, crtc, &ovl);
+	if (ovl.num < 2)
+		return 0;
+
+	first = ovl.state[0];
+	f0 = first->fb->format;
+	sw0 = drm_rect_width(&first->src) >> 16;
+	sh0 = drm_rect_height(&first->src) >> 16;
+	dw0 = drm_rect_width(&first->dst);
+	dh0 = drm_rect_height(&first->dst);
+
+	for (i = 0; i < ovl.num; i++) {
+		struct drm_plane_state *st = ovl.state[i];
+		struct sun8i_layer *l = plane_to_sun8i_layer(st->plane);
+		const struct drm_format_info *f = st->fb->format;
+		u32 sw, sh, dw, dh, dx, dy, ox, oy;
+
+		why = "AFBC";
+		if (drm_is_afbc(st->fb->modifier))
+			goto reject;
+
+		why = "colour pipeline";
+		if (sun50i_cdc_active(l, state, st))
+			goto reject;
+
+		why = "fractional source";
+		if ((st->src.x1 | st->src.y1 | st->src.x2 | st->src.y2) & 0xffff)
+			goto reject;
+
+		sw = drm_rect_width(&st->src) >> 16;
+		sh = drm_rect_height(&st->src) >> 16;
+		dw = drm_rect_width(&st->dst);
+		dh = drm_rect_height(&st->dst);
+		why = "scale factor";
+		if ((u64)sw * dw0 != (u64)sw0 * dw ||
+		    (u64)sh * dh0 != (u64)sh0 * dh)
+			goto reject;
+
+		dx = st->dst.x1 - ovl.dst.x1;
+		dy = st->dst.y1 - ovl.dst.y1;
+		why = "position between source pixels";
+		if ((u64)dx * sw % dw || (u64)dy * sh % dh)
+			goto reject;
+
+		if (!f->is_yuv && !f0->is_yuv)
+			continue;
+
+		/* the VI overlay has one video format and one CSC */
+		why = "YUV format or colour encoding";
+		if (f->format != f0->format ||
+		    st->color_encoding != first->color_encoding ||
+		    st->color_range != first->color_range)
+			goto reject;
+
+		ox = (u64)dx * sw / dw;
+		oy = (u64)dy * sh / dh;
+		why = "off the chroma grid";
+		if ((st->src.x1 >> 16) % f->hsub || sw % f->hsub ||
+		    ox % f->hsub || (st->src.y1 >> 16) % f->vsub ||
+		    sh % f->vsub || oy % f->vsub)
+			goto reject;
+	}
+
+	return 0;
+
+reject:
+	drm_dbg_atomic(crtc->dev, "[CRTC:%d] channel %d: %u layers, %s\n",
+		       crtc->base.id, layer->channel, ovl.num, why);
+	return -EINVAL;
+}
+
+/* switch off the overlay slots no visible layer uses */
+static void sun8i_layer_clear_slots(struct sun8i_layer *layer,
+				    unsigned int used)
+{
+	u32 ch_base = sun8i_channel_base(layer);
+	unsigned int slot;
+
+	for (slot = used; slot < SUN8I_LAYER_OVERLAYS; slot++)
+		regmap_write(layer->regs,
+			     layer->type == SUN8I_LAYER_TYPE_VI ?
+			     SUN8I_MIXER_CHAN_VI_LAYER_ATTR(ch_base, slot) :
+			     SUN8I_MIXER_CHAN_UI_LAYER_ATTR(ch_base, slot), 0);
+}
+
 /* the planes of one channel on the CRTC being committed */
 struct sun8i_mixer_chan {
+	struct sun8i_layer *layer;	/* any plane of the channel */
 	struct drm_rect dst;		/* union of the visible planes */
 	unsigned int visible;		/* visible planes */
 	bool attached;			/* any plane on the CRTC */
@@ -696,17 +894,20 @@ static void sun8i_mixer_commit(struct sunxi_engine *engine,
 		bool enable;
 		int zpos;
 
-		if (!(plane->possible_crtcs & drm_crtc_mask(crtc)))
+		if (!(plane->possible_crtcs & drm_crtc_mask(crtc)) ||
+		    WARN_ON(layer->index >= MAX_CHANNELS))
 			continue;
 
+		ch = &chans[layer->index];
+		ch->layer = layer;
+
 		plane_state = drm_atomic_get_new_plane_state(state, plane);
 		if (!plane_state)
 			plane_state = plane->state;
 
-		if (plane_state->crtc != crtc || WARN_ON(layer->index >= MAX_CHANNELS))
+		if (plane_state->crtc != crtc)
 			continue;
 
-		ch = &chans[layer->index];
 		enable = plane_state->visible;
 		zpos = plane_state->normalized_zpos;
 
@@ -738,10 +939,12 @@ static void sun8i_mixer_commit(struct sunxi_engine *engine,
 		 * multiplies colour with (pixel and/or plane) alpha itself.
 		 * Planes without a blend mode property (DE2 VI layers, no pixel
 		 * alpha) keep the non-pre-multiplied path, which their global
-		 * alpha relies on.
+		 * alpha relies on. Several layers of one channel leave it
+		 * pre-multiplied (sun8i_ovl_premul_ctl()).
 		 */
-		ch->premul = plane->blend_mode_property &&
-			     plane_state->pixel_blend_mode == DRM_MODE_BLEND_PREMULTI;
+		ch->premul = ch->visible > 1 ||
+			     (plane->blend_mode_property &&
+			      plane_state->pixel_blend_mode == DRM_MODE_BLEND_PREMULTI);
 	}
 
 	/*
@@ -753,6 +956,9 @@ static void sun8i_mixer_commit(struct sunxi_engine *engine,
 		struct sun8i_mixer_chan *ch = &chans[i];
 		int key, pipe = 0, x, y, w, h;
 
+		if (ch->layer && ch->layer->chan_layers)
+			sun8i_layer_clear_slots(ch->layer, ch->visible);
+
 		if (!ch->attached)
 			continue;
 
@@ -1003,7 +1209,66 @@ static void sun50i_mixer_disable_color_correction(struct sunxi_engine *engine)
 	sun50i_mixer_set_output_yuv(engine, false);
 }
 
+/*
+ * A channel is one blender pipe: its visible planes must be adjacent in
+ * z. Every plane of the CRTC joins the commit, as a change of one layer
+ * moves the slots and window coordinates of the others.
+ */
+static int sun50i_mixer_atomic_check(struct sunxi_engine *engine,
+				     struct drm_crtc_state *crtc_state)
+{
+	struct drm_atomic_commit *state = crtc_state->state;
+	struct drm_plane_state *vis[MAX_CHANNELS * SUN8I_LAYER_OVERLAYS];
+	struct drm_crtc *crtc = crtc_state->crtc;
+	unsigned int n = 0, seen = 0;
+	struct drm_plane *plane;
+	int i, j, last = -1, ret;
+
+	ret = drm_atomic_add_affected_planes(state, crtc);
+	if (ret)
+		return ret;
+
+	drm_for_each_plane_mask(plane, crtc->dev, crtc_state->plane_mask) {
+		struct drm_plane_state *st;
+
+		st = drm_atomic_get_new_plane_state(state, plane);
+		if (!st || !st->visible)
+			continue;
+		if (WARN_ON(n == ARRAY_SIZE(vis)))
+			return -EINVAL;
+
+		for (j = n; j > 0 &&
+		     vis[j - 1]->normalized_zpos > st->normalized_zpos; j--)
+			vis[j] = vis[j - 1];
+		vis[j] = st;
+		n++;
+	}
+
+	for (i = 0; i < n; i++) {
+		struct sun8i_layer *layer = plane_to_sun8i_layer(vis[i]->plane);
+
+		if (layer->index == last)
+			continue;
+
+		if (seen & BIT(layer->index)) {
+			drm_dbg_atomic(crtc->dev,
+				       "[CRTC:%d] channel %d planes not adjacent in z\n",
+				       crtc->base.id, layer->channel);
+			return -EINVAL;
+		}
+		seen |= BIT(layer->index);
+		last = layer->index;
+
+		ret = sun8i_ovl_check(layer, state, crtc);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
 static const struct sunxi_engine_ops sun50i_engine_ops = {
+	.atomic_check		= sun50i_mixer_atomic_check,
 	.commit			= sun8i_mixer_commit,
 	.layers_init		= sun50i_layers_init,
 	.mode_set		= sun8i_mixer_mode_set,
diff --git a/drivers/gpu/drm/sun4i/sun8i_mixer.h b/drivers/gpu/drm/sun4i/sun8i_mixer.h
