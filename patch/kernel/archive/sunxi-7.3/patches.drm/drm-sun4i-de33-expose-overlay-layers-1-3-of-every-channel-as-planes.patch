From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 13 Nov 2026 20:53:15 +0000
Subject: [PATCH] drm/sun4i: de33: Expose overlay layers 1-3 of every channel
 as planes

Each DE33 channel has four overlay layers but only layer 0 was a plane.
Create a plane for each layer, with default zpos channel * 4 + layer so
that the planes of a channel are adjacent in z. The decompressor and the
colour pipeline act on the whole channel and stay on layer 0.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/gpu/drm/sun4i/sun50i_afbc.c    |  2 +-
 drivers/gpu/drm/sun4i/sun50i_planes.c  | 70 ++++++++++++++++----------
 drivers/gpu/drm/sun4i/sun8i_mixer.c    |  4 +-
 drivers/gpu/drm/sun4i/sun8i_ui_layer.c |  5 +-
 drivers/gpu/drm/sun4i/sun8i_ui_layer.h |  1 +
 drivers/gpu/drm/sun4i/sun8i_vi_layer.c | 11 ++--
 drivers/gpu/drm/sun4i/sun8i_vi_layer.h |  1 +
 7 files changed, 59 insertions(+), 35 deletions(-)

diff --git a/drivers/gpu/drm/sun4i/sun50i_afbc.c b/drivers/gpu/drm/sun4i/sun50i_afbc.c
index efe52bb84..4fb84e50e 100644
--- a/drivers/gpu/drm/sun4i/sun50i_afbc.c
+++ b/drivers/gpu/drm/sun4i/sun50i_afbc.c
@@ -133,7 +133,7 @@ static const struct sun50i_afbc_format *sun50i_afbc_get_format(u32 format)
 
 static bool sun50i_afbc_supported(struct sun8i_layer *layer)
 {
-	return layer->cfg->afbc_mask & BIT(layer->channel);
+	return layer->cfg->afbc_mask & BIT(layer->channel) && !layer->overlay;
 }
 
 bool sun50i_afbc_format_mod_supported(struct sun8i_layer *layer,
diff --git a/drivers/gpu/drm/sun4i/sun50i_planes.c b/drivers/gpu/drm/sun4i/sun50i_planes.c
index b4013881d..9c7e685d1 100644
--- a/drivers/gpu/drm/sun4i/sun50i_planes.c
+++ b/drivers/gpu/drm/sun4i/sun50i_planes.c
@@ -65,7 +65,7 @@ sun50i_planes_setup(struct device *dev, struct drm_device *drm,
 	const struct sun50i_planes_quirks *quirks;
 	struct drm_plane **drm_planes;
 	const struct default_map *map;
-	unsigned int i;
+	unsigned int i, ovl, num;
 
 	if (!of_match_node(sun50i_planes_of_table, dev->of_node)) {
 		dev_err(dev, "Device is not planes driver!\n");
@@ -85,37 +85,55 @@ sun50i_planes_setup(struct device *dev, struct drm_device *drm,
 	quirks = planes->quirks;
 	map = &quirks->def_map[mixer];
 
-	drm_planes = devm_kcalloc(drm->dev, map->num_ch + 1,
-				  sizeof(*drm_planes), GFP_KERNEL);
+	/* every overlay layer of a channel is a plane */
+	num = map->num_ch * SUN8I_LAYER_OVERLAYS;
+	drm_planes = devm_kcalloc(drm->dev, num + 1, sizeof(*drm_planes),
+				  GFP_KERNEL);
 	if (!drm_planes)
 		return ERR_PTR(-ENOMEM);
 
 	for (i = 0; i < map->num_ch; i++) {
 		unsigned int phy_ch = map->map[i];
-		struct sun8i_layer *layer;
-		enum drm_plane_type type;
-
-		if ((i == 0 && map->num_ch == 1) || i == 1)
-			type = DRM_PLANE_TYPE_PRIMARY;
-		else
-			type = DRM_PLANE_TYPE_OVERLAY;
-
-		if (phy_ch < UI_PLANE_OFFSET)
-			layer = sun8i_vi_layer_init_one(drm, type, planes->regs,
-							i, phy_ch, map->num_ch,
-							&quirks->cfg);
-		else
-			layer = sun8i_ui_layer_init_one(drm, type, planes->regs,
-							i, phy_ch, map->num_ch,
-							&quirks->cfg);
-
-		if (IS_ERR(layer)) {
-			dev_err(drm->dev,
-				"Couldn't initialize DRM plane\n");
-			return ERR_CAST(layer);
-		}
+		struct sun8i_layer **chan_layers;
+
+		chan_layers = devm_kcalloc(drm->dev, SUN8I_LAYER_OVERLAYS,
+					   sizeof(*chan_layers), GFP_KERNEL);
+		if (!chan_layers)
+			return ERR_PTR(-ENOMEM);
+
+		for (ovl = 0; ovl < SUN8I_LAYER_OVERLAYS; ovl++) {
+			unsigned int n = i * SUN8I_LAYER_OVERLAYS + ovl;
+			struct sun8i_layer *layer;
+			enum drm_plane_type type;
 
-		drm_planes[i] = &layer->plane;
+			if (!ovl && ((i == 0 && map->num_ch == 1) || i == 1))
+				type = DRM_PLANE_TYPE_PRIMARY;
+			else
+				type = DRM_PLANE_TYPE_OVERLAY;
+
+			if (phy_ch < UI_PLANE_OFFSET)
+				layer = sun8i_vi_layer_init_one(drm, type,
+								planes->regs,
+								i, phy_ch, ovl,
+								n, num,
+								&quirks->cfg);
+			else
+				layer = sun8i_ui_layer_init_one(drm, type,
+								planes->regs,
+								i, phy_ch, ovl,
+								n, num,
+								&quirks->cfg);
+
+			if (IS_ERR(layer)) {
+				dev_err(drm->dev,
+					"Couldn't initialize DRM plane\n");
+				return ERR_CAST(layer);
+			}
+
+			layer->chan_layers = chan_layers;
+			chan_layers[ovl] = layer;
+			drm_planes[n] = &layer->plane;
+		}
 	}
 
 	return drm_planes;
diff --git a/drivers/gpu/drm/sun4i/sun8i_mixer.c b/drivers/gpu/drm/sun4i/sun8i_mixer.c
index 72a8b8b54..d0cf6faf8 100644
--- a/drivers/gpu/drm/sun4i/sun8i_mixer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_mixer.c
@@ -1025,7 +1025,7 @@ static struct drm_plane **sun8i_layers_init(struct drm_device *drm,
 			type = DRM_PLANE_TYPE_OVERLAY;
 
 		layer = sun8i_vi_layer_init_one(drm, type, mixer->engine.regs,
-						i, i, plane_cnt,
+						i, i, 0, i, plane_cnt,
 						&mixer->cfg->lay_cfg);
 		if (IS_ERR(layer)) {
 			dev_err(drm->dev,
@@ -1046,7 +1046,7 @@ static struct drm_plane **sun8i_layers_init(struct drm_device *drm,
 			type = DRM_PLANE_TYPE_CURSOR;
 
 		layer = sun8i_ui_layer_init_one(drm, type, mixer->engine.regs,
-						index, index, plane_cnt,
+						index, index, 0, index, plane_cnt,
 						&mixer->cfg->lay_cfg);
 		if (IS_ERR(layer)) {
 			dev_err(drm->dev, "Couldn't initialize %s plane\n",
diff --git a/drivers/gpu/drm/sun4i/sun8i_ui_layer.c b/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
index e135c1614..1f38179fa 100644
--- a/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
@@ -285,6 +285,7 @@ struct sun8i_layer *sun8i_ui_layer_init_one(struct drm_device *drm,
 					    enum drm_plane_type type,
 					    struct regmap *regs,
 					    int index, int phy_index,
+					    int overlay, int zpos,
 					    int plane_cnt,
 					    const struct sun8i_layer_cfg *cfg)
 {
@@ -298,7 +299,7 @@ struct sun8i_layer *sun8i_ui_layer_init_one(struct drm_device *drm,
 	layer->type = SUN8I_LAYER_TYPE_UI;
 	layer->index = index;
 	layer->channel = phy_index;
-	layer->overlay = 0;
+	layer->overlay = overlay;
 	layer->regs = regs;
 	layer->cfg = cfg;
 
@@ -326,7 +327,7 @@ struct sun8i_layer *sun8i_ui_layer_init_one(struct drm_device *drm,
 		return ERR_PTR(ret);
 	}
 
-	ret = drm_plane_create_zpos_property(&layer->plane, index,
+	ret = drm_plane_create_zpos_property(&layer->plane, zpos,
 					     0, plane_cnt - 1);
 	if (ret) {
 		dev_err(drm->dev, "Couldn't add zpos property\n");
diff --git a/drivers/gpu/drm/sun4i/sun8i_ui_layer.h b/drivers/gpu/drm/sun4i/sun8i_ui_layer.h
index 1581ffc6d..064f08d61 100644
--- a/drivers/gpu/drm/sun4i/sun8i_ui_layer.h
+++ b/drivers/gpu/drm/sun4i/sun8i_ui_layer.h
@@ -53,6 +53,7 @@ struct sun8i_layer *sun8i_ui_layer_init_one(struct drm_device *drm,
 					    enum drm_plane_type type,
 					    struct regmap *regs,
 					    int index, int phy_index,
+					    int overlay, int zpos,
 					    int plane_cnt,
 					    const struct sun8i_layer_cfg *cfg);
 #endif /* _SUN8I_UI_LAYER_H_ */
diff --git a/drivers/gpu/drm/sun4i/sun8i_vi_layer.c b/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
index b36ba5a2e..16934d295 100644
--- a/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
@@ -523,6 +523,7 @@ struct sun8i_layer *sun8i_vi_layer_init_one(struct drm_device *drm,
 					    enum drm_plane_type type,
 					    struct regmap *regs,
 					    int index, int phy_index,
+					    int overlay, int zpos,
 					    int plane_cnt,
 					    const struct sun8i_layer_cfg *cfg)
 {
@@ -540,7 +541,7 @@ struct sun8i_layer *sun8i_vi_layer_init_one(struct drm_device *drm,
 	layer->type = SUN8I_LAYER_TYPE_VI;
 	layer->index = index;
 	layer->channel = phy_index;
-	layer->overlay = 0;
+	layer->overlay = overlay;
 	layer->regs = regs;
 	layer->cfg = cfg;
 
@@ -554,7 +555,8 @@ struct sun8i_layer *sun8i_vi_layer_init_one(struct drm_device *drm,
 			formats = sun8i_vi_layer_de3_no_yuv_formats;
 			format_count = ARRAY_SIZE(sun8i_vi_layer_de3_no_yuv_formats);
 		}
-		modifiers = layer->cfg->afbc_mask & BIT(phy_index) ?
+		/* the decompressor replaces the whole overlay */
+		modifiers = layer->cfg->afbc_mask & BIT(phy_index) && !overlay ?
 			    sun50i_afbc_modifiers : sun8i_layer_modifiers;
 	} else {
 		formats = sun8i_vi_layer_formats;
@@ -591,7 +593,7 @@ struct sun8i_layer *sun8i_vi_layer_init_one(struct drm_device *drm,
 		}
 	}
 
-	ret = drm_plane_create_zpos_property(&layer->plane, index,
+	ret = drm_plane_create_zpos_property(&layer->plane, zpos,
 					     0, plane_cnt - 1);
 	if (ret) {
 		dev_err(drm->dev, "Couldn't add zpos property\n");
@@ -616,7 +618,8 @@ struct sun8i_layer *sun8i_vi_layer_init_one(struct drm_device *drm,
 		return ERR_PTR(ret);
 	}
 
-	if (layer->cfg->cdc_mask & BIT(phy_index)) {
+	/* the CDC is a channel unit, its pipeline is on overlay 0 */
+	if (layer->cfg->cdc_mask & BIT(phy_index) && !overlay) {
 		ret = sun50i_cdc_init(layer);
 		if (ret) {
 			dev_err(drm->dev, "Couldn't add the colour pipeline\n");
diff --git a/drivers/gpu/drm/sun4i/sun8i_vi_layer.h b/drivers/gpu/drm/sun4i/sun8i_vi_layer.h
index 29cc55736..2e789cddc 100644
--- a/drivers/gpu/drm/sun4i/sun8i_vi_layer.h
+++ b/drivers/gpu/drm/sun4i/sun8i_vi_layer.h
@@ -58,6 +58,7 @@ struct sun8i_layer *sun8i_vi_layer_init_one(struct drm_device *drm,
 					    enum drm_plane_type type,
 					    struct regmap *regs,
 					    int index, int phy_index,
+					    int overlay, int zpos,
 					    int plane_cnt,
 					    const struct sun8i_layer_cfg *cfg);
 #endif /* _SUN8I_VI_LAYER_H_ */
