diff --git a/drivers/media/platform/sunxi/sun50i-di300/sun50i-di300.c b/drivers/media/platform/sunxi/sun50i-di300/sun50i-di300.c
index 4dc81dfbf..54a2364fb 100644
--- a/drivers/media/platform/sunxi/sun50i-di300/sun50i-di300.c
+++ b/drivers/media/platform/sunxi/sun50i-di300/sun50i-di300.c
@@ -21,6 +21,7 @@
 #include <linux/clk.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
+#include <linux/math64.h>
 #include <linux/minmax.h>
 #include <linux/module.h>
 #include <linux/of.h>
@@ -191,21 +192,108 @@ static void deinterlace_write_out_addr(struct deinterlace_dev *dev,
 	deinterlace_write(dev, hreg, 0);
 }
 
+static bool deinterlace_fmt_is_planar(u32 pixelformat)
+{
+	switch (pixelformat) {
+	case V4L2_PIX_FMT_YUV420:
+	case V4L2_PIX_FMT_YVU420:
+	case V4L2_PIX_FMT_YUV422P:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool deinterlace_fmt_is_422(u32 pixelformat)
+{
+	switch (pixelformat) {
+	case V4L2_PIX_FMT_NV16:
+	case V4L2_PIX_FMT_NV61:
+	case V4L2_PIX_FMT_YUV422P:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* frames of input history a mode keeps after a run */
+static unsigned int deinterlace_mode_history(unsigned int mode)
+{
+	switch (mode) {
+	case DEINTERLACE_MODE_MOTION_FIELD:
+		return 2;
+	case DEINTERLACE_MODE_MOTION_FRAME:
+	case DEINTERLACE_MODE_TNR:
+		return 1;
+	default:
+		return 0;
+	}
+}
+
+static unsigned int deinterlace_mode_outputs(unsigned int mode)
+{
+	return mode == DEINTERLACE_MODE_MOTION_FIELD ? 2 : 1;
+}
+
+static void deinterlace_write_pitches(struct deinterlace_dev *dev,
+				      const struct deinterlace_planes *f0,
+				      const struct deinterlace_planes *f1,
+				      const struct deinterlace_planes *f2,
+				      const struct deinterlace_planes *dit,
+				      const struct deinterlace_planes *tnr)
+{
+	unsigned int i;
+
+	/* input pitches are field pitches: two lines of the frame */
+	for (i = 0; i < 3; i++) {
+		deinterlace_write(dev, DEINTERLACE_IN_F01_PITCH(i),
+				  DEINTERLACE_IN_F01_PITCH_F0(f0->pitch[i] * 2) |
+				  DEINTERLACE_IN_F01_PITCH_F1(f1->pitch[i] * 2));
+		deinterlace_write(dev, DEINTERLACE_IN_F2_PITCH(i),
+				  f2->pitch[i] * 2);
+		deinterlace_write(dev, DEINTERLACE_OUT_DIT_PITCH(i),
+				  dit->pitch[i]);
+		deinterlace_write(dev, DEINTERLACE_OUT_TNR_PITCH(i),
+				  tnr ? tnr->pitch[i] : 0);
+	}
+}
+
+static u32 deinterlace_tnr_strength(struct deinterlace_ctx *ctx)
+{
+	u32 s = ctx->tnr_mode == DEINTERLACE_TNR_ADAPTIVE ?
+		ctx->tnr_gain : ctx->tnr_strength;
+
+	return DEINTERLACE_TNR_STRENGTH_Y(s) | DEINTERLACE_TNR_STRENGTH_U(s) |
+	       DEINTERLACE_TNR_STRENGTH_V(s);
+}
+
 static void deinterlace_device_run(void *priv)
 {
 	struct deinterlace_ctx *ctx = priv;
 	struct deinterlace_dev *dev = ctx->dev;
 	struct vb2_v4l2_buffer *src, *dst0, *dst1;
-	struct deinterlace_planes in_pl, out_pl;
+	struct deinterlace_planes src_pl, dst_pl, tnr_pl;
+	const struct deinterlace_planes *f0_pl, *f1_pl;
 	struct v4l2_m2m_buffer *b;
-	dma_addr_t next, curr, prev, out0, out1;
-	unsigned int hwfmt = deinterlace_hw_format(ctx->src_fmt.pixelformat);
-	unsigned int i, reg;
-	bool motion;
+	dma_addr_t f0, f1, f2, out0, out1;
+	unsigned int src_hw = deinterlace_hw_format(ctx->src_fmt.pixelformat);
+	unsigned int dst_hw = deinterlace_hw_format(ctx->dst_fmt.pixelformat);
+	unsigned int tnr_hw = deinterlace_hw_format(ctx->tnr_fmt.pixelformat);
+	unsigned int f0_hw, f1_hw, i, reg, dma, func;
+	unsigned int mode = ctx->mode;
+	bool motion, tnr_ref;
 
 	src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
 
-	ctx->fmd_active = dev->has_fmd && ctx->fmd_enabled;
+	ctx->fmd_active = dev->has_fmd && ctx->fmd_enabled &&
+			  mode == DEINTERLACE_MODE_MOTION_FIELD;
+	ctx->tnr_active = dev->has_tnr && ctx->tnr_mode != DEINTERLACE_TNR_OFF &&
+			  (mode == DEINTERLACE_MODE_MOTION_FIELD ||
+			   mode == DEINTERLACE_MODE_MOTION_FRAME ||
+			   mode == DEINTERLACE_MODE_TNR) &&
+			  deinterlace_fmt_is_planar(ctx->dst_fmt.pixelformat);
+	if (mode == DEINTERLACE_MODE_TNR)
+		ctx->tnr_active = true; /* checked in start_streaming() */
 
 	/*
 	 * Apply this job's field-weave decision, if userspace attached a
@@ -222,19 +310,16 @@ static void deinterlace_device_run(void *priv)
 	}
 
 	/*
-	 * Pick the two buffers actually at the front of the ready
-	 * queue. v4l2_m2m_last_dst_buf() returns the tail of the whole
-	 * ready list, which is only the "second" buffer when exactly
-	 * two are queued; with more buffers queued (the normal case for
-	 * any real client) it names a buffer this job never touches,
-	 * while the IRQ handler's two dst_buf_remove() calls always pop
-	 * from the front and would complete a stale, never-written one.
+	 * Pick the buffers actually at the front of the ready queue; the
+	 * IRQ handler completes these same buffers by pointer.
 	 */
 	dst0 = NULL;
 	dst1 = NULL;
 	v4l2_m2m_for_each_dst_buf(ctx->fh.m2m_ctx, b) {
 		if (!dst0) {
 			dst0 = &b->vb;
+			if (deinterlace_mode_outputs(mode) < 2)
+				break;
 		} else if (!dst1) {
 			dst1 = &b->vb;
 			break;
@@ -244,95 +329,190 @@ static void deinterlace_device_run(void *priv)
 	ctx->dst1 = dst1;
 
 	v4l2_m2m_buf_copy_metadata(src, dst0);
-	v4l2_m2m_buf_copy_metadata(src, dst1);
-	/*
-	 * The second output is the second field of the same frame: put it
-	 * half a frame interval after the first one, so field-rate output
-	 * keeps monotonic, evenly spaced timestamps.
-	 */
-	if (ctx->prev[0] && src->vb2_buf.timestamp > ctx->prev[0]->vb2_buf.timestamp)
-		dst1->vb2_buf.timestamp +=
-			(src->vb2_buf.timestamp -
-			 ctx->prev[0]->vb2_buf.timestamp) / 2;
+	if (dst1) {
+		v4l2_m2m_buf_copy_metadata(src, dst1);
+		/*
+		 * The second output is the second field of the same frame:
+		 * put it half a frame interval after the first one, so
+		 * field-rate output keeps monotonic, evenly spaced
+		 * timestamps.
+		 */
+		if (ctx->prev[0] &&
+		    src->vb2_buf.timestamp > ctx->prev[0]->vb2_buf.timestamp)
+			dst1->vb2_buf.timestamp +=
+				(src->vb2_buf.timestamp -
+				 ctx->prev[0]->vb2_buf.timestamp) / 2;
+	}
 
-	next = vb2_dma_contig_plane_dma_addr(&src->vb2_buf, 0);
-	curr = ctx->prev[0] ?
-		vb2_dma_contig_plane_dma_addr(&ctx->prev[0]->vb2_buf, 0) : next;
-	prev = ctx->prev[1] ?
-		vb2_dma_contig_plane_dma_addr(&ctx->prev[1]->vb2_buf, 0) : curr;
+	deinterlace_get_planes(&ctx->src_fmt, &src_pl);
+	deinterlace_get_planes(&ctx->dst_fmt, &dst_pl);
+	deinterlace_get_planes(&ctx->tnr_fmt, &tnr_pl);
 
 	/*
-	 * A single real temporal neighbour (prev[0]) is enough to turn
-	 * motion mode on: the missing prev[1] slot then just duplicates
-	 * curr, which reads as "no motion" between those two and leaves
-	 * the genuine next-vs-curr comparison to drive the spatial/
-	 * temporal blend. Requiring both slots real only delays real
-	 * motion-adaptive output by an extra frame at stream start.
+	 * Input slots are in temporal order, oldest first: the vendor
+	 * userspace (libcedarc omx_deinterlace.cpp, diSetPara()) puts the
+	 * frame before last in IN_F0, the previous frame in IN_F1 and the
+	 * newest frame in IN_F2. The DIT deinterlaces IN_F1 (fields 2 and
+	 * 3) and the TNR filters IN_F2 against IN_F1. The single-frame
+	 * modes (bob, weave) read IN_F1 only.
+	 *
+	 * With TNR on, the filtered copies of the previous frames, kept in
+	 * driver buffers, replace the original frames as references, as
+	 * the vendor does (recursive filtering): the frame the DIT outputs
+	 * is then the filtered one.
 	 */
-	motion = ctx->prev[0] != NULL;
+	f2 = vb2_dma_contig_plane_dma_addr(&src->vb2_buf, 0);
+	f1_pl = &src_pl;
+	f0_pl = &src_pl;
+	f1_hw = src_hw;
+	f0_hw = src_hw;
+
+	switch (mode) {
+	case DEINTERLACE_MODE_BOB:
+	case DEINTERLACE_MODE_WEAVE:
+		f1 = f2;
+		f0 = f2;
+		motion = false;
+		break;
+	default:
+		f1 = ctx->prev[0] ?
+			vb2_dma_contig_plane_dma_addr(&ctx->prev[0]->vb2_buf, 0) :
+			f2;
+		f0 = ctx->prev[1] ?
+			vb2_dma_contig_plane_dma_addr(&ctx->prev[1]->vb2_buf, 0) :
+			f1;
+		/*
+		 * A single real temporal neighbour is enough for motion
+		 * detection; the first run has none and falls back to
+		 * spatial interpolation.
+		 */
+		motion = ctx->prev[0] != NULL;
+		break;
+	}
+
+	tnr_ref = false;
+	if (ctx->tnr_active && ctx->tnr_hist[0] >= 0) {
+		f1 = ctx->tnr_dma[ctx->tnr_hist[0]];
+		f1_pl = &tnr_pl;
+		f1_hw = tnr_hw;
+		f0 = f1;
+		f0_pl = f1_pl;
+		f0_hw = f1_hw;
+		tnr_ref = true;
+	}
+	if (tnr_ref && ctx->tnr_hist[1] >= 0) {
+		f0 = ctx->tnr_dma[ctx->tnr_hist[1]];
+	} else if (tnr_ref && ctx->prev[1]) {
+		f0 = vb2_dma_contig_plane_dma_addr(&ctx->prev[1]->vb2_buf, 0);
+		f0_pl = &src_pl;
+		f0_hw = src_hw;
+	}
 
 	deinterlace_write(dev, DEINTERLACE_SIZE,
 			  DEINTERLACE_SIZE_WIDTH(ctx->src_fmt.width) |
 			  DEINTERLACE_SIZE_HEIGHT(ctx->src_fmt.height));
 
-	reg = DEINTERLACE_FMT_IN0(hwfmt) | DEINTERLACE_FMT_IN1(hwfmt) |
-	      DEINTERLACE_FMT_IN2(hwfmt) | DEINTERLACE_FMT_DIT(hwfmt);
-	if (deinterlace_fmt_is_uv_combined(ctx->src_fmt.pixelformat) &&
-	    deinterlace_fmt_is_uv_first(ctx->src_fmt.pixelformat))
+	reg = DEINTERLACE_FMT_IN0(f0_hw) | DEINTERLACE_FMT_IN1(f1_hw) |
+	      DEINTERLACE_FMT_IN2(src_hw) | DEINTERLACE_FMT_DIT(dst_hw) |
+	      DEINTERLACE_FMT_TNR(tnr_hw);
+	/* one UV order for all semi-planar buffers (try_fmt keeps them equal) */
+	if ((deinterlace_fmt_is_uv_combined(ctx->src_fmt.pixelformat) &&
+	     deinterlace_fmt_is_uv_first(ctx->src_fmt.pixelformat)) ||
+	    (deinterlace_fmt_is_uv_combined(ctx->dst_fmt.pixelformat) &&
+	     deinterlace_fmt_is_uv_first(ctx->dst_fmt.pixelformat)))
 		reg |= DEINTERLACE_FMT_UVSEQ;
 	deinterlace_write(dev, DEINTERLACE_FMT, reg);
 
-	if (ctx->first_field)
-		deinterlace_write(dev, DEINTERLACE_FIELD_ORDER,
-				  DEINTERLACE_FIELD_ORDER_BFF);
-	else
-		deinterlace_write(dev, DEINTERLACE_FIELD_ORDER, 0);
-
-	deinterlace_get_planes(&ctx->src_fmt, &in_pl);
-	deinterlace_get_planes(&ctx->dst_fmt, &out_pl);
-
-	/* input pitches are field pitches: two lines of the frame */
-	for (i = 0; i < 3; i++) {
-		unsigned int in_pitch = in_pl.pitch[i] * 2;
-
-		deinterlace_write(dev, DEINTERLACE_IN_F01_PITCH(i),
-				  DEINTERLACE_IN_F01_PITCH_F0(in_pitch) |
-				  DEINTERLACE_IN_F01_PITCH_F1(in_pitch));
-		deinterlace_write(dev, DEINTERLACE_IN_F2_PITCH(i), in_pitch);
-		deinterlace_write(dev, DEINTERLACE_OUT_DIT_PITCH(i),
-				  out_pl.pitch[i]);
-	}
+	deinterlace_write(dev, DEINTERLACE_FIELD_ORDER,
+			  ctx->first_field ? DEINTERLACE_FIELD_ORDER_BFF : 0);
 
-	/*
-	 * Input slots are in temporal order, oldest first: the vendor
-	 * userspace (libcedarc omx_deinterlace.cpp, diSetPara()) puts the
-	 * frame before last in in_fb0, the previous frame in in_fb1 and the
-	 * newest frame in in_fb2, and the hardware deinterlaces the middle
-	 * slot (fields 2 and 3).
-	 */
+	deinterlace_write_pitches(dev, f0_pl, f1_pl, &src_pl, &dst_pl,
+				  ctx->tnr_active ? (mode == DEINTERLACE_MODE_TNR ?
+						     &dst_pl : &tnr_pl) : NULL);
 
 	deinterlace_write_in_addr(dev, DEINTERLACE_IN_F0_TOP_ADDR(0),
 				  DEINTERLACE_IN_F0_TOP_HADDR,
 				  DEINTERLACE_IN_F0_BOT_ADDR(0),
-				  DEINTERLACE_IN_F0_BOT_HADDR,
-				  prev, &in_pl);
+				  DEINTERLACE_IN_F0_BOT_HADDR, f0, f0_pl);
 	deinterlace_write_in_addr(dev, DEINTERLACE_IN_F1_TOP_ADDR(0),
 				  DEINTERLACE_IN_F1_TOP_HADDR,
 				  DEINTERLACE_IN_F1_BOT_ADDR(0),
-				  DEINTERLACE_IN_F1_BOT_HADDR,
-				  curr, &in_pl);
+				  DEINTERLACE_IN_F1_BOT_HADDR, f1, f1_pl);
 	deinterlace_write_in_addr(dev, DEINTERLACE_IN_F2_TOP_ADDR(0),
 				  DEINTERLACE_IN_F2_TOP_HADDR,
 				  DEINTERLACE_IN_F2_BOT_ADDR(0),
-				  DEINTERLACE_IN_F2_BOT_HADDR,
-				  next, &in_pl);
+				  DEINTERLACE_IN_F2_BOT_HADDR, f2, &src_pl);
 
 	out0 = vb2_dma_contig_plane_dma_addr(&dst0->vb2_buf, 0);
-	out1 = vb2_dma_contig_plane_dma_addr(&dst1->vb2_buf, 0);
-	deinterlace_write_out_addr(dev, DEINTERLACE_OUT_DIT0_ADDR(0),
-				   DEINTERLACE_OUT_DIT0_HADDR, out0, &out_pl);
-	deinterlace_write_out_addr(dev, DEINTERLACE_OUT_DIT1_ADDR(0),
-				   DEINTERLACE_OUT_DIT1_HADDR, out1, &out_pl);
+	out1 = dst1 ? vb2_dma_contig_plane_dma_addr(&dst1->vb2_buf, 0) : 0;
+
+	/*
+	 * Output routing, from the vendor driver (di_client_reset()):
+	 * field-rate motion mode writes both DIT outputs; the single-frame
+	 * modes write DIT output 1 only; TNR-only mode writes only the TNR
+	 * output. Other modes with TNR write the filtered newest frame to
+	 * a driver buffer, for use as reference by the next runs.
+	 */
+	dma = DEINTERLACE_DMA_CTL_MCLK_GATE;
+	func = 0;
+	switch (mode) {
+	case DEINTERLACE_MODE_MOTION_FIELD:
+		dma |= DEINTERLACE_DMA_CTL_DI | DEINTERLACE_DMA_CTL_P |
+		       DEINTERLACE_DMA_CTL_C | DEINTERLACE_DMA_CTL_W0 |
+		       DEINTERLACE_DMA_CTL_W1;
+		func |= DEINTERLACE_FUNC_EN_DIT;
+		deinterlace_write_out_addr(dev, DEINTERLACE_OUT_DIT0_ADDR(0),
+					   DEINTERLACE_OUT_DIT0_HADDR, out0,
+					   &dst_pl);
+		deinterlace_write_out_addr(dev, DEINTERLACE_OUT_DIT1_ADDR(0),
+					   DEINTERLACE_OUT_DIT1_HADDR, out1,
+					   &dst_pl);
+		break;
+	case DEINTERLACE_MODE_MOTION_FRAME:
+		dma |= DEINTERLACE_DMA_CTL_P | DEINTERLACE_DMA_CTL_C |
+		       DEINTERLACE_DMA_CTL_W1;
+		func |= DEINTERLACE_FUNC_EN_DIT;
+		deinterlace_write_out_addr(dev, DEINTERLACE_OUT_DIT1_ADDR(0),
+					   DEINTERLACE_OUT_DIT1_HADDR, out0,
+					   &dst_pl);
+		break;
+	case DEINTERLACE_MODE_BOB:
+	case DEINTERLACE_MODE_WEAVE:
+		dma |= DEINTERLACE_DMA_CTL_P | DEINTERLACE_DMA_CTL_W1;
+		func |= DEINTERLACE_FUNC_EN_DIT;
+		deinterlace_write_out_addr(dev, DEINTERLACE_OUT_DIT1_ADDR(0),
+					   DEINTERLACE_OUT_DIT1_HADDR, out0,
+					   &dst_pl);
+		break;
+	case DEINTERLACE_MODE_TNR:
+		dma |= DEINTERLACE_DMA_CTL_P | DEINTERLACE_DMA_CTL_C;
+		deinterlace_write_out_addr(dev, DEINTERLACE_OUT_TNR_ADDR(0),
+					   DEINTERLACE_OUT_TNR_HADDR, out0,
+					   &dst_pl);
+		break;
+	}
+
+	if (ctx->tnr_active) {
+		dma |= DEINTERLACE_DMA_CTL_TNR;
+		func |= DEINTERLACE_FUNC_EN_TNR;
+		if (mode != DEINTERLACE_MODE_TNR) {
+			ctx->tnr_cur = 0;
+			while (ctx->tnr_cur == ctx->tnr_hist[0] ||
+			       ctx->tnr_cur == ctx->tnr_hist[1])
