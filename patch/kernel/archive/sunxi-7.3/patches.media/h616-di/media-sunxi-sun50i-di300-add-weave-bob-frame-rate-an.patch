+		dma |= DEINTERLACE_DMA_CTL_FR | DEINTERLACE_DMA_CTL_FW;
+		func |= DEINTERLACE_FUNC_EN_MD;
+	}
 
 	/*
 	 * Motion flags: two bits per pixel, read from the previous run and
@@ -344,20 +524,23 @@ static void deinterlace_device_run(void *priv)
 	deinterlace_write(dev, DEINTERLACE_OUT_FLAG_ADDR,
 			  ctx->flag_dma[!ctx->flag_idx]);
 	deinterlace_write(dev, DEINTERLACE_FLAG_HADDR, 0);
-	ctx->flag_idx = !ctx->flag_idx;
+	if (func & DEINTERLACE_FUNC_EN_MD)
+		ctx->flag_idx = !ctx->flag_idx;
 
 	/*
-	 * Restrict the deinterlace and motion-detect blocks to the full
-	 * frame. The crop registers power up as an empty (zero) window;
-	 * left at zero the engine asserts busy but processes nothing and
-	 * never signals completion.
+	 * Restrict the deinterlace, motion-detect and TNR blocks to the
+	 * full frame. The crop registers power up as an empty (zero)
+	 * window; left at zero the engine asserts busy but processes
+	 * nothing and never signals completion.
 	 */
 	reg = (ctx->src_fmt.width - 1) << 16;
 	deinterlace_write(dev, DEINTERLACE_DIT_CROP_H, reg);
 	deinterlace_write(dev, DEINTERLACE_MD_CROP_H, reg);
