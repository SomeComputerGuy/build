+/*
+ * The TNR output is planar (datasheet: YV12 or planar YUV422) and, in
+ * the deinterlacing modes, goes to driver buffers that serve as the
+ * filtered references of the next runs: the newest frame written, the
+ * two previous ones read.
+ */
+static int deinterlace_tnr_alloc(struct deinterlace_ctx *ctx)
+{
+	unsigned int i;
+
+	ctx->tnr_fmt = ctx->src_fmt;
+	ctx->tnr_fmt.pixelformat =
+		deinterlace_fmt_is_422(ctx->src_fmt.pixelformat) ?
+		V4L2_PIX_FMT_YUV422P : V4L2_PIX_FMT_YUV420;
+	deinterlace_prepare_format(&ctx->tnr_fmt);
+
+	ctx->tnr_hist[0] = -1;
+	ctx->tnr_hist[1] = -1;
+	ctx->tnr_gain = ctx->tnr_gain_max;
+
+	if (!ctx->dev->has_tnr || ctx->tnr_mode == DEINTERLACE_TNR_OFF ||
+	    ctx->mode == DEINTERLACE_MODE_TNR ||
+	    deinterlace_mode_history(ctx->mode) == 0)
+		return 0;
+
+	for (i = 0; i < DEINTERLACE_TNR_BUFS; i++) {
+		ctx->tnr_buf[i] = dma_alloc_coherent(ctx->dev->dev,
+						     ctx->tnr_fmt.sizeimage,
+						     &ctx->tnr_dma[i],
+						     GFP_KERNEL);
+		if (!ctx->tnr_buf[i]) {
+			deinterlace_tnr_free(ctx);
+			return -ENOMEM;
+		}
+	}
+
+	return 0;
+}
