+/* SPDX-License-Identifier: ((GPL-2.0+ WITH Linux-syscall-note) OR MIT) */
+/*
+ * Allwinner DI300 deinterlacer (sun50i-di300) controls
+ *
+ * The deinterlacing method is the standard V4L2_CID_DEINTERLACING_MODE
+ * with a driver-defined menu; match its items by name.
+ */
+
+#ifndef _UAPI_LINUX_SUNXI_DI300_H
+#define _UAPI_LINUX_SUNXI_DI300_H
+
+#include <linux/v4l2-controls.h>
+
+/*
+ * V4L2_CID_SUNXI_DI300_FMD_STATS - film mode detection statistics
+ *
+ * Read-only, volatile array of 10 u32, latched at the end of the last
+ * completed job of the device: FID12, FID23, FOD_FID30, FOD_FID32,
+ * FOD_FID10, FOD_FID12, FRD02, FRD13 (30-bit counters), FIELD_HIST0,
+ * FIELD_HIST1.
+ */
+#define V4L2_CID_SUNXI_DI300_FMD_STATS		(V4L2_CID_USER_SUNXI_DI300_BASE + 0)
+
+/*
+ * V4L2_CID_SUNXI_DI300_FMD_ENABLE - run film mode detection
+ *
+ * Boolean. Computes the FMD statistics in the "Motion Adaptive, Field
+ * Rate" mode.
+ */
+#define V4L2_CID_SUNXI_DI300_FMD_ENABLE		(V4L2_CID_USER_SUNXI_DI300_BASE + 1)
+
+/*
+ * V4L2_CID_SUNXI_DI300_FMD_WEAVE - per-job field weave
+ *
+ * Array of 2 u32, usually set in the request of an OUTPUT buffer: [0]
+ * for the job's first CAPTURE buffer, [1] for its second. Bits 1:0 = 0-2
+ * weave the fields at that phase instead of the motion-adaptive blend,
+ * 3 = no weave (default). With weave on, bit 2 keeps the video blend in
+ * video-on-film areas and bit 3 also weaves chroma. Used with FMD_ENABLE.
+ */
+#define V4L2_CID_SUNXI_DI300_FMD_WEAVE		(V4L2_CID_USER_SUNXI_DI300_BASE + 2)
+
+/*
+ * V4L2_CID_SUNXI_DI300_TNR_MODE - temporal noise reduction
+ *
+ * Menu: 0 off, 1 fixed strength, 2 adaptive strength. Applied in the
+ * motion-adaptive and TNR-only modes with a planar capture format. Fixed
+ * while streaming.
+ */
+#define V4L2_CID_SUNXI_DI300_TNR_MODE		(V4L2_CID_USER_SUNXI_DI300_BASE + 3)
+
+/* V4L2_CID_SUNXI_DI300_TNR_STRENGTH - fixed TNR strength, 0-255 (0x3a) */
+#define V4L2_CID_SUNXI_DI300_TNR_STRENGTH	(V4L2_CID_USER_SUNXI_DI300_BASE + 4)
+
+/*
+ * V4L2_CID_SUNXI_DI300_TNR_LEVEL - adaptive TNR strength bounds
+ *
+ * Menu: 0 high, 1 middle, 2 low.
+ */
+#define V4L2_CID_SUNXI_DI300_TNR_LEVEL		(V4L2_CID_USER_SUNXI_DI300_BASE + 5)
+
+#endif /* _UAPI_LINUX_SUNXI_DI300_H */
