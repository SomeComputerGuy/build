+static bool deinterlace_fmt_is_planar(u32 pixelformat)
+{
+	switch (pixelformat) {
+	case V4L2_PIX_FMT_YUV420:
+	case V4L2_PIX_FMT_YVU420:
+	case V4L2_PIX_FMT_YUV422P:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool deinterlace_fmt_is_422(u32 pixelformat)
+{
+	switch (pixelformat) {
+	case V4L2_PIX_FMT_NV16:
+	case V4L2_PIX_FMT_NV61:
+	case V4L2_PIX_FMT_YUV422P:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* frames of input history a mode keeps after a run */
+static unsigned int deinterlace_mode_history(unsigned int mode)
+{
+	switch (mode) {
+	case DEINTERLACE_MODE_MOTION_FIELD:
+		return 2;
+	case DEINTERLACE_MODE_MOTION_FRAME:
+	case DEINTERLACE_MODE_TNR:
+		return 1;
+	default:
+		return 0;
+	}
+}
+
+static unsigned int deinterlace_mode_outputs(unsigned int mode)
+{
+	return mode == DEINTERLACE_MODE_MOTION_FIELD ||
+	       mode == DEINTERLACE_MODE_BOB_FIELD ? 2 : 1;
+}
+
+/*
+ * Menu items that can replace each other while streaming: the ones with
+ * the same output rate. TNR-only has its own output channel and needs a
+ * planar capture format (checked at STREAMON).
+ */
+static unsigned int deinterlace_mode_class(unsigned int mode)
+{
+	return mode == DEINTERLACE_MODE_TNR ? 0 : deinterlace_mode_outputs(mode);
+}
+
+/*
+ * The mode a job runs in. Progressive (V4L2_FIELD_NONE) input is passed
+ * through whatever the deinterlacing method (weave of a progressive
+ * frame is a copy), except in the TNR-only mode, which is made for it.
+ * The field order is part of the OUTPUT format, fixed while streaming.
+ */
+static unsigned int deinterlace_job_mode(struct deinterlace_ctx *ctx)
+{
+	unsigned int mode = READ_ONCE(ctx->ctrl_mode);
+
+	if (ctx->src_fmt.field == V4L2_FIELD_NONE &&
+	    mode != DEINTERLACE_MODE_TNR)
+		return DEINTERLACE_MODE_WEAVE;
+
+	return mode;
+}
+
+/*
+ * The method changed while streaming (at the same output rate): start
+ * the new one from the state of a new stream, without the history,
+ * motion flags or filtered references of the old one. Called from
+ * device_run(), so no job of this context is running.
+ */
+static void deinterlace_mode_reset(struct deinterlace_ctx *ctx)
+{
+	unsigned int i;
+
+	for (i = 2; i-- > 0;) {
+		if (ctx->prev[i])
+			v4l2_m2m_buf_done(ctx->prev[i], VB2_BUF_STATE_DONE);
+		ctx->prev[i] = NULL;
+	}
+
+	memset(ctx->flag_buf[0], 0, ctx->flag_size);
+	memset(ctx->flag_buf[1], 0, ctx->flag_size);
+	ctx->flag_idx = 0;
+	ctx->vof_sel = 0;
+
+	ctx->tnr_hist[0] = -1;
+	ctx->tnr_hist[1] = -1;
+	ctx->tnr_gain = ctx->tnr_gain_max;
+}
+
+static void deinterlace_write_pitches(struct deinterlace_dev *dev,
+				      const struct deinterlace_planes *f0,
+				      const struct deinterlace_planes *f1,
+				      const struct deinterlace_planes *f2,
+				      const struct deinterlace_planes *dit,
+				      const struct deinterlace_planes *tnr)
+{
+	unsigned int i;
+
+	/* input pitches are field pitches: two lines of the frame */
+	for (i = 0; i < 3; i++) {
+		deinterlace_write(dev, DEINTERLACE_IN_F01_PITCH(i),
+				  DEINTERLACE_IN_F01_PITCH_F0(f0->pitch[i] * 2) |
+				  DEINTERLACE_IN_F01_PITCH_F1(f1->pitch[i] * 2));
+		deinterlace_write(dev, DEINTERLACE_IN_F2_PITCH(i),
+				  f2->pitch[i] * 2);
+		deinterlace_write(dev, DEINTERLACE_OUT_DIT_PITCH(i),
+				  dit->pitch[i]);
+		deinterlace_write(dev, DEINTERLACE_OUT_TNR_PITCH(i),
+				  tnr ? tnr->pitch[i] : 0);
+	}
+}
+
+static u32 deinterlace_tnr_strength(struct deinterlace_ctx *ctx)
+{
+	u32 s = ctx->tnr_mode == DEINTERLACE_TNR_ADAPTIVE ?
+		ctx->tnr_gain : ctx->tnr_strength;
+
+	return DEINTERLACE_TNR_STRENGTH_Y(s) | DEINTERLACE_TNR_STRENGTH_U(s) |
+	       DEINTERLACE_TNR_STRENGTH_V(s);
+}
+
+/*
+ * In the field-rate modes both CAPTURE buffers of a job come from one
+ * OUTPUT buffer. The first carries the OUTPUT timestamp, the second one is
+ * placed half a frame period later. The period is taken from real
+ * timestamps only:
+ *  - the previous OUTPUT buffer of this stream, once there is one;
+ *  - for the first frame after STREAMON, the next OUTPUT buffer, if
+ *    userspace has queued it by the time the job starts.
+ * If neither is available, or the timestamps do not increase, the offset is
+ * 0 and both CAPTURE buffers carry the OUTPUT timestamp. The period is not
+ * guessed, and VIDIOC_S_PARM cannot supply it because mem2mem devices other
+ * than encoders do not implement it. Userspace that wants distinct
+ * timestamps from the first frame on queues two OUTPUT buffers before the
+ * later of the two STREAMON calls.
+ *
+ * @src is still at the head of the OUTPUT ready queue.
+ */
+static u64 deinterlace_second_field_offset(struct deinterlace_ctx *ctx,
+					   struct vb2_v4l2_buffer *src)
+{
+	struct v4l2_m2m_queue_ctx *q_ctx = &ctx->fh.m2m_ctx->out_q_ctx;
+	u64 ts = src->vb2_buf.timestamp;
+	struct v4l2_m2m_buffer *b;
+	unsigned long flags;
+	u64 next = 0;
+
+	if (ctx->prev_ts_valid)
+		return ts > ctx->prev_ts ? (ts - ctx->prev_ts) / 2 : 0;
+
+	spin_lock_irqsave(&q_ctx->rdy_spinlock, flags);
+	list_for_each_entry(b, &q_ctx->rdy_queue, list) {
+		if (&b->vb != src) {
+			next = b->vb.vb2_buf.timestamp;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&q_ctx->rdy_spinlock, flags);
+
+	return next > ts ? (next - ts) / 2 : 0;
+}
