 	ret = clk_prepare_enable(dev->bus_clk);
 	if (ret) {
 		dev_err(dev->dev, "Failed to enable bus clock\n");
-		return ret;
+		goto err_reset;
 	}
 
 	ret = clk_prepare_enable(dev->mod_clk);
@@ -1020,26 +1174,20 @@
 		goto err_mod_clk;
 	}
 
-	ret = reset_control_deassert(dev->rstc);
-	if (ret) {
-		dev_err(dev->dev, "Failed to deassert reset\n");
