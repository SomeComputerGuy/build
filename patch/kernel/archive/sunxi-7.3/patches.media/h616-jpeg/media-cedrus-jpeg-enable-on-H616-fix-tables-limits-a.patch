+/*
+ * The JPEG decoder runs in the MPEG engine. It holds one luma and one chroma
+ * set of tables: Y uses the tables of the first scan component, Cb and Cr
+ * share the tables of the second one.
+ *
+ * Huffman SRAM image, 2 KiB written as 512 little-endian words:
+ *   0x000  4 x 64 byte descriptors (Y-DC, Y-AC, C-DC, C-AC), each holding
+ *          16 x u16 first canonical code per length, 16 x u8 count of
+ *          symbols with shorter codes, 16 bytes of padding
+ *   0x100  zero
+ *   0x400  4 x 256 byte HUFFVAL arrays, same order, zero padded
+ */
+#define CEDRUS_JPEG_HUFF_DESC_SIZE	64
+#define CEDRUS_JPEG_HUFF_VALS_OFFSET	0x400
+#define CEDRUS_JPEG_HUFF_VALS_SIZE	256
+#define CEDRUS_JPEG_HUFF_SRAM_SIZE	0x800
+
+struct cedrus_jpeg_huff {
+	const u8	*bits;		/* BITS[1..16] */
+	const u8	*vals;		/* HUFFVAL */
+	unsigned int	count;
+};
+
+struct cedrus_jpeg_sram {
+	struct cedrus_dev	*dev;
+	unsigned int		pos;
+	u32			word;
+};
