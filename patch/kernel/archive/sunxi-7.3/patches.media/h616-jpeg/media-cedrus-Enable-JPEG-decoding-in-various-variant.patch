From 85e65e532f744d616c06d349671719f04168444b Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Wed, 31 Jul 2024 18:44:13 +0200
Subject: [PATCH 3/5] media: cedrus: Enable JPEG decoding in various variants

As far as manuals go, only A10 and A13 don't have JPEG support
mentioned, all others do.

To be safe, enable it on all variants except A13, since it was tested to
be functional on A10.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
Link: https://lore.kernel.org/r/20240731164422.206503-4-linkmauve@linkmauve.fr
---
 drivers/staging/media/sunxi/cedrus/cedrus.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.c b/drivers/staging/media/sunxi/cedrus/cedrus.c
index fdc5be30d..63a6e04e3 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.c
@@ -919,6 +919,7 @@ static void cedrus_remove(struct platform_device *pdev)
 
 static const struct cedrus_variant sun4i_a10_cedrus_variant = {
 	.capabilities	= CEDRUS_CAPABILITY_MPEG2_DEC |
+			  CEDRUS_CAPABILITY_JPEG_DEC |
 			  CEDRUS_CAPABILITY_H264_DEC |
 			  CEDRUS_CAPABILITY_VP8_DEC,
 	.mod_rate	= 320000000,
@@ -933,6 +934,7 @@ static const struct cedrus_variant sun5i_a13_cedrus_variant = {
 
