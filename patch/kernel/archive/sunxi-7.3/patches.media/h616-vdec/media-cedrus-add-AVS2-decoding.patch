diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_regs.h b/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
index 0e3e38dae..c569a94d5 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
@@ -1103,4 +1103,84 @@
  * helper (used in libvpx and the vendor Vp9TileInit()): offsets are
  * rounded down to 64-pixel (8-MI) superblock boundaries.
  */
+/*
+ * AVS2 decoder, in the H.265 engine slot (VE_MODE_DEC_H265). The register
+ * layout was recovered from the debug information and the disassembly of
+ * the vendor libawavs2.so (libcedarc, Allwinner); see
+ * harness/research/avs2/regmap.md in the integration tree. Offsets 0x30
+ * to 0x4c, 0x50 to 0x58 and 0x84/0x8c are shared with the H.265 and VP9
+ * decoders.
+ */
+#define VE_DEC_AVS2_SEQ_HDR		(VE_ENGINE_DEC_H265 + 0x04)
+#define VE_DEC_AVS2_SEQ_HDR_LCU_SIZE_MINUS3(v)	SHIFT_AND_MASK_BITS(v, 2, 0)
+#define VE_DEC_AVS2_SEQ_HDR_BIT_DEPTH_MINUS8(v)	SHIFT_AND_MASK_BITS(v, 5, 3)
+#define VE_DEC_AVS2_SEQ_HDR_SLICE_DATA		BIT(6)
+#define VE_DEC_AVS2_SEQ_HDR_FIELD_CODED		BIT(7)
+#define VE_DEC_AVS2_SEQ_HDR_WSM			BIT(16)
+#define VE_DEC_AVS2_SEQ_HDR_DHP			BIT(17)
+#define VE_DEC_AVS2_SEQ_HDR_MHP_SKIP		BIT(18)
+#define VE_DEC_AVS2_SEQ_HDR_PMVR		BIT(19)
+#define VE_DEC_AVS2_SEQ_HDR_SECONDARY_TRANSFORM	BIT(20)
+#define VE_DEC_AVS2_SEQ_HDR_NSQT		BIT(21)
+#define VE_DEC_AVS2_SEQ_HDR_NSIP		BIT(22)
+#define VE_DEC_AVS2_SEQ_HDR_AMP			BIT(23)
+#define VE_DEC_AVS2_SEQ_HDR_SAO_DISABLE		BIT(24)
+/* Named adaptive_leveling_filter_disable, but the vendor sets it to enable. */
+#define VE_DEC_AVS2_SEQ_HDR_ALF			BIT(25)
+#define VE_DEC_AVS2_SEQ_HDR_CROSS_SLICE_LF	BIT(26)
+#define VE_DEC_AVS2_SEQ_HDR_BCBR		BIT(27)
+#define VE_DEC_AVS2_SEQ_HDR_PROGRESSIVE_SEQ	BIT(28)
+#define VE_DEC_AVS2_SEQ_HDR_BACKGROUND		BIT(29)
+#define VE_DEC_AVS2_SEQ_HDR_DECODER_AVS2	(0x1 << 30)
+
+#define VE_DEC_AVS2_PIC_SIZE		(VE_ENGINE_DEC_H265 + 0x08)
+#define VE_DEC_AVS2_PIC_SIZE_WIDTH(w)		SHIFT_AND_MASK_BITS(w, 13, 0)
+#define VE_DEC_AVS2_PIC_SIZE_HEIGHT(h)		SHIFT_AND_MASK_BITS(h, 29, 16)
+
+#define VE_DEC_AVS2_PIC_HDR0		(VE_ENGINE_DEC_H265 + 0x10)
+#define VE_DEC_AVS2_PIC_HDR0_ALF_LUMA		BIT(0)
+#define VE_DEC_AVS2_PIC_HDR0_ALF_CB		BIT(1)
+#define VE_DEC_AVS2_PIC_HDR0_ALF_CR		BIT(2)
+#define VE_DEC_AVS2_PIC_HDR0_FIXED_QP		BIT(3)
+#define VE_DEC_AVS2_PIC_HDR0_LF_DISABLE		BIT(4)
+#define VE_DEC_AVS2_PIC_HDR0_BACKGROUND_REF	BIT(5)
+#define VE_DEC_AVS2_PIC_HDR0_QP(v)		SHIFT_AND_MASK_BITS(v, 14, 8)
+#define VE_DEC_AVS2_PIC_HDR0_REFERENCED		BIT(15)
+#define VE_DEC_AVS2_PIC_HDR0_CB_QP_DELTA(v)	SHIFT_AND_MASK_BITS(v, 21, 16)
+#define VE_DEC_AVS2_PIC_HDR0_CR_QP_DELTA(v)	SHIFT_AND_MASK_BITS(v, 29, 24)
+
