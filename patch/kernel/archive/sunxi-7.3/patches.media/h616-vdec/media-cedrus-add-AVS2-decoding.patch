+++ b/drivers/staging/media/sunxi/cedrus/cedrus.c
@@ -148,6 +148,44 @@ static int cedrus_try_ctrl(struct v4l2_ctrl *ctrl)
 			ctx->bit_depth = dec->bit_depth;
 			cedrus_reset_cap_format(ctx);
 		}
+	} else if (ctrl->id == V4L2_CID_STATELESS_AVS2_SEQUENCE) {
+		const struct v4l2_ctrl_avs2_sequence *seq =
+			ctrl->p_new.p_avs2_sequence;
+		struct cedrus_ctx *ctx = container_of(ctrl->handler,
+						      struct cedrus_ctx, hdl);
+		unsigned int bit_depth;
+		struct vb2_queue *vq;
+
+		/* Only 4:2:0 is supported */
+		if (seq->chroma_format != 1)
+			return -EINVAL;
+
+		/*
+		 * Interlaced (field coded) sequences need per-field
+		 * reference handling that is not implemented yet.
+		 */
+		if (seq->flags & V4L2_AVS2_SEQUENCE_FLAG_FIELD_CODED_SEQUENCE)
+			return -EINVAL;
+
+		if (cedrus_check_pic_size(ctx, seq->horizontal_size,
+					  seq->vertical_size))
+			return -EINVAL;
+
+		bit_depth = 6 + 2 * seq->sample_precision;
+		if (bit_depth > 8 &&
+		    !cedrus_is_capable(ctx, CEDRUS_CAPABILITY_H265_10_DEC))
+			return -EINVAL;
+
+		vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx,
+				     V4L2_BUF_TYPE_VIDEO_CAPTURE);
+
+		if (vb2_is_busy(vq)) {
+			if (ctx->bit_depth < bit_depth)
+				return -EINVAL;
+		} else {
+			ctx->bit_depth = bit_depth;
+			cedrus_reset_cap_format(ctx);
+		}
 	} else if (ctrl->id == V4L2_CID_STATELESS_VC1_SEQUENCE) {
 		const struct v4l2_ctrl_vc1_sequence *seq = ctrl->p_new.p_vc1_sequence;
 
