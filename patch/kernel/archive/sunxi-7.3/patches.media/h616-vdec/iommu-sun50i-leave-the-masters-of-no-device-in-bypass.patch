From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 5 Nov 2026 15:30:00 +0000
Subject: [PATCH] iommu: sun50i: leave the masters of no device in bypass

The IOMMU translates every master as soon as it is enabled
(IOMMU_BYPASS_REG = 0), also the masters that no device claims. A
device described without "iommus" then has all its DMA fault, although
the hardware would pass its physical addresses through: the reset value
of the bypass register is all ones.

Translate only the masters of the probed devices and keep the others
in bypass. This lets a board run one device untranslated, with
physically contiguous buffers, while the other masters stay behind the
IOMMU. The H616 video engine needs it for 4K 10-bit VP9 into a linear
P010 surface: its write misses the micro TLB on 42% of the accesses,
and untranslated it decodes 12% faster (59 -> 67 fps). Nothing changes
for a device tree in which every DMA master has "iommus".

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/iommu/sun50i-iommu.c | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/drivers/iommu/sun50i-iommu.c b/drivers/iommu/sun50i-iommu.c
--- a/drivers/iommu/sun50i-iommu.c
+++ b/drivers/iommu/sun50i-iommu.c
@@ -122,6 +122,13 @@
 
 	/* For each master, all the masters of the device it belongs to */
 	u32 sibling_masters[32];
+
+	/*
+	 * Masters of the devices that use the IOMMU. The others stay in
+	 * bypass, as after reset: a device described without "iommus" (or
+	 * with an empty one) does its DMA with physical addresses.
+	 */
+	u32 translated;
 };
 
 struct sun50i_iommu_domain {
@@ -471,7 +478,8 @@
 	iommu_write(iommu, IOMMU_TTB_REG, sun50i_domain->dt_dma);
 	iommu_write(iommu, IOMMU_TLB_PREFETCH_REG,
 		    iommu->variant->tlb_prefetch);
-	iommu_write(iommu, IOMMU_BYPASS_REG, 0);
+	iommu_write(iommu, IOMMU_BYPASS_REG,
+		    iommu->variant->masters & ~iommu->translated);
 	iommu_write(iommu, IOMMU_INT_ENABLE_REG,
 		    IOMMU_INT_PT_MASK | iommu->variant->masters);
 	iommu_write(iommu, IOMMU_DM_AUT_CTRL_REG(SUN50I_IOMMU_ACI_NONE),
@@ -860,6 +868,7 @@
 	struct sun50i_iommu *iommu;
 
 	struct iommu_fwspec *fwspec = dev_iommu_fwspec_get(dev);
+	unsigned long flags;
 	u32 mask = 0;
 	unsigned int i;
 
@@ -874,6 +883,14 @@
 		if (fwspec->ids[i] < ARRAY_SIZE(iommu->sibling_masters))
 			iommu->sibling_masters[fwspec->ids[i]] |= mask;
 
+	/* Translate the masters of this device from now on. */
+	spin_lock_irqsave(&iommu->iommu_lock, flags);
+	iommu->translated |= mask & iommu->variant->masters;
+	if (iommu->domain && iommu->domain != &sun50i_iommu_identity_domain)
+		iommu_write(iommu, IOMMU_BYPASS_REG,
+			    iommu->variant->masters & ~iommu->translated);
+	spin_unlock_irqrestore(&iommu->iommu_lock, flags);
+
 	return &iommu->iommu;
 }
 
