+const unsigned int cedrus_enc_controls_count = ARRAY_SIZE(cedrus_enc_controls);
+
+/* Formats */
+
+/*
+ * The raw (OUTPUT) picture: NV12, with a macroblock aligned stride. The
+ * engine reads whole macroblock rows, so the buffer has room for the
+ * aligned height; the chroma plane stays at bytesperline * height as NV12
+ * defines it. The format keeps the visible size: the encode core crops
+ * the coded picture to it in the SPS.
+ */
+static void cedrus_enc_prepare_raw_format(struct v4l2_pix_format *pix_fmt)
+{
+	unsigned int width = pix_fmt->width;
+	unsigned int height = pix_fmt->height;
+	unsigned int bytesperline = pix_fmt->bytesperline;
+
+	pix_fmt->pixelformat = V4L2_PIX_FMT_NV12;
+
+	v4l2_apply_frmsize_constraints(&width, &height, &cedrus_enc_frmsize);
+
+	/* The maximum is to avoid overflows. */
+	if (bytesperline < width || bytesperline > 32 * width)
+		bytesperline = width;
+
+	bytesperline = ALIGN(bytesperline, 16);
+
+	pix_fmt->width = width;
+	pix_fmt->height = height;
+	pix_fmt->bytesperline = bytesperline;
+	pix_fmt->sizeimage = bytesperline * ALIGN(height, 16) * 3 / 2;
+	pix_fmt->field = V4L2_FIELD_NONE;
+}
+
+/*
+ * The coded (CAPTURE) stream: one access unit per buffer. The size defaults
+ * to that of the raw picture, which a low QP intra picture can approach;
+ * userspace may ask for more. The engine stops at the end of the buffer
+ * (the job then fails with a stall), it never writes past it.
+ */
+static void cedrus_enc_prepare_coded_format(struct cedrus_ctx *ctx,
+					    struct v4l2_pix_format *pix_fmt)
+{
+	const struct v4l2_pix_format *raw_fmt = &ctx->src_fmt;
+	unsigned int sizeimage = pix_fmt->sizeimage;
+
+	pix_fmt->pixelformat = V4L2_PIX_FMT_H264_SLICE;
+	pix_fmt->width = raw_fmt->width;
+	pix_fmt->height = raw_fmt->height;
+	pix_fmt->bytesperline = 0;
+
+	if (!sizeimage)
+		sizeimage = raw_fmt->bytesperline * raw_fmt->height * 3 / 2;
+
+	sizeimage = max_t(unsigned int, sizeimage, CEDRUS_ENC_CODED_MIN_SIZE);
+	pix_fmt->sizeimage = ALIGN(sizeimage, CEDRUS_ENC_CODED_ALIGN);
+
+	pix_fmt->field = V4L2_FIELD_NONE;
+	pix_fmt->colorspace = raw_fmt->colorspace;
+	pix_fmt->xfer_func = raw_fmt->xfer_func;
+	pix_fmt->ycbcr_enc = raw_fmt->ycbcr_enc;
+	pix_fmt->quantization = raw_fmt->quantization;
+}
+
+void cedrus_enc_reset_formats(struct cedrus_ctx *ctx)
+{
+	struct cedrus_enc_h264_ctx *h264_ctx = &ctx->codec.enc_h264;
+
+	ctx->current_codec = &cedrus_enc_ops_h264;
+
+	memset(&ctx->src_fmt, 0, sizeof(ctx->src_fmt));
+	ctx->src_fmt.width = 1280;
+	ctx->src_fmt.height = 720;
+	cedrus_enc_prepare_raw_format(&ctx->src_fmt);
+
+	memset(&ctx->dst_fmt, 0, sizeof(ctx->dst_fmt));
+	cedrus_enc_prepare_coded_format(ctx, &ctx->dst_fmt);
+
+	h264_ctx->timeperframe.numerator = 1;
+	h264_ctx->timeperframe.denominator = 30;
+}
+
+static int cedrus_enc_querycap(struct file *file, void *priv,
+			       struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, CEDRUS_NAME, sizeof(cap->driver));
+	strscpy(cap->card, CEDRUS_NAME, sizeof(cap->card));
+	snprintf(cap->bus_info, sizeof(cap->bus_info),
+		 "platform:%s", CEDRUS_NAME);
+
+	return 0;
+}
+
+static int cedrus_enc_enum_fmt_vid_cap(struct file *file, void *priv,
+				       struct v4l2_fmtdesc *f)
+{
+	if (f->index)
+		return -EINVAL;
+
+	f->pixelformat = V4L2_PIX_FMT_H264_SLICE;
+
+	return 0;
+}
+
+static int cedrus_enc_enum_fmt_vid_out(struct file *file, void *priv,
+				       struct v4l2_fmtdesc *f)
+{
+	if (f->index)
+		return -EINVAL;
+
+	f->pixelformat = V4L2_PIX_FMT_NV12;
+
+	return 0;
+}
+
+static int cedrus_enc_enum_framesizes(struct file *file, void *priv,
+				      struct v4l2_frmsizeenum *fsize)
+{
+	if (fsize->index)
+		return -EINVAL;
+
+	if (fsize->pixel_format != V4L2_PIX_FMT_NV12 &&
+	    fsize->pixel_format != V4L2_PIX_FMT_H264_SLICE)
+		return -EINVAL;
+
+	fsize->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	fsize->stepwise = cedrus_enc_frmsize;
+	memset(fsize->reserved, 0, sizeof(fsize->reserved));
+
+	return 0;
+}
+
+static int cedrus_enc_g_fmt_vid_cap(struct file *file, void *priv,
+				    struct v4l2_format *f)
+{
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+
+	f->fmt.pix = ctx->dst_fmt;
+
+	return 0;
+}
+
+static int cedrus_enc_g_fmt_vid_out(struct file *file, void *priv,
+				    struct v4l2_format *f)
+{
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+
+	f->fmt.pix = ctx->src_fmt;
+
+	return 0;
+}
+
+static int cedrus_enc_try_fmt_vid_cap(struct file *file, void *priv,
+				      struct v4l2_format *f)
+{
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+
+	cedrus_enc_prepare_coded_format(ctx, &f->fmt.pix);
+
+	return 0;
+}
+
+static int cedrus_enc_try_fmt_vid_out(struct file *file, void *priv,
+				      struct v4l2_format *f)
+{
+	cedrus_enc_prepare_raw_format(&f->fmt.pix);
+
+	return 0;
+}
+
+static int cedrus_enc_s_fmt_vid_cap(struct file *file, void *priv,
+				    struct v4l2_format *f)
+{
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+	struct vb2_queue *vq;
+
+	vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx, f->type);
+	if (vb2_is_busy(vq))
+		return -EBUSY;
+
+	cedrus_enc_prepare_coded_format(ctx, &f->fmt.pix);
+	ctx->dst_fmt = f->fmt.pix;
+
+	return 0;
+}
+
+static int cedrus_enc_s_fmt_vid_out(struct file *file, void *priv,
+				    struct v4l2_format *f)
+{
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+	struct vb2_queue *vq, *peer_vq;
+
+	vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx, f->type);
+	peer_vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx,
+				  V4L2_BUF_TYPE_VIDEO_CAPTURE);
+
+	/* The coded format follows the raw picture size. */
+	if (vb2_is_busy(vq) || vb2_is_busy(peer_vq))
+		return -EBUSY;
+
+	cedrus_enc_prepare_raw_format(&f->fmt.pix);
+	ctx->src_fmt = f->fmt.pix;
+
+	ctx->dst_fmt.sizeimage = 0;
+	cedrus_enc_prepare_coded_format(ctx, &ctx->dst_fmt);
+
+	return 0;
+}
+
+/* The frame rate goes to the VUI timing info of the SPS. */
+static int cedrus_enc_g_parm(struct file *file, void *priv,
+			     struct v4l2_streamparm *parm)
+{
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+	struct cedrus_enc_h264_ctx *h264_ctx = &ctx->codec.enc_h264;
+
+	if (parm->type != V4L2_BUF_TYPE_VIDEO_OUTPUT)
+		return -EINVAL;
+
+	parm->parm.output.capability = V4L2_CAP_TIMEPERFRAME;
+	parm->parm.output.timeperframe = h264_ctx->timeperframe;
+
+	return 0;
+}
+
+static int cedrus_enc_s_parm(struct file *file, void *priv,
+			     struct v4l2_streamparm *parm)
+{
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+	struct cedrus_enc_h264_ctx *h264_ctx = &ctx->codec.enc_h264;
+	struct v4l2_fract *timeperframe = &parm->parm.output.timeperframe;
+
+	if (parm->type != V4L2_BUF_TYPE_VIDEO_OUTPUT)
+		return -EINVAL;
+
+	if (timeperframe->numerator && timeperframe->denominator)
+		h264_ctx->timeperframe = *timeperframe;
+
+	return cedrus_enc_g_parm(file, priv, parm);
+}
+
+const struct v4l2_ioctl_ops cedrus_enc_ioctl_ops = {
+	.vidioc_querycap		= cedrus_enc_querycap,
+
+	.vidioc_enum_fmt_vid_cap	= cedrus_enc_enum_fmt_vid_cap,
+	.vidioc_g_fmt_vid_cap		= cedrus_enc_g_fmt_vid_cap,
+	.vidioc_try_fmt_vid_cap		= cedrus_enc_try_fmt_vid_cap,
+	.vidioc_s_fmt_vid_cap		= cedrus_enc_s_fmt_vid_cap,
+
+	.vidioc_enum_fmt_vid_out	= cedrus_enc_enum_fmt_vid_out,
+	.vidioc_enum_framesizes		= cedrus_enc_enum_framesizes,
+	.vidioc_g_fmt_vid_out		= cedrus_enc_g_fmt_vid_out,
+	.vidioc_try_fmt_vid_out		= cedrus_enc_try_fmt_vid_out,
+	.vidioc_s_fmt_vid_out		= cedrus_enc_s_fmt_vid_out,
+
+	.vidioc_g_parm			= cedrus_enc_g_parm,
+	.vidioc_s_parm			= cedrus_enc_s_parm,
+
+	.vidioc_reqbufs			= v4l2_m2m_ioctl_reqbufs,
+	.vidioc_querybuf		= v4l2_m2m_ioctl_querybuf,
+	.vidioc_qbuf			= v4l2_m2m_ioctl_qbuf,
+	.vidioc_dqbuf			= v4l2_m2m_ioctl_dqbuf,
+	.vidioc_prepare_buf		= v4l2_m2m_ioctl_prepare_buf,
+	.vidioc_create_bufs		= v4l2_m2m_ioctl_create_bufs,
+	.vidioc_remove_bufs		= v4l2_m2m_ioctl_remove_bufs,
+	.vidioc_expbuf			= v4l2_m2m_ioctl_expbuf,
+
+	.vidioc_streamon		= v4l2_m2m_ioctl_streamon,
+	.vidioc_streamoff		= v4l2_m2m_ioctl_streamoff,
+
+	.vidioc_subscribe_event		= v4l2_ctrl_subscribe_event,
+	.vidioc_unsubscribe_event	= v4l2_event_unsubscribe,
+};
+
+/* Queues */
+
+static int cedrus_enc_queue_setup(struct vb2_queue *vq, unsigned int *nbufs,
+				  unsigned int *nplanes, unsigned int sizes[],
+				  struct device *alloc_devs[])
+{
+	struct cedrus_ctx *ctx = vb2_get_drv_priv(vq);
+	struct v4l2_pix_format *pix_fmt;
+
+	if (V4L2_TYPE_IS_OUTPUT(vq->type))
+		pix_fmt = &ctx->src_fmt;
+	else
+		pix_fmt = &ctx->dst_fmt;
+
+	if (*nplanes) {
+		if (sizes[0] < pix_fmt->sizeimage)
+			return -EINVAL;
+	} else {
+		sizes[0] = pix_fmt->sizeimage;
+		*nplanes = 1;
+	}
+
+	return 0;
+}
+
+static int cedrus_enc_buf_prepare(struct vb2_buffer *vb)
+{
+	struct vb2_queue *vq = vb->vb2_queue;
+	struct cedrus_ctx *ctx = vb2_get_drv_priv(vq);
+	struct v4l2_pix_format *pix_fmt;
+
+	if (V4L2_TYPE_IS_OUTPUT(vq->type))
+		pix_fmt = &ctx->src_fmt;
+	else
+		pix_fmt = &ctx->dst_fmt;
+
+	if (vb2_plane_size(vb, 0) < pix_fmt->sizeimage)
+		return -EINVAL;
+
+	/* The coded size is known when the job is done. */
+	if (V4L2_TYPE_IS_CAPTURE(vq->type))
+		vb2_set_plane_payload(vb, 0, 0);
+
+	return 0;
+}
+
+static const struct vb2_ops cedrus_enc_qops = {
+	.queue_setup		= cedrus_enc_queue_setup,
+	.buf_prepare		= cedrus_enc_buf_prepare,
+	.buf_queue		= cedrus_buf_queue,
+	.buf_out_validate	= cedrus_buf_out_validate,
+	.buf_request_complete	= cedrus_buf_request_complete,
+	.start_streaming	= cedrus_start_streaming,
+	.stop_streaming		= cedrus_stop_streaming,
+};
+
+int cedrus_enc_queue_init(void *priv, struct vb2_queue *src_vq,
+			  struct vb2_queue *dst_vq)
+{
+	struct cedrus_ctx *ctx = priv;
+	int ret;
+
+	src_vq->type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
+	src_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	src_vq->dma_attrs = DMA_ATTR_NO_KERNEL_MAPPING;
+	src_vq->drv_priv = ctx;
+	src_vq->buf_struct_size = sizeof(struct cedrus_buffer);
+	src_vq->ops = &cedrus_enc_qops;
+	src_vq->mem_ops = &vb2_dma_contig_memops;
+	src_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	src_vq->lock = &ctx->dev->dev_mutex;
+	src_vq->dev = ctx->dev->dev;
+	/* The encode parameters come with the picture, in a request. */
+	src_vq->supports_requests = true;
+	src_vq->requires_requests = true;
+
+	ret = vb2_queue_init(src_vq);
+	if (ret)
+		return ret;
+
+	dst_vq->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+	dst_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	dst_vq->drv_priv = ctx;
+	dst_vq->buf_struct_size = sizeof(struct cedrus_buffer);
+	dst_vq->ops = &cedrus_enc_qops;
+	dst_vq->mem_ops = &vb2_dma_contig_memops;
+	dst_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	dst_vq->lock = &ctx->dev->dev_mutex;
+	dst_vq->dev = ctx->dev->dev;
+
+	return vb2_queue_init(dst_vq);
+}
+
+/* Job */
+
+void cedrus_enc_device_run(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	struct cedrus_run run = {};
+	struct media_request *src_req;
+	int error;
+
+	run.src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
+	run.dst = v4l2_m2m_next_dst_buf(ctx->fh.m2m_ctx);
+
+	/* Apply the request's controls: the encode core reads them. */
+	src_req = run.src->vb2_buf.req_obj.req;
+	if (src_req)
+		v4l2_ctrl_request_setup(src_req, &ctx->hdl);
+
+	v4l2_m2m_buf_copy_metadata(run.src, run.dst);
+
+	cedrus_engine_switch_reset(ctx);
+
+	error = ctx->current_codec->setup(ctx, &run);
+	if (error)
+		dev_err_ratelimited(dev->dev,
+				    "Failed to setup encoding job: %d\n", error);
+
+	/*
+	 * Complete the request's controls: the core wrote the parameters it
+	 * adapted back to them.
+	 */
+	if (src_req)
+		v4l2_ctrl_request_complete(src_req, &ctx->hdl);
+
+	if (!error) {
+		schedule_delayed_work(&dev->watchdog_work,
+				      msecs_to_jiffies(CEDRUS_WATCHDOG_TIMEOUT_MS));
+
+		ctx->current_codec->trigger(ctx);
+	} else {
+		v4l2_m2m_buf_done_and_job_finish(dev->m2m_dev, ctx->fh.m2m_ctx,
+						 VB2_BUF_STATE_ERROR);
+	}
+}
