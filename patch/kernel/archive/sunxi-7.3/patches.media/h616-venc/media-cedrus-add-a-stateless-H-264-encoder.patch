+	bool				is_enc;
 
 	struct v4l2_ctrl_handler	hdl;
 	struct v4l2_ctrl		**ctrls;
@@ -313,6 +318,7 @@ struct cedrus_ctx {
 			/* 16 KiB aligned address in the buffer */
 			dma_addr_t	mb_info_buf_addr;
 		} avs;
+		struct cedrus_enc_h264_ctx	enc_h264;
 	} codec;
 };
 
@@ -361,11 +367,15 @@ struct cedrus_variant {
 	 * vendor library does on the H616.
 	 */
 	bool		jpeg_rotate_out;
+	/* Register conventions of the H.264 encoder, CEDRUS_ENC_FLAG_*. */
+	unsigned int	enc_flags;
 };
 
 struct cedrus_dev {
 	struct v4l2_device	v4l2_dev;
 	struct video_device	vfd;
+	/* The encoder video device, with CEDRUS_CAPABILITY_H264_ENC. */
+	struct video_device	vfd_enc;
 	struct media_device	mdev;
 	struct media_pad	pad[2];
 	struct platform_device	*pdev;
@@ -391,6 +401,7 @@ struct cedrus_dev {
 	unsigned int		h265_max_width;
 	unsigned int		h265_max_height;
 	bool			jpeg_rotate_out;
+	unsigned int		enc_flags;
 
 	struct delayed_work	watchdog_work;
 };
@@ -405,6 +416,7 @@ extern struct cedrus_dec_ops cedrus_dec_ops_mpeg4;
 extern struct cedrus_dec_ops cedrus_dec_ops_avs2;
 extern struct cedrus_dec_ops cedrus_dec_ops_jpeg;
 extern struct cedrus_dec_ops cedrus_dec_ops_avs;
+extern struct cedrus_dec_ops cedrus_enc_ops_h264;
 
 static inline void cedrus_write(struct cedrus_dev *dev, u32 reg, u32 val)
 {
@@ -639,6 +651,10 @@ static inline bool is_afbc_format(u32 format)
 	}
 }
 
+/* Controls of the encoder video device (cedrus_enc.c). */
+extern const struct cedrus_control cedrus_enc_controls[];
+extern const unsigned int cedrus_enc_controls_count;
+
 void *cedrus_find_control_data(struct cedrus_ctx *ctx, u32 id);
 bool cedrus_ctrl_in_request(struct cedrus_ctx *ctx, struct media_request *req,
 			    u32 id);
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_dec.c b/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
index 5f99b8e89..16a58fce7 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
@@ -22,6 +22,7 @@
 
 #include "cedrus.h"
 #include "cedrus_dec.h"
+#include "cedrus_enc.h"
 #include "cedrus_hw.h"
 
 static bool cedrus_is_mpeg4_part2(u32 pixelformat)
@@ -31,6 +32,29 @@ static bool cedrus_is_mpeg4_part2(u32 pixelformat)
 	       pixelformat == V4L2_PIX_FMT_SPK_SLICE;
 }
 
+/*
+ * Reset the VE when the job switches between engines that leave state
+ * behind, and remember the source format of this job for the next one.
+ * Shared with the encoder (cedrus_enc.c), whose jobs follow and precede
+ * decoding jobs on the same engine.
+ */
+void cedrus_engine_switch_reset(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+
+	if ((dev->last_src_pixelformat &&
+	     dev->last_src_pixelformat != ctx->src_fmt.pixelformat &&
+	     (dev->last_src_pixelformat == V4L2_PIX_FMT_VP9_FRAME ||
+	      ctx->src_fmt.pixelformat == V4L2_PIX_FMT_VP9_FRAME ||
+	      dev->last_src_pixelformat == V4L2_PIX_FMT_AVS2_FRAME ||
+	      ctx->src_fmt.pixelformat == V4L2_PIX_FMT_AVS2_FRAME ||
+	      dev->last_src_pixelformat == V4L2_PIX_FMT_AVS_FRAME ||
+	      ctx->src_fmt.pixelformat == V4L2_PIX_FMT_AVS_FRAME)) ||
+	    cedrus_is_mpeg4_part2(ctx->src_fmt.pixelformat))
+		reset_control_reset(dev->rstc);
+	dev->last_src_pixelformat = ctx->src_fmt.pixelformat;
+}
+
 void cedrus_device_run(void *priv)
 {
 	struct cedrus_ctx *ctx = priv;
@@ -39,6 +63,11 @@ void cedrus_device_run(void *priv)
 	struct media_request *src_req;
 	int error;
 
+	if (ctx->is_enc) {
+		cedrus_enc_device_run(ctx);
+		return;
+	}
+
 	run.src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
 	run.dst = v4l2_m2m_next_dst_buf(ctx->fh.m2m_ctx);
 
@@ -202,17 +231,7 @@ void cedrus_device_run(void *priv)
 	 * Reset the VE before each of its jobs; the reset takes a few
 	 * microseconds.
 	 */
-	if ((dev->last_src_pixelformat &&
-	     dev->last_src_pixelformat != ctx->src_fmt.pixelformat &&
-	     (dev->last_src_pixelformat == V4L2_PIX_FMT_VP9_FRAME ||
-	      ctx->src_fmt.pixelformat == V4L2_PIX_FMT_VP9_FRAME ||
-	      dev->last_src_pixelformat == V4L2_PIX_FMT_AVS2_FRAME ||
-	      ctx->src_fmt.pixelformat == V4L2_PIX_FMT_AVS2_FRAME ||
-	      dev->last_src_pixelformat == V4L2_PIX_FMT_AVS_FRAME ||
-	      ctx->src_fmt.pixelformat == V4L2_PIX_FMT_AVS_FRAME)) ||
-	    cedrus_is_mpeg4_part2(ctx->src_fmt.pixelformat))
-		reset_control_reset(dev->rstc);
-	dev->last_src_pixelformat = ctx->src_fmt.pixelformat;
+	cedrus_engine_switch_reset(ctx);
 
 	cedrus_dst_format_set(dev, &ctx->dst_fmt);
 
