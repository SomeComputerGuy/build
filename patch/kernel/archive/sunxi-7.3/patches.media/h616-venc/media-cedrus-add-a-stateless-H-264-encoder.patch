+/*
+ * Cedrus VPU driver: stateless H.264 encoder
+ *
+ * Copyright (C) 2023 Bootlin
+ * Copyright (C) 2026 Arun Iyengar <aiyengar1990@gmail.com>
+ */
+
+#ifndef _CEDRUS_ENC_H_
+#define _CEDRUS_ENC_H_
+
+#include <linux/bits.h>
+#include <linux/sizes.h>
+#include <linux/types.h>
+#include <linux/videodev2.h>
+#include <media/v4l2-h264-enc.h>
+
+struct cedrus_ctx;
+struct cedrus_dev;
+struct vb2_queue;
+
+/*
+ * Register conventions of the H.264 encoder block, per engine generation
+ * (struct cedrus_variant.enc_flags). The V3s encoder (Bootlin's
+ * cedrus/h264-encoding branch) takes byte addresses and macroblock sizes;
+ * the 0x12011 encoders of the H6 and H616 (vendor libVE "h6" programming,
+ * confirmed on the H616 by the Hardened-BliKVM lab, 2026-10) differ as
+ * flagged below.
+ */
+
+/* Encoder block address registers hold the address in units of 256 bytes. */
+#define CEDRUS_ENC_FLAG_ADDR_SHIFT_8		BIT(0)
+/*
+ * The ISP picture and scaler sizes are the visible size in units of 8
+ * pixels, and the input stride is also written to the second stride
+ * register.
+ */
+#define CEDRUS_ENC_FLAG_ISP_SIZE_8PX		BIT(1)
+/*
+ * Encoder parameters of the vendor library for these engines: dynamic
+ * motion estimation with its thresholds, PARA1 bit 27, the ME_PARA value
+ * 0x11000 and no chroma QP offset.
+ */
+#define CEDRUS_ENC_FLAG_H6_PARAMS		BIT(2)
+
+/* The encoder coded buffer address registers have 256 byte granularity. */
+#define CEDRUS_ENC_CODED_ALIGN			256
+/* The stream size register counts in units of 65536 bits (0x12011). */
+#define CEDRUS_ENC_CODED_MIN_SIZE		SZ_64K
+
+/* P pictures narrower than 13 macroblocks never finish on the H616. */
+#define CEDRUS_ENC_INTER_MIN_WIDTH_MBS		13
+
+/*
+ * Reconstruction buffer of the stateless encode core: the reconstructed
+ * picture (luma then chroma) and the sub-pixel planes the motion search
+ * reads for a reference.
+ */
+struct cedrus_enc_h264_rec {
+	void		*rec;
+	dma_addr_t	rec_dma;
+	size_t		rec_size;
+	size_t		rec_luma_size;
+
+	void		*subpix;
+	dma_addr_t	subpix_dma;
+	size_t		subpix_size;
+};
+
+struct cedrus_enc_h264_ctx {
+	struct v4l2_h264_enc	enc;
+	struct v4l2_fract	timeperframe;
+
+	unsigned int		width_mbs;
+	unsigned int		height_mbs;
+
+	void			*mb_info;
+	dma_addr_t		mb_info_dma;
+	size_t			mb_info_size;
+
+	/* Emulation prevention is off while the bit writer puts raw bits. */
+	bool			eptb_disabled;
+};
+
+extern const struct v4l2_ioctl_ops cedrus_enc_ioctl_ops;
+
+int cedrus_enc_queue_init(void *priv, struct vb2_queue *src_vq,
+			  struct vb2_queue *dst_vq);
+void cedrus_enc_reset_formats(struct cedrus_ctx *ctx);
+void cedrus_enc_device_run(struct cedrus_ctx *ctx);
+
+#endif
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.c b/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.c
new file mode 100644
index 000000000..fadfa7fcf
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.c
@@ -0,0 +1,724 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cedrus VPU driver: H.264 encoder engine
+ *
+ * Copyright (C) 2023 Bootlin
+ * Copyright (C) 2026 Arun Iyengar <aiyengar1990@gmail.com>
+ *
+ * Register programming after Paul Kocialkowski's cedrus/h264-encoding
+ * branch (Allwinner V3s) and, for the 0x12011 encoders of the H6 and H616,
+ * the vendor library's programming as recorded by the Hardened-BliKVM lab
+ * on the H616 (2026-10): see CEDRUS_ENC_FLAG_* in cedrus_enc.h.
+ *
+ * The stateless H.264 encode core writes the headers (AUD, SPS, PPS and
+ * the slice header) through the engine's bit writer, which puts them at
+ * the start of the coded buffer; the engine then appends the slice data.
+ * The engine does the emulation prevention, so the core's software
+ * emulation prevention is bypassed (the bits operations are implemented).
+ */
+
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/iopoll.h>
+#include <linux/sizes.h>
+#include <linux/types.h>
+#include <linux/videodev2.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-h264-enc.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "cedrus.h"
+#include "cedrus_enc.h"
+#include "cedrus_hw.h"
+#include "cedrus_regs.h"
+
+static inline struct cedrus_ctx *cedrus_enc_ctx(struct v4l2_h264_enc *enc)
+{
+	return enc->private_data;
+}
+
+static inline u32 cedrus_enc_addr(struct cedrus_ctx *ctx, dma_addr_t addr)
+{
+	if (ctx->dev->enc_flags & CEDRUS_ENC_FLAG_ADDR_SHIFT_8)
+		return addr >> 8;
+
+	return addr;
+}
+
+static int cedrus_enc_poll(struct cedrus_dev *dev, u32 reg, u32 flags)
+{
+	u32 value;
+
+	/* The bit writer and the sync idle flags answer within microseconds. */
+	return readl_poll_timeout_atomic(dev->base + reg, value,
+					 (value & flags) == flags, 1, 10000);
+}
+
+/* Bit writer: the rbsp operations of the encode core. */
+
+static void cedrus_enc_h264_eptb(struct cedrus_ctx *ctx, bool disable)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	struct cedrus_enc_h264_ctx *h264_ctx = &ctx->codec.enc_h264;
+	u32 value;
+
+	if (h264_ctx->eptb_disabled == disable)
+		return;
+
+	value = cedrus_read(dev, VE_ENC_AVC_PARA0);
+	if (disable)
+		value |= VE_ENC_AVC_PARA0_EPTB_DIS;
+	else
+		value &= ~VE_ENC_AVC_PARA0_EPTB_DIS;
+	cedrus_write(dev, VE_ENC_AVC_PARA0, value);
+
+	h264_ctx->eptb_disabled = disable;
+}
+
+static int cedrus_enc_h264_put_bits(struct v4l2_h264_enc_rbsp *rbsp,
+				    u32 value, unsigned char bits_count)
+{
+	struct cedrus_ctx *ctx = rbsp->private_data;
+	struct cedrus_dev *dev = ctx->dev;
+	int ret;
+
+	if (bits_count > 32)
+		return -EINVAL;
+
+	ret = cedrus_enc_poll(dev, VE_ENC_AVC_STATUS,
+			      VE_ENC_AVC_STATUS_PUT_BITS_READY);
+	if (ret)
+		return ret;
+
+	cedrus_write(dev, VE_ENC_AVC_PUTBITSDATA, value);
+	cedrus_write(dev, VE_ENC_AVC_STARTTRIG,
+		     VE_ENC_AVC_STARTTRIG_ENCODE_MODE_H264 |
+		     VE_ENC_AVC_STARTTRIG_NUM_BITS(bits_count) |
+		     VE_ENC_AVC_STARTTRIG_TYPE_PUT_BITS);
+
+	/* The core leaves the accounting to the operation. */
+	rbsp->bits_count += bits_count;
+	rbsp->bit_offset = rbsp->bits_count % 8;
+
+	return 0;
+}
+
+/*
+ * Raw bits (start codes, NAL unit headers) go without emulation prevention,
+ * the other bits with it. The mode is only switched at a byte boundary, as
+ * the vendor library does, so a byte written in pieces keeps one mode.
+ */
+static int cedrus_enc_h264_rbsp_bits_raw(struct v4l2_h264_enc_rbsp *rbsp,
+					 u32 value, unsigned char bits_count)
+{
+	struct cedrus_ctx *ctx = rbsp->private_data;
+
+	if (!bits_count)
+		return 0;
+
+	if (!rbsp->bit_offset)
+		cedrus_enc_h264_eptb(ctx, true);
+
+	return cedrus_enc_h264_put_bits(rbsp, value, bits_count);
+}
+
+static int cedrus_enc_h264_rbsp_bits(struct v4l2_h264_enc_rbsp *rbsp,
+				     u32 value, unsigned char bits_count)
+{
+	struct cedrus_ctx *ctx = rbsp->private_data;
+
+	if (!bits_count)
+		return 0;
+
+	if (!rbsp->bit_offset)
+		cedrus_enc_h264_eptb(ctx, false);
+
+	return cedrus_enc_h264_put_bits(rbsp, value, bits_count);
+}
+
+/* Trailing zero bits never need emulation prevention: keep the mode. */
+static int cedrus_enc_h264_rbsp_align(struct v4l2_h264_enc_rbsp *rbsp)
+{
+	if (!rbsp->bit_offset)
+		return 0;
+
+	return cedrus_enc_h264_put_bits(rbsp, 0, 8 - rbsp->bit_offset);
+}
+
+static const struct v4l2_h264_enc_rbsp_ops cedrus_enc_h264_rbsp_ops = {
+	.bits_raw	= cedrus_enc_h264_rbsp_bits_raw,
+	.bits		= cedrus_enc_h264_rbsp_bits,
+	.align		= cedrus_enc_h264_rbsp_align,
+};
+
+/* Encode core operations */
+
+static int cedrus_enc_h264_state_constrain(struct v4l2_h264_enc *enc,
+					   struct v4l2_h264_enc_state *state)
+{
+	struct cedrus_ctx *ctx = cedrus_enc_ctx(enc);
+	struct v4l2_ctrl_h264_sps *sps = &state->sps;
+	struct v4l2_ctrl_h264_pps *pps = &state->pps;
+	struct v4l2_ctrl_h264_encode_params *encode = &state->encode;
+
+	/* SPS */
+
+	switch (sps->profile_idc) {
+	case 66:
+	case 77:
+	case 100:
+		break;
+	default:
+		sps->profile_idc = 66;
+		break;
+	}
+
+	if (!sps->level_idc)
+		sps->level_idc = 40;
+
+	/* 8-bit 4:2:0 frames. */
+	sps->chroma_format_idc = 1;
+	sps->bit_depth_luma_minus8 = 0;
+	sps->bit_depth_chroma_minus8 = 0;
+	sps->flags &= ~(V4L2_H264_SPS_FLAG_SEPARATE_COLOUR_PLANE |
+			V4L2_H264_SPS_FLAG_QPPRIME_Y_ZERO_TRANSFORM_BYPASS |
+			V4L2_H264_SPS_FLAG_MB_ADAPTIVE_FRAME_FIELD |
+			V4L2_H264_SPS_FLAG_GAPS_IN_FRAME_NUM_VALUE_ALLOWED);
+	sps->flags |= V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY |
+		      V4L2_H264_SPS_FLAG_DIRECT_8X8_INFERENCE;
+
+	/* A single reference picture. */
+	if (sps->max_num_ref_frames > 1)
+		sps->max_num_ref_frames = 1;
+
+	/* PPS */
+
+	/*
+	 * The engine has CABAC (bit 8 of PARA0), but the meaning of the
+	 * "fix mode num" field next to it, which the vendor library sets
+	 * for P pictures, is not established: CAVLC only until then.
+	 */
+	pps->flags &= ~(V4L2_H264_PPS_FLAG_ENTROPY_CODING_MODE |
+			V4L2_H264_PPS_FLAG_TRANSFORM_8X8_MODE |
+			V4L2_H264_PPS_FLAG_CONSTRAINED_INTRA_PRED);
+
+	/* The deblocking filter is set per slice (PARA0). */
+	pps->flags |= V4L2_H264_PPS_FLAG_DEBLOCKING_FILTER_CONTROL_PRESENT;
+
+	pps->num_ref_idx_l0_default_active_minus1 = 0;
+	pps->num_ref_idx_l1_default_active_minus1 = 0;
+	pps->pic_init_qp_minus26 = clamp_t(s8, pps->pic_init_qp_minus26,
+					   -26, 25);
+
+	/* PARA1 has 3 bits for the chroma QP offset; the 0x12011 has none. */
+	if (ctx->dev->enc_flags & CEDRUS_ENC_FLAG_H6_PARAMS)
+		pps->chroma_qp_index_offset = 0;
+	else
+		pps->chroma_qp_index_offset =
+			clamp_t(s8, pps->chroma_qp_index_offset, 0, 7);
+
+	/* Encode */
+
+	/* Frames with one short-term reference. */
+	encode->flags &= ~(V4L2_H264_ENCODE_FLAG_LONG_TERM_REFERENCE |
+			   V4L2_H264_ENCODE_FLAG_NUM_REF_IDX_ACTIVE_OVERRIDE |
+			   V4L2_H264_ENCODE_FLAG_FIELD_PIC |
+			   V4L2_H264_ENCODE_FLAG_BOTTOM_FIELD);
+	encode->num_ref_idx_l0_active_minus1 = 0;
+	encode->num_ref_idx_l1_active_minus1 = 0;
+	encode->delta_pic_order_cnt_bottom = 0;
+	encode->delta_pic_order_cnt0 = 0;
+	encode->delta_pic_order_cnt1 = 0;
+
+	encode->frame_num &= GENMASK(sps->log2_max_frame_num_minus4 + 3, 0);
+	encode->pic_order_cnt_lsb &=
+		GENMASK(sps->log2_max_pic_order_cnt_lsb_minus4 + 3, 0);
+
+	encode->cabac_init_idc = 0;
+
+	if (encode->disable_deblocking_filter_idc > 2)
+		encode->disable_deblocking_filter_idc = 0;
+
+	encode->slice_alpha_c0_offset_div2 =
+		clamp_t(s8, encode->slice_alpha_c0_offset_div2, -6, 6);
+	encode->slice_beta_offset_div2 =
+		clamp_t(s8, encode->slice_beta_offset_div2, -6, 6);
+
+	/* The engine never finishes a P picture of a narrow frame. */
+	if (encode->slice_type == V4L2_H264_SLICE_TYPE_P &&
+	    state->width_mbs < CEDRUS_ENC_INTER_MIN_WIDTH_MBS)
+		encode->slice_type = V4L2_H264_SLICE_TYPE_I;
+
+	return 0;
+}
+
+/*
+ * Reconstruction buffer sizes of the V3s encoder, which the vendor library
+ * also requests for the H616 at every picture size.
+ */
+static int cedrus_enc_h264_rec_buffer_alloc(struct v4l2_h264_enc *enc,
+					    struct v4l2_h264_enc_rec_buffer *buffer)
+{
+	struct cedrus_ctx *ctx = cedrus_enc_ctx(enc);
+	struct cedrus_enc_h264_ctx *h264_ctx = &ctx->codec.enc_h264;
+	struct device *dev = ctx->dev->dev;
+	unsigned int width_mbs = h264_ctx->width_mbs;
+	unsigned int height_mbs = h264_ctx->height_mbs;
+	unsigned int subpix_width, subpix_height, chroma_size;
+	struct cedrus_enc_h264_rec *rec;
+
+	rec = kzalloc(sizeof(*rec), GFP_KERNEL);
+	if (!rec)
+		return -ENOMEM;
+
+	rec->rec_luma_size = ALIGN(width_mbs, 2) * 16 *
+			     ALIGN(height_mbs + 1, 4) * 16;
+	chroma_size = ALIGN(width_mbs, 2) * 16 *
+		      ALIGN(DIV_ROUND_UP(height_mbs, 2), 4) * 16;
+	rec->rec_size = ALIGN(rec->rec_luma_size + chroma_size, SZ_4K);
+
+	rec->rec = dma_alloc_attrs(dev, rec->rec_size, &rec->rec_dma,
+				   GFP_KERNEL, DMA_ATTR_NO_KERNEL_MAPPING);
+	if (!rec->rec)
+		goto error_rec;
+
+	subpix_width = ALIGN_DOWN((width_mbs + 47) * 2 / 3, 32) +
+		       ALIGN(width_mbs, 32) * 2;
+	subpix_height = (height_mbs * 16 + 72) / 8;
+	rec->subpix_size = ALIGN(subpix_width * subpix_height, SZ_4K);
+
+	rec->subpix = dma_alloc_attrs(dev, rec->subpix_size, &rec->subpix_dma,
+				      GFP_KERNEL, DMA_ATTR_NO_KERNEL_MAPPING);
+	if (!rec->subpix)
+		goto error_subpix;
+
+	buffer->private_data = rec;
+
+	return 0;
+
+error_subpix:
+	dma_free_attrs(dev, rec->rec_size, rec->rec, rec->rec_dma,
+		       DMA_ATTR_NO_KERNEL_MAPPING);
+error_rec:
+	kfree(rec);
+
+	return -ENOMEM;
+}
+
+static int cedrus_enc_h264_rec_buffer_free(struct v4l2_h264_enc *enc,
+					   struct v4l2_h264_enc_rec_buffer *buffer)
+{
+	struct cedrus_ctx *ctx = cedrus_enc_ctx(enc);
+	struct device *dev = ctx->dev->dev;
+	struct cedrus_enc_h264_rec *rec = buffer->private_data;
+
+	if (!rec)
+		return -EINVAL;
+
+	dma_free_attrs(dev, rec->subpix_size, rec->subpix, rec->subpix_dma,
+		       DMA_ATTR_NO_KERNEL_MAPPING);
+	dma_free_attrs(dev, rec->rec_size, rec->rec, rec->rec_dma,
+		       DMA_ATTR_NO_KERNEL_MAPPING);
+	kfree(rec);
+	buffer->private_data = NULL;
+
+	return 0;
+}
+
+static const struct v4l2_h264_enc_ops cedrus_enc_h264_core_ops = {
+	.state_constrain	= cedrus_enc_h264_state_constrain,
+	.rec_buffer_alloc	= cedrus_enc_h264_rec_buffer_alloc,
+	.rec_buffer_free	= cedrus_enc_h264_rec_buffer_free,
+};
+
+/* Engine */
+
+static int cedrus_enc_h264_start(struct cedrus_ctx *ctx)
+{
+	struct cedrus_enc_h264_ctx *h264_ctx = &ctx->codec.enc_h264;
+	struct v4l2_h264_enc *enc = &h264_ctx->enc;
+	struct device *dev = ctx->dev->dev;
+	int ret;
+
+	h264_ctx->width_mbs = DIV_ROUND_UP(ctx->src_fmt.width, 16);
+	h264_ctx->height_mbs = DIV_ROUND_UP(ctx->src_fmt.height, 16);
+
+	/* Macroblock information buffer: 4 KiB per 32 macroblock columns. */
+	h264_ctx->mb_info_size = DIV_ROUND_UP(h264_ctx->width_mbs, 32) * SZ_4K;
+	h264_ctx->mb_info = dma_alloc_attrs(dev, h264_ctx->mb_info_size,
+					    &h264_ctx->mb_info_dma, GFP_KERNEL,
+					    DMA_ATTR_NO_KERNEL_MAPPING);
+	if (!h264_ctx->mb_info)
+		return -ENOMEM;
+
+	memset(enc, 0, sizeof(*enc));
+	enc->ops = &cedrus_enc_h264_core_ops;
+	enc->rbsp_ops = &cedrus_enc_h264_rbsp_ops;
+	enc->private_data = ctx;
+	enc->format = &ctx->src_fmt;
+	enc->timeperframe = &h264_ctx->timeperframe;
+	enc->ctrl_handler = &ctx->hdl;
+	/* One reference slot: the engine predicts from one picture. */
+	enc->ref_slots_count_init = 1;
+	enc->flags = V4L2_H264_ENC_FLAG_INTER_PRED;
+
+	ret = v4l2_h264_enc_init(enc);
+	if (ret) {
+		dma_free_attrs(dev, h264_ctx->mb_info_size, h264_ctx->mb_info,
+			       h264_ctx->mb_info_dma,
+			       DMA_ATTR_NO_KERNEL_MAPPING);
+		h264_ctx->mb_info = NULL;
+		return ret;
+	}
+
+	return 0;
+}
+
+static void cedrus_enc_h264_stop(struct cedrus_ctx *ctx)
+{
+	struct cedrus_enc_h264_ctx *h264_ctx = &ctx->codec.enc_h264;
+	struct device *dev = ctx->dev->dev;
+
+	v4l2_h264_enc_exit(&h264_ctx->enc);
+
+	if (h264_ctx->mb_info)
+		dma_free_attrs(dev, h264_ctx->mb_info_size, h264_ctx->mb_info,
+			       h264_ctx->mb_info_dma,
+			       DMA_ATTR_NO_KERNEL_MAPPING);
+	h264_ctx->mb_info = NULL;
+}
+
+/*
+ * Select the encoder: the decoder field disabled, the input stage and the
+ * encoder enabled, after a pulse of the encoder reset, as the vendor
+ * library does before every picture.
+ */
+static void cedrus_enc_h264_engine_enable(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	u32 mode, value;
+
+	if (dev->ve_mode_ddr)
+		mode = dev->ve_mode_ddr;
+	else
+		mode = VE_MODE_REC_WR_MODE_2MB | VE_MODE_DDR_MODE_BW_128;
+
+	mode |= VE_MODE_DISABLED;
+
+	cedrus_write(dev, VE_MODE, mode);
+
+	value = cedrus_read(dev, VE_RESET);
+	cedrus_write(dev, VE_RESET, value | VE_RESET_ENCODER_RESET);
+	cedrus_write(dev, VE_RESET, value & ~VE_RESET_ENCODER_RESET);
+
+	cedrus_write(dev, VE_MODE, mode | VE_MODE_ENC_ENABLE |
+		     VE_MODE_ENC_ISP_ENABLE);
+}
+
+static void cedrus_enc_h264_setup_isp(struct cedrus_ctx *ctx,
+				      struct vb2_buffer *src_buf)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	struct cedrus_enc_h264_ctx *h264_ctx = &ctx->codec.enc_h264;
+	const struct v4l2_pix_format *fmt = &ctx->src_fmt;
+	unsigned int stride_mbs = fmt->bytesperline / 16;
+	unsigned int luma_size = fmt->bytesperline * fmt->height;
+	unsigned int width, height;
+	dma_addr_t luma, chroma;
+
+	if (dev->enc_flags & CEDRUS_ENC_FLAG_ISP_SIZE_8PX) {
+		/* The visible size in units of 8 pixels. */
+		width = DIV_ROUND_UP(fmt->width, 8);
+		height = DIV_ROUND_UP(fmt->height, 8);
+	} else {
+		width = h264_ctx->width_mbs;
+		height = h264_ctx->height_mbs;
+	}
+
+	cedrus_write(dev, VE_ISP_PIC_INFO,
+		     VE_ISP_PIC_INFO_WIDTH(width) |
+		     VE_ISP_PIC_INFO_HEIGHT(height));
+	cedrus_write(dev, VE_ISP_SCALER_SIZE,
+		     VE_ISP_SCALER_SIZE_HEIGHT(height) |
+		     VE_ISP_SCALER_SIZE_WIDTH(width));
+
+	cedrus_write(dev, VE_ISP_PIC_STRIDE0,
+		     VE_ISP_PIC_STRIDE0_INPUT_MBS(stride_mbs));
+	if (dev->enc_flags & CEDRUS_ENC_FLAG_ISP_SIZE_8PX)
+		cedrus_write(dev, VE_ISP_PIC_STRIDE1,
+			     VE_ISP_PIC_STRIDE1_INPUT_MBS(stride_mbs));
+
+	/* NV12, no rotation or scaling, no interrupt from this stage. */
+	cedrus_write(dev, VE_ISP_CTRL, VE_ISP_CTRL_FORMAT_YUV420SP |
+		     VE_ISP_CTRL_COLORSPACE_BT601);
+
+	/* The input addresses are byte addresses on every generation. */
+	luma = vb2_dma_contig_plane_dma_addr(src_buf, 0);
+	chroma = luma + luma_size;
+	cedrus_write(dev, VE_ISP_INPUT_LUMA_ADDR, luma);
+	cedrus_write(dev, VE_ISP_INPUT_CHROMA0_ADDR, chroma);
+	cedrus_write(dev, VE_ISP_INPUT_CHROMA1_ADDR, chroma + luma_size / 4);
+}
+
+static int cedrus_enc_h264_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	struct cedrus_enc_h264_ctx *h264_ctx = &ctx->codec.enc_h264;
+	struct v4l2_h264_enc *enc = &h264_ctx->enc;
+	struct v4l2_h264_enc_state *state = &enc->state_active;
+	struct v4l2_h264_enc_ref *ref = &enc->ref;
+	const struct v4l2_ctrl_h264_pps *pps;
+	const struct v4l2_ctrl_h264_encode_params *encode;
+	struct cedrus_enc_h264_rec *rec, *ref_rec;
+	struct vb2_buffer *dst_buf = &run->dst->vb2_buf;
+	unsigned int stride_mbs = ctx->src_fmt.bytesperline / 16;
+	unsigned int coded_size = vb2_plane_size(dst_buf, 0);
+	dma_addr_t coded_dma = vb2_dma_contig_plane_dma_addr(dst_buf, 0);
+	u32 value;
+	int ret;
+
+	cedrus_enc_h264_engine_enable(ctx);
+
+	cedrus_enc_h264_setup_isp(ctx, &run->src->vb2_buf);
+
+	/* Clear the interrupt and status flags. */
+	cedrus_write(dev, VE_ENC_AVC_INT_EN, 0);
+	cedrus_write(dev, VE_ENC_AVC_STATUS, VE_ENC_AVC_STATUS_MASK);
+
+	/* Coded buffer. */
+
+	cedrus_write(dev, VE_ENC_AVC_STARTTRIG, 0);
+	cedrus_write(dev, VE_ENC_AVC_STM_BIT_OFFSET, 0);
+
+	coded_size = ALIGN_DOWN(coded_size, CEDRUS_ENC_CODED_ALIGN);
+	cedrus_write(dev, VE_ENC_AVC_STM_START_ADDR,
+		     cedrus_enc_addr(ctx, coded_dma));
+	cedrus_write(dev, VE_ENC_AVC_STM_END_ADDR,
+		     cedrus_enc_addr(ctx, coded_dma + coded_size - 1));
+	cedrus_write(dev, VE_ENC_AVC_STM_BIT_MAX, coded_size * 8);
+
+	cedrus_write(dev, VE_ENC_AVC_STM_BIT_LEN, 0);
+	cedrus_write(dev, VE_ENC_AVC_HEADER_BITS, 0);
+	cedrus_write(dev, VE_ENC_AVC_RESIDUAL_BITS, 0);
+
+	/*
+	 * Headers: the core prepares the state, picks the QP and the
+	 * references, and writes the headers through the bit writer.
+	 */
+
+	cedrus_write(dev, VE_ENC_AVC_PARA0, 0);
+	h264_ctx->eptb_disabled = false;
+
+	ret = v4l2_h264_enc_step(enc, run->dst);
+	if (ret)
+		return ret;
+
+	pps = &state->pps;
+	encode = &state->encode;
+
+	/*
+	 * Picture parameters, which also switches the emulation prevention
+	 * back on for the slice data.
+	 */
+
+	value = VE_ENC_AVC_PARA0_PIC_TYPE_FRAME |
+		VE_ENC_AVC_PARA0_REF_PIC_TYPE_FRAME |
+		VE_ENC_AVC_PARA0_DEBLOCK_IDC(encode->disable_deblocking_filter_idc) |
+		VE_ENC_AVC_PARA0_ALPHA_OFFSET_DIV2(encode->slice_alpha_c0_offset_div2) |
+		VE_ENC_AVC_PARA0_BETA_OFFSET_DIV2(encode->slice_beta_offset_div2);
+
+	if (pps->flags & V4L2_H264_PPS_FLAG_ENTROPY_CODING_MODE)
+		value |= VE_ENC_AVC_PARA0_ENTROPY_CODING_CABAC;
+
+	if (encode->slice_type == V4L2_H264_SLICE_TYPE_P) {
+		/*
+		 * The vendor library writes 0x410 for a P picture: the slice
+		 * type and the first bit of the field the V3s register map
+		 * calls "fix mode num".
+		 */
+		value |= VE_ENC_AVC_PARA0_SLICE_TYPE_P |
+			 VE_ENC_AVC_PARA0_FIX_MODE_NUM(1);
+	} else {
+		value |= VE_ENC_AVC_PARA0_SLICE_TYPE_I;
+	}
+
+	cedrus_write(dev, VE_ENC_AVC_PARA0, value);
+	h264_ctx->eptb_disabled = false;
+
+	/* Let the bit writer finish before the engine takes the stream over. */
+	ret = cedrus_enc_poll(dev, VE_RESET,
+			      VE_RESET_CACHE_SYNC_IDLE | VE_RESET_SYNC_IDLE);
+	if (ret)
+		return ret;
+
+	/* Buffers. */
+
+	rec = ref->buffer_current.private_data;
+	if (!rec)
+		return -EINVAL;
+
+	if (encode->slice_type == V4L2_H264_SLICE_TYPE_P) {
+		if (!ref->l0_active_count)
+			return -EINVAL;
+
+		ref_rec = ref->buffers[ref->l0[0].index].private_data;
+		if (!ref_rec)
+			return -EINVAL;
+	} else {
+		/* An intra picture names its own reconstruction. */
+		ref_rec = rec;
+	}
+
+	cedrus_write(dev, VE_ENC_AVC_MB_INFO_ADDR,
+		     cedrus_enc_addr(ctx, h264_ctx->mb_info_dma));
+	cedrus_write(dev, VE_ENC_AVC_MV_BUF_ADDR, 0);
+
+	cedrus_write(dev, VE_ENC_AVC_REC_ADDR_Y,
+		     cedrus_enc_addr(ctx, rec->rec_dma));
+	cedrus_write(dev, VE_ENC_AVC_REC_ADDR_C,
+		     cedrus_enc_addr(ctx, rec->rec_dma + rec->rec_luma_size));
+	cedrus_write(dev, VE_ENC_AVC_REF0_ADDR_Y,
+		     cedrus_enc_addr(ctx, ref_rec->rec_dma));
+	cedrus_write(dev, VE_ENC_AVC_REF0_ADDR_C,
+		     cedrus_enc_addr(ctx, ref_rec->rec_dma +
+				     ref_rec->rec_luma_size));
+
+	cedrus_write(dev, VE_ENC_AVC_SUBPIX_ADDR_LAST,
+		     cedrus_enc_addr(ctx, ref_rec->subpix_dma));
+	cedrus_write(dev, VE_ENC_AVC_SUBPIX_ADDR_NEW,
+		     cedrus_enc_addr(ctx, rec->subpix_dma));
+
+	cedrus_write(dev, VE_ENC_AVC_DEBLK_ADDR, 0);
+	cedrus_write(dev, VE_ENC_AVC_CYCLIC_INTRA_REFRESH, 0);
+
+	/* Quantisation and motion estimation. */
+
+	value = VE_ENC_AVC_PARA1_RC_MODE_FIXED |
+		VE_ENC_AVC_PARA1_FIXED_QP(enc->rc.qp) |
+		VE_ENC_AVC_PARA1_STRIDE_MBS_DIV_48(DIV_ROUND_UP(stride_mbs, 48));
+
+	if (dev->enc_flags & CEDRUS_ENC_FLAG_H6_PARAMS) {
+		value |= VE_ENC_AVC_PARA1_DYNAMIC_ME_EN |
+			 VE_ENC_AVC_PARA1_H6_UNKNOWN27;
+
+		/* The vendor library's thresholds, from the stride. */
+		cedrus_write(dev, VE_ENC_AVC_DYNAMIC_ME_PAR0,
+			     VE_ENC_AVC_DYNAMIC_ME_PAR0_TH1(6 * stride_mbs / 10) |
+			     VE_ENC_AVC_DYNAMIC_ME_PAR0_TH0(stride_mbs / 10));
+		cedrus_write(dev, VE_ENC_AVC_DYNAMIC_ME_PAR1,
+			     VE_ENC_AVC_DYNAMIC_ME_PAR1_TH3(32 * stride_mbs / 10) |
+			     VE_ENC_AVC_DYNAMIC_ME_PAR1_TH2(26 * stride_mbs / 10));
+
+		cedrus_write(dev, VE_ENC_AVC_ME_PARA,
+			     VE_ENC_AVC_ME_PARA_WB_MV_INFO_DIS |
+			     VE_ENC_AVC_ME_PARA_QUANT_THRESHOLD_DIS);
+	} else {
+		value |= VE_ENC_AVC_PARA1_QP_CHROMA_OFFSET0(pps->chroma_qp_index_offset);
+
+		cedrus_write(dev, VE_ENC_AVC_DYNAMIC_ME_PAR0, 0);
+		cedrus_write(dev, VE_ENC_AVC_DYNAMIC_ME_PAR1, 0);
+
+		cedrus_write(dev, VE_ENC_AVC_ME_PARA,
+			     VE_ENC_AVC_ME_PARA_WB_MV_INFO_DIS |
+			     VE_ENC_AVC_ME_PARA_FME_SEARCH_LEVEL(2));
+	}
+
+	cedrus_write(dev, VE_ENC_AVC_PARA1, value);
+	cedrus_write(dev, VE_ENC_AVC_PARA2, 0);
+
+	/* The hardware rate control assistance is not used: a fixed QP. */
+	cedrus_write(dev, VE_ENC_AVC_RC_INIT, 0);
+	cedrus_write(dev, VE_ENC_AVC_RC_MAD_TH0, 0);
+	cedrus_write(dev, VE_ENC_AVC_RC_MAD_TH1, 0);
+	cedrus_write(dev, VE_ENC_AVC_RC_MAD_TH2, 0);
+	cedrus_write(dev, VE_ENC_AVC_RC_MAD_TH3, 0);
+	cedrus_write(dev, VE_ENC_AVC_RC_MAD_SUM, 0);
+
+	/* Statistics. */
+	cedrus_write(dev, VE_ENC_AVC_MAD, 0);
+	cedrus_write(dev, VE_ENC_AVC_OVERTIME_MB, 0);
+	cedrus_write(dev, VE_ENC_AVC_ME_INFO, 0);
+
+	return 0;
+}
+
+static void cedrus_enc_h264_trigger(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+
+	cedrus_write(dev, VE_ENC_AVC_INT_EN,
+		     VE_ENC_AVC_INT_EN_MB_OVERTIME |
+		     VE_ENC_AVC_INT_EN_STALL |
+		     VE_ENC_AVC_INT_EN_FINISH);
+
+	cedrus_write(dev, VE_ENC_AVC_STARTTRIG,
+		     VE_ENC_AVC_STARTTRIG_ENCODE_MODE_H264 |
+		     VE_ENC_AVC_STARTTRIG_TYPE_ENC_START);
+}
+
+static enum cedrus_irq_status cedrus_enc_h264_irq_status(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	u32 status;
+
+	status = cedrus_read(dev, VE_ENC_AVC_STATUS) & VE_ENC_AVC_STATUS_MASK;
+	if (!status)
+		return CEDRUS_IRQ_NONE;
+
+	/* A stall is the end of the coded buffer: the picture is incomplete. */
+	if (status == VE_ENC_AVC_STATUS_FINISH)
+		return CEDRUS_IRQ_OK;
+
+	dev_err_ratelimited(dev->dev, "encode failed, status 0x%x\n", status);
+
+	return CEDRUS_IRQ_ERROR;
+}
+
+static void cedrus_enc_h264_irq_clear(struct cedrus_ctx *ctx)
+{
+	cedrus_write(ctx->dev, VE_ENC_AVC_STATUS, VE_ENC_AVC_STATUS_MASK);
+}
+
+static void cedrus_enc_h264_irq_disable(struct cedrus_ctx *ctx)
+{
+	cedrus_write(ctx->dev, VE_ENC_AVC_INT_EN, 0);
+}
+
+/* The picture is done: its size, and the core's reference and RC bookkeeping. */
+static void cedrus_enc_h264_post_process(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	struct cedrus_enc_h264_ctx *h264_ctx = &ctx->codec.enc_h264;
+	struct vb2_v4l2_buffer *dst = v4l2_m2m_next_dst_buf(ctx->fh.m2m_ctx);
+	unsigned int bits, size;
+
+	if (WARN_ON(!dst))
+		return;
+
+	bits = cedrus_read(dev, VE_ENC_AVC_STM_BIT_LEN);
+	size = DIV_ROUND_UP(bits, 8);
+
+	if (!size || size > vb2_plane_size(&dst->vb2_buf, 0)) {
+		dev_err_ratelimited(dev->dev, "invalid coded size %u (%u bits)\n",
+				    size, bits);
+		vb2_set_plane_payload(&dst->vb2_buf, 0, 0);
+		return;
+	}
+
+	vb2_set_plane_payload(&dst->vb2_buf, 0, size);
+
+	v4l2_h264_enc_complete(&h264_ctx->enc, dst);
+}
+
+struct cedrus_dec_ops cedrus_enc_ops_h264 = {
+	.irq_clear	= cedrus_enc_h264_irq_clear,
+	.irq_disable	= cedrus_enc_h264_irq_disable,
+	.irq_status	= cedrus_enc_h264_irq_status,
+	.setup		= cedrus_enc_h264_setup,
+	.start		= cedrus_enc_h264_start,
+	.stop		= cedrus_enc_h264_stop,
+	.trigger	= cedrus_enc_h264_trigger,
+	.post_process	= cedrus_enc_h264_post_process,
+};
