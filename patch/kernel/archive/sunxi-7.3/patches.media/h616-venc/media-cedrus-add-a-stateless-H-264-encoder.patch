diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc.c b/drivers/staging/media/sunxi/cedrus/cedrus_enc.c
new file mode 100644
index 000000000..e683f5431
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc.c
@@ -0,0 +1,662 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cedrus VPU driver: stateless H.264 encoder, V4L2 side
+ *
+ * Copyright (C) 2023 Bootlin
+ * Copyright (C) 2026 Arun Iyengar <aiyengar1990@gmail.com>
+ *
+ * The encoder is a second video device on the same engine as the decoder.
+ * It takes NV12 pictures on its OUTPUT queue and produces one H.264 access
+ * unit per CAPTURE buffer, driven by the stateless H.264 encode core
+ * (media/v4l2-h264-enc.h): userspace provides the SPS, the PPS and the
+ * per picture encode parameters through requests, the core writes the
+ * headers and tracks the references, the engine encodes the slice data.
+ */
+
+#include <linux/pm_runtime.h>
+
+#include <media/v4l2-device.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "cedrus.h"
+#include "cedrus_dec.h"
+#include "cedrus_enc.h"
+#include "cedrus_hw.h"
+#include "cedrus_video.h"
+
+/*
+ * Pictures wider than 2048 pixels need the external deblocking line buffer
+ * (VE_ENC_AVC_DEBLK_ADDR) that the vendor library programs on the T527;
+ * it is not known for the H616 yet, so the encoder stops at 2048.
+ */
+static const struct v4l2_frmsize_stepwise cedrus_enc_frmsize = {
+	.min_width	= 16,
+	.max_width	= 2048,
+	.step_width	= 2,
+	.min_height	= 16,
+	.max_height	= 2048,
+	.step_height	= 2,
+};
+
+/* Controls */
+
+const struct cedrus_control cedrus_enc_controls[] = {
+	{
+		.cfg = {
+			.id	= V4L2_CID_STATELESS_H264_SPS,
+		},
+		.capabilities	= CEDRUS_CAPABILITY_H264_ENC,
+	},
+	{
+		.cfg = {
+			.id	= V4L2_CID_STATELESS_H264_PPS,
+		},
+		.capabilities	= CEDRUS_CAPABILITY_H264_ENC,
+	},
+	{
+		.cfg = {
+			.id	= V4L2_CID_STATELESS_H264_ENCODE_PARAMS,
+		},
+		.capabilities	= CEDRUS_CAPABILITY_H264_ENC,
+	},
+	{
+		.cfg = {
+			.id	= V4L2_CID_STATELESS_H264_START_CODE,
+			.min	= V4L2_STATELESS_H264_START_CODE_NONE,
+			.max	= V4L2_STATELESS_H264_START_CODE_ANNEX_B,
+			.def	= V4L2_STATELESS_H264_START_CODE_ANNEX_B,
+		},
+		.capabilities	= CEDRUS_CAPABILITY_H264_ENC,
+	},
+	{
+		.cfg = {
+			.id	= V4L2_CID_MPEG_VIDEO_AU_DELIMITER,
+			.min	= 0,
+			.max	= 1,
+			.step	= 1,
+			.def	= 0,
+		},
+		.capabilities	= CEDRUS_CAPABILITY_H264_ENC,
+	},
+	{
+		.cfg = {
+			.id	= V4L2_CID_MPEG_VIDEO_PREPEND_SPSPPS_TO_IDR,
+			.min	= 0,
+			.max	= 1,
+			.step	= 1,
+			.def	= 1,
+		},
+		.capabilities	= CEDRUS_CAPABILITY_H264_ENC,
+	},
+	/*
+	 * Profile and level are informative here: the SPS control carries
+	 * profile_idc and level_idc. CABAC (main and high profiles) is not
+	 * enabled yet, see cedrus_enc_h264_state_constrain().
+	 */
+	{
