diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.c b/drivers/staging/media/sunxi/cedrus/cedrus.c
index 1df70eb40..23a6cd34a 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.c
@@ -26,6 +26,7 @@
 #include "cedrus.h"
 #include "cedrus_video.h"
 #include "cedrus_dec.h"
+#include "cedrus_enc.h"
 #include "cedrus_hw.h"
 #include "cedrus_regs.h"
 
@@ -702,11 +703,18 @@ u32 cedrus_get_num_of_controls(struct cedrus_ctx *ctx, u32 id)
 static int cedrus_init_ctrls(struct cedrus_dev *dev, struct cedrus_ctx *ctx)
 {
 	struct v4l2_ctrl_handler *hdl = &ctx->hdl;
+	const struct cedrus_control *controls = cedrus_controls;
+	unsigned int controls_count = CEDRUS_CONTROLS_COUNT;
 	struct v4l2_ctrl *ctrl;
 	unsigned int ctrl_size;
 	unsigned int i, j;
 
-	v4l2_ctrl_handler_init(hdl, CEDRUS_CONTROLS_COUNT);
+	if (ctx->is_enc) {
+		controls = cedrus_enc_controls;
+		controls_count = cedrus_enc_controls_count;
+	}
+
+	v4l2_ctrl_handler_init(hdl, controls_count);
 	if (hdl->error) {
 		v4l2_err(&dev->v4l2_dev,
 			 "Failed to initialize control handler: %d\n",
@@ -714,7 +722,7 @@ static int cedrus_init_ctrls(struct cedrus_dev *dev, struct cedrus_ctx *ctx)
 		return hdl->error;
 	}
 
-	ctrl_size = sizeof(ctrl) * CEDRUS_CONTROLS_COUNT + 1;
+	ctrl_size = sizeof(ctrl) * (controls_count + 1);
 
 	ctx->ctrls = kzalloc(ctrl_size, GFP_KERNEL);
 	if (!ctx->ctrls) {
@@ -723,16 +731,15 @@ static int cedrus_init_ctrls(struct cedrus_dev *dev, struct cedrus_ctx *ctx)
 	}
 
 	j = 0;
-	for (i = 0; i < CEDRUS_CONTROLS_COUNT; i++) {
-		if (!cedrus_is_capable(ctx, cedrus_controls[i].capabilities))
+	for (i = 0; i < controls_count; i++) {
+		if (!cedrus_is_capable(ctx, controls[i].capabilities))
 			continue;
 
-		ctrl = v4l2_ctrl_new_custom(hdl, &cedrus_controls[i].cfg,
-					    NULL);
+		ctrl = v4l2_ctrl_new_custom(hdl, &controls[i].cfg, NULL);
 		if (hdl->error) {
 			v4l2_err(&dev->v4l2_dev,
 				 "Failed to create %s control: %d\n",
-				 v4l2_ctrl_get_name(cedrus_controls[i].cfg.id),
+				 v4l2_ctrl_get_name(controls[i].cfg.id),
 				 hdl->error);
 
 			v4l2_ctrl_handler_free(hdl);
@@ -816,15 +823,21 @@ static int cedrus_open(struct file *file)
 	v4l2_fh_init(&ctx->fh, video_devdata(file));
 	ctx->dev = dev;
 	ctx->bit_depth = 8;
+	/* Both video devices share the engine and its job queue. */
+	ctx->is_enc = video_devdata(file) == &dev->vfd_enc;
 
 	ctx->fh.m2m_ctx = v4l2_m2m_ctx_init(dev->m2m_dev, ctx,
+					    ctx->is_enc ? &cedrus_enc_queue_init :
 					    &cedrus_queue_init);
 	if (IS_ERR(ctx->fh.m2m_ctx)) {
 		ret = PTR_ERR(ctx->fh.m2m_ctx);
 		goto err_free;
 	}
 
-	cedrus_reset_out_format(ctx);
+	if (ctx->is_enc)
+		cedrus_enc_reset_formats(ctx);
+	else
+		cedrus_reset_out_format(ctx);
 
 	ret = cedrus_init_ctrls(dev, ctx);
 	if (ret)
@@ -887,6 +900,16 @@ static const struct video_device cedrus_video_device = {
 	.device_caps	= V4L2_CAP_VIDEO_M2M | V4L2_CAP_STREAMING,
 };
 
+static const struct video_device cedrus_enc_video_device = {
+	.name		= CEDRUS_NAME "-enc",
+	.vfl_dir	= VFL_DIR_M2M,
+	.fops		= &cedrus_fops,
+	.ioctl_ops	= &cedrus_enc_ioctl_ops,
+	.minor		= -1,
+	.release	= video_device_release_empty,
+	.device_caps	= V4L2_CAP_VIDEO_M2M | V4L2_CAP_STREAMING,
+};
+
 static const struct v4l2_m2m_ops cedrus_m2m_ops = {
 	.device_run	= cedrus_device_run,
 };
@@ -970,6 +993,40 @@ static int cedrus_probe(struct platform_device *pdev)
 		goto err_video;
 	}
 
+	/*
+	 * The encoder is a second video device on the same M2M device, so
+	 * that its jobs and the decoding jobs are serialised on the engine.
+	 * Its media controller entities are created by the same helper,
+	 * whose bookkeeping only knows one set: the decoder's entities are
+	 * then released with the media device.
+	 */
+	if (dev->capabilities & CEDRUS_CAPABILITY_H264_ENC) {
+		dev->vfd_enc = cedrus_enc_video_device;
+		dev->vfd_enc.lock = &dev->dev_mutex;
+		dev->vfd_enc.v4l2_dev = &dev->v4l2_dev;
+		video_set_drvdata(&dev->vfd_enc, dev);
+
+		ret = video_register_device(&dev->vfd_enc, VFL_TYPE_VIDEO, 0);
+		if (ret) {
+			v4l2_err(&dev->v4l2_dev,
+				 "Failed to register encoder video device\n");
+			goto err_m2m_mc;
+		}
+
+		v4l2_info(&dev->v4l2_dev,
+			  "Encoder registered as /dev/video%d\n",
+			  dev->vfd_enc.num);
+
+		ret = v4l2_m2m_register_media_controller(dev->m2m_dev,
+							 &dev->vfd_enc,
+							 MEDIA_ENT_F_PROC_VIDEO_ENCODER);
+		if (ret) {
+			v4l2_err(&dev->v4l2_dev,
+				 "Failed to initialize the encoder media controller\n");
+			goto err_video_enc;
+		}
+	}
+
 	ret = media_device_register(&dev->mdev);
 	if (ret) {
 		v4l2_err(&dev->v4l2_dev, "Failed to register media device\n");
@@ -978,6 +1035,8 @@ static int cedrus_probe(struct platform_device *pdev)
 
 	return 0;
 
+err_video_enc:
+	video_unregister_device(&dev->vfd_enc);
 err_m2m_mc:
 	v4l2_m2m_unregister_media_controller(dev->m2m_dev);
 err_video:
@@ -1005,6 +1064,8 @@ static void cedrus_remove(struct platform_device *pdev)
 	}
 
 	v4l2_m2m_release(dev->m2m_dev);
+	if (video_is_registered(&dev->vfd_enc))
+		video_unregister_device(&dev->vfd_enc);
 	video_unregister_device(&dev->vfd);
 	v4l2_device_unregister(&dev->v4l2_dev);
 
