 #define CEDRUS_CAPABILITY_JPEG_DEC	BIT(10)
 #define CEDRUS_CAPABILITY_AVS_DEC	BIT(11)
+#define CEDRUS_CAPABILITY_H264_ENC	BIT(12)
 
 #define CEDRUS_VC1_MIN_WIDTH		128
 
@@ -234,6 +237,8 @@ struct cedrus_ctx {
 	struct v4l2_pix_format		dst_fmt;
 	struct cedrus_dec_ops		*current_codec;
 	unsigned int			bit_depth;
