From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 6 Nov 2026 08:12:00 +0000
Subject: [PATCH] media: h264: Write parameter sets with a non-zero nal_ref_idc

H.264 7.4.1: nal_ref_idc shall not be equal to 0 for sequence parameter
set and picture parameter set NAL units. The stateless encode rbsp writer
puts both with nal_ref_idc 0 (NAL header bytes 0x07 and 0x08). FFmpeg
accepts that, a strict parser need not. Write 3, as x264 and the vendor
encoders do.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
--- a/drivers/media/v4l2-core/v4l2-h264-enc-rbsp.c
+++ b/drivers/media/v4l2-core/v4l2-h264-enc-rbsp.c
@@ -336,6 +336,12 @@
 }
 EXPORT_SYMBOL_GPL(v4l2_h264_enc_rbsp_start_code);
 
+/*
+ * H.264 7.4.1: nal_ref_idc shall not be 0 for a sequence or picture
+ * parameter set NAL unit. 3, as x264 and the vendor encoders write.
+ */
+#define V4L2_H264_ENC_PS_REF_IDC	3
+
 static int v4l2_h264_enc_rbsp_nalu_begin(struct v4l2_h264_enc_rbsp *rbsp,
 					 u8 nal_ref_idc, u8 nal_unit_type)
 {
@@ -654,7 +660,8 @@
 	unsigned int i;
 	int ret;
 
-	ret = v4l2_h264_enc_rbsp_nalu_begin(rbsp, 0, V4L2_H264_NALU_TYPE_SPS);
+	ret = v4l2_h264_enc_rbsp_nalu_begin(rbsp, V4L2_H264_ENC_PS_REF_IDC,
+					    V4L2_H264_NALU_TYPE_SPS);
 	if (ret)
 		return ret;
 
@@ -845,7 +852,8 @@
 	u8 pic_scaling_matrix_present_flag = 0;
 	int ret;
 
-	ret = v4l2_h264_enc_rbsp_nalu_begin(rbsp, 0, V4L2_H264_NALU_TYPE_PPS);
+	ret = v4l2_h264_enc_rbsp_nalu_begin(rbsp, V4L2_H264_ENC_PS_REF_IDC,
+					    V4L2_H264_NALU_TYPE_PPS);
 	if (ret)
 		return ret;
 
