+/*
+ * Register an encoder video device on the engine's M2M device, so that its
+ * jobs and the decoding jobs are serialised on the engine, with its own
+ * media entities.
+ */
+static int cedrus_enc_register(struct cedrus_dev *dev,
+			       struct video_device *vdev,
+			       const struct video_device *template,
+			       struct cedrus_enc_mc *mc, const char *what)
+{
+	int ret;
+
+	*vdev = *template;
+	vdev->lock = &dev->dev_mutex;
+	vdev->v4l2_dev = &dev->v4l2_dev;
+	video_set_drvdata(vdev, dev);
+
+	ret = video_register_device(vdev, VFL_TYPE_VIDEO, 0);
+	if (ret) {
+		v4l2_err(&dev->v4l2_dev,
+			 "Failed to register %s video device\n", what);
+		return ret;
+	}
+
+	v4l2_info(&dev->v4l2_dev, "%s registered as /dev/video%d\n", what,
+		  vdev->num);
+
+	ret = cedrus_enc_register_media(dev, vdev, mc);
+	if (ret) {
+		v4l2_err(&dev->v4l2_dev,
+			 "Failed to initialize the %s media controller\n",
+			 what);
+		video_unregister_device(vdev);
+	}
+
+	return ret;
 }
 
