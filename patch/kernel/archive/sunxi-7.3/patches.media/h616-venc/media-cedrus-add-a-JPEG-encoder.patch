diff -ruN a/drivers/staging/media/sunxi/cedrus/cedrus_enc_jpeg.c b/drivers/staging/media/sunxi/cedrus/cedrus_enc_jpeg.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus_enc_jpeg.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc_jpeg.c
@@ -0,0 +1,861 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cedrus VPU driver: JPEG encoder
+ *
+ * Copyright (C) 2026 Arun Iyengar <aiyengar1990@gmail.com>
+ *
+ * The H.264 encoder block of the engine also encodes JPEG (the encode mode
+ * field of its trigger register). This is a third video device on the
+ * engine's M2M device, a stateful JPEG encoder like the Hantro one: a raw
+ * 4:2:0 picture on the OUTPUT queue gives one baseline JPEG image on the
+ * CAPTURE queue, at the quality of V4L2_CID_JPEG_COMPRESSION_QUALITY. No
+ * requests are needed, and V4L2_ENC_CMD_STOP drains the queue.
+ *
+ * Register use after the linux-sunxi VE register guide (AVC block in JPEG
+ * mode: the JPEG control fields of 0xb04, the quantisation tables through
+ * the 0xbe0/0xbe4 memory port); the input stage and the coded buffer
+ * registers are those of the H.264 encoder (cedrus_enc_h264.c). The engine
+ * writes the entropy coded scan with the Annex K Huffman tables; the driver
+ * writes the headers before it and the EOI marker after it.
+ */
+
+#include <linux/dma-mapping.h>
+#include <linux/sizes.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/videodev2.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-jpeg.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "cedrus.h"
+#include "cedrus_dec.h"
+#include "cedrus_enc.h"
+#include "cedrus_hw.h"
+#include "cedrus_regs.h"
+#include "cedrus_video.h"
+
+/*
+ * Sizes in units of 2 pixels, as the H.264 encoder. The engine has no line
+ * buffer to size in JPEG mode; the input stage takes up to 2047 units of 8
+ * pixels and up to 2047 macroblocks of stride.
+ */
+static const struct v4l2_frmsize_stepwise cedrus_enc_jpeg_frmsize = {
+	.min_width	= 16,
+	.max_width	= 4096,
+	.step_width	= 2,
+	.min_height	= 16,
+	.max_height	= 4096,
+	.step_height	= 2,
+};
+
+#define CEDRUS_ENC_JPEG_DEFAULT_QUALITY		75
+
+/* Controls */
+
+const struct cedrus_control cedrus_enc_jpeg_controls[] = {
+	{
+		.cfg = {
+			.id	= V4L2_CID_JPEG_COMPRESSION_QUALITY,
+			.min	= 1,
+			.max	= 100,
+			.step	= 1,
+			.def	= CEDRUS_ENC_JPEG_DEFAULT_QUALITY,
+		},
+		.capabilities	= CEDRUS_CAPABILITY_JPEG_ENC,
+	},
+};
+
+const unsigned int cedrus_enc_jpeg_controls_count =
+	ARRAY_SIZE(cedrus_enc_jpeg_controls);
+
+/* Headers */
+
+struct cedrus_enc_jpeg_writer {
+	u8		*buf;
+	unsigned int	pos;
+};
+
+static void cedrus_enc_jpeg_put8(struct cedrus_enc_jpeg_writer *w, u8 value)
+{
+	w->buf[w->pos++] = value;
+}
+
+static void cedrus_enc_jpeg_put16(struct cedrus_enc_jpeg_writer *w, u16 value)
+{
+	cedrus_enc_jpeg_put8(w, value >> 8);
+	cedrus_enc_jpeg_put8(w, value & 0xff);
+}
+
+static void cedrus_enc_jpeg_put(struct cedrus_enc_jpeg_writer *w,
+				const u8 *data, unsigned int size)
+{
+	memcpy(w->buf + w->pos, data, size);
+	w->pos += size;
+}
+
+#define JPEG_MARKER_SOI		0xffd8
+#define JPEG_MARKER_EOI		0xffd9
+#define JPEG_MARKER_APP0	0xffe0
+#define JPEG_MARKER_DQT		0xffdb
+#define JPEG_MARKER_SOF0	0xffc0
+#define JPEG_MARKER_DHT		0xffc4
+#define JPEG_MARKER_COM		0xfffe
+#define JPEG_MARKER_SOS		0xffda
+
+/* The smallest comment segment: the marker and its length field. */
+#define JPEG_COM_MIN_SIZE	4
+
+/* The quality scaling of the IJG library, on the Annex K tables. */
+static void cedrus_enc_jpeg_scale_tables(struct cedrus_enc_jpeg_ctx *jpeg_ctx,
+					 int quality)
+{
+	static const u8 * const ref[2] = {
+		v4l2_jpeg_ref_table_luma_qt,
+		v4l2_jpeg_ref_table_chroma_qt,
+	};
+	unsigned int scale, t, i, value;
+
+	quality = clamp(quality, 1, 100);
+	scale = quality < 50 ? 5000 / quality : 200 - 2 * quality;
+
+	for (t = 0; t < 2; t++) {
+		for (i = 0; i < V4L2_JPEG_PIXELS_IN_BLOCK; i++) {
+			value = (ref[t][i] * scale + 50) / 100;
+			jpeg_ctx->qt[t][i] = clamp(value, 1U, 255U);
+		}
+	}
+
+	jpeg_ctx->quality = quality;
+}
+
+/*
+ * SOI, JFIF APP0, DQT, SOF0 (three components, 4:2:0), DHT (the Annex K
+ * tables), a comment segment that pads the headers to a multiple of 256
+ * bytes, SOS. The scan follows at the next 256 byte boundary of the coded
+ * buffer, where the engine starts writing.
+ */
+static void cedrus_enc_jpeg_build_header(struct cedrus_enc_jpeg_ctx *jpeg_ctx,
+					 unsigned int width,
+					 unsigned int height)
+{
+	static const u8 jfif[] = {
+		'J', 'F', 'I', 'F', 0,
+		1, 1,		/* version 1.01 */
+		0,		/* aspect ratio only */
+		0, 1, 0, 1,	/* 1:1 */
+		0, 0,		/* no thumbnail */
+	};
+	static const struct {
+		u8		class_id;
+		const u8	*table;
+		unsigned int	size;
+	} dht[] = {
+		{ V4L2_JPEG_DC_HT | V4L2_JPEG_LUM_HT,
+		  v4l2_jpeg_ref_table_luma_dc_ht, V4L2_JPEG_REF_HT_DC_LEN },
+		{ V4L2_JPEG_AC_HT | V4L2_JPEG_LUM_HT,
+		  v4l2_jpeg_ref_table_luma_ac_ht, V4L2_JPEG_REF_HT_AC_LEN },
+		{ V4L2_JPEG_DC_HT | V4L2_JPEG_CHR_HT,
+		  v4l2_jpeg_ref_table_chroma_dc_ht, V4L2_JPEG_REF_HT_DC_LEN },
+		{ V4L2_JPEG_AC_HT | V4L2_JPEG_CHR_HT,
+		  v4l2_jpeg_ref_table_chroma_ac_ht, V4L2_JPEG_REF_HT_AC_LEN },
+	};
+	struct cedrus_enc_jpeg_writer w = { .buf = jpeg_ctx->header };
+	const unsigned int sos_size = 2 + 12;
+	unsigned int i, t, length, com_size;
+
+	cedrus_enc_jpeg_put16(&w, JPEG_MARKER_SOI);
+
+	cedrus_enc_jpeg_put16(&w, JPEG_MARKER_APP0);
+	cedrus_enc_jpeg_put16(&w, 2 + sizeof(jfif));
+	cedrus_enc_jpeg_put(&w, jfif, sizeof(jfif));
+
+	/* The tables go in zigzag order, 8-bit precision. */
+	cedrus_enc_jpeg_put16(&w, JPEG_MARKER_DQT);
+	cedrus_enc_jpeg_put16(&w, 2 + 2 * (1 + V4L2_JPEG_PIXELS_IN_BLOCK));
+	for (t = 0; t < 2; t++) {
+		cedrus_enc_jpeg_put8(&w, t);
+		for (i = 0; i < V4L2_JPEG_PIXELS_IN_BLOCK; i++)
+			cedrus_enc_jpeg_put8(&w, jpeg_ctx->qt[t][v4l2_jpeg_zigzag_scan_index[i]]);
+	}
+
+	cedrus_enc_jpeg_put16(&w, JPEG_MARKER_SOF0);
+	cedrus_enc_jpeg_put16(&w, 2 + 6 + 3 * 3);
+	cedrus_enc_jpeg_put8(&w, 8);
+	cedrus_enc_jpeg_put16(&w, height);
+	cedrus_enc_jpeg_put16(&w, width);
+	cedrus_enc_jpeg_put8(&w, 3);
+	/* Y: 2x2 sampling, table 0; Cb and Cr: 1x1, table 1. */
+	cedrus_enc_jpeg_put8(&w, 1);
+	cedrus_enc_jpeg_put8(&w, 0x22);
+	cedrus_enc_jpeg_put8(&w, 0);
+	for (i = 2; i <= 3; i++) {
+		cedrus_enc_jpeg_put8(&w, i);
+		cedrus_enc_jpeg_put8(&w, 0x11);
+		cedrus_enc_jpeg_put8(&w, 1);
+	}
+
+	length = 2;
+	for (t = 0; t < ARRAY_SIZE(dht); t++)
+		length += 1 + dht[t].size;
+	cedrus_enc_jpeg_put16(&w, JPEG_MARKER_DHT);
+	cedrus_enc_jpeg_put16(&w, length);
+	for (t = 0; t < ARRAY_SIZE(dht); t++) {
+		cedrus_enc_jpeg_put8(&w, dht[t].class_id);
+		cedrus_enc_jpeg_put(&w, dht[t].table, dht[t].size);
+	}
+
+	com_size = ALIGN(w.pos + sos_size + JPEG_COM_MIN_SIZE,
+			 CEDRUS_ENC_CODED_ALIGN) - w.pos - sos_size;
+	cedrus_enc_jpeg_put16(&w, JPEG_MARKER_COM);
+	cedrus_enc_jpeg_put16(&w, com_size - 2);
+	memset(w.buf + w.pos, 0, com_size - 4);
+	w.pos += com_size - 4;
+
+	cedrus_enc_jpeg_put16(&w, JPEG_MARKER_SOS);
+	cedrus_enc_jpeg_put16(&w, sos_size - 2);
+	cedrus_enc_jpeg_put8(&w, 3);
+	cedrus_enc_jpeg_put8(&w, 1);
+	cedrus_enc_jpeg_put8(&w, 0x00);
+	for (i = 2; i <= 3; i++) {
+		cedrus_enc_jpeg_put8(&w, i);
+		cedrus_enc_jpeg_put8(&w, 0x11);
+	}
+	cedrus_enc_jpeg_put8(&w, 0);	/* Ss */
+	cedrus_enc_jpeg_put8(&w, 63);	/* Se */
+	cedrus_enc_jpeg_put8(&w, 0);	/* Ah, Al */
+
+	jpeg_ctx->header_size = w.pos;
+	jpeg_ctx->header_width = width;
+	jpeg_ctx->header_height = height;
+}
+
+/* Formats */
+
+/*
+ * The coded (CAPTURE) buffer: the headers and the scan. The default is
+ * twice the raw picture, far more than a quality 100 encode of a natural
+ * picture takes; the engine stops at the end of the buffer (a stall, the
+ * job fails), it never writes past it.
+ */
+static void cedrus_enc_jpeg_prepare_coded_format(struct cedrus_ctx *ctx,
+						 struct v4l2_pix_format *pix_fmt)
+{
+	const struct v4l2_pix_format *raw_fmt = &ctx->src_fmt;
+	unsigned int sizeimage = pix_fmt->sizeimage;
+
+	pix_fmt->pixelformat = V4L2_PIX_FMT_JPEG;
+	pix_fmt->width = raw_fmt->width;
+	pix_fmt->height = raw_fmt->height;
+	pix_fmt->bytesperline = 0;
+
+	if (!sizeimage)
+		sizeimage = CEDRUS_ENC_JPEG_HEADER_MAX +
+			    raw_fmt->bytesperline * raw_fmt->height * 3;
+
+	sizeimage = clamp_t(unsigned int, sizeimage, CEDRUS_ENC_CODED_MIN_SIZE,
+			    CEDRUS_ENC_CODED_MAX_SIZE);
+	pix_fmt->sizeimage = ALIGN(sizeimage, CEDRUS_ENC_CODED_ALIGN);
+
+	pix_fmt->field = V4L2_FIELD_NONE;
+	pix_fmt->colorspace = V4L2_COLORSPACE_JPEG;
+	pix_fmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+	pix_fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	pix_fmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+}
+
+void cedrus_enc_jpeg_reset_formats(struct cedrus_ctx *ctx)
+{
+	struct cedrus_enc_jpeg_ctx *jpeg_ctx = &ctx->codec.enc_jpeg;
+
+	ctx->current_codec = &cedrus_enc_ops_jpeg;
+
+	memset(&ctx->src_fmt, 0, sizeof(ctx->src_fmt));
+	ctx->src_fmt.width = 1280;
+	ctx->src_fmt.height = 720;
+	cedrus_enc_prepare_raw_format(&ctx->src_fmt, &cedrus_enc_jpeg_frmsize);
+
+	memset(&ctx->dst_fmt, 0, sizeof(ctx->dst_fmt));
+	cedrus_enc_jpeg_prepare_coded_format(ctx, &ctx->dst_fmt);
+
+	jpeg_ctx->timeperframe.numerator = 1;
+	jpeg_ctx->timeperframe.denominator = 30;
+}
+
+static int cedrus_enc_jpeg_enum_fmt_vid_cap(struct file *file, void *priv,
+					    struct v4l2_fmtdesc *f)
+{
+	if (f->index)
+		return -EINVAL;
+
+	f->pixelformat = V4L2_PIX_FMT_JPEG;
+
+	return 0;
+}
+
+static int cedrus_enc_jpeg_enum_fmt_vid_out(struct file *file, void *priv,
+					    struct v4l2_fmtdesc *f)
+{
+	return cedrus_enc_enum_raw_format(f);
+}
+
+static int cedrus_enc_jpeg_enum_framesizes(struct file *file, void *priv,
+					   struct v4l2_frmsizeenum *fsize)
+{
+	if (fsize->index)
+		return -EINVAL;
+
+	if (!cedrus_enc_raw_format_find(fsize->pixel_format) &&
+	    fsize->pixel_format != V4L2_PIX_FMT_JPEG)
+		return -EINVAL;
+
+	fsize->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	fsize->stepwise = cedrus_enc_jpeg_frmsize;
+	memset(fsize->reserved, 0, sizeof(fsize->reserved));
+
+	return 0;
+}
+
+static int cedrus_enc_jpeg_g_fmt_vid_cap(struct file *file, void *priv,
+					 struct v4l2_format *f)
+{
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+
+	f->fmt.pix = ctx->dst_fmt;
+
+	return 0;
+}
+
+static int cedrus_enc_jpeg_g_fmt_vid_out(struct file *file, void *priv,
+					 struct v4l2_format *f)
+{
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+
+	f->fmt.pix = ctx->src_fmt;
+
+	return 0;
+}
+
+static int cedrus_enc_jpeg_try_fmt_vid_cap(struct file *file, void *priv,
+					   struct v4l2_format *f)
+{
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+
+	cedrus_enc_jpeg_prepare_coded_format(ctx, &f->fmt.pix);
+
+	return 0;
+}
+
+static int cedrus_enc_jpeg_try_fmt_vid_out(struct file *file, void *priv,
+					   struct v4l2_format *f)
+{
+	cedrus_enc_prepare_raw_format(&f->fmt.pix, &cedrus_enc_jpeg_frmsize);
+
+	return 0;
+}
+
+static int cedrus_enc_jpeg_s_fmt_vid_cap(struct file *file, void *priv,
+					 struct v4l2_format *f)
+{
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+	struct vb2_queue *vq;
+
+	vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx, f->type);
+	if (vb2_is_busy(vq))
+		return -EBUSY;
+
+	cedrus_enc_jpeg_prepare_coded_format(ctx, &f->fmt.pix);
+	ctx->dst_fmt = f->fmt.pix;
+
+	return 0;
+}
+
+static int cedrus_enc_jpeg_s_fmt_vid_out(struct file *file, void *priv,
+					 struct v4l2_format *f)
+{
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+	struct vb2_queue *vq, *peer_vq;
+
+	vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx, f->type);
+	peer_vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx,
+				  V4L2_BUF_TYPE_VIDEO_CAPTURE);
+
+	/* The coded format follows the raw picture size. */
+	if (vb2_is_busy(vq) || vb2_is_busy(peer_vq))
+		return -EBUSY;
+
+	cedrus_enc_prepare_raw_format(&f->fmt.pix, &cedrus_enc_jpeg_frmsize);
+	ctx->src_fmt = f->fmt.pix;
+
+	ctx->dst_fmt.sizeimage = 0;
+	cedrus_enc_jpeg_prepare_coded_format(ctx, &ctx->dst_fmt);
+
+	return 0;
+}
+
+/* The frame rate is informative: every picture is coded on its own. */
+static int cedrus_enc_jpeg_g_parm(struct file *file, void *priv,
+				  struct v4l2_streamparm *parm)
+{
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+
+	if (parm->type != V4L2_BUF_TYPE_VIDEO_OUTPUT)
+		return -EINVAL;
+
+	parm->parm.output.capability = V4L2_CAP_TIMEPERFRAME;
+	parm->parm.output.timeperframe = ctx->codec.enc_jpeg.timeperframe;
+
+	return 0;
+}
+
+static int cedrus_enc_jpeg_s_parm(struct file *file, void *priv,
+				  struct v4l2_streamparm *parm)
+{
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+	struct v4l2_fract *timeperframe = &parm->parm.output.timeperframe;
+
+	if (parm->type != V4L2_BUF_TYPE_VIDEO_OUTPUT)
+		return -EINVAL;
+
+	if (timeperframe->numerator && timeperframe->denominator)
+		ctx->codec.enc_jpeg.timeperframe = *timeperframe;
+
+	return cedrus_enc_jpeg_g_parm(file, priv, parm);
+}
+
+static int cedrus_enc_jpeg_encoder_cmd(struct file *file, void *priv,
+				       struct v4l2_encoder_cmd *ec)
+{
+	struct cedrus_ctx *ctx = cedrus_file2ctx(file);
+	int ret;
+
+	ret = v4l2_m2m_ioctl_try_encoder_cmd(file, priv, ec);
+	if (ret)
+		return ret;
+
+	if (!vb2_is_streaming(v4l2_m2m_get_src_vq(ctx->fh.m2m_ctx)) ||
+	    !vb2_is_streaming(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx)))
+		return 0;
+
+	ret = v4l2_m2m_ioctl_encoder_cmd(file, priv, ec);
+	if (ret)
+		return ret;
+
+	if (ec->cmd == V4L2_ENC_CMD_START)
+		vb2_clear_last_buffer_dequeued(&ctx->fh.m2m_ctx->cap_q_ctx.q);
+
+	return 0;
+}
+
+const struct v4l2_ioctl_ops cedrus_enc_jpeg_ioctl_ops = {
+	.vidioc_querycap		= cedrus_enc_querycap,
+
+	.vidioc_enum_fmt_vid_cap	= cedrus_enc_jpeg_enum_fmt_vid_cap,
+	.vidioc_g_fmt_vid_cap		= cedrus_enc_jpeg_g_fmt_vid_cap,
+	.vidioc_try_fmt_vid_cap		= cedrus_enc_jpeg_try_fmt_vid_cap,
+	.vidioc_s_fmt_vid_cap		= cedrus_enc_jpeg_s_fmt_vid_cap,
+
+	.vidioc_enum_fmt_vid_out	= cedrus_enc_jpeg_enum_fmt_vid_out,
+	.vidioc_enum_framesizes		= cedrus_enc_jpeg_enum_framesizes,
+	.vidioc_g_fmt_vid_out		= cedrus_enc_jpeg_g_fmt_vid_out,
+	.vidioc_try_fmt_vid_out		= cedrus_enc_jpeg_try_fmt_vid_out,
+	.vidioc_s_fmt_vid_out		= cedrus_enc_jpeg_s_fmt_vid_out,
+
+	.vidioc_g_parm			= cedrus_enc_jpeg_g_parm,
+	.vidioc_s_parm			= cedrus_enc_jpeg_s_parm,
+
+	.vidioc_reqbufs			= v4l2_m2m_ioctl_reqbufs,
+	.vidioc_querybuf		= v4l2_m2m_ioctl_querybuf,
+	.vidioc_qbuf			= v4l2_m2m_ioctl_qbuf,
+	.vidioc_dqbuf			= v4l2_m2m_ioctl_dqbuf,
+	.vidioc_prepare_buf		= v4l2_m2m_ioctl_prepare_buf,
+	.vidioc_create_bufs		= v4l2_m2m_ioctl_create_bufs,
+	.vidioc_remove_bufs		= v4l2_m2m_ioctl_remove_bufs,
+	.vidioc_expbuf			= v4l2_m2m_ioctl_expbuf,
+
+	.vidioc_streamon		= v4l2_m2m_ioctl_streamon,
+	.vidioc_streamoff		= v4l2_m2m_ioctl_streamoff,
+
+	.vidioc_try_encoder_cmd		= v4l2_m2m_ioctl_try_encoder_cmd,
+	.vidioc_encoder_cmd		= cedrus_enc_jpeg_encoder_cmd,
+
+	.vidioc_subscribe_event		= v4l2_ctrl_subscribe_event,
+	.vidioc_unsubscribe_event	= v4l2_event_unsubscribe,
+};
+
+/* Queues */
+
+static int cedrus_enc_jpeg_queue_setup(struct vb2_queue *vq,
+				       unsigned int *nbufs,
+				       unsigned int *nplanes,
+				       unsigned int sizes[],
+				       struct device *alloc_devs[])
+{
+	struct cedrus_ctx *ctx = vb2_get_drv_priv(vq);
+	struct v4l2_pix_format *pix_fmt;
+
+	if (V4L2_TYPE_IS_OUTPUT(vq->type))
+		pix_fmt = &ctx->src_fmt;
+	else
+		pix_fmt = &ctx->dst_fmt;
+
+	if (*nplanes) {
+		if (sizes[0] < pix_fmt->sizeimage)
+			return -EINVAL;
+	} else {
+		sizes[0] = pix_fmt->sizeimage;
+		*nplanes = 1;
+	}
+
+	return 0;
+}
+
+static int cedrus_enc_jpeg_buf_prepare(struct vb2_buffer *vb)
+{
+	struct vb2_queue *vq = vb->vb2_queue;
+	struct cedrus_ctx *ctx = vb2_get_drv_priv(vq);
+	struct v4l2_pix_format *pix_fmt;
+
+	if (V4L2_TYPE_IS_OUTPUT(vq->type))
+		pix_fmt = &ctx->src_fmt;
+	else
+		pix_fmt = &ctx->dst_fmt;
+
+	if (vb2_plane_size(vb, 0) < pix_fmt->sizeimage)
+		return -EINVAL;
+
+	if (V4L2_TYPE_IS_CAPTURE(vq->type)) {
+		/* The driver writes the headers and the EOI marker. */
+		if (!vb2_plane_vaddr(vb, 0))
+			return -EINVAL;
+
+		/* The coded size is known when the job is done. */
+		vb2_set_plane_payload(vb, 0, 0);
+	}
+
+	return 0;
+}
+
+static const struct vb2_ops cedrus_enc_jpeg_qops = {
+	.queue_setup		= cedrus_enc_jpeg_queue_setup,
+	.buf_prepare		= cedrus_enc_jpeg_buf_prepare,
+	.buf_queue		= cedrus_buf_queue,
+	.buf_out_validate	= cedrus_buf_out_validate,
+	.start_streaming	= cedrus_start_streaming,
+	.stop_streaming		= cedrus_stop_streaming,
+};
+
+int cedrus_enc_jpeg_queue_init(void *priv, struct vb2_queue *src_vq,
+			       struct vb2_queue *dst_vq)
+{
+	struct cedrus_ctx *ctx = priv;
+	int ret;
+
+	src_vq->type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
+	src_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	src_vq->dma_attrs = DMA_ATTR_NO_KERNEL_MAPPING;
+	src_vq->drv_priv = ctx;
+	src_vq->buf_struct_size = sizeof(struct cedrus_buffer);
+	src_vq->ops = &cedrus_enc_jpeg_qops;
+	src_vq->mem_ops = &vb2_dma_contig_memops;
+	src_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	src_vq->lock = &ctx->dev->dev_mutex;
+	src_vq->dev = ctx->dev->dev;
+
+	ret = vb2_queue_init(src_vq);
+	if (ret)
+		return ret;
+
+	/* The coded buffers keep a kernel mapping for the headers. */
+	dst_vq->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+	dst_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	dst_vq->drv_priv = ctx;
+	dst_vq->buf_struct_size = sizeof(struct cedrus_buffer);
+	dst_vq->ops = &cedrus_enc_jpeg_qops;
+	dst_vq->mem_ops = &vb2_dma_contig_memops;
+	dst_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	dst_vq->lock = &ctx->dev->dev_mutex;
+	dst_vq->dev = ctx->dev->dev;
+
+	return vb2_queue_init(dst_vq);
+}
+
+/* Engine */
+
+/*
+ * The H.264 path's address registers (reconstruction, references, sub-pixel,
+ * macroblock information, motion vectors, rate control, line buffer,
+ * temporal filter counts): whether the engine touches any of them in JPEG
+ * mode is not documented. The encoder reset clears them to 0, and behind the
+ * IOMMU an access through 0 is a page fault that stalls the engine (as the
+ * H.264 encoder found, see struct cedrus_enc_h264_aux), so they all name
+ * one buffer the size of the largest of them, a reconstructed picture.
+ */
+static int cedrus_enc_jpeg_start(struct cedrus_ctx *ctx)
+{
+	struct cedrus_enc_jpeg_ctx *jpeg_ctx = &ctx->codec.enc_jpeg;
+	struct device *dev = ctx->dev->dev;
+	unsigned int width_mbs = DIV_ROUND_UP(ctx->src_fmt.width, 16);
+	unsigned int height_mbs = DIV_ROUND_UP(ctx->src_fmt.height, 16);
+	size_t rec_size, picture_size;
+
+	rec_size = ALIGN(width_mbs, 2) * 16 *
+		   (ALIGN(height_mbs + 1, 4) +
+		    ALIGN(DIV_ROUND_UP(height_mbs, 2), 4)) * 16;
+	picture_size = ALIGN(width_mbs * 16, 32) *
+		       ALIGN(height_mbs * 16, 128) * 3 / 2;
+
+	jpeg_ctx->scratch_size = ALIGN(max(rec_size, picture_size), SZ_4K);
+	jpeg_ctx->scratch = dma_alloc_attrs(dev, jpeg_ctx->scratch_size,
+					    &jpeg_ctx->scratch_dma, GFP_KERNEL,
+					    DMA_ATTR_NO_KERNEL_MAPPING);
+	if (!jpeg_ctx->scratch)
+		return -ENOMEM;
+
+	/* Built at the first picture. */
+	jpeg_ctx->quality = 0;
+	jpeg_ctx->header_size = 0;
+
+	return 0;
+}
+
+static void cedrus_enc_jpeg_stop(struct cedrus_ctx *ctx)
+{
+	struct cedrus_enc_jpeg_ctx *jpeg_ctx = &ctx->codec.enc_jpeg;
+
+	if (jpeg_ctx->scratch)
+		dma_free_attrs(ctx->dev->dev, jpeg_ctx->scratch_size,
+			       jpeg_ctx->scratch, jpeg_ctx->scratch_dma,
+			       DMA_ATTR_NO_KERNEL_MAPPING);
+	jpeg_ctx->scratch = NULL;
+}
+
+/* As the H.264 encoder: the decoder off, a pulse of the encoder reset. */
+static void cedrus_enc_jpeg_engine_enable(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	u32 mode, value;
+
+	if (dev->ve_mode_ddr)
+		mode = dev->ve_mode_ddr;
+	else
+		mode = VE_MODE_REC_WR_MODE_2MB | VE_MODE_DDR_MODE_BW_128;
+
+	mode |= VE_MODE_DISABLED;
+
+	cedrus_write(dev, VE_MODE, mode);
+
+	value = cedrus_read(dev, VE_RESET);
+	cedrus_write(dev, VE_RESET, value | VE_RESET_ENCODER_RESET);
+	cedrus_write(dev, VE_RESET, value & ~VE_RESET_ENCODER_RESET);
+
+	cedrus_write(dev, VE_MODE, mode | VE_MODE_ENC_ENABLE |
+		     VE_MODE_ENC_ISP_ENABLE);
+}
+
+static int cedrus_enc_jpeg_quality(struct cedrus_ctx *ctx)
+{
+	struct v4l2_ctrl *ctrl;
+
+	ctrl = v4l2_ctrl_find(&ctx->hdl, V4L2_CID_JPEG_COMPRESSION_QUALITY);
+	if (!ctrl)
+		return CEDRUS_ENC_JPEG_DEFAULT_QUALITY;
+
+	return v4l2_ctrl_g_ctrl(ctrl);
+}
+
+static int cedrus_enc_jpeg_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	struct cedrus_enc_jpeg_ctx *jpeg_ctx = &ctx->codec.enc_jpeg;
+	struct vb2_buffer *src_buf = &run->src->vb2_buf;
+	struct vb2_buffer *dst_buf = &run->dst->vb2_buf;
+	unsigned int coded_size = vb2_plane_size(dst_buf, 0);
+	dma_addr_t coded_dma = vb2_dma_contig_plane_dma_addr(dst_buf, 0);
+	dma_addr_t scan_dma, scratch;
+	unsigned int scan_size, t, i;
+	int quality;
+	u8 *coded;
+
+	coded = vb2_plane_vaddr(dst_buf, 0);
+	if (!coded || !jpeg_ctx->scratch)
+		return -EINVAL;
+
+	quality = cedrus_enc_jpeg_quality(ctx);
+	if (quality != jpeg_ctx->quality ||
+	    jpeg_ctx->header_width != ctx->src_fmt.width ||
+	    jpeg_ctx->header_height != ctx->src_fmt.height ||
+	    !jpeg_ctx->header_size) {
+		cedrus_enc_jpeg_scale_tables(jpeg_ctx, quality);
+		cedrus_enc_jpeg_build_header(jpeg_ctx, ctx->src_fmt.width,
+					     ctx->src_fmt.height);
+	}
+
+	/* The scan starts after the headers, at a 256 byte boundary. */
+	coded_size = ALIGN_DOWN(coded_size, CEDRUS_ENC_CODED_ALIGN);
+	if (coded_size < jpeg_ctx->header_size + CEDRUS_ENC_CODED_MIN_SIZE)
+		return -ENOSPC;
+
+	memcpy(coded, jpeg_ctx->header, jpeg_ctx->header_size);
+	scan_dma = coded_dma + jpeg_ctx->header_size;
+	scan_size = coded_size - jpeg_ctx->header_size;
+
+	cedrus_enc_jpeg_engine_enable(ctx);
+
+	cedrus_enc_setup_isp(ctx, src_buf);
+
+	/* Clear the interrupt and status flags. */
+	cedrus_write(dev, VE_ENC_AVC_INT_EN, 0);
+	cedrus_write(dev, VE_ENC_AVC_STATUS, VE_ENC_AVC_STATUS_MASK);
+
+	/* Coded buffer: the scan part. */
+	cedrus_write(dev, VE_ENC_AVC_STARTTRIG, 0);
+	cedrus_write(dev, VE_ENC_AVC_STM_BIT_OFFSET, 0);
+	cedrus_write(dev, VE_ENC_AVC_STM_START_ADDR,
+		     cedrus_enc_addr(ctx, scan_dma));
+	cedrus_write(dev, VE_ENC_AVC_STM_END_ADDR,
+		     cedrus_enc_addr(ctx, scan_dma + scan_size - 1));
+	cedrus_write(dev, VE_ENC_AVC_STM_BIT_MAX, scan_size * 8);
+	cedrus_write(dev, VE_ENC_AVC_STM_BIT_LEN, 0);
+	cedrus_write(dev, VE_ENC_AVC_HEADER_BITS, 0);
+	cedrus_write(dev, VE_ENC_AVC_RESIDUAL_BITS, 0);
+
+	/* Quantisation tables, luma then chroma, natural order. */
+	cedrus_write(dev, VE_ENC_AVC_SRAM_INDEX, 0);
+	for (t = 0; t < 2; t++)
+		for (i = 0; i < V4L2_JPEG_PIXELS_IN_BLOCK; i++)
+			cedrus_write(dev, VE_ENC_AVC_SRAM_DATA,
+				     VE_ENC_AVC_SRAM_DATA_JPEG_QM(jpeg_ctx->qt[t][i]));
+
+	cedrus_write(dev, VE_ENC_AVC_PARA0,
+		     VE_ENC_JPEG_CTRL_FILL1 | VE_ENC_JPEG_CTRL_STUFF |
+		     VE_ENC_JPEG_CTRL_BIAS_C(0x400 / jpeg_ctx->qt[1][0]) |
+		     VE_ENC_JPEG_CTRL_BIAS_Y(0x400 / jpeg_ctx->qt[0][0]));
+	cedrus_write(dev, VE_ENC_AVC_PARA1, 0);
+	cedrus_write(dev, VE_ENC_AVC_PARA2, 0);
+	cedrus_write(dev, VE_ENC_AVC_ME_PARA, VE_ENC_AVC_ME_PARA_WB_MV_INFO_DIS);
+	cedrus_write(dev, VE_ENC_AVC_CYCLIC_INTRA_REFRESH, 0);
+
+	/* Every other address register names the scratch buffer. */
+	scratch = cedrus_enc_addr(ctx, jpeg_ctx->scratch_dma);
+	cedrus_write(dev, VE_ENC_AVC_MB_INFO_ADDR, scratch);
+	cedrus_write(dev, VE_ENC_AVC_MV_BUF_ADDR, scratch);
+	cedrus_write(dev, VE_ENC_AVC_RC_BUF_ADDR, scratch);
+	cedrus_write(dev, VE_ENC_AVC_REC_ADDR_Y, scratch);
+	cedrus_write(dev, VE_ENC_AVC_REC_ADDR_C, scratch);
+	cedrus_write(dev, VE_ENC_AVC_REF0_ADDR_Y, scratch);
+	cedrus_write(dev, VE_ENC_AVC_REF0_ADDR_C, scratch);
+	cedrus_write(dev, VE_ENC_AVC_REF1_ADDR_Y, scratch);
+	cedrus_write(dev, VE_ENC_AVC_REF1_ADDR_C, scratch);
+	cedrus_write(dev, VE_ENC_AVC_SUBPIX_ADDR_LAST, scratch);
+	cedrus_write(dev, VE_ENC_AVC_SUBPIX_ADDR_NEW, scratch);
+	cedrus_write(dev, VE_ENC_AVC_DEBLK_ADDR, scratch);
+	cedrus_write(dev, VE_ENC_AVC_TFCNT_ADDR, scratch);
+
+	cedrus_write(dev, VE_ENC_AVC_RC_INIT, 0);
+	cedrus_write(dev, VE_ENC_AVC_MAD, 0);
+	cedrus_write(dev, VE_ENC_AVC_OVERTIME_MB, 0);
+	cedrus_write(dev, VE_ENC_AVC_ME_INFO, 0);
+
+	cedrus_enc_layout_reset(ctx);
+	cedrus_enc_layout_add(ctx, "source",
+			      vb2_dma_contig_plane_dma_addr(src_buf, 0),
+			      vb2_plane_size(src_buf, 0));
+	cedrus_enc_layout_add(ctx, "coded", coded_dma,
+			      vb2_plane_size(dst_buf, 0));
+	cedrus_enc_layout_add(ctx, "scan", scan_dma, scan_size);
+	cedrus_enc_layout_add(ctx, "scratch", jpeg_ctx->scratch_dma,
+			      jpeg_ctx->scratch_size);
+
+	run->dst->flags |= V4L2_BUF_FLAG_KEYFRAME;
+
+	return 0;
+}
+
+static void cedrus_enc_jpeg_trigger(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+
+	cedrus_write(dev, VE_ENC_AVC_INT_EN,
+		     VE_ENC_AVC_INT_EN_MB_OVERTIME |
+		     VE_ENC_AVC_INT_EN_STALL |
+		     VE_ENC_AVC_INT_EN_FINISH);
+
+	cedrus_write(dev, VE_ENC_AVC_STARTTRIG,
+		     VE_ENC_AVC_STARTTRIG_ENCODE_MODE_JPEG |
+		     VE_ENC_AVC_STARTTRIG_TYPE_ENC_START);
+}
+
+static enum cedrus_irq_status cedrus_enc_jpeg_irq_status(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	u32 status;
+
+	status = cedrus_read(dev, VE_ENC_AVC_STATUS) & VE_ENC_AVC_STATUS_MASK;
+	if (!status)
+		return CEDRUS_IRQ_NONE;
+
+	/* A stall is the end of the coded buffer: the image is incomplete. */
+	if (status == VE_ENC_AVC_STATUS_FINISH)
+		return CEDRUS_IRQ_OK;
+
+	dev_err_ratelimited(dev->dev, "JPEG encode failed, status 0x%x\n",
+			    status);
+
+	return CEDRUS_IRQ_ERROR;
+}
+
+static void cedrus_enc_jpeg_irq_clear(struct cedrus_ctx *ctx)
+{
+	cedrus_write(ctx->dev, VE_ENC_AVC_STATUS, VE_ENC_AVC_STATUS_MASK);
+}
+
+static void cedrus_enc_jpeg_irq_disable(struct cedrus_ctx *ctx)
+{
+	cedrus_write(ctx->dev, VE_ENC_AVC_INT_EN, 0);
+}
+
+/* The scan is done: the EOI marker after it, and the image's size. */
+static void cedrus_enc_jpeg_post_process(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	struct cedrus_enc_jpeg_ctx *jpeg_ctx = &ctx->codec.enc_jpeg;
+	struct vb2_v4l2_buffer *dst = v4l2_m2m_next_dst_buf(ctx->fh.m2m_ctx);
+	unsigned int bits, size;
+	u8 *coded;
+
+	if (WARN_ON(!dst))
+		return;
+
+	coded = vb2_plane_vaddr(&dst->vb2_buf, 0);
+	bits = cedrus_read(dev, VE_ENC_AVC_STM_BIT_LEN);
+	size = jpeg_ctx->header_size + DIV_ROUND_UP(bits, 8);
+
+	if (!coded || !bits ||
+	    size + 2 > vb2_plane_size(&dst->vb2_buf, 0)) {
+		dev_err_ratelimited(dev->dev, "invalid JPEG scan size (%u bits)\n",
+				    bits);
+		vb2_set_plane_payload(&dst->vb2_buf, 0, 0);
+		return;
+	}
+
+	coded[size] = JPEG_MARKER_EOI >> 8;
+	coded[size + 1] = JPEG_MARKER_EOI & 0xff;
+
+	vb2_set_plane_payload(&dst->vb2_buf, 0, size + 2);
+}
+
+struct cedrus_dec_ops cedrus_enc_ops_jpeg = {
+	.irq_clear	= cedrus_enc_jpeg_irq_clear,
+	.irq_disable	= cedrus_enc_jpeg_irq_disable,
+	.irq_status	= cedrus_enc_jpeg_irq_status,
+	.setup		= cedrus_enc_jpeg_setup,
+	.start		= cedrus_enc_jpeg_start,
+	.stop		= cedrus_enc_jpeg_stop,
+	.trigger	= cedrus_enc_jpeg_trigger,
+	.post_process	= cedrus_enc_jpeg_post_process,
+};
