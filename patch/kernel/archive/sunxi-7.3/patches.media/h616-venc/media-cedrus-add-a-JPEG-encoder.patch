+u32 cedrus_enc_addr(struct cedrus_ctx *ctx, dma_addr_t addr)
+{
+	if (ctx->dev->enc_flags & CEDRUS_ENC_FLAG_ADDR_SHIFT_8)
+		return addr >> 8;
+
+	return addr;
+}
