+/* Input stage, shared by the H.264 and the JPEG encoders */
+
+void cedrus_enc_setup_isp(struct cedrus_ctx *ctx, struct vb2_buffer *src_buf)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	const struct v4l2_pix_format *fmt = &ctx->src_fmt;
+	const struct cedrus_enc_raw_format *raw;
+	unsigned int stride_mbs = fmt->bytesperline / 16;
+	unsigned int luma_size = fmt->bytesperline * fmt->height;
+	unsigned int width, height;
+	dma_addr_t luma, chroma0, chroma1;
+
+	raw = cedrus_enc_raw_format_find(fmt->pixelformat);
+	if (WARN_ON(!raw))
+		raw = &cedrus_enc_raw_formats[0];
+
+	if (dev->enc_flags & CEDRUS_ENC_FLAG_ISP_SIZE_8PX) {
+		/* The visible size in units of 8 pixels. */
+		width = DIV_ROUND_UP(fmt->width, 8);
+		height = DIV_ROUND_UP(fmt->height, 8);
+	} else {
+		width = DIV_ROUND_UP(fmt->width, 16);
+		height = DIV_ROUND_UP(fmt->height, 16);
+	}
+
+	cedrus_write(dev, VE_ISP_PIC_INFO,
+		     VE_ISP_PIC_INFO_WIDTH(width) |
+		     VE_ISP_PIC_INFO_HEIGHT(height));
+	cedrus_write(dev, VE_ISP_SCALER_SIZE,
+		     VE_ISP_SCALER_SIZE_HEIGHT(height) |
+		     VE_ISP_SCALER_SIZE_WIDTH(width));
+
+	cedrus_write(dev, VE_ISP_PIC_STRIDE0,
+		     VE_ISP_PIC_STRIDE0_INPUT_MBS(stride_mbs));
+	if (dev->enc_flags & CEDRUS_ENC_FLAG_ISP_SIZE_8PX)
+		cedrus_write(dev, VE_ISP_PIC_STRIDE1,
+			     VE_ISP_PIC_STRIDE1_INPUT_MBS(stride_mbs));
+
+	/* No rotation or scaling, no interrupt from this stage. */
+	cedrus_write(dev, VE_ISP_CTRL, raw->isp_format |
+		     VE_ISP_CTRL_COLORSPACE_BT601);
+
+	/*
+	 * The input addresses are byte addresses on every generation. The
+	 * chroma plane(s) follow the luma plane of the visible height; the
+	 * planes of the three-plane formats have half the luma stride.
+	 */
+	luma = vb2_dma_contig_plane_dma_addr(src_buf, 0);
+	chroma0 = luma + luma_size;
+	chroma1 = chroma0 + luma_size / 4;
+	if (raw->cr_first)
+		swap(chroma0, chroma1);
+
+	cedrus_write(dev, VE_ISP_INPUT_LUMA_ADDR, luma);
+	cedrus_write(dev, VE_ISP_INPUT_CHROMA0_ADDR, chroma0);
+	cedrus_write(dev, VE_ISP_INPUT_CHROMA1_ADDR, chroma1);
+}
