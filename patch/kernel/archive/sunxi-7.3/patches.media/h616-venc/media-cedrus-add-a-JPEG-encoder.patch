+const struct cedrus_enc_raw_format *cedrus_enc_raw_format_find(u32 pixelformat)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(cedrus_enc_raw_formats); i++)
+		if (cedrus_enc_raw_formats[i].pixelformat == pixelformat)
+			return &cedrus_enc_raw_formats[i];
+
+	return NULL;
+}
+
+int cedrus_enc_enum_raw_format(struct v4l2_fmtdesc *f)
+{
+	if (f->index >= ARRAY_SIZE(cedrus_enc_raw_formats))
+		return -EINVAL;
+
+	f->pixelformat = cedrus_enc_raw_formats[f->index].pixelformat;
+
+	return 0;
+}
