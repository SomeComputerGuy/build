From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 6 Nov 2026 08:30:00 +0000
Subject: [PATCH] media: cedrus: enc: give the source buffer room for the engine's read past its end

Runner jobs 35 (kernel c31) and 37 (c32) encoded 1280x720 and 1920x1080,
intra and inter, without a fault, and the first 1366x768 picture stalled
on both kernels at the same address:

  sun50i-iommu 30f0000.iommu: Page fault for 0x00000000fff83000 (master 3, dir rd, L2 page table, status 0x8)
  cedrus 1c0e000.video-codec: frame processing timed out!

c32 had given the macroblock info buffer a picture's size, so that buffer
was not it. dma-iommu aligns an IOVA range to its size rounded up to a
power of two and allocates top down; the buffers of an encode are
allocated in the order OUTPUT, CAPTURE, then those of start_streaming.
The only buffer of the run that ends at 0xfff83000 is a 387 page one in
the topmost 2 MiB slot, 0xffe00000: the first OUTPUT (NV12 source)
buffer, 1376 x 768 x 3/2 bytes, which the first picture reads. So the
input stage reads past the end of the chroma plane. 1366x768 is the only
size tested whose macroblock aligned picture fills its last page to the
byte: 1280x720 has 20 KiB to spare there, 1920x1080 15 KiB. Without an
IOMMU (the vendor stack) the read is invisible.

Add one macroblock row of luma (16 lines of the stride) to the sizeimage
of the raw format, so that a non-multiple-of-64 width works rather than
being refused. The IOMMU stays on.

For the next fault of this kind, record the IOVA and size of every buffer
of the last encode job: /sys/kernel/debug/cedrus/encoder-buffers, and the
same list in the log after an encode job timed out. Also correct the
comment of the macroblock info buffer, which blamed the fault on it.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
--- a/drivers/staging/media/sunxi/cedrus/cedrus.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.h
@@ -409,6 +409,9 @@
 	unsigned int		h265_max_height;
 	bool			jpeg_rotate_out;
 	unsigned int		enc_flags;
+	/* Buffers of the last encode job (struct cedrus_enc_layout). */
+	struct cedrus_enc_layout enc_layout;
+	struct dentry		*debugfs;
 
 	struct delayed_work	watchdog_work;
 };
--- a/drivers/staging/media/sunxi/cedrus/cedrus.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.c
@@ -1149,6 +1149,8 @@
 	 * that its jobs and the decoding jobs are serialised on the engine.
 	 */
 	if (dev->capabilities & CEDRUS_CAPABILITY_H264_ENC) {
+		spin_lock_init(&dev->enc_layout.lock);
+
 		dev->vfd_enc = cedrus_enc_video_device;
 		dev->vfd_enc.lock = &dev->dev_mutex;
 		dev->vfd_enc.v4l2_dev = &dev->v4l2_dev;
@@ -1179,6 +1181,9 @@
 		goto err_enc_mc;
 	}
 
+	if (dev->capabilities & CEDRUS_CAPABILITY_H264_ENC)
+		cedrus_enc_debugfs_init(dev);
+
 	return 0;
 
 err_enc_mc:
@@ -1206,6 +1211,7 @@
 	struct cedrus_dev *dev = platform_get_drvdata(pdev);
 
 	cancel_delayed_work_sync(&dev->watchdog_work);
+	cedrus_enc_debugfs_exit(dev);
 	if (media_devnode_is_registered(dev->mdev.devnode)) {
 		media_device_unregister(&dev->mdev);
 		cedrus_enc_unregister_media(dev);
--- a/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
@@ -323,6 +323,8 @@
 		return;
 
 	v4l2_err(&dev->v4l2_dev, "frame processing timed out!\n");
+	if (ctx->is_enc)
+		cedrus_enc_report_layout(dev);
 
 	reset_control_reset(dev->rstc);
 	v4l2_m2m_buf_done_and_job_finish(ctx->dev->m2m_dev, ctx->fh.m2m_ctx,
--- a/drivers/staging/media/sunxi/cedrus/cedrus_enc.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc.h
@@ -10,6 +10,7 @@
 #define _CEDRUS_ENC_H_
 
 #include <linux/bits.h>
+#include <linux/spinlock.h>
 #include <linux/sizes.h>
 #include <linux/types.h>
 #include <linux/videodev2.h>
@@ -110,6 +111,29 @@
 	bool			eptb_disabled;
 };
 
+/*
+ * The buffers of the last encode job, IOVA and size, for the debugfs file
+ * <debugfs>/cedrus/encoder-buffers and for the report after a job timed
+ * out: an IOMMU fault names an address, this names the buffer around it.
+ */
+#define CEDRUS_ENC_LAYOUT_MAX			12
+
+struct cedrus_enc_layout_entry {
+	const char	*name;
+	dma_addr_t	dma;
+	size_t		size;
+};
+
+struct cedrus_enc_layout {
+	spinlock_t	lock;	/* the job writes, debugfs reads */
+	unsigned int	width;
+	unsigned int	height;
+	unsigned int	bytesperline;
+	unsigned int	sizeimage;
+	unsigned int	count;
+	struct cedrus_enc_layout_entry entry[CEDRUS_ENC_LAYOUT_MAX];
+};
+
 extern const struct v4l2_ioctl_ops cedrus_enc_ioctl_ops;
 
 int cedrus_enc_queue_init(void *priv, struct vb2_queue *src_vq,
@@ -117,4 +141,11 @@
 void cedrus_enc_reset_formats(struct cedrus_ctx *ctx);
 void cedrus_enc_device_run(struct cedrus_ctx *ctx);
 
+void cedrus_enc_layout_reset(struct cedrus_ctx *ctx);
+void cedrus_enc_layout_add(struct cedrus_ctx *ctx, const char *name,
+			   dma_addr_t dma, size_t size);
+void cedrus_enc_report_layout(struct cedrus_dev *dev);
+void cedrus_enc_debugfs_init(struct cedrus_dev *dev);
+void cedrus_enc_debugfs_exit(struct cedrus_dev *dev);
+
 #endif
--- a/drivers/staging/media/sunxi/cedrus/cedrus_enc.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc.c
@@ -13,7 +13,9 @@
  * headers and tracks the references, the engine encodes the slice data.
  */
 
+#include <linux/debugfs.h>
 #include <linux/pm_runtime.h>
+#include <linux/seq_file.h>
 
 #include <media/v4l2-device.h>
 #include <media/v4l2-event.h>
@@ -250,7 +252,24 @@
  * aligned height; the chroma plane stays at bytesperline * height as NV12
  * defines it. The format keeps the visible size: the encode core crops
  * the coded picture to it in the SPS.
+ *
+ * The input stage also reads past the end of the chroma plane of the
+ * macroblock aligned picture. Without an IOMMU that is an invisible read
+ * of the next bytes; behind it, the first 1366x768 picture of runner jobs
+ * 35 and 37 faulted on the page right after its source buffer ("Page
+ * fault for 0xfff83000 (master 3, dir rd, L2 page table)": the buffer of
+ * 1376 x 1152 bytes, 387 pages, is the first allocation of the run and
+ * sits in the topmost 2 MiB IOVA slot, 0xffe00000-0xfff83000), the only
+ * size so far whose macroblock aligned NV12 picture fills its last page to
+ * the byte. 1280x720 has 16 lines of chroma (20 KiB) to spare in its last
+ * page and 1920x1080 has 8 (15 KiB), and neither faulted, so the read past
+ * the end is shorter than that. How far it goes is not documented: the
+ * buffer gets one more macroblock row of luma (16 lines) on top, which
+ * also covers a read rounded up to a 64 byte burst on the last line (1366
+ * is the only width tested that is not a multiple of 64).
  */
+#define CEDRUS_ENC_RAW_TAIL_LINES		16
+
 static void cedrus_enc_prepare_raw_format(struct v4l2_pix_format *pix_fmt)
 {
 	unsigned int width = pix_fmt->width;
@@ -270,7 +289,8 @@
 	pix_fmt->width = width;
 	pix_fmt->height = height;
 	pix_fmt->bytesperline = bytesperline;
-	pix_fmt->sizeimage = bytesperline * ALIGN(height, 16) * 3 / 2;
+	pix_fmt->sizeimage = bytesperline * (ALIGN(height, 16) * 3 / 2 +
+					     CEDRUS_ENC_RAW_TAIL_LINES);
 	pix_fmt->field = V4L2_FIELD_NONE;
 }
 
@@ -614,6 +634,94 @@
 	return vb2_queue_init(dst_vq);
 }
 
+/* Buffer layout of the last job: debugfs and the timeout report */
+
+void cedrus_enc_layout_reset(struct cedrus_ctx *ctx)
+{
+	struct cedrus_enc_layout *layout = &ctx->dev->enc_layout;
+	unsigned long flags;
+
+	spin_lock_irqsave(&layout->lock, flags);
+	layout->width = ctx->src_fmt.width;
+	layout->height = ctx->src_fmt.height;
+	layout->bytesperline = ctx->src_fmt.bytesperline;
+	layout->sizeimage = ctx->src_fmt.sizeimage;
+	layout->count = 0;
+	spin_unlock_irqrestore(&layout->lock, flags);
+}
+
+void cedrus_enc_layout_add(struct cedrus_ctx *ctx, const char *name,
+			   dma_addr_t dma, size_t size)
+{
+	struct cedrus_enc_layout *layout = &ctx->dev->enc_layout;
+	struct cedrus_enc_layout_entry *entry;
+	unsigned long flags;
+
+	spin_lock_irqsave(&layout->lock, flags);
+	if (layout->count < CEDRUS_ENC_LAYOUT_MAX) {
+		entry = &layout->entry[layout->count++];
+		entry->name = name;
+		entry->dma = dma;
+		entry->size = size;
+	}
+	spin_unlock_irqrestore(&layout->lock, flags);
+}
+
+void cedrus_enc_report_layout(struct cedrus_dev *dev)
+{
+	struct cedrus_enc_layout *layout = &dev->enc_layout;
+	struct cedrus_enc_layout copy;
+	unsigned long flags;
+	unsigned int i;
+
+	spin_lock_irqsave(&layout->lock, flags);
+	copy = *layout;
+	spin_unlock_irqrestore(&layout->lock, flags);
+
+	dev_err(dev->dev, "encoder buffers: %ux%u stride %u size %u\n",
+		copy.width, copy.height, copy.bytesperline, copy.sizeimage);
+	for (i = 0; i < copy.count; i++)
+		dev_err(dev->dev, "  %-10s %pad + 0x%zx\n", copy.entry[i].name,
+			&copy.entry[i].dma, copy.entry[i].size);
+}
+
+static int cedrus_enc_buffers_show(struct seq_file *s, void *data)
+{
+	struct cedrus_dev *dev = s->private;
+	struct cedrus_enc_layout *layout = &dev->enc_layout;
+	struct cedrus_enc_layout copy;
+	unsigned long flags;
+	unsigned int i;
+
+	spin_lock_irqsave(&layout->lock, flags);
+	copy = *layout;
+	spin_unlock_irqrestore(&layout->lock, flags);
+
+	seq_printf(s, "format %ux%u stride %u size %u\n", copy.width,
+		   copy.height, copy.bytesperline, copy.sizeimage);
+	for (i = 0; i < copy.count; i++)
+		seq_printf(s, "%-10s 0x%08llx 0x%08llx 0x%zx\n",
+			   copy.entry[i].name, (u64)copy.entry[i].dma,
+			   (u64)copy.entry[i].dma + copy.entry[i].size,
+			   copy.entry[i].size);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(cedrus_enc_buffers);
+
+void cedrus_enc_debugfs_init(struct cedrus_dev *dev)
+{
+	dev->debugfs = debugfs_create_dir(CEDRUS_NAME, NULL);
+	debugfs_create_file("encoder-buffers", 0444, dev->debugfs, dev,
+			    &cedrus_enc_buffers_fops);
+}
+
+void cedrus_enc_debugfs_exit(struct cedrus_dev *dev)
+{
+	debugfs_remove_recursive(dev->debugfs);
+	dev->debugfs = NULL;
+}
+
 /* Job */
 
 void cedrus_enc_device_run(struct cedrus_ctx *ctx)
--- a/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc_h264.c
@@ -413,15 +413,13 @@
 
 	/*
 	 * Macroblock information buffer (0xbc0). The V3s register map gives
-	 * it 4 KiB per 32 macroblock columns, but the H616 engine reads past
-	 * that: job 35's first 1366x768 picture (86 by 48 macroblocks: 12 KiB
-	 * in a 16 KiB IOVA range) faulted on the first page after it ("Page
-	 * fault for 0xfff83000 ... L2 page table", the end of the only buffer
-	 * of the picture that fits there), 1280x720 (also 12 KiB, fewer rows)
-	 * did not, and at 1920x1080 (16 KiB, no unmapped tail) a read past
-	 * the end lands in the next mapping. How far it reads is not
-	 * documented: give it a picture's size, as the T527 driver (the one
-	 * encoder of this family behind an IOMMU) does.
+	 * it 4 KiB per 32 macroblock columns, and on the H616 the engine
+	 * writes just under 32 bytes per macroblock column into it (Hardened
+	 * BliKVM lab). How far it reads is not documented, so it gets a
+	 * picture's size, as in the T527 driver (the one encoder of this
+	 * family behind an IOMMU). (The 1366x768 fault of job 35 that this
+	 * was first blamed on was the source buffer: job 37 faulted at the
+	 * same address with this size, see cedrus_enc_prepare_raw_format().)
 	 */
 	h264_ctx->mb_info_size =
 		ALIGN(ALIGN(h264_ctx->width_mbs * 16, 32) *
@@ -551,6 +549,42 @@
 	cedrus_write(dev, VE_ISP_INPUT_CHROMA1_ADDR, chroma + luma_size / 4);
 }
 
+/* The buffers of this job, for debugfs and the timeout report. */
+static void cedrus_enc_h264_record_layout(struct cedrus_ctx *ctx,
+					  struct cedrus_run *run,
+					  struct cedrus_enc_h264_rec *rec,
+					  struct cedrus_enc_h264_rec *ref_rec)
+{
+	struct cedrus_enc_h264_ctx *h264_ctx = &ctx->codec.enc_h264;
+	struct cedrus_enc_h264_aux *aux = &h264_ctx->aux;
+	struct vb2_buffer *src_buf = &run->src->vb2_buf;
+	struct vb2_buffer *dst_buf = &run->dst->vb2_buf;
+
+	cedrus_enc_layout_reset(ctx);
+	cedrus_enc_layout_add(ctx, "source",
+			      vb2_dma_contig_plane_dma_addr(src_buf, 0),
+			      vb2_plane_size(src_buf, 0));
+	cedrus_enc_layout_add(ctx, "coded",
+			      vb2_dma_contig_plane_dma_addr(dst_buf, 0),
+			      vb2_plane_size(dst_buf, 0));
+	cedrus_enc_layout_add(ctx, "mb-info", h264_ctx->mb_info_dma,
+			      h264_ctx->mb_info_size);
+	cedrus_enc_layout_add(ctx, "mv", aux->dma + aux->mv_offset,
+			      aux->rc_offset - aux->mv_offset);
+	cedrus_enc_layout_add(ctx, "rc", aux->dma + aux->rc_offset,
+			      aux->line_offset - aux->rc_offset);
+	cedrus_enc_layout_add(ctx, "line", aux->dma + aux->line_offset,
+			      aux->tfcnt_offset - aux->line_offset);
+	cedrus_enc_layout_add(ctx, "tfcnt", aux->dma + aux->tfcnt_offset,
+			      aux->size - aux->tfcnt_offset);
+	cedrus_enc_layout_add(ctx, "rec", rec->rec_dma, rec->rec_size);
+	cedrus_enc_layout_add(ctx, "rec-subpix", rec->subpix_dma,
+			      rec->subpix_size);
+	cedrus_enc_layout_add(ctx, "ref", ref_rec->rec_dma, ref_rec->rec_size);
+	cedrus_enc_layout_add(ctx, "ref-subpix", ref_rec->subpix_dma,
+			      ref_rec->subpix_size);
+}
+
 static int cedrus_enc_h264_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
 {
 	struct cedrus_dev *dev = ctx->dev;
@@ -701,6 +735,8 @@
 		     cedrus_enc_addr(ctx, aux->dma + aux->tfcnt_offset));
 	cedrus_write(dev, VE_ENC_AVC_CYCLIC_INTRA_REFRESH, 0);
 
+	cedrus_enc_h264_record_layout(ctx, run, rec, ref_rec);
+
 	/* Quantisation and motion estimation. */
 
 	value = VE_ENC_AVC_PARA1_RC_MODE_FIXED |
