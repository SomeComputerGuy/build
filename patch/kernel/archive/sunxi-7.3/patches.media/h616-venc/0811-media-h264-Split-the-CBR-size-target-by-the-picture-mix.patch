From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Mon, 9 Nov 2026 23:00:00 +0000
Subject: [PATCH] media: h264: Split the CBR size target by the picture mix

The CBR rate control gives an intra picture six times the average size
target and an inter picture 80% of it, which averages the target for one
intra picture in 25. With a shorter intra period the stream overshoots:
by about 15% with one intra picture in 10, by 70% and more when every
picture is intra (a model encoder whose size halves every 6 QP).

Split the average target instead so that the pictures of the size window
average it: an intra picture gets as many times an inter picture's size
as it costs more at one QP, measured on the last pictures of each type
(their sizes brought to QP 26 by 2^(dQP/6); 6 until both types are
known), weighted by the share of intra pictures in the size window (1 in
25 until there is a window). The same model stays within 5% of the
target at intra periods 1, 10 and 30 from 256 kbit/s to 20 Mbit/s (where
QP 51 can reach the target).

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
--- a/drivers/media/v4l2-core/v4l2-h264-enc-rc.c
+++ b/drivers/media/v4l2-core/v4l2-h264-enc-rc.c
@@ -5,6 +5,8 @@
  * Copyright (C) 2025-2026 Paul Kocialkowski <paulk@sys-base.io>
  */
 
+#include <linux/math64.h>
+#include <linux/minmax.h>
 #include <linux/module.h>
 #include <media/v4l2-h264-enc.h>
 
@@ -158,10 +160,92 @@
 	.estimate	= cq_estimate,
 };
 
-static int cbr_measure(struct v4l2_h264_enc_rc *rc, unsigned long *size)
+/* 1000 * 2^(k / 6): the size factor of k QP steps. */
+static const unsigned int qp_step_scale[6] = {
+	1000, 1122, 1260, 1414, 1587, 1782
+};
+
+/* A picture's size at QP 26, from its size at another QP. */
+static unsigned long long rc_size_qp26(unsigned long size, unsigned int qp)
+{
+	unsigned long long value = size;
+	int diff = (int)qp - 26;
+
+	if (diff >= 0) {
+		value <<= diff / 6;
+		value = div_u64(value * qp_step_scale[diff % 6], 1000);
+	} else {
+		value >>= -diff / 6;
+		value = div_u64(value * 1000, qp_step_scale[-diff % 6]);
+	}
+
+	return value;
+}
+
+static unsigned long long
+rc_type_size_qp26(const struct v4l2_h264_enc_rc_stats_type *type)
+{
+	unsigned long long total = 0;
+	unsigned int i;
+
+	for (i = 0; i < type->count; i++)
+		total += rc_size_qp26(type->size[i], type->qp[i]);
+
+	return type->count ? div_u64(total, type->count) : 0;
+}
+
+/*
+ * Split an average size target between intra and inter pictures so that
+ * the pictures of the size window still average the target: an intra
+ * picture gets as many times an inter picture's size as it costs more at
+ * one QP (from the last pictures of each type, 6 until both are known),
+ * weighted by the share of intra pictures in the window (1 in 25 until
+ * there is a window). A fixed split for 1 intra picture in 25 overshoots
+ * the bitrate with shorter intra periods: by 15% at 10, by 70% and more
+ * when every picture is intra.
+ */
+static unsigned long rc_split_target(struct v4l2_h264_enc_rc *rc,
+				     unsigned long target)
 {
 	struct v4l2_h264_enc_state *state = rc->state;
 	struct v4l2_ctrl_h264_encode_params *encode = &state->encode;
+	struct v4l2_h264_enc_rc_stats *stats = &rc->stats;
+	unsigned long long intra_size, pred_size, divisor, pred_target;
+	unsigned int intra_share = 40;	/* per mille */
+	unsigned int ratio = 6000;	/* per mille */
+	unsigned int intra_count = 0;
+	unsigned int i;
+
+	if (stats->count) {
+		for (i = 0; i < stats->count; i++)
+			if (stats->slice_type[i] == V4L2_H264_SLICE_TYPE_I)
+				intra_count++;
+
+		intra_share = 1000 * intra_count / stats->count;
+	}
+
+	intra_size = rc_type_size_qp26(&stats->intra);
+	pred_size = rc_type_size_qp26(&stats->pred);
+	if (intra_size && pred_size)
+		ratio = clamp_t(u64, div64_u64(1000 * intra_size, pred_size),
+				1500, 20000);
+
+	/* Inter picture target: target / (share * ratio + 1 - share). */
+	divisor = (u64)intra_share * ratio + (1000 - intra_share) * 1000ULL;
+	pred_target = div64_u64((u64)target * 1000000, divisor);
+
+	pr_debug("  intra share: %u pm, intra/inter ratio: %u pm", intra_share,
+		 ratio);
+
+	if (encode->slice_type == V4L2_H264_SLICE_TYPE_I)
+		return div_u64(pred_target * ratio, 1000);
+
+	return pred_target;
+}
+
+static int cbr_measure(struct v4l2_h264_enc_rc *rc, unsigned long *size)
+{
+	struct v4l2_h264_enc_state *state = rc->state;
 	struct v4l2_fract *timeperframe = &state->timeperframe;
 	struct v4l2_h264_enc_rc_stats *stats = &rc->stats;
 	unsigned long long budget;
@@ -192,14 +276,7 @@
 	pr_debug("  nominal target: %lu bytes", target_nominal);
 	pr_debug("  uniform target: %lu bytes", target);
 
-	/* Bump size for intra frames and reduce for pred frames.
-	 * We are better off with good quality initial references.
-	 * Maintain average assuming 1 intra frame for 24 inter frames.
-	 */
-	if (encode->slice_type == V4L2_H264_SLICE_TYPE_I)
-		target = target * 6;
-	else
-		target = target * 80 / 100;
+	target = rc_split_target(rc, target);
 
 	/* Reduce target size on bitrate overshoot to calm things down. */
 	if (9 * stats->size_total > 10 * stats->count * target_nominal) {
