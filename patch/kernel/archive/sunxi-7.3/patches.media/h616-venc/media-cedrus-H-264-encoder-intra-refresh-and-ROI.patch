+/*
+ * Cyclic intra refresh: each P picture codes the next group of macroblock
+ * columns intra; an I picture restarts the cycle. Groups as in the vendor
+ * library: the width split into the period, the first ones a column wider.
+ */
+static u32 cedrus_enc_h264_intra_refresh(struct cedrus_ctx *ctx,
+					 const struct v4l2_ctrl_h264_encode_params *encode)
+{
+	struct cedrus_enc_h264_ctx *h264_ctx = &ctx->codec.enc_h264;
+	unsigned int width_mbs = h264_ctx->width_mbs;
+	unsigned int height_mbs = h264_ctx->height_mbs;
+	unsigned int period, mbs, columns, groups, pos, start, end;
+
+	period = *(s32 *)cedrus_find_control_data(ctx,
+			V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD);
+	mbs = *(s32 *)cedrus_find_control_data(ctx,
+			V4L2_CID_MPEG_VIDEO_CYCLIC_INTRA_REFRESH_MB);
+
+	if (encode->slice_type != V4L2_H264_SLICE_TYPE_P || (!period && !mbs)) {
+		h264_ctx->intra_refresh_pos = 0;
+		return 0;
+	}
+
+	if (period) {
+		groups = min(period, width_mbs);
+		pos = h264_ctx->intra_refresh_pos % groups;
+		columns = width_mbs / groups;
+		start = columns * pos + min(pos, width_mbs % groups);
+		end = start + columns + (pos < width_mbs % groups) - 1;
+	} else {
+		columns = clamp(DIV_ROUND_UP(mbs, height_mbs), 1U, width_mbs);
+		groups = DIV_ROUND_UP(width_mbs, columns);
+		pos = h264_ctx->intra_refresh_pos % groups;
+		start = columns * pos;
+		end = min(start + columns, width_mbs) - 1;
+	}
+
+	h264_ctx->intra_refresh_pos = (pos + 1) % groups;
+
+	return VE_ENC_AVC_CYCLIC_INTRA_REFRESH_EN |
+	       VE_ENC_AVC_CYCLIC_INTRA_REFRESH_COL_START_MB(start) |
+	       VE_ENC_AVC_CYCLIC_INTRA_REFRESH_COL_END_MB(end);
+}
+
+/*
+ * Regions of interest from the delta QP map: the areas and their offsets,
+ * with each region's QP kept within 0..51. Returns the number of areas; a
+ * map that does not fit the picture (set before a format change) is not
+ * applied.
+ */
+static unsigned int cedrus_enc_h264_setup_roi(struct cedrus_ctx *ctx,
+					      unsigned int qp)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	struct cedrus_enc_h264_ctx *h264_ctx = &ctx->codec.enc_h264;
+	struct cedrus_enc_roi_area areas[CEDRUS_ENC_ROI_AREAS] = {};
+	u32 offsets = 0;
+	u32 id = V4L2_CID_MPEG_VIDEO_ROI_MB_DELTA_QP;
+	int count, delta_qp, i;
+
+	count = cedrus_enc_roi_areas(cedrus_find_control_data(ctx, id),
+				     cedrus_get_num_of_controls(ctx, id),
+				     h264_ctx->width_mbs, h264_ctx->height_mbs,
+				     areas);
+	if (count < 0)
+		count = 0;
+
+	for (i = 0; i < CEDRUS_ENC_ROI_AREAS; i++) {
+		delta_qp = 0;
+		if (i < count)
+			delta_qp = clamp_t(int, qp + areas[i].delta_qp, 0, 51) - qp;
+
+		offsets |= VE_ENC_AVC_ROI_QP_OFFSET_N(i, delta_qp);
+		cedrus_write(dev, VE_ENC_AVC_ROI_AREA(i),
+			     VE_ENC_AVC_ROI_AREA_LEFT_MB(areas[i].left) |
+			     VE_ENC_AVC_ROI_AREA_RIGHT_MB(areas[i].right) |
+			     VE_ENC_AVC_ROI_AREA_TOP_MB(areas[i].top) |
+			     VE_ENC_AVC_ROI_AREA_BOTTOM_MB(areas[i].bottom));
+	}
+
+	cedrus_write(dev, VE_ENC_AVC_ROI_QP_OFFSET, offsets);
+
+	return count;
+}
+
