+			.min	= V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD_TYPE_CYCLIC,
+			.max	= V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD_TYPE_CYCLIC,
+			.def	= V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD_TYPE_CYCLIC,
+		},
+		.capabilities	= CEDRUS_CAPABILITY_H264_ENC,
+	},
+	{
+		.cfg = {
+			.id	= V4L2_CID_MPEG_VIDEO_INTRA_REFRESH_PERIOD,
+			.min	= 0,
+			.max	= 256,
+			.step	= 1,
+			.def	= 0,
+		},
+		.capabilities	= CEDRUS_CAPABILITY_H264_ENC,
+	},
+	{
+		.cfg = {
+			.id	= V4L2_CID_MPEG_VIDEO_CYCLIC_INTRA_REFRESH_MB,
+			.min	= 0,
+			.max	= CEDRUS_ENC_MBS_MAX,
+			.step	= 1,
+			.def	= 0,
+		},
+		.capabilities	= CEDRUS_CAPABILITY_H264_ENC,
+	},
+	/* Regions of interest: a delta QP per macroblock, in four areas. */
+	{
+		.cfg = {
+			.id	= V4L2_CID_MPEG_VIDEO_ROI_MB_SIZE,
+			.min	= CEDRUS_ENC_ROI_MB_SIZE,
+			.max	= CEDRUS_ENC_ROI_MB_SIZE,
+			.step	= 1,
+			.def	= CEDRUS_ENC_ROI_MB_SIZE,
+		},
+		.capabilities	= CEDRUS_CAPABILITY_H264_ENC,
+	},
+	{
+		.cfg = {
+			.id	= V4L2_CID_MPEG_VIDEO_ROI_MB_DELTA_QP,
+			.ops	= &cedrus_enc_roi_ctrl_ops,
+			/* The 6-bit offsets of the encoder. */
+			.min	= -32,
+			.max	= 31,
+			.step	= 1,
+			.def	= 0,
+			.dims	= { CEDRUS_ENC_MBS_MAX },
+		},
+		.capabilities	= CEDRUS_CAPABILITY_H264_ENC,
+	},
 };
 
 const unsigned int cedrus_enc_controls_count = ARRAY_SIZE(cedrus_enc_controls);
