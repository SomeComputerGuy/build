@@ -702,7 +788,8 @@ static int cedrus_enc_h264_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
 		     cedrus_enc_addr(ctx, aux->dma + aux->line_offset));
 	cedrus_write(dev, VE_ENC_AVC_TFCNT_ADDR,
