+
 	if (dev->enc_flags & CEDRUS_ENC_FLAG_H6_PARAMS) {
 		value |= VE_ENC_AVC_PARA1_DYNAMIC_ME_EN |
-			 VE_ENC_AVC_PARA1_H6_UNKNOWN27;
+			 VE_ENC_AVC_PARA1_TRANSFORM_8X8_DIS;
 
 		/* The vendor library's thresholds, from the stride. */
 		cedrus_write(dev, VE_ENC_AVC_DYNAMIC_ME_PAR0,
@@ -724,7 +814,7 @@ static int cedrus_enc_h264_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
 			     VE_ENC_AVC_DYNAMIC_ME_PAR1_TH3(32 * stride_mbs / 10) |
 			     VE_ENC_AVC_DYNAMIC_ME_PAR1_TH2(26 * stride_mbs / 10));
 
-		cedrus_write(dev, VE_ENC_AVC_ME_PARA,
+		cedrus_write(dev, VE_ENC_AVC_ME_PARA, me_para |
 			     VE_ENC_AVC_ME_PARA_WB_MV_INFO_DIS |
 			     VE_ENC_AVC_ME_PARA_QUANT_THRESHOLD_DIS);
 	} else {
@@ -733,7 +823,7 @@ static int cedrus_enc_h264_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
 		cedrus_write(dev, VE_ENC_AVC_DYNAMIC_ME_PAR0, 0);
 		cedrus_write(dev, VE_ENC_AVC_DYNAMIC_ME_PAR1, 0);
 
-		cedrus_write(dev, VE_ENC_AVC_ME_PARA,
+		cedrus_write(dev, VE_ENC_AVC_ME_PARA, me_para |
 			     VE_ENC_AVC_ME_PARA_WB_MV_INFO_DIS |
 			     VE_ENC_AVC_ME_PARA_FME_SEARCH_LEVEL(2));
 	}
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_regs.h b/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
--- a/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
@@ -1355,8 +1355,11 @@
 #define VE_ENC_AVC_PARA1			(VE_ENGINE_ENC_AVC + 0x08)
 #define VE_ENC_AVC_PARA1_MODE_OPTIMIZE_EN	BIT(31)
 #define VE_ENC_AVC_PARA1_MODE_OPTIMIZE_PAR(v)	SHIFT_AND_MASK_BITS(v, 30, 28)
-/* Set by the vendor library on the 0x12011 encoders, meaning unknown. */
-#define VE_ENC_AVC_PARA1_H6_UNKNOWN27		BIT(27)
+/*
+ * The vendor library's "8x8 transform off", set on the 0x12011 encoders.
+ * These code 4x4 transforms only, with it set or clear.
+ */
+#define VE_ENC_AVC_PARA1_TRANSFORM_8X8_DIS	BIT(27)
 #define VE_ENC_AVC_PARA1_CLIP_MV_EN		BIT(26)
 #define VE_ENC_AVC_PARA1_CLIP_MV_PAR(v)		SHIFT_AND_MASK_BITS(v, 25, 24)
 #define VE_ENC_AVC_PARA1_TEMP_FILTER_HIS_OUT_DIS	BIT(19)
@@ -1471,8 +1474,17 @@
 #define VE_ENC_AVC_DEBLK_ADDR			(VE_ENGINE_ENC_AVC + 0xc4)
 #define VE_ENC_AVC_TFCNT_ADDR			(VE_ENGINE_ENC_AVC + 0xc8)
 
+/*
+ * Four regions of interest: a 6-bit QP offset per region (byte n) and an
+ * area per region, in macroblocks, the right and bottom ones included.
+ */
 #define VE_ENC_AVC_ROI_QP_OFFSET		(VE_ENGINE_ENC_AVC + 0xcc)
+#define VE_ENC_AVC_ROI_QP_OFFSET_N(n, v)	(((v) & 0x3f) << (8 * (n)))
 #define VE_ENC_AVC_ROI_AREA(n)			(VE_ENGINE_ENC_AVC + 0xd0 + 4 * (n))
+#define VE_ENC_AVC_ROI_AREA_BOTTOM_MB(v)	SHIFT_AND_MASK_BITS(v, 31, 24)
+#define VE_ENC_AVC_ROI_AREA_TOP_MB(v)		SHIFT_AND_MASK_BITS(v, 23, 16)
+#define VE_ENC_AVC_ROI_AREA_RIGHT_MB(v)		SHIFT_AND_MASK_BITS(v, 15, 8)
+#define VE_ENC_AVC_ROI_AREA_LEFT_MB(v)		SHIFT_AND_MASK_BITS(v, 7, 0)
 
 /*
  * Internal memory port of the block: an auto-incrementing index and the
