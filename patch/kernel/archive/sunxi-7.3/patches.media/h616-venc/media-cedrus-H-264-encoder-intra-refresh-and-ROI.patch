+		     cedrus_enc_h264_intra_refresh(ctx, encode));
 
 	cedrus_enc_h264_record_layout(ctx, run, rec, ref_rec);
 
@@ -712,9 +799,12 @@ static int cedrus_enc_h264_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
 		VE_ENC_AVC_PARA1_FIXED_QP(enc->rc.qp) |
 		VE_ENC_AVC_PARA1_STRIDE_MBS_DIV_48(DIV_ROUND_UP(stride_mbs, 48));
 
+	me_para = cedrus_enc_h264_setup_roi(ctx, enc->rc.qp) ?
