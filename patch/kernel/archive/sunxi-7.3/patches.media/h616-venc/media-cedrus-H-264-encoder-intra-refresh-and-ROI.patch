From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 13 Nov 2026 17:24:08 +0000
Subject: media: cedrus: H.264 encoder intra refresh and ROI

Cyclic intra refresh of macroblock columns (0xb28), from
INTRA_REFRESH_PERIOD or CYCLIC_INTRA_REFRESH_MB.

Regions of interest from the ROI_MB_DELTA_QP map. The engine has four
areas, each with a 6-bit QP offset (0xbcc-0xbdc); a map that needs more
is rejected.

PARA1 bit 27 is the vendor library's "8x8 transform off". The H616
engine codes the same 4x4-only slice data with it clear, so the 8x8
transform stays off.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc.c b/drivers/staging/media/sunxi/cedrus/cedrus_enc.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus_enc.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc.c
@@ -47,6 +47,105 @@ static const struct v4l2_frmsize_stepwise cedrus_enc_frmsize = {
 
 /* Controls */
 
+static bool cedrus_enc_roi_in_areas(const struct cedrus_enc_roi_area *areas,
+				    unsigned int count, unsigned int x,
+				    unsigned int y)
+{
+	unsigned int i;
+
+	for (i = 0; i < count; i++)
+		if (x >= areas[i].left && x <= areas[i].right &&
+		    y >= areas[i].top && y <= areas[i].bottom)
+			return true;
+
+	return false;
+}
+
+static bool cedrus_enc_roi_row_takes(const s8 *row, unsigned int left,
+				     unsigned int right, s8 delta_qp)
+{
+	unsigned int x;
+
+	for (x = left; x <= right; x++)
+		if (row[x] != delta_qp)
+			return false;
+
+	return true;
+}
+
+/*
+ * Cover the non-zero entries of a ROI delta QP map, one per macroblock in
+ * raster order, with rectangles of one delta QP each: the encoder has four.
+ * Returns how many, or -EINVAL for a map that needs more or does not match
+ * the picture. A map of zeros, of any size, has none.
+ */
+int cedrus_enc_roi_areas(const s8 *map, unsigned int count,
+			 unsigned int width_mbs, unsigned int height_mbs,
+			 struct cedrus_enc_roi_area *areas)
+{
+	unsigned int n = 0, x, y, right, bottom;
+	s8 delta_qp;
+
+	if (!memchr_inv(map, 0, count))
+		return 0;
+
+	if (count != width_mbs * height_mbs)
+		return -EINVAL;
+
+	for (y = 0; y < height_mbs; y++) {
+		for (x = 0; x < width_mbs; x++) {
+			delta_qp = map[y * width_mbs + x];
+			if (!delta_qp || cedrus_enc_roi_in_areas(areas, n, x, y))
+				continue;
+
+			if (n == CEDRUS_ENC_ROI_AREAS)
+				return -EINVAL;
+
+			right = x;
+			while (right + 1 < width_mbs &&
+			       map[y * width_mbs + right + 1] == delta_qp &&
+			       !cedrus_enc_roi_in_areas(areas, n, right + 1, y))
+				right++;
+
+			bottom = y;
+			while (bottom + 1 < height_mbs &&
+			       cedrus_enc_roi_row_takes(&map[(bottom + 1) * width_mbs],
+							x, right, delta_qp))
+				bottom++;
+
+			areas[n].left = x;
+			areas[n].right = right;
+			areas[n].top = y;
+			areas[n].bottom = bottom;
+			areas[n].delta_qp = delta_qp;
+			n++;
+		}
+	}
+
+	return n;
+}
+
+static int cedrus_enc_roi_try_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct cedrus_ctx *ctx = container_of(ctrl->handler, struct cedrus_ctx,
+					      hdl);
+	struct cedrus_enc_roi_area areas[CEDRUS_ENC_ROI_AREAS];
+	int ret;
+
+	ret = cedrus_enc_roi_areas(ctrl->p_new.p_s8, ctrl->new_elems,
+				   DIV_ROUND_UP(ctx->src_fmt.width,
+						CEDRUS_ENC_ROI_MB_SIZE),
+				   DIV_ROUND_UP(ctx->src_fmt.height,
+						CEDRUS_ENC_ROI_MB_SIZE),
+				   areas);
+
+	return ret < 0 ? ret : 0;
+}
+
+static const struct v4l2_ctrl_ops cedrus_enc_roi_ctrl_ops = {
+	.try_ctrl = cedrus_enc_roi_try_ctrl,
+};
+
 const struct cedrus_control cedrus_enc_controls[] = {
 	{
 		.cfg = {
@@ -250,6 +349,64 @@ const struct cedrus_control cedrus_enc_controls[] = {
 		},
 		.capabilities	= CEDRUS_CAPABILITY_H264_ENC,
 	},
+	/*
