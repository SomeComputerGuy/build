diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_avs.c b/drivers/staging/media/sunxi/cedrus/cedrus_avs.c
new file mode 100644
index 000000000..340f84eb8
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_avs.c
@@ -0,0 +1,446 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Cedrus VPU driver: AVS1 (GB/T 20090.2 JiZhun) and AVS+ (GY/T 257.1
+ * Guangdian) decoding
+ *
+ * The decoder runs in the H.264 engine slot of the video engine, like VP8,
+ * selected by a mode bit of the control register. Software parses the
+ * sequence and picture headers; the engine is started once per picture,
+ * parses the slice headers itself and decodes all the slices of the
+ * picture, of both fields for a field coded picture. It removes the
+ * pseudo start code bits from the slice data itself.
+ *
+ * The register sequence was recovered, for interoperability, from the
+ * debug information and the disassembly of the vendor libawavs.so
+ * (libcedarc); no vendor code is used.
+ */
+
+#include <linux/types.h>
+
+#include <media/videobuf2-dma-contig.h>
+
+#include "cedrus.h"
+#include "cedrus_hw.h"
+#include "cedrus_regs.h"
+
+/* Macroblock neighbour information, whatever the picture size. */
+#define CEDRUS_AVS_MB_INFO_BUF_SIZE	(48 * SZ_1K)
+#define CEDRUS_AVS_MB_INFO_BUF_ALIGN	SZ_16K
+/* Co-located motion vectors: 32 bytes per macroblock. */
+#define CEDRUS_AVS_MV_COL_MB_SIZE	32
+
+#define CEDRUS_AVS_GUANGDIAN_FLAGS \
+	(V4L2_AVS_PICTURE_FLAG_NO_FORWARD_REFERENCE | \
+	 V4L2_AVS_PICTURE_FLAG_PB_FIELD_ENHANCED | \
+	 V4L2_AVS_PICTURE_FLAG_WEIGHTING_QUANT | \
+	 V4L2_AVS_PICTURE_FLAG_AEC)
+
+static enum cedrus_irq_status cedrus_avs_irq_status(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	u32 reg = cedrus_read(dev, VE_H264_STATUS);
+
+	/*
+	 * The whole picture is in the buffer, so a request for more data
+	 * means that the picture is truncated or corrupted.
+	 */
+	if (reg & (VE_H264_STATUS_DECODE_ERR_INT |
+		   VE_H264_STATUS_VLD_DATA_REQ_INT)) {
+		dev_warn_ratelimited(dev->dev,
+				     "AVS decode error: status %#x, error case %#x, mb %u\n",
+				     reg, cedrus_read(dev, VE_H264_ERROR_CASE),
+				     cedrus_read(dev, VE_H264_CUR_MB_NUM) & 0xffff);
+		return CEDRUS_IRQ_ERROR;
+	}
+
+	if (reg & VE_H264_STATUS_SLICE_DECODE_INT) {
+		dev_dbg(dev->dev, "AVS picture done: status %#x, mb %u\n",
+			reg, cedrus_read(dev, VE_H264_CUR_MB_NUM) & 0xffff);
+		return CEDRUS_IRQ_OK;
+	}
+
+	return CEDRUS_IRQ_NONE;
+}
+
+static void cedrus_avs_irq_clear(struct cedrus_ctx *ctx)
+{
+	cedrus_write(ctx->dev, VE_H264_STATUS, VE_H264_STATUS_INT_MASK);
+}
+
+static void cedrus_avs_irq_disable(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	u32 reg = cedrus_read(dev, VE_H264_CTRL);
+
+	cedrus_write(dev, VE_H264_CTRL, reg & ~VE_H264_CTRL_INT_MASK);
+}
+
+static int cedrus_avs_mv_col_alloc(struct cedrus_ctx *ctx,
+				   struct cedrus_buffer *buf)
+{
+	unsigned int mb_width, mb_height;
+
+	if (buf->codec.avs.mv_col_buf_size)
+		return 0;
+
+	/* The vendor library rounds the macroblock counts as follows. */
+	mb_width = ((ctx->src_fmt.width + 63) >> 4) & ~3;
+	mb_height = ((ctx->src_fmt.height + 63) >> 4) & ~3;
+
+	buf->codec.avs.mv_col_buf_size =
+		mb_width * mb_height * CEDRUS_AVS_MV_COL_MB_SIZE;
+
+	/* Buffer is never accessed by CPU, so we can skip kernel mapping. */
+	buf->codec.avs.mv_col_buf =
+		dma_alloc_attrs(ctx->dev->dev, buf->codec.avs.mv_col_buf_size,
+				&buf->codec.avs.mv_col_buf_dma, GFP_KERNEL,
+				DMA_ATTR_NO_KERNEL_MAPPING);
+	if (!buf->codec.avs.mv_col_buf) {
+		buf->codec.avs.mv_col_buf_size = 0;
+		return -ENOMEM;
+	}
+
+	return 0;
+}
+
+static struct vb2_buffer *cedrus_avs_ref_buf(struct vb2_queue *vq,
+					     const struct v4l2_avs_ref_pic *ref)
+{
+	if (!(ref->flags & V4L2_AVS_REF_FLAG_VALID))
+		return NULL;
+
+	return vb2_find_buffer(vq, ref->timestamp);
+}
+
+static u8 cedrus_avs_ref_distance(const struct v4l2_avs_ref_pic *ref)
+{
+	return (ref->flags & V4L2_AVS_REF_FLAG_VALID) ?
+	       ref->picture_distance : 0;
+}
+
+static void cedrus_avs_write_ref(struct cedrus_ctx *ctx,
+				 struct vb2_buffer *buf, struct vb2_buffer *cur,
+				 u32 luma_reg, u32 chroma_reg)
+{
+	struct cedrus_dev *dev = ctx->dev;
+
+	/* A missing reference is replaced by the current picture. */
+	if (!buf)
+		buf = cur;
+
+	cedrus_write(dev, luma_reg, cedrus_dst_buf_addr(ctx, buf, 0));
+	cedrus_write(dev, chroma_reg, cedrus_dst_buf_addr(ctx, buf, 1));
+}
+
+static int cedrus_avs_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
+{
+	const struct v4l2_ctrl_avs_sequence *seq = run->avs.sequence;
+	const struct v4l2_ctrl_avs_picture *pic = run->avs.picture;
+	const struct v4l2_ctrl_avs_weight_quant *wq = run->avs.weight_quant;
+	const struct v4l2_avs_ref_pic *fwd, *bwd, *prev_fwd;
+	struct vb2_buffer *src_buf = &run->src->vb2_buf;
+	struct vb2_buffer *dst_buf = &run->dst->vb2_buf;
+	struct cedrus_dev *dev = ctx->dev;
+	struct cedrus_buffer *cedrus_buf;
+	struct vb2_buffer *fwd_buf, *bwd_buf;
+	struct vb2_queue *vq;
+	dma_addr_t src_addr, mv_col_addr;
+	size_t payload, plane_size;
+	u32 reg, ctrl;
+	int ret;
+
+	if (!seq || !pic)
+		return -EINVAL;
+
+	payload = vb2_get_plane_payload(src_buf, 0);
+	plane_size = vb2_plane_size(src_buf, 0);
+	if (pic->data_offset >= payload)
+		return -EINVAL;
+
+	if (seq->horizontal_size > ctx->src_fmt.width ||
+	    seq->vertical_size > ctx->src_fmt.height)
+		return -EINVAL;
+
+	if (seq->profile_id == V4L2_AVS_PROFILE_JIZHUN &&
+	    (pic->flags & CEDRUS_AVS_GUANGDIAN_FLAGS))
+		return -EINVAL;
+
+	if ((pic->flags & V4L2_AVS_PICTURE_FLAG_WEIGHTING_QUANT) && !wq)
+		return -EINVAL;
+
+	cedrus_buf = vb2_to_cedrus_buffer(dst_buf);
+	ret = cedrus_avs_mv_col_alloc(ctx, cedrus_buf);
+	if (ret)
+		return ret;
+
+	vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx, V4L2_BUF_TYPE_VIDEO_CAPTURE);
+
+	/*
+	 * A P picture has two forward references; the engine takes the
+	 * second one where a B picture has its backward reference.
+	 */
+	fwd = &pic->refs[V4L2_AVS_REF_FORWARD];
+	prev_fwd = &pic->refs[V4L2_AVS_REF_SECOND_FORWARD];
+	if (pic->picture_type == V4L2_AVS_PICTURE_TYPE_B)
+		bwd = &pic->refs[V4L2_AVS_REF_BACKWARD];
+	else
+		bwd = prev_fwd;
+
+	fwd_buf = cedrus_avs_ref_buf(vq, fwd);
+	/* The vendor library gives an I picture itself as second reference. */
+	bwd_buf = pic->picture_type == V4L2_AVS_PICTURE_TYPE_I ? NULL :
+		  cedrus_avs_ref_buf(vq, bwd);
+
+	/*
+	 * I and P pictures write their co-located motion vectors, which the
+	 * B pictures that follow read from their backward reference.
+	 */
+	mv_col_addr = cedrus_buf->codec.avs.mv_col_buf_dma;
+	if (pic->picture_type == V4L2_AVS_PICTURE_TYPE_B && bwd_buf) {
+		struct cedrus_buffer *bwd_cbuf = vb2_to_cedrus_buffer(bwd_buf);
+
+		if (bwd_cbuf->codec.avs.mv_col_buf_size)
+			mv_col_addr = bwd_cbuf->codec.avs.mv_col_buf_dma;
+	}
+
+	/* Activate the H.264 engine, which also decodes AVS. */
+	cedrus_engine_enable(ctx);
+
+	src_addr = vb2_dma_contig_plane_dma_addr(src_buf, 0);
+
+	ctrl = VE_AVS_CTRL_IS_AVS | VE_H264_CTRL_INT_MASK;
+	cedrus_write(dev, VE_H264_CTRL, ctrl);
+
+	reg = VE_AVS_PIC_MB_SIZE_HEIGHT(seq->vertical_size) |
+	      VE_AVS_PIC_MB_SIZE_WIDTH(seq->horizontal_size);
+	cedrus_write(dev, VE_AVS_PIC_MB_SIZE, reg);
+
+	reg = VE_AVS_PIC_SIZE_HEIGHT(seq->vertical_size) |
+	      VE_AVS_PIC_SIZE_WIDTH(seq->horizontal_size);
+	cedrus_write(dev, VE_AVS_PIC_SIZE, reg);
+
+	/* Sequence header and the AVS+ tools of the picture. */
+	reg = VE_AVS_PIC_SET_PARAM_PROFILE(seq->profile_id) |
+	      VE_AVS_PIC_SET_PARAM_LEVEL(seq->level_id) |
+	      VE_AVS_PIC_SET_PARAM_CHROMA_FORMAT(seq->chroma_format) |
+	      VE_AVS_PIC_SET_PARAM_SAMPLE_PRECISION(seq->sample_precision);
+	if (pic->flags & V4L2_AVS_PICTURE_FLAG_NO_FORWARD_REFERENCE)
+		reg |= VE_AVS_PIC_SET_PARAM_NO_FORWARD_REF;
+	if (pic->flags & V4L2_AVS_PICTURE_FLAG_PB_FIELD_ENHANCED)
+		reg |= VE_AVS_PIC_SET_PARAM_PB_FIELD_ENHANCED;
+	if (pic->flags & V4L2_AVS_PICTURE_FLAG_AEC)
+		reg |= VE_AVS_PIC_SET_PARAM_AEC;
+	if (pic->flags & V4L2_AVS_PICTURE_FLAG_WEIGHTING_QUANT) {
+		reg |= VE_AVS_PIC_SET_PARAM_WEIGHTING_QUANT;
+		if (wq->flags &
+		    V4L2_AVS_WEIGHT_QUANT_FLAG_CHROMA_QUANT_PARAM_DISABLE)
+			reg |= VE_AVS_PIC_SET_PARAM_CHROMA_QUANT_DISABLE;
+	}
+	cedrus_write(dev, VE_AVS_PIC_SET_PARAM, reg);
+
+	/*
+	 * Weighting quantization: the engine derives the matrices from the
+	 * syntax elements. The deltas are those of the parameter set chosen
+	 * by the index, zero for the default parameters.
+	 */
+	if (pic->flags & V4L2_AVS_PICTURE_FLAG_WEIGHTING_QUANT) {
+		const s16 *delta = NULL;
+		u8 d[V4L2_AVS_WEIGHT_QUANT_NUM_PARAMS] = {};
+		unsigned int i;
+
+		if (wq->weighting_quant_param_index == 1)
+			delta = wq->weighting_quant_param_delta1;
+		else if (wq->weighting_quant_param_index == 2)
+			delta = wq->weighting_quant_param_delta2;
+
+		for (i = 0; delta && i < ARRAY_SIZE(d); i++)
+			d[i] = delta[i];
+
+		reg = VE_AVS_WEIGHT_QUANT1_DELTA1(d[1]) |
+		      VE_AVS_WEIGHT_QUANT1_DELTA0(d[0]) |
+		      VE_AVS_WEIGHT_QUANT1_MODEL(wq->weighting_quant_model) |
+		      VE_AVS_WEIGHT_QUANT1_PARAM_INDEX(wq->weighting_quant_param_index) |
+		      VE_AVS_WEIGHT_QUANT1_DELTA_CR(wq->chroma_quant_param_delta_cr) |
+		      VE_AVS_WEIGHT_QUANT1_DELTA_CB(wq->chroma_quant_param_delta_cb);
+		cedrus_write(dev, VE_AVS_WEIGHT_QUANT1, reg);
+
+		reg = VE_AVS_WEIGHT_QUANT2_DELTA5(d[5]) |
+		      VE_AVS_WEIGHT_QUANT2_DELTA4(d[4]) |
+		      VE_AVS_WEIGHT_QUANT2_DELTA3(d[3]) |
+		      VE_AVS_WEIGHT_QUANT2_DELTA2(d[2]);
+		cedrus_write(dev, VE_AVS_WEIGHT_QUANT2, reg);
+	} else {
+		cedrus_write(dev, VE_AVS_WEIGHT_QUANT1, 0);
+		cedrus_write(dev, VE_AVS_WEIGHT_QUANT2, 0);
+	}
+
+	/*
+	 * Picture distances as coded; the engine derives the temporal
+	 * distances. The fourth one is that of the second forward reference
+	 * of an I or P picture, and for a B picture that of the reference
+	 * before its forward reference.
+	 */
+	reg = VE_AVS_PIC_DIST_CUR(pic->picture_distance) |
+	      VE_AVS_PIC_DIST_FWD(cedrus_avs_ref_distance(fwd)) |
+	      VE_AVS_PIC_DIST_PREV_FWD(cedrus_avs_ref_distance(prev_fwd));
+	if (pic->picture_type == V4L2_AVS_PICTURE_TYPE_B)
+		reg |= VE_AVS_PIC_DIST_BWD(cedrus_avs_ref_distance(bwd));
+	cedrus_write(dev, VE_AVS_PIC_DIST, reg);
+
+	/* Picture header. */
+	reg = VE_AVS_PIC_PARAM_TYPE(pic->picture_type) |
+	      VE_AVS_PIC_PARAM_QP(pic->picture_qp) |
+	      VE_AVS_PIC_PARAM_ALPHA_C_OFFSET(pic->alpha_c_offset) |
+	      VE_AVS_PIC_PARAM_BETA_OFFSET(pic->beta_offset);
+	if (pic->flags & V4L2_AVS_PICTURE_FLAG_PICTURE_STRUCTURE)
+		reg |= VE_AVS_PIC_PARAM_FRAME;
+	if (pic->flags & V4L2_AVS_PICTURE_FLAG_PROGRESSIVE_FRAME)
+		reg |= VE_AVS_PIC_PARAM_PROGRESSIVE_FRAME;
+	if (pic->flags & V4L2_AVS_PICTURE_FLAG_TOP_FIELD_FIRST)
+		reg |= VE_AVS_PIC_PARAM_TOP_FIELD_FIRST;
+	if (pic->flags & V4L2_AVS_PICTURE_FLAG_PICTURE_REFERENCE)
+		reg |= VE_AVS_PIC_PARAM_PICTURE_REFERENCE;
+	if (pic->flags & V4L2_AVS_PICTURE_FLAG_ADVANCED_PRED_MODE_DISABLE)
+		reg |= VE_AVS_PIC_PARAM_ADVANCED_PRED_DISABLE;
+	if (pic->flags & V4L2_AVS_PICTURE_FLAG_SKIP_MODE)
+		reg |= VE_AVS_PIC_PARAM_SKIP_MODE;
+	if (pic->flags & V4L2_AVS_PICTURE_FLAG_FIXED_PICTURE_QP)
+		reg |= VE_AVS_PIC_PARAM_FIXED_QP;
+	if (pic->flags & V4L2_AVS_PICTURE_FLAG_LOOP_FILTER_DISABLE)
+		reg |= VE_AVS_PIC_PARAM_LOOP_FILTER_DISABLE;
+
+	/* Coding of the references; the vendor library leaves it 0 for I. */
+	if (pic->picture_type != V4L2_AVS_PICTURE_TYPE_I) {
+		if (fwd->flags & V4L2_AVS_REF_FLAG_PICTURE_STRUCTURE)
+			reg |= VE_AVS_PIC_PARAM_FWD_FRAME;
+		if (fwd->flags & V4L2_AVS_REF_FLAG_TOP_FIELD_FIRST)
+			reg |= VE_AVS_PIC_PARAM_FWD_TOP_FIELD_FIRST;
+		if (fwd->flags & V4L2_AVS_REF_FLAG_INTRA)
+			reg |= VE_AVS_PIC_PARAM_FWD_INTRA;
+		if (bwd->flags & V4L2_AVS_REF_FLAG_PICTURE_STRUCTURE)
+			reg |= VE_AVS_PIC_PARAM_BWD_FRAME;
+		if (bwd->flags & V4L2_AVS_REF_FLAG_TOP_FIELD_FIRST)
+			reg |= VE_AVS_PIC_PARAM_BWD_TOP_FIELD_FIRST;
+		if (bwd->flags & V4L2_AVS_REF_FLAG_INTRA)
+			reg |= VE_AVS_PIC_PARAM_BWD_INTRA;
+	}
+	cedrus_write(dev, VE_AVS_PIC_PARAM, reg);
+
+	ctrl |= VE_AVS_CTRL_MCRI_CACHE_EN;
+	cedrus_write(dev, VE_H264_CTRL, ctrl);
+
+	cedrus_write(dev, VE_AVS_MV_COL_ADDR, mv_col_addr);
+	cedrus_write(dev, VE_AVS_MB_INFO_ADDR, ctx->codec.avs.mb_info_buf_addr);
+
+	/* Reconstruction and references. */
+	cedrus_write(dev, VE_AVS_REC_LUMA, cedrus_dst_buf_addr(ctx, dst_buf, 0));
+	cedrus_write(dev, VE_AVS_REC_CHROMA,
+		     cedrus_dst_buf_addr(ctx, dst_buf, 1));
+	cedrus_avs_write_ref(ctx, fwd_buf, dst_buf,
+			     VE_AVS_FWD_LUMA, VE_AVS_FWD_CHROMA);
+	cedrus_avs_write_ref(ctx, bwd_buf, dst_buf,
+			     VE_AVS_BWD_LUMA, VE_AVS_BWD_CHROMA);
+
+	/* The engine removes the pseudo start code bits of the slice data. */
+	ctrl |= VE_AVS_CTRL_PSEUDO_START_CODE_REMOVE;
+	cedrus_write(dev, VE_H264_CTRL, ctrl);
+
+	/* Bitstream, from the first slice start code to the end of the data. */
+	cedrus_write(dev, VE_H264_VLD_OFFSET, pic->data_offset * 8);
+	cedrus_write(dev, VE_H264_VLD_LEN, (payload - pic->data_offset) * 8);
+	cedrus_write(dev, VE_H264_VLD_ADDR,
+		     VE_H264_VLD_ADDR_VAL(src_addr) |
+		     VE_H264_VLD_ADDR_FIRST | VE_H264_VLD_ADDR_VALID |
+		     VE_H264_VLD_ADDR_LAST);
+	cedrus_write(dev, VE_H264_VLD_END, src_addr + plane_size);
+
+	/* Reset the registers changed by the hardware. */
+	cedrus_write(dev, VE_H264_MB_ADDR, 0);
+	cedrus_write(dev, VE_H264_ERROR_CASE, 0);
+	cedrus_write(dev, VE_H264_CUR_MB_NUM, 0);
+
+	/* Initialize bitstream access. */
+	cedrus_write(dev, VE_H264_TRIGGER_TYPE,
+		     VE_AVS_TRIGGER_STCD_TYPE(1) |
+		     VE_H264_TRIGGER_TYPE_INIT_SWDEC);
+
+	return 0;
+}
+
+static int cedrus_avs_start(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+
+	/*
+	 * Allocate enough to place the buffer on a 16 KiB boundary, which
+	 * the vendor library computes for it (but does not program).
+	 */
+	ctx->codec.avs.mb_info_buf_size = CEDRUS_AVS_MB_INFO_BUF_SIZE +
+					  CEDRUS_AVS_MB_INFO_BUF_ALIGN;
+	ctx->codec.avs.mb_info_buf =
+		dma_alloc_attrs(dev->dev, ctx->codec.avs.mb_info_buf_size,
+				&ctx->codec.avs.mb_info_buf_dma, GFP_KERNEL,
+				DMA_ATTR_NO_KERNEL_MAPPING);
+	if (!ctx->codec.avs.mb_info_buf)
+		return -ENOMEM;
+
+	ctx->codec.avs.mb_info_buf_addr =
+		ALIGN(ctx->codec.avs.mb_info_buf_dma,
+		      CEDRUS_AVS_MB_INFO_BUF_ALIGN);
+
+	return 0;
+}
+
+static void cedrus_avs_buf_cleanup(struct cedrus_ctx *ctx,
+				   struct cedrus_buffer *buf)
+{
+	if (buf->codec.avs.mv_col_buf_size > 0) {
+		dma_free_attrs(ctx->dev->dev, buf->codec.avs.mv_col_buf_size,
+			       buf->codec.avs.mv_col_buf,
+			       buf->codec.avs.mv_col_buf_dma,
+			       DMA_ATTR_NO_KERNEL_MAPPING);
+
+		buf->codec.avs.mv_col_buf_size = 0;
+	}
+}
+
+static void cedrus_avs_stop(struct cedrus_ctx *ctx)
+{
+	struct cedrus_dev *dev = ctx->dev;
+	struct vb2_queue *vq;
+	unsigned int i;
+
+	vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx, V4L2_BUF_TYPE_VIDEO_CAPTURE);
+
+	for (i = 0; i < vb2_get_num_buffers(vq); i++) {
+		struct vb2_buffer *vb = vb2_get_buffer(vq, i);
+
+		if (!vb)
+			continue;
+
+		cedrus_avs_buf_cleanup(ctx, vb2_to_cedrus_buffer(vb));
+	}
+
+	dma_free_attrs(dev->dev, ctx->codec.avs.mb_info_buf_size,
+		       ctx->codec.avs.mb_info_buf,
+		       ctx->codec.avs.mb_info_buf_dma,
+		       DMA_ATTR_NO_KERNEL_MAPPING);
+}
+
+static void cedrus_avs_trigger(struct cedrus_ctx *ctx)
+{
+	cedrus_write(ctx->dev, VE_H264_TRIGGER_TYPE,
+		     VE_AVS_TRIGGER_STCD_TYPE(1) |
+		     VE_AVS_TRIGGER_TYPE_PIC_DECODE);
+}
+
+struct cedrus_dec_ops cedrus_dec_ops_avs = {
+	.irq_clear	= cedrus_avs_irq_clear,
+	.irq_disable	= cedrus_avs_irq_disable,
+	.irq_status	= cedrus_avs_irq_status,
+	.setup		= cedrus_avs_setup,
+	.start		= cedrus_avs_start,
+	.stop		= cedrus_avs_stop,
+	.buf_cleanup	= cedrus_avs_buf_cleanup,
+	.trigger	= cedrus_avs_trigger,
+};
