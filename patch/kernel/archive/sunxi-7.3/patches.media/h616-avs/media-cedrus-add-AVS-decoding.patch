diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.c b/drivers/staging/media/sunxi/cedrus/cedrus.c
index 7fbdca8ac..5964b65af 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.c
@@ -186,6 +186,28 @@ static int cedrus_try_ctrl(struct v4l2_ctrl *ctrl)
 			ctx->bit_depth = bit_depth;
 			cedrus_reset_cap_format(ctx);
 		}
+	} else if (ctrl->id == V4L2_CID_STATELESS_AVS_SEQUENCE) {
+		const struct v4l2_ctrl_avs_sequence *seq =
+			ctrl->p_new.p_avs_sequence;
+		struct cedrus_ctx *ctx = container_of(ctrl->handler,
+						      struct cedrus_ctx, hdl);
+		struct vb2_queue *vq;
+
+		/* Only 8-bit 4:2:0 is supported */
+		if (seq->chroma_format != 1 || seq->sample_precision != 1)
+			return -EINVAL;
+
+		if (cedrus_check_pic_size(ctx, seq->horizontal_size,
+					  seq->vertical_size))
+			return -EINVAL;
+
+		vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx,
+				     V4L2_BUF_TYPE_VIDEO_CAPTURE);
+
+		if (!vb2_is_busy(vq) && ctx->bit_depth != 8) {
+			ctx->bit_depth = 8;
+			cedrus_reset_cap_format(ctx);
+		}
 	} else if (ctrl->id == V4L2_CID_STATELESS_VC1_SEQUENCE) {
 		const struct v4l2_ctrl_vc1_sequence *seq = ctrl->p_new.p_vc1_sequence;
 
@@ -574,6 +596,25 @@ static const struct cedrus_control cedrus_controls[] = {
 		},
 		.capabilities	= CEDRUS_CAPABILITY_AVS2_DEC,
 	},
+	{
+		.cfg = {
+			.id	= V4L2_CID_STATELESS_AVS_SEQUENCE,
+			.ops	= &cedrus_ctrl_ops,
+		},
+		.capabilities	= CEDRUS_CAPABILITY_AVS_DEC,
+	},
+	{
+		.cfg = {
+			.id	= V4L2_CID_STATELESS_AVS_PICTURE,
+		},
+		.capabilities	= CEDRUS_CAPABILITY_AVS_DEC,
+	},
+	{
+		.cfg = {
+			.id	= V4L2_CID_STATELESS_AVS_WEIGHT_QUANT,
+		},
+		.capabilities	= CEDRUS_CAPABILITY_AVS_DEC,
+	},
 };
 
 #define CEDRUS_CONTROLS_COUNT	ARRAY_SIZE(cedrus_controls)
@@ -701,6 +742,20 @@ static int cedrus_request_validate(struct media_request *req)
 		return -EINVAL;
 	}
 
+	/*
+	 * Each AVS picture comes with its sequence and picture headers;
+	 * there is no sensible default for either.
+	 */
+	if (ctx->src_fmt.pixelformat == V4L2_PIX_FMT_AVS_FRAME &&
+	    (!cedrus_ctrl_in_request(ctx, req,
+				     V4L2_CID_STATELESS_AVS_SEQUENCE) ||
+	     !cedrus_ctrl_in_request(ctx, req,
+				     V4L2_CID_STATELESS_AVS_PICTURE))) {
+		v4l2_info(&ctx->dev->v4l2_dev,
+			  "Missing required codec control(s)\n");
+		return -ENOENT;
+	}
+
 	return vb2_request_validate(req);
 }
 
