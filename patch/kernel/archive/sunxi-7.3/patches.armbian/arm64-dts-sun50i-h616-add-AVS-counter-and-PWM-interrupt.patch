From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Tue, 10 Nov 2026 12:00:00 +0000
Subject: arm64: dts: allwinner: h616: Add the AVS counters and the PWM interrupt

Describe the AVS counters of the timer block, and the interrupt of the
PWM controller (GIC SPI 16, H616 user manual v1.0, 3.8.1 interrupt sources:
PWM is interrupt 48), which the PWM capture uses.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---

--- a/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
@@ -433,9 +433,16 @@
 			clocks = <&osc24M>;
 		};
 
+		avs_counter: counter@30090c0 {
+			compatible = "allwinner,sun50i-h616-avs-counter";
+			reg = <0x030090c0 0x10>;
+			clocks = <&osc24M>;
+		};
+
 		pwm: pwm@300a000 {
 			compatible = "allwinner,sun50i-h616-pwm";
 			reg = <0x0300a000 0x400>;
+			interrupts = <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&osc24M>, <&ccu CLK_BUS_PWM>;
 			clock-names = "mod", "bus";
 			resets = <&ccu RST_BUS_PWM>;
-- 
Armbian

