From 12930c131cf181aae9cfd24347d4191e476e349b Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Tue, 10 Nov 2026 08:29:22 +0000
Subject: [PATCH 02/17] drm/panfrost: Power the GPU up for a reset queued from
 the MMU code

panfrost_reset_work() calls panfrost_reset() without a runtime PM
reference. wait_ready() queues it from MMU operations whose callers drop
their reference right after, so the GPU can be runtime suspended when it
runs. Take a reference in the work. If the GPU cannot be resumed, no job
is on it and its next runtime resume resets it, so clear reset.pending
there.

The access to a suspended GPU was not reproduced. With a resume failure
injected into the work (test-only hook), a job submitted meanwhile
started at once.

Fixes: f9ab9c66f080 ("drm/panfrost: Reset the GPU when the AS_ACTIVE bit is stuck")
Cc: stable@vger.kernel.org
Reported-by: Sashiko <sashiko-bot@kernel.org>
Closes: https://lore.kernel.org/all/sashiko-outbox-206548@kernel.org/
Closes: https://lore.kernel.org/all/sashiko-outbox-212557@kernel.org/
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/gpu/drm/panfrost/panfrost_device.c | 2 ++
 drivers/gpu/drm/panfrost/panfrost_job.c    | 9 +++++++++
 2 files changed, 11 insertions(+)

diff --git a/drivers/gpu/drm/panfrost/panfrost_device.c b/drivers/gpu/drm/panfrost/panfrost_device.c
index d0a23c5..78dc3a3 100644
--- a/drivers/gpu/drm/panfrost/panfrost_device.c
+++ b/drivers/gpu/drm/panfrost/panfrost_device.c
@@ -451,6 +451,8 @@ static int panfrost_device_runtime_resume(struct device *dev)
 			goto err_bus_ace_clk;
 	}
 
+	/* This reset also does any reset still pending. */
+	atomic_set(&pfdev->reset.pending, 0);
 	panfrost_device_reset(pfdev, true);
 	panfrost_devfreq_resume(pfdev);
 
diff --git a/drivers/gpu/drm/panfrost/panfrost_job.c b/drivers/gpu/drm/panfrost/panfrost_job.c
index a3c90c5..b2735cd 100644
--- a/drivers/gpu/drm/panfrost/panfrost_job.c
+++ b/drivers/gpu/drm/panfrost/panfrost_job.c
@@ -808,7 +808,16 @@ static void panfrost_reset_work(struct work_struct *work)
 	struct panfrost_device *pfdev;
 
 	pfdev = container_of(work, struct panfrost_device, reset.work);
+
+	/* The GPU may have been runtime suspended since the work was queued.
+	 * If it cannot be resumed, no job is on it, and the next runtime
+	 * resume resets it.
+	 */
+	if (pm_runtime_resume_and_get(pfdev->base.dev))
+		return;
+
 	panfrost_reset(pfdev, NULL);
+	pm_runtime_put_autosuspend(pfdev->base.dev);
 }
 
 static const struct drm_sched_backend_ops panfrost_sched_ops = {
