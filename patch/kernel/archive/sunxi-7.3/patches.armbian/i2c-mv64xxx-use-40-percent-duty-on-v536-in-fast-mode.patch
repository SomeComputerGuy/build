From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 5 Nov 2026 12:00:00 +0000
Subject: i2c: mv64xxx: Use the 40 % SCL duty cycle on V536-style TWI in fast mode

The TWI clock register of the V536/H616 has a CLK_DUTY bit (bit 7,
1 = 40 % high time, the reset value; H616 user manual v1.0, 9.1.6.6
TWI_CCR). The driver writes only the M/N dividers and so clears it,
giving a 50 % duty cycle. At 400 kHz that is a 1.25 us SCL low time,
below the 1.3 us fast-mode minimum of the I2C specification.

Set CLK_DUTY for allwinner,sun8i-v536-i2c compatible controllers when the
bus runs above standard mode (tLOW 1.5 us, tHIGH 1.0 us at 400 kHz).
Standard mode keeps 50 %.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---

--- a/drivers/i2c/busses/i2c-mv64xxx.c
+++ b/drivers/i2c/busses/i2c-mv64xxx.c
@@ -29,6 +29,7 @@
 
 #define MV64XXX_I2C_BAUD_DIV_N(val)			(val & 0x7)
 #define MV64XXX_I2C_BAUD_DIV_M(val)			((val & 0xf) << 3)
+#define	MV64XXX_I2C_BAUD_DUTY_40			BIT(7)
 
 #define	MV64XXX_I2C_REG_CONTROL_ACK			BIT(2)
 #define	MV64XXX_I2C_REG_CONTROL_IFLG			BIT(3)
@@ -147,6 +148,8 @@
 	bool			irq_clear_inverted;
 	/* Clk div is 2 to the power n, not 2 to the power n + 1 */
 	bool			clk_n_base_0;
+	/* sun8i-v536+ TWI_CCR bit 7: 0 = 50 %, 1 = 40 % SCL high time */
+	bool			clk_duty_40;
 	struct i2c_bus_recovery_info	rinfo;
 	bool			atomic;
 	bool			rtpm_pinned;
@@ -213,7 +216,8 @@
 	}
 
 	writel(0, drv_data->reg_base + drv_data->reg_offsets.soft_reset);
-	writel(MV64XXX_I2C_BAUD_DIV_M(drv_data->freq_m) | MV64XXX_I2C_BAUD_DIV_N(drv_data->freq_n),
+	writel(MV64XXX_I2C_BAUD_DIV_M(drv_data->freq_m) | MV64XXX_I2C_BAUD_DIV_N(drv_data->freq_n) |
+	       (drv_data->clk_duty_40 ? MV64XXX_I2C_BAUD_DUTY_40 : 0),
 		drv_data->reg_base + drv_data->reg_offsets.clock);
 	writel(0, drv_data->reg_base + drv_data->reg_offsets.addr);
 	writel(0, drv_data->reg_base + drv_data->reg_offsets.ext_addr);
@@ -917,6 +921,15 @@
 	if (of_device_is_compatible(np, "allwinner,sun6i-a31-i2c"))
 		drv_data->irq_clear_inverted = true;
 
+	/*
+	 * At 400 kHz a 50 % duty cycle gives tLOW = 1.25 us, below the I2C
+	 * fast-mode minimum of 1.3 us. The V536/H616 TWI resets CLK_DUTY to
+	 * 40 % high (H616 UM 9.1.6.6); keep that above standard mode.
+	 */
+	if (of_device_is_compatible(np, "allwinner,sun8i-v536-i2c") &&
+	    bus_freq > I2C_MAX_STANDARD_MODE_FREQ)
+		drv_data->clk_duty_40 = true;
+
 out:
 	return rc;
 }
