--- /dev/null
+++ b/drivers/counter/sun50i-avs-cnt.c
@@ -0,0 +1,299 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Allwinner H616 audio/video sync (AVS) counters
+ *
+ * The timer block of the H616 has two free-running 33-bit counters for
+ * audio/video synchronisation. Each one counts OSC24M cycles divided by a
+ * programmable divisor N (2..2048) and can be enabled, paused and loaded
+ * with an initial value at any time. Only the upper 32 bits of a counter
+ * are visible, so the count read here advances at 24 MHz / N / 2.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/counter.h>
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+
+#define AVS_CNT_CTL		0x00
+#define AVS_CNT_CTL_EN(x)	BIT(x)
+#define AVS_CNT_CTL_PS(x)	BIT(8 + (x))
+#define AVS_CNT(x)		(0x04 + 4 * (x))
+#define AVS_CNT_DIV		0x0c
+#define AVS_CNT_DIV_MASK(x)	((x) ? GENMASK(27, 16) : GENMASK(11, 0))
+
+#define AVS_NUM_COUNTERS	2
+/* the divisor field holds N - 1; zero is reserved, N is at most 0x800 */
+#define AVS_DIV_MIN		2
+#define AVS_DIV_MAX		0x800
+
+struct sun50i_avs_cnt {
+	void __iomem *base;
+	/* serialises the read-modify-write of the shared registers */
+	struct mutex lock;
+	unsigned long parent_rate;
+};
+
+static void sun50i_avs_cnt_rmw(struct sun50i_avs_cnt *avs, u32 reg, u32 mask,
+			       u32 val)
+{
+	u32 v;
+
+	mutex_lock(&avs->lock);
+	v = readl(avs->base + reg);
+	writel((v & ~mask) | (val & mask), avs->base + reg);
+	mutex_unlock(&avs->lock);
+}
+
+static int sun50i_avs_cnt_count_read(struct counter_device *counter,
+				     struct counter_count *count, u64 *val)
+{
+	struct sun50i_avs_cnt *avs = counter_priv(counter);
+
+	*val = readl(avs->base + AVS_CNT(count->id));
+
+	return 0;
+}
+
+static int sun50i_avs_cnt_count_write(struct counter_device *counter,
+				      struct counter_count *count,
+				      const u64 val)
+{
+	struct sun50i_avs_cnt *avs = counter_priv(counter);
+
+	if (val > U32_MAX)
+		return -ERANGE;
+
+	/* also clears the hidden LSB of the 33-bit counter, as required */
+	writel(val, avs->base + AVS_CNT(count->id));
+
+	return 0;
+}
+
+static int sun50i_avs_cnt_function_read(struct counter_device *counter,
+					struct counter_count *count,
+					enum counter_function *function)
+{
+	*function = COUNTER_FUNCTION_INCREASE;
+
+	return 0;
+}
+
+static int sun50i_avs_cnt_action_read(struct counter_device *counter,
+				      struct counter_count *count,
+				      struct counter_synapse *synapse,
+				      enum counter_synapse_action *action)
+{
+	*action = COUNTER_SYNAPSE_ACTION_RISING_EDGE;
+
+	return 0;
+}
+
+static int sun50i_avs_cnt_enable_read(struct counter_device *counter,
+				      struct counter_count *count, u8 *enable)
+{
+	struct sun50i_avs_cnt *avs = counter_priv(counter);
+
+	*enable = !!(readl(avs->base + AVS_CNT_CTL) &
+		     AVS_CNT_CTL_EN(count->id));
+
+	return 0;
+}
+
+static int sun50i_avs_cnt_enable_write(struct counter_device *counter,
+				       struct counter_count *count, u8 enable)
+{
+	struct sun50i_avs_cnt *avs = counter_priv(counter);
+
+	sun50i_avs_cnt_rmw(avs, AVS_CNT_CTL, AVS_CNT_CTL_EN(count->id),
+			   enable ? AVS_CNT_CTL_EN(count->id) : 0);
+
+	return 0;
+}
+
+static int sun50i_avs_cnt_pause_read(struct counter_device *counter,
+				     struct counter_count *count, u8 *pause)
+{
+	struct sun50i_avs_cnt *avs = counter_priv(counter);
+
+	*pause = !!(readl(avs->base + AVS_CNT_CTL) &
+		    AVS_CNT_CTL_PS(count->id));
+
+	return 0;
+}
+
+static int sun50i_avs_cnt_pause_write(struct counter_device *counter,
+				      struct counter_count *count, u8 pause)
+{
+	struct sun50i_avs_cnt *avs = counter_priv(counter);
+
+	sun50i_avs_cnt_rmw(avs, AVS_CNT_CTL, AVS_CNT_CTL_PS(count->id),
+			   pause ? AVS_CNT_CTL_PS(count->id) : 0);
+
+	return 0;
+}
+
+static int sun50i_avs_cnt_prescaler_read(struct counter_device *counter,
+					 struct counter_count *count, u64 *div)
+{
+	struct sun50i_avs_cnt *avs = counter_priv(counter);
+	u32 mask = AVS_CNT_DIV_MASK(count->id);
+
+	*div = field_get(mask, readl(avs->base + AVS_CNT_DIV)) + 1;
+
+	return 0;
+}
+
+static int sun50i_avs_cnt_prescaler_write(struct counter_device *counter,
+					  struct counter_count *count, u64 div)
+{
+	struct sun50i_avs_cnt *avs = counter_priv(counter);
+	u32 mask = AVS_CNT_DIV_MASK(count->id);
+
+	if (div < AVS_DIV_MIN || div > AVS_DIV_MAX)
+		return -EINVAL;
+
+	sun50i_avs_cnt_rmw(avs, AVS_CNT_DIV, mask, field_prep(mask, div - 1));
+
+	return 0;
+}
+
+/* rate at which the visible (upper 32-bit) count advances */
+static int sun50i_avs_cnt_frequency_read(struct counter_device *counter,
+					 struct counter_count *count, u64 *freq)
+{
+	struct sun50i_avs_cnt *avs = counter_priv(counter);
+	u64 div;
+
+	sun50i_avs_cnt_prescaler_read(counter, count, &div);
+	*freq = div_u64(avs->parent_rate, 2 * div);
+
+	return 0;
+}
+
+static const struct counter_ops sun50i_avs_cnt_ops = {
+	.count_read = sun50i_avs_cnt_count_read,
+	.count_write = sun50i_avs_cnt_count_write,
+	.function_read = sun50i_avs_cnt_function_read,
+	.action_read = sun50i_avs_cnt_action_read,
+};
+
+static struct counter_signal sun50i_avs_cnt_signals[] = {
+	{
+		.id = 0,
+		.name = "OSC24M",
+	},
+};
+
+static const enum counter_synapse_action sun50i_avs_cnt_actions[] = {
+	COUNTER_SYNAPSE_ACTION_RISING_EDGE,
+};
+
+static const enum counter_function sun50i_avs_cnt_functions[] = {
+	COUNTER_FUNCTION_INCREASE,
+};
+
+static struct counter_synapse sun50i_avs_cnt_synapses[] = {
+	{
+		.actions_list = sun50i_avs_cnt_actions,
+		.num_actions = ARRAY_SIZE(sun50i_avs_cnt_actions),
+		.signal = &sun50i_avs_cnt_signals[0],
+	},
+};
+
+static struct counter_comp sun50i_avs_cnt_ext[] = {
+	COUNTER_COMP_ENABLE(sun50i_avs_cnt_enable_read,
+			    sun50i_avs_cnt_enable_write),
+	COUNTER_COMP_COUNT_BOOL("pause", sun50i_avs_cnt_pause_read,
+				sun50i_avs_cnt_pause_write),
+	COUNTER_COMP_COUNT_U64("prescaler", sun50i_avs_cnt_prescaler_read,
+			       sun50i_avs_cnt_prescaler_write),
+	COUNTER_COMP_COUNT_U64("frequency", sun50i_avs_cnt_frequency_read,
+			       NULL),
+};
+
+static struct counter_count sun50i_avs_cnt_counts[AVS_NUM_COUNTERS] = {
+	{
+		.id = 0,
+		.name = "AVS Counter 0",
+		.functions_list = sun50i_avs_cnt_functions,
+		.num_functions = ARRAY_SIZE(sun50i_avs_cnt_functions),
+		.synapses = sun50i_avs_cnt_synapses,
+		.num_synapses = ARRAY_SIZE(sun50i_avs_cnt_synapses),
+		.ext = sun50i_avs_cnt_ext,
+		.num_ext = ARRAY_SIZE(sun50i_avs_cnt_ext),
+	},
+	{
+		.id = 1,
+		.name = "AVS Counter 1",
+		.functions_list = sun50i_avs_cnt_functions,
+		.num_functions = ARRAY_SIZE(sun50i_avs_cnt_functions),
+		.synapses = sun50i_avs_cnt_synapses,
+		.num_synapses = ARRAY_SIZE(sun50i_avs_cnt_synapses),
+		.ext = sun50i_avs_cnt_ext,
+		.num_ext = ARRAY_SIZE(sun50i_avs_cnt_ext),
+	},
+};
+
+static int sun50i_avs_cnt_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct counter_device *counter;
+	struct sun50i_avs_cnt *avs;
+	struct clk *clk;
+	int ret;
+
+	counter = devm_counter_alloc(dev, sizeof(*avs));
+	if (!counter)
+		return -ENOMEM;
+	avs = counter_priv(counter);
+
+	avs->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(avs->base))
+		return PTR_ERR(avs->base);
+
+	clk = devm_clk_get_enabled(dev, NULL);
+	if (IS_ERR(clk))
+		return dev_err_probe(dev, PTR_ERR(clk), "failed to get clock\n");
+	avs->parent_rate = clk_get_rate(clk);
+
+	ret = devm_mutex_init(dev, &avs->lock);
+	if (ret)
+		return ret;
+
+	counter->name = dev_name(dev);
+	counter->parent = dev;
+	counter->ops = &sun50i_avs_cnt_ops;
+	counter->counts = sun50i_avs_cnt_counts;
+	counter->num_counts = ARRAY_SIZE(sun50i_avs_cnt_counts);
+	counter->signals = sun50i_avs_cnt_signals;
+	counter->num_signals = ARRAY_SIZE(sun50i_avs_cnt_signals);
+
+	ret = devm_counter_add(dev, counter);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to add counter\n");
+
+	return 0;
+}
+
+static const struct of_device_id sun50i_avs_cnt_of_match[] = {
+	{ .compatible = "allwinner,sun50i-h616-avs-counter" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sun50i_avs_cnt_of_match);
+
+static struct platform_driver sun50i_avs_cnt_driver = {
+	.probe = sun50i_avs_cnt_probe,
+	.driver = {
+		.name = "sun50i-avs-cnt",
+		.of_match_table = sun50i_avs_cnt_of_match,
+	},
+};
+module_platform_driver(sun50i_avs_cnt_driver);
+
+MODULE_DESCRIPTION("Allwinner H616 audio/video sync counter driver");
+MODULE_LICENSE("GPL");
+MODULE_IMPORT_NS("COUNTER");
-- 
