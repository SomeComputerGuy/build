 	reg |= SUN6I_TFR_CTL_CS(spi_get_chipselect(spi, 0));
 
+	/* A target only picks the SSx input it listens on; the host drives it */
+	if (spi_controller_is_target(spi->controller)) {
+		sun6i_spi_write(sspi, SUN6I_TFR_CTL_REG, reg);
+		return;
+	}
