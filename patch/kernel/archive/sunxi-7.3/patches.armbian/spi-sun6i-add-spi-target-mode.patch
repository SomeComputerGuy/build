+/*
+ * Target (slave) mode, H616 user manual 9.3.3.5: with GCR.MODE cleared the
+ * controller waits for the host to assert SS and drive SPI_CLK; the TX FIFO
+ * is shifted out on MISO and MOSI is shifted into the RX FIFO. There are no
+ * burst counters and no TC for a transfer the host sizes, so the transfer
+ * is complete once the RX FIFO has delivered tfr->len bytes (SPI is full
+ * duplex: that is also the moment the last TX byte has been clocked out).
+ * PIO only; the wait is unbounded until the host clocks the data or the
+ * transfer is aborted (spi_target_abort, or the spidev user is signalled).
+ */
+static int sun6i_spi_target_transfer_one(struct spi_controller *host,
+					 struct spi_device *spi,
+					 struct spi_transfer *tfr)
+{
+	struct sun6i_spi *sspi = spi_controller_get_devdata(host);
+	unsigned int trig_level = sspi->cfg->fifo_depth / 4 * 3;
+	unsigned long mclk_rate;
+	int ret = 0;
+	u32 reg;
+
+	if (tfr->len > SUN6I_MAX_XFER_SIZE)
+		return -EINVAL;
+	if (!tfr->len)
+		return 0;
+
+	reinit_completion(&sspi->done);
+	sspi->tx_buf = tfr->tx_buf;
+	sspi->rx_buf = tfr->rx_buf;
+	sspi->len = tfr->len;
+	sspi->rx_left = tfr->len;
+	sspi->target_aborted = false;
+	sspi->target_error = false;
+
+	/* Clear pending interrupts and reset both FIFOs */
+	sun6i_spi_write(sspi, SUN6I_INT_STA_REG, ~0);
+	sun6i_spi_write(sspi, SUN6I_FIFO_CTL_REG,
+			SUN6I_FIFO_CTL_RF_RST | SUN6I_FIFO_CTL_TF_RST);
+
+	/* TX refill at 3/4 empty as in host mode; RX level per the transfer */
+	sun6i_spi_write(sspi, SUN6I_FIFO_CTL_REG,
+			trig_level << SUN6I_FIFO_CTL_TF_ERQ_TRIG_LEVEL_BITS);
+	sun6i_spi_target_set_rx_trigger(sspi);
+
+	/*
+	 * Clock polarity and phase, bit order and SS polarity follow the
+	 * host's. SS is an input: the controller owns it, and every byte the
+	 * host clocks is received (no dummy bursts to discard).
+	 */
+	reg = sun6i_spi_read(sspi, SUN6I_TFR_CTL_REG);
+	reg &= ~(SUN6I_TFR_CTL_CPOL | SUN6I_TFR_CTL_CPHA | SUN6I_TFR_CTL_FBS |
+		 SUN6I_TFR_CTL_SPOL | SUN6I_TFR_CTL_DHB |
+		 SUN6I_TFR_CTL_CS_MANUAL);
+
+	if (spi->mode & SPI_CPOL)
+		reg |= SUN6I_TFR_CTL_CPOL;
+
+	if (spi->mode & SPI_CPHA)
+		reg |= SUN6I_TFR_CTL_CPHA;
+
+	if (spi->mode & SPI_LSB_FIRST)
+		reg |= SUN6I_TFR_CTL_FBS;
+
+	if (!(spi->mode & SPI_CS_HIGH))
+		reg |= SUN6I_TFR_CTL_SPOL;
+
+	sun6i_spi_write(sspi, SUN6I_TFR_CTL_REG, reg);
+
+	/*
+	 * SPI_CLK comes from the host. The module clock only has to sample
+	 * it: keep it at least four times the expected bus clock (the
+	 * device's spi-max-frequency) so the input shift register is safe,
+	 * within the 200 MHz the host path uses for a 100 MHz bus.
+	 */
+	mclk_rate = clk_get_rate(sspi->mclk);
+	if (mclk_rate < 4UL * tfr->speed_hz)
+		clk_set_rate(sspi->mclk,
+			     min(4UL * tfr->speed_hz, SUN6I_TARGET_MAX_MCLK));
+
+	/* Enable the controller; MODE stays 0 (target) from runtime resume */
+	reg = sun6i_spi_read(sspi, SUN6I_GBL_CTL_REG);
+	reg &= ~SUN6I_GBL_CTL_MASTER;
+	reg |= SUN6I_GBL_CTL_BUS_ENABLE;
+	sun6i_spi_write(sspi, SUN6I_GBL_CTL_REG, reg);
+
+	/* Preload the TX FIFO (zeros for an RX-only transfer) */
+	sun6i_spi_fill_fifo(sspi);
+
+	/* RX level, FIFO errors, and TX refills for long transfers */
+	reg = SUN6I_INT_CTL_RF_RDY | SUN6I_INT_CTL_RF_OVF | SUN6I_INT_CTL_TF_UDR;
+	if (sspi->len)
+		reg |= SUN6I_INT_CTL_TF_ERQ;
+	sun6i_spi_write(sspi, SUN6I_INT_CTL_REG, reg);
+
+	if (wait_for_completion_interruptible(&sspi->done) ||
+	    sspi->target_aborted)
+		ret = -EINTR;
+	else if (sspi->target_error)
+		ret = -EIO;
+
+	sun6i_spi_write(sspi, SUN6I_INT_CTL_REG, 0);
+
+	/*
+	 * Stop listening until the next transfer and drop whatever a
+	 * half-done or over-long host transfer left in the FIFOs.
+	 */
+	reg = sun6i_spi_read(sspi, SUN6I_GBL_CTL_REG);
+	sun6i_spi_write(sspi, SUN6I_GBL_CTL_REG, reg & ~SUN6I_GBL_CTL_BUS_ENABLE);
+	sun6i_spi_write(sspi, SUN6I_FIFO_CTL_REG,
+			SUN6I_FIFO_CTL_RF_RST | SUN6I_FIFO_CTL_TF_RST);
+
+	if (ret == -EIO)
+		dev_warn(&host->dev, "%s: FIFO error in target transfer of %u bytes\n",
+			 dev_name(&spi->dev), tfr->len);
+
+	return ret;
+}
+
+static int sun6i_spi_target_abort(struct spi_controller *host)
+{
+	struct sun6i_spi *sspi = spi_controller_get_devdata(host);
+
+	sspi->target_aborted = true;
+	complete(&sspi->done);
+
+	return 0;
+}
+
 static int sun6i_spi_transfer_one(struct spi_controller *host,
 				  struct spi_device *spi,
 				  struct spi_transfer *tfr)
@@ -288,6 +457,9 @@
 	int ret = 0;
 	u32 reg;
 
+	if (spi_controller_is_target(host))
+		return sun6i_spi_target_transfer_one(host, spi, tfr);
+
 	if (tfr->len > SUN6I_MAX_XFER_SIZE)
 		return -EINVAL;
 
@@ -531,11 +703,64 @@
 	return ret;
 }
 
+static irqreturn_t sun6i_spi_target_handler(struct sun6i_spi *sspi, u32 status)
+{
+	u32 level;
+
+	/* FIFO under/overrun: the host clocked faster or longer than served */
+	if (status & (SUN6I_INT_CTL_RF_OVF | SUN6I_INT_CTL_TF_UDR)) {
+		sun6i_spi_write(sspi, SUN6I_INT_STA_REG,
+				status & (SUN6I_INT_CTL_RF_OVF | SUN6I_INT_CTL_TF_UDR));
+		if (sspi->rx_left) {
+			sspi->target_error = true;
+			complete(&sspi->done);
+		}
+		return IRQ_HANDLED;
+	}
+
+	/* Receive FIFO at the trigger level */
+	if (status & SUN6I_INT_CTL_RF_RDY) {
+		/*
+		 * Clear first, then drain; the level is re-armed below and a
+		 * byte arriving in between is caught by the final re-check,
+		 * so no wakeup is lost on the last bytes of a transfer.
+		 */
+		do {
+			sun6i_spi_write(sspi, SUN6I_INT_STA_REG, SUN6I_INT_CTL_RF_RDY);
+			sun6i_spi_drain_fifo(sspi);
+			if (!sspi->rx_left) {
+				complete(&sspi->done);
+				return IRQ_HANDLED;
+			}
+			level = sun6i_spi_target_set_rx_trigger(sspi);
+		} while (sun6i_spi_get_rx_fifo_count(sspi) >= level);
+
+		return IRQ_HANDLED;
+	}
+
+	/* Transmit FIFO 3/4 empty */
+	if (status & SUN6I_INT_CTL_TF_ERQ) {
+		sun6i_spi_fill_fifo(sspi);
+
+		if (!sspi->len)
+			sun6i_spi_disable_interrupt(sspi, SUN6I_INT_CTL_TF_ERQ);
+
+		sun6i_spi_write(sspi, SUN6I_INT_STA_REG, SUN6I_INT_CTL_TF_ERQ);
+
+		return IRQ_HANDLED;
+	}
+
+	return IRQ_NONE;
+}
+
 static irqreturn_t sun6i_spi_handler(int irq, void *dev_id)
 {
 	struct sun6i_spi *sspi = dev_id;
 	u32 status = sun6i_spi_read(sspi, SUN6I_INT_STA_REG);
 
+	if (spi_controller_is_target(sspi->host))
+		return sun6i_spi_target_handler(sspi, status);
+
 	/* Transfer complete */
 	if (status & SUN6I_INT_CTL_TC) {
 		sun6i_spi_write(sspi, SUN6I_INT_STA_REG, SUN6I_INT_CTL_TC);
@@ -592,7 +817,9 @@
 		goto err2;
 	}
 
+	/* Host mode with transmit pause, or target mode (MODE = 0) */
 	sun6i_spi_write(sspi, SUN6I_GBL_CTL_REG,
