+/*
+ * Target mode: raise RF_RDY when the rest of the transfer has arrived, or
+ * 3/4 of the FIFO as in host mode when more than that is still expected.
+ * Returns the programmed level.
+ */
+static u32 sun6i_spi_target_set_rx_trigger(struct sun6i_spi *sspi)
+{
+	u32 level = min_t(u32, sspi->rx_left, sspi->cfg->fifo_depth / 4 * 3);
+	u32 reg = sun6i_spi_read(sspi, SUN6I_FIFO_CTL_REG);
+
+	reg &= ~(SUN6I_FIFO_CTL_RF_RDY_TRIG_LEVEL_MASK <<
+		 SUN6I_FIFO_CTL_RF_RDY_TRIG_LEVEL_BITS);
+	reg |= level << SUN6I_FIFO_CTL_RF_RDY_TRIG_LEVEL_BITS;
+	sun6i_spi_write(sspi, SUN6I_FIFO_CTL_REG, reg);
+
+	return level;
+}
