@@ -250,8 +251,9 @@ static int ecdsa_x962_create(struct crypto_template *tmpl, struct rtattr **tb)
 
 	spawn = sig_instance_ctx(inst);
 
+	type = sign ? CRYPTO_SIG_ALG_CAN_SIGN : 0;
 	err = crypto_grab_sig(spawn, sig_crypto_instance(inst),
-			      crypto_attr_alg_name(tb[1]), 0, mask);
+			      crypto_attr_alg_name(tb[1]), type, mask | type);
 	if (err)
 		goto err_free_inst;
 
@@ -272,7 +274,8 @@ static int ecdsa_x962_create(struct crypto_template *tmpl, struct rtattr **tb)
 	inst->alg.init = ecdsa_x962_init_tfm;
 	inst->alg.exit = ecdsa_x962_exit_tfm;
 
-	inst->alg.sign = ecdsa_x962_sign;
+	if (ecdsa_alg->base.cra_flags & CRYPTO_SIG_ALG_CAN_SIGN)
+		inst->alg.sign = ecdsa_x962_sign;
 	inst->alg.verify = ecdsa_x962_verify;
