From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 12 Nov 2026 12:00:00 +0000
Subject: TEST ONLY: net: stmmac: dwmac-sun8i: switch and counters for the TX
 DMA start

For test-cumulative only, never for the image branch; revert after the
board job. test_always_start=1 writes TX_DMA_START for every frame as
before; test_start_skipped and test_start_running count the starts left
out and the starts written while the TX DMA was running.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---

--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c
@@ -445,10 +445,30 @@
 	writel(v, ioaddr + EMAC_TX_CTL1);
 }
 
+/* TEST ONLY: test_always_start = 1 writes TX_DMA_START for every frame, as
+ * before; test_start_skipped counts the starts left out, test_start_running
+ * the starts written while the TX DMA was running a frame.
+ */
+static bool test_always_start;
+module_param(test_always_start, bool, 0644);
+static unsigned int test_start_skipped;
+module_param(test_start_skipped, uint, 0444);
+static unsigned int test_start_running;
+module_param(test_start_running, uint, 0444);
+
 static void sun8i_dwmac_enable_dma_transmission(void __iomem *ioaddr, u32 chan)
 {
 	u32 state, v;
 
+	if (READ_ONCE(test_always_start)) {
+		state = FIELD_GET(EMAC_TX_DMA_STATE,
+				  readl(ioaddr + EMAC_TX_DMA_STA));
+		if (state != EMAC_TX_DMA_STATE_STOP &&
+		    state != EMAC_TX_DMA_STATE_SUSPEND)
+			test_start_running++;
+		goto start;
+	}
+
 	/* TX_DMA_START restarts the TX DMA state machine. Written while the
 	 * DMA moves a frame of several descriptors into the FIFO in threshold
 	 * mode, it can abort that frame with a TX FIFO underflow. A running
@@ -464,10 +484,13 @@
 				       EMAC_TX_DMA_STATE_FETCH, 0, 10)) {
 		state = FIELD_GET(EMAC_TX_DMA_STATE, state);
 		if (state != EMAC_TX_DMA_STATE_STOP &&
-		    state != EMAC_TX_DMA_STATE_SUSPEND)
+		    state != EMAC_TX_DMA_STATE_SUSPEND) {
+			test_start_skipped++;
 			return;
+		}
 	}
 
+start:
 	v = readl(ioaddr + EMAC_TX_CTL1);
 	v |= EMAC_TX_DMA_START;
 	v |= EMAC_TX_DMA_EN;
-- 
Armbian

