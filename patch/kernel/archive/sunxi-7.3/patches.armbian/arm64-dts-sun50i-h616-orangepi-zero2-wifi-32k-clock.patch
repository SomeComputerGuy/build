From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Tue, 3 Nov 2026 01:07:02 +0000
Subject: arm64: dts: allwinner: h616: orangepi-zero2: feed the 32kHz clock to
 the WiFi module

The Orange Pi Zero board DT hands the RTC's 32kHz fanout clock to the
WiFi power sequence as clocks = <&rtc 1> with clock-names =
"osc32k-out". mmc-pwrseq-simple only looks up a clock named
"ext_clock" and treats a missing one as optional, so the clock is never
requested and the fanout stays off (clk_summary: osc32k-fanout enable
count 0). The binding also only allows "ext_clock".

Use the documented name and the CLK_OSC32K_FANOUT macro in the shared
dtsi. On the Zero2 the X32KFOUT pin (PG10) is the AP-CK32KO net to the
module per the v1.3 schematic and the vendor BSP routes the 32kHz clock
to the WiFi module through it, so also mux PG10 there. The Zero3 keeps
PG10 unmuxed until its wiring is confirmed.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 .../arm64/boot/dts/allwinner/sun50i-h616-orangepi-zero.dtsi | 4 ++--
 .../arm64/boot/dts/allwinner/sun50i-h616-orangepi-zero2.dts | 6 ++++++
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h616-orangepi-zero.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-h616-orangepi-zero.dtsi
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h616-orangepi-zero.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h616-orangepi-zero.dtsi
@@ -96,8 +96,8 @@ reg_vcc_wifi_io: vcc-wifi-io {
 
 	wifi_pwrseq: wifi-pwrseq {
 		compatible = "mmc-pwrseq-simple";
-		clocks = <&rtc 1>;
-		clock-names = "osc32k-out";
+		clocks = <&rtc CLK_OSC32K_FANOUT>;
+		clock-names = "ext_clock";
 		reset-gpios = <&pio 6 18 GPIO_ACTIVE_LOW>; /* PG18 */
 		post-power-on-delay-ms = <200>;
 	};
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h616-orangepi-zero2.dts b/arch/arm64/boot/dts/allwinner/sun50i-h616-orangepi-zero2.dts
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h616-orangepi-zero2.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h616-orangepi-zero2.dts
@@ -172,3 +172,9 @@ flash@0 {
 		spi-rx-bus-width = <2>;
 	};
 };
+
+&wifi_pwrseq {
+	/* PG10 (X32KFOUT) is the AP-CK32KO net to the WiFi/BT module */
+	pinctrl-names = "default";
+	pinctrl-0 = <&x32clk_fanout_pin>;
+};
-- 
