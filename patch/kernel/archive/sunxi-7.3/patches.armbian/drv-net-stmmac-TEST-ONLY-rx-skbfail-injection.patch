From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 13 Nov 2026 04:10:00 +0000
Subject: [PATCH] TEST ONLY: net: stmmac: napi_build_skb() failure injection (item 36)

TEST ONLY, work-list item 36, never for the image: stmmac parameters
test_skbfail_every (fail napi_build_skb() on the first buffer of every
Nth multi-descriptor frame), test_skbfail_old (handle the failure as
before the fix), counters test_skbfail_multi and test_skbfail_hits.

Assisted-by: Claude
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
diff --git a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
--- a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
@@ -5895,6 +5895,19 @@
 	return failure ? limit : (int)count;
 }
 
+/* TEST ONLY (work-list item 36): fail napi_build_skb() on the first buffer of
+ * every Nth frame that spans several descriptors; test_skbfail_old = 1 handles
+ * the failure as before the fix (the rest of the frame starts a new skb).
+ */
+static unsigned int test_skbfail_every;
+module_param(test_skbfail_every, uint, 0644);
+static bool test_skbfail_old;
+module_param(test_skbfail_old, bool, 0644);
+static unsigned int test_skbfail_multi;	/* multi-descriptor frame starts seen while every != 0 */
+module_param(test_skbfail_multi, uint, 0644);
+static unsigned int test_skbfail_hits;	/* injected failures */
+module_param(test_skbfail_hits, uint, 0644);
+
 /**
  * stmmac_rx - manage the receive process
  * @priv: driver private structure
@@ -6094,14 +6107,23 @@
 			/* XDP program may expand or reduce tail */
 			buf1_len = ctx.xdp.data_end - ctx.xdp.data;
 
-			skb = napi_build_skb(page_address(buf->page),
-					     rx_q->napi_skb_frag_size);
+			if (test_skbfail_every && (status & rx_not_ls) &&
+			    ++test_skbfail_multi % test_skbfail_every == 0) {
+				test_skbfail_hits++;
+				skb = NULL;
+			} else {
+				skb = napi_build_skb(page_address(buf->page),
+						     rx_q->napi_skb_frag_size);
+			}
 			if (!skb) {
 				page_pool_recycle_direct(rx_q->page_pool,
 							 buf->page);
 				buf->page = NULL;
 				rx_dropped++;
-				error = 1;
+				if (test_skbfail_old)
+					count++;
+				else
+					error = 1;
 				goto drain_data;
 			}
 
@@ -6133,7 +6155,8 @@
 		if (likely(status & rx_not_ls))
 			goto read_again;
 		if (!skb) {
-			count++;
+			if (!test_skbfail_old)
+				count++;
 			continue;
 		}
 
-- 
