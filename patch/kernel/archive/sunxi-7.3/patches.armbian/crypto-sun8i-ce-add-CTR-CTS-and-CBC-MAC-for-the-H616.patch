  *
  * This file add support for AES cipher with 128,192,256 bits keysize in
- * CBC and ECB mode, and for AES-XTS with 256 and 512 bits keysize.
+ * CBC and ECB mode, for AES-XTS with 256 and 512 bits keysize, and for
+ * AES-CTR, AES-CTS and 3DES-CTR.
  *
  * You could find a link for the datasheet in Documentation/arch/arm/sunxi.rst
  */
@@ -23,12 +24,26 @@
 #include "sun8i-ce.h"
 
 /*
- * XTS uses the request IV as the tweak of its first block and returns no IV,
  * CBC returns the last ciphertext block as the IV of the next request.
+ * CTR returns the counter after the last block (sun8i_ce_ctr_add()).
+ * XTS uses the request IV as the tweak of its first block and returns no IV,
+ * CTS returns no IV either: a request is always a complete message.
  */
 static bool sun8i_ce_cipher_iv_out(struct sun8i_ce_alg_template *algt)
 {
-	return algt->ce_blockmode != CE_ID_OP_XTS;
+	return algt->ce_blockmode == CE_ID_OP_CBC;
+}
+
+/* Add n to the big-endian counter that fills the whole IV block */
+static void sun8i_ce_ctr_add(u8 *ctr, unsigned int size, u32 n)
+{
+	u64 v = n;
+
+	while (size-- && v) {
+		v += ctr[size];
+		ctr[size] = v & 0xff;
+		v >>= 8;
+	}
 }
 
 static int sun8i_ce_cipher_need_fallback(struct skcipher_request *areq)
@@ -69,11 +84,37 @@ static int sun8i_ce_cipher_need_fallback(struct skcipher_request *areq)
