+		if (areq->cryptlen <= AES_BLOCK_SIZE) {
+			if (IS_ENABLED(CONFIG_CRYPTO_DEV_SUN8I_CE_DEBUG))
+				algt->stat_fb_leniv++;
 
-		return true;
+			return true;
+		}
+		break;
+	case CE_ID_OP_CTR:
+		/* a final partial block is left to the fallback */
+		todo = crypto_skcipher_chunksize(tfm);
+		if (areq->cryptlen % todo) {
+			if (IS_ENABLED(CONFIG_CRYPTO_DEV_SUN8I_CE_DEBUG))
+				algt->stat_fb_mod16++;
+
+			return true;
+		}
+		break;
+	default:
+		if (areq->cryptlen % 16) {
+			if (IS_ENABLED(CONFIG_CRYPTO_DEV_SUN8I_CE_DEBUG))
+				algt->stat_fb_mod16++;
+
+			return true;
+		}
 	}
 
 	len = areq->cryptlen;
@@ -184,7 +225,10 @@ static int sun8i_ce_cipher_prepare(struct skcipher_request *areq,
 		common = CE_ALG_RAES;
 	else
 		common = ce->variant->alg_cipher[algt->ce_algo_id];
-	common |= rctx->op_dir | CE_COMM_INT;
+	common |= CE_COMM_INT;
+	/* CTR encrypts the counter in both directions */
+	if (algt->ce_blockmode != CE_ID_OP_CTR)
+		common |= rctx->op_dir;
 	cet->t_common_ctl = cpu_to_le32(common);
 	/* CTS and recent CE (H6) need length in bytes, in word otherwise */
 	if (ce->variant->cipher_t_dlen_in_bytes)
@@ -192,9 +236,11 @@ static int sun8i_ce_cipher_prepare(struct skcipher_request *areq,
 	else
 		cet->t_dlen = cpu_to_le32(areq->cryptlen / 4);
 
+	ivsize = crypto_skcipher_ivsize(tfm);
 	sym = ce->variant->op_mode[algt->ce_blockmode];
 	len = op->keylen;
-	if (algt->ce_blockmode == CE_ID_OP_XTS) {
+	switch (algt->ce_blockmode) {
+	case CE_ID_OP_XTS:
 		/*
 		 * One request is one data unit: its first block uses the
 		 * tweak from the IV, its last block ends the data unit. The
@@ -202,6 +248,18 @@ static int sun8i_ce_cipher_prepare(struct skcipher_request *areq,
 		 */
 		sym |= CE_SYM_XTS_FIRST | CE_SYM_XTS_LAST;
 		len /= 2;
+		break;
+	case CE_ID_OP_CTR:
+		/* The counter is the whole IV block, as in the ctr template */
+		if (ivsize == AES_BLOCK_SIZE)
+			sym |= CE_SYM_CTR_128;
+		else
+			sym |= CE_SYM_CTR_64;
+		break;
+	case CE_ID_OP_CTS:
+		/* One request is one complete message */
+		sym |= CE_SYM_CTS_LAST;
+		break;
 	}
 	switch (len) {
 	case 128 / 8:
@@ -226,7 +284,12 @@ static int sun8i_ce_cipher_prepare(struct skcipher_request *areq,
 	}
 	cet->t_key = desc_addr_val_le32(ce, rctx->addr_key);
 
-	ivsize = crypto_skcipher_ivsize(tfm);
+	/* Where the CE writes the IV of the next block, unused by the driver */
+	if (algt->ce_blockmode == CE_ID_OP_CTR ||
+	    algt->ce_blockmode == CE_ID_OP_CTS)
+		cet->t_ctr = desc_addr_val_le32(ce,
+						ce->chanlist[rctx->flow].iv_out_phy);
+
 	if (areq->iv && ivsize > 0) {
 		if (sun8i_ce_cipher_iv_out(algt) &&
 		    (rctx->op_dir & CE_DECRYPTION)) {
@@ -376,6 +439,9 @@ static void sun8i_ce_cipher_unprepare(struct skcipher_request *areq,
 							 offset, ivsize, 0);
 			}
 		}
+		if (algt->ce_blockmode == CE_ID_OP_CTR)
+			sun8i_ce_ctr_add(areq->iv, ivsize,
+					 areq->cryptlen / ivsize);
 		memzero_explicit(rctx->bounce_iv, ivsize);
 	}
 
