-			algt->stat_fb_mod16++;
+	switch (algt->ce_blockmode) {
+	case CE_ID_OP_CTS:
+		/*
+		 * One block is plain CBC: the CTS flag is for a last package
+		 * of more than one block. Lengths that are not a multiple of
+		 * 4 are sent to the fallback by the SG checks below.
