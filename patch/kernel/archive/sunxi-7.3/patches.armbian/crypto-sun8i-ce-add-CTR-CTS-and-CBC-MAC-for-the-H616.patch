+
+int sun8i_ce_cbcmac_setkey(struct crypto_ahash *tfm, const u8 *key,
+			   unsigned int keylen)
+{
+	struct sun8i_ce_hash_tfm_ctx *op = crypto_ahash_ctx(tfm);
+	int err;
+
+	err = aes_check_keylen(keylen);
+	if (err)
+		return err;
+
+	kfree_sensitive(op->key);
+	op->keylen = keylen;
+	op->key = kmemdup(key, keylen, GFP_KERNEL | GFP_DMA);
+	if (!op->key)
+		return -ENOMEM;
+
+	crypto_ahash_clear_flags(op->fallback_tfm, CRYPTO_TFM_REQ_MASK);
+	crypto_ahash_set_flags(op->fallback_tfm,
+			       crypto_ahash_get_flags(tfm) & CRYPTO_TFM_REQ_MASK);
+
+	return crypto_ahash_setkey(op->fallback_tfm, key, keylen);
+}
+
+/*
+ * The CE takes whole blocks only: the zero padding of a final partial block
+ * and the empty message are left to the fallback.
+ */
+int sun8i_ce_cbcmac_digest(struct ahash_request *areq)
+{
+	struct crypto_ahash *tfm = crypto_ahash_reqtfm(areq);
+	struct sun8i_ce_hash_tfm_ctx *ctx = crypto_ahash_ctx(tfm);
+	struct sun8i_ce_hash_reqctx *rctx = ahash_request_ctx_dma(areq);
+	struct sun8i_ce_dev *ce = ctx->ce;
+	struct crypto_engine *engine;
+	int e;
+
+	if (sun8i_ce_hash_need_fallback(areq))
+		return sun8i_ce_hash_digest_fb(areq);
+
+	if (areq->nbytes % AES_BLOCK_SIZE) {
+		if (IS_ENABLED(CONFIG_CRYPTO_DEV_SUN8I_CE_DEBUG)) {
+			struct sun8i_ce_alg_template *algt;
+			struct ahash_alg *alg = crypto_ahash_alg(tfm);
+
+			algt = container_of(alg, struct sun8i_ce_alg_template,
+					    alg.hash.base);
+			algt->stat_fb_srclen++;
+		}
+		return sun8i_ce_hash_digest_fb(areq);
+	}
+
+	e = sun8i_ce_get_engine_number(ce);
+	rctx->flow = e;
+	engine = ce->chanlist[e].engine;
+
+	return crypto_transfer_hash_request_to_engine(engine, areq);
+}
+
+/*
+ * CBC-MAC: an AES-CBC encryption from a zero IV of which the CE writes the
+ * last block only, to the destination.
+ */
+static int sun8i_ce_cbcmac_prepare(struct ahash_request *areq,
+				   struct ce_task *cet)
+{
+	struct crypto_ahash *tfm = crypto_ahash_reqtfm(areq);
+	struct sun8i_ce_hash_tfm_ctx *ctx = crypto_ahash_ctx(tfm);
+	struct sun8i_ce_hash_reqctx *rctx = ahash_request_ctx_dma(areq);
+	struct ahash_alg *alg = crypto_ahash_alg(tfm);
+	struct sun8i_ce_alg_template *algt;
+	struct sun8i_ce_dev *ce = ctx->ce;
+	struct scatterlist *sg;
+	unsigned int len, todo;
+	int nr_sgs, i, err;
+	u32 common, sym;
+
+	algt = container_of(alg, struct sun8i_ce_alg_template, alg.hash.base);
+
+	if (IS_ENABLED(CONFIG_CRYPTO_DEV_SUN8I_CE_DEBUG))
+		algt->stat_req++;
+
+	memset(cet, 0, sizeof(struct ce_task));
+
+	cet->t_id = cpu_to_le32(rctx->flow);
+	common = ce->variant->alg_cipher[algt->ce_algo_id];
+	common |= CE_ENCRYPTION | CE_COMM_INT;
+	common |= CE_COMM_CBCMAC_LEN(AES_BLOCK_SIZE * 8);
+	cet->t_common_ctl = cpu_to_le32(common);
+
+	sym = ce->variant->op_mode[CE_ID_OP_CBCMAC];
+	switch (ctx->keylen) {
+	case AES_KEYSIZE_128:
+		sym |= CE_AES_128BITS;
+		break;
+	case AES_KEYSIZE_192:
+		sym |= CE_AES_192BITS;
+		break;
+	case AES_KEYSIZE_256:
+		sym |= CE_AES_256BITS;
+		break;
+	}
+	cet->t_sym_ctl = cpu_to_le32(sym);
+	cet->t_asym_ctl = 0;
+
+	if (ce->variant->cipher_t_dlen_in_bytes)
+		cet->t_dlen = cpu_to_le32(areq->nbytes);
+	else
+		cet->t_dlen = cpu_to_le32(areq->nbytes / 4);
+
+	rctx->addr_key = dma_map_single(ce->dev, ctx->key, ctx->keylen,
+					DMA_TO_DEVICE);
+	if (dma_mapping_error(ce->dev, rctx->addr_key)) {
+		dev_err(ce->dev, "Cannot DMA MAP KEY\n");
+		return -EFAULT;
+	}
+	cet->t_key = desc_addr_val_le32(ce, rctx->addr_key);
+
+	/* The IV is zero; the ctr address gets the IV of the next block */
+	memset(rctx->pad, 0, AES_BLOCK_SIZE);
+	rctx->pad_len = AES_BLOCK_SIZE;
+	rctx->addr_pad = dma_map_single(ce->dev, rctx->pad, rctx->pad_len,
+					DMA_TO_DEVICE);
+	if (dma_mapping_error(ce->dev, rctx->addr_pad)) {
+		dev_err(ce->dev, "Cannot DMA MAP IV\n");
+		err = -EFAULT;
+		goto err_unmap_key;
+	}
+	cet->t_iv = desc_addr_val_le32(ce, rctx->addr_pad);
+	cet->t_ctr = desc_addr_val_le32(ce, ce->chanlist[rctx->flow].iv_out_phy);
+
+	rctx->nr_sgs = sg_nents_for_len(areq->src, areq->nbytes);
+	nr_sgs = dma_map_sg(ce->dev, areq->src, rctx->nr_sgs, DMA_TO_DEVICE);
+	if (nr_sgs <= 0 || nr_sgs > MAX_SG) {
+		dev_err(ce->dev, "Invalid sg number %d\n", nr_sgs);
+		err = -EINVAL;
+		goto err_unmap_iv;
+	}
+
+	len = areq->nbytes;
+	for_each_sg(areq->src, sg, nr_sgs, i) {
+		cet->t_src[i].addr = desc_addr_val_le32(ce, sg_dma_address(sg));
+		todo = min(len, sg_dma_len(sg));
+		cet->t_src[i].len = cpu_to_le32(todo / 4);
+		len -= todo;
+	}
+	if (len > 0) {
+		dev_err(ce->dev, "remaining len %d\n", len);
+		err = -EINVAL;
+		goto err_unmap_src;
+	}
+
+	rctx->result_len = AES_BLOCK_SIZE;
+	rctx->addr_res = dma_map_single(ce->dev, rctx->result, rctx->result_len,
+					DMA_FROM_DEVICE);
+	if (dma_mapping_error(ce->dev, rctx->addr_res)) {
+		dev_err(ce->dev, "DMA map dest\n");
+		err = -EINVAL;
+		goto err_unmap_src;
+	}
+	cet->t_dst[0].addr = desc_addr_val_le32(ce, rctx->addr_res);
+	cet->t_dst[0].len = cpu_to_le32(rctx->result_len / 4);
+
+	return 0;
+
+err_unmap_src:
+	dma_unmap_sg(ce->dev, areq->src, rctx->nr_sgs, DMA_TO_DEVICE);
+err_unmap_iv:
+	dma_unmap_single(ce->dev, rctx->addr_pad, rctx->pad_len, DMA_TO_DEVICE);
+err_unmap_key:
+	dma_unmap_single(ce->dev, rctx->addr_key, ctx->keylen, DMA_TO_DEVICE);
+	return err;
+}
+
+int sun8i_ce_cbcmac_run(struct crypto_engine *engine, void *async_req)
+{
+	struct ahash_request *areq = ahash_request_cast(async_req);
+	struct crypto_ahash *tfm = crypto_ahash_reqtfm(areq);
+	struct sun8i_ce_hash_tfm_ctx *ctx = crypto_ahash_ctx(tfm);
+	struct sun8i_ce_hash_reqctx *rctx = ahash_request_ctx_dma(areq);
+	struct sun8i_ce_dev *ce = ctx->ce;
+	int err;
+
+	err = sun8i_ce_cbcmac_prepare(areq, ce->chanlist[rctx->flow].tl);
+	if (err)
+		return err;
+
+	err = sun8i_ce_run_task(ce, rctx->flow, crypto_ahash_alg_name(tfm));
+
+	dma_unmap_single(ce->dev, rctx->addr_res, rctx->result_len,
+			 DMA_FROM_DEVICE);
+	dma_unmap_sg(ce->dev, areq->src, rctx->nr_sgs, DMA_TO_DEVICE);
+	dma_unmap_single(ce->dev, rctx->addr_pad, rctx->pad_len, DMA_TO_DEVICE);
+	dma_unmap_single(ce->dev, rctx->addr_key, ctx->keylen, DMA_TO_DEVICE);
+
+	if (!err)
+		memcpy(areq->result, rctx->result, AES_BLOCK_SIZE);
+
+	local_bh_disable();
+	crypto_finalize_hash_request(engine, async_req, err);
+	local_bh_enable();
+
+	return 0;
+}
