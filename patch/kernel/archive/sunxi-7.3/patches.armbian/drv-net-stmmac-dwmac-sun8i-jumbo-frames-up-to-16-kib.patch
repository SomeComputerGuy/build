From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 13 Nov 2026 10:00:00 +0000
Subject: [PATCH] net: stmmac: dwmac-sun8i: jumbo frames up to 16 KiB

The EMAC handles frames up to 16384 bytes (H616 UM 6.5.5/6.5.9,
FRM_LEN_CTL), but the MTU stops at 4070, the largest frame that fits
the 4 KiB TX FIFO.

In store-and-forward mode a larger frame starts once the FIFO is full;
the DMA then has to keep up with the line. With bursts of 8 words it
does not at 1 Gbit/s and the FIFO underflows; 16 or 32 keep it full.

- BASIC_CTL1 BURST_LEN from the variant (32 on H616 EMAC0, else 8) or
  snps,pbl/txpbl/rxpbl (largest; one field for RX and TX);
- with a burst length >= 16 (STMMAC_FLAG_MTU_ABOVE_TXFIFO): max MTU
  16358, FRM_LEN_CTL set, stmmac_change_mtu() skips the aligned-MTU
  FIFO/16368 checks;
- fix the TX/RX threshold mappings (TX mode 256 selected 64);
- a TX underflow resumes the TX DMA instead of resetting the TX ring.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c | 107 ++++++++++++++++++----
 drivers/net/ethernet/stmicro/stmmac/stmmac_main.c |   5 +-
 include/linux/stmmac.h                            |   1 +
 3 files changed, 94 insertions(+), 19 deletions(-)

diff --git a/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c b/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c
index 6ad13e1..bc668d9 100644
--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c
@@ -46,6 +46,9 @@ extern int sunxi_get_soc_chipid(unsigned char *chipid);
  *				These two also indicate the bitmask for
  *				the RX and TX delay chain registers. A
  *				value of zero indicates this is not supported.
+ * @dma_burst_len:		DMA burst length in words (EMAC_BASIC_CTL1
+ *				BURST_LEN) when the DT has no snps,pbl;
+ *				0 = 8
  */
 struct emac_variant {
 	const struct reg_field *syscon_field;
@@ -55,6 +58,7 @@ struct emac_variant {
 	bool support_rgmii;
 	u8 rx_delay_max;
 	u8 tx_delay_max;
+	u8 dma_burst_len;
 };
 
 /* struct sunxi_priv_data - hold all sunxi private data
@@ -137,6 +141,18 @@ static const struct emac_variant emac_variant_a64 = {
 	.tx_delay_max = 7,
 };
 
+/* H616 EMAC0: bursts of 32 words keep the TX FIFO full at 1 Gbit/s */
+static const struct emac_variant emac_variant_h616 = {
+	.syscon_field = &sun8i_syscon_reg_field,
+	.soc_has_internal_phy = false,
+	.support_mii = true,
+	.support_rmii = true,
+	.support_rgmii = true,
+	.rx_delay_max = 31,
+	.tx_delay_max = 7,
+	.dma_burst_len = 32,
+};
+
 static const struct emac_variant emac_variant_h616_internal = {
 	.syscon_field = &sun8i_syscon_reg_field,
 	.soc_has_internal_phy = true,
@@ -192,6 +208,12 @@ static const struct emac_variant emac_variant_h6 = {
 
 /* Use in EMAC_BASIC_CTL1 */
 #define EMAC_BURSTLEN_SHIFT		24
+/* BURST_LEN is a 6-bit field in words, one value for RX and TX, with no
+ * 8x mode (snps,no-pbl-x8 does not apply); the snps,pbl binding allows up
+ * to 32
+ */
+#define EMAC_BURSTLEN_DEFAULT		8
+#define EMAC_BURSTLEN_MAX		32
 
 /* Used in EMAC_RX_FRM_FLT */
 #define EMAC_FRM_FLT_RXALL              BIT(0)
@@ -222,19 +244,24 @@ static const struct emac_variant emac_variant_h6 = {
 
 /* Used in RX_CTL0 */
 #define EMAC_RX_RECEIVER_EN             BIT(31)
+#define EMAC_RX_FRM_LEN_CTL		BIT(30)
 #define EMAC_RX_JUMBO_FRM_EN		BIT(29)
 #define EMAC_RX_DO_CRC BIT(27)
 #define EMAC_RX_FLOW_CTL_EN             BIT(16)
 
 /* Used in TX_CTL0 */
 #define EMAC_TX_TRANSMITTER_EN  BIT(31)
+#define EMAC_TX_FRM_LEN_CTL	BIT(30)
 
-/* Frames must fit in the 4 KiB TX FIFO, to be sent in store-and-forward
- * mode, with two VLAN tags and the FCS.
+/* With FRM_LEN_CTL, frames of up to 16384 bytes (else 10240). In
+ * store-and-forward mode a frame larger than the 4 KiB TX FIFO starts once
+ * the FIFO is full; the DMA then has to keep up with the line, which at
+ * 1 Gbit/s takes bursts of at least 16 words.
  */
 #define EMAC_TX_FIFO_SIZE	4096
-#define EMAC_MAX_MTU		(EMAC_TX_FIFO_SIZE - ETH_HLEN - \
-				 2 * VLAN_HLEN - ETH_FCS_LEN)
+#define EMAC_MAX_FRAME_LEN	16384
+#define EMAC_MAX_MTU(len)	((len) - ETH_HLEN - 2 * VLAN_HLEN - ETH_FCS_LEN)
+#define EMAC_JUMBO_MIN_BURSTLEN	16
 
 /* Used in EMAC_TX_FLOW_CTL */
 #define EMAC_TX_FLOW_CTL_EN             BIT(0)
@@ -338,7 +365,9 @@ static int sun8i_dwmac_dma_reset(void __iomem *ioaddr)
 static void sun8i_dwmac_dma_init(void __iomem *ioaddr,
 				 struct stmmac_dma_cfg *dma_cfg)
 {
-	writel(EMAC_RX_INT | EMAC_TX_INT, ioaddr + EMAC_INT_EN);
+	writel(dma_cfg->pbl << EMAC_BURSTLEN_SHIFT, ioaddr + EMAC_BASIC_CTL1);
+	writel(EMAC_RX_INT | EMAC_TX_INT | EMAC_TX_UNDERFLOW_INT,
+	       ioaddr + EMAC_INT_EN);
 	writel(0x1FFFFFF, ioaddr + EMAC_INT_STA);
 }
 
@@ -505,8 +534,14 @@ static int sun8i_dwmac_dma_interrupt(struct stmmac_priv *priv,
 	if (v & EMAC_TX_TIMEOUT_INT)
 		ret |= tx_hard_error;
 
+	/* An underflow aborts one frame (its descriptor reports it) and
+	 * suspends the TX DMA: resume it rather than reset the TX ring.
+	 * Other TX_CTL1 writers run only at open/close.
+	 */
 	if (v & EMAC_TX_UNDERFLOW_INT) {
-		ret |= tx_hard_error;
+		writel(readl(ioaddr + EMAC_TX_CTL1) | EMAC_TX_DMA_START,
+		       ioaddr + EMAC_TX_CTL1);
+		ret |= handle_tx;
 		x->tx_undeflow_irq++;
 	}
 
@@ -557,13 +592,14 @@ static void sun8i_dwmac_dma_operation_mode_rx(struct stmmac_priv *priv,
 	} else {
 		v &= ~EMAC_RX_MD;
 		v &= ~EMAC_RX_TH_MASK;
-		if (mode < 32)
+		/* the smallest threshold of at least @mode bytes */
+		if (mode <= 32)
 			v |= EMAC_RX_TH_32;
-		else if (mode < 64)
+		else if (mode <= 64)
 			v |= EMAC_RX_TH_64;
-		else if (mode < 96)
+		else if (mode <= 96)
 			v |= EMAC_RX_TH_96;
-		else if (mode < 128)
+		else
 			v |= EMAC_RX_TH_128;
 	}
 	writel(v, ioaddr + EMAC_RX_CTL1);
@@ -587,13 +623,14 @@ static void sun8i_dwmac_dma_operation_mode_tx(struct stmmac_priv *priv,
 	} else {
 		v &= ~EMAC_TX_MD;
 		v &= ~EMAC_TX_TH_MASK;
-		if (mode < 64)
+		/* the smallest threshold of at least @mode bytes */
+		if (mode <= 64)
 			v |= EMAC_TX_TH_64;
-		else if (mode < 128)
+		else if (mode <= 128)
 			v |= EMAC_TX_TH_128;
-		else if (mode < 192)
+		else if (mode <= 192)
 			v |= EMAC_TX_TH_192;
-		else if (mode < 256)
+		else
 			v |= EMAC_TX_TH_256;
 	}
 	writel(v, ioaddr + EMAC_TX_CTL1);
@@ -656,21 +693,47 @@ err_disable_regulator_phy_io:
 	return ret;
 }
 
+/* One BURST_LEN for RX and TX: the largest of snps,pbl, snps,txpbl and
+ * snps,rxpbl, else the variant's default; kept in dma_cfg->pbl
+ */
+static void sun8i_dwmac_set_burst_len(struct device *dev,
+				      const struct emac_variant *variant,
+				      struct stmmac_dma_cfg *dma_cfg)
+{
+	u32 bl = max3(dma_cfg->pbl, dma_cfg->txpbl, dma_cfg->rxpbl);
+
+	if (!of_property_present(dev->of_node, "snps,pbl") &&
+	    !dma_cfg->txpbl && !dma_cfg->rxpbl)
+		bl = variant->dma_burst_len ?: EMAC_BURSTLEN_DEFAULT;
+	dma_cfg->pbl = clamp(bl, 1U, (u32)EMAC_BURSTLEN_MAX);
+}
+
 static void sun8i_dwmac_core_init(struct mac_device_info *hw,
 				  struct net_device *dev)
 {
+	struct stmmac_priv *priv = netdev_priv(dev);
 	void __iomem *ioaddr = hw->pcsr;
 	u32 v;
 
-	v = (8 << EMAC_BURSTLEN_SHIFT); /* burst len */
-	writel(v, ioaddr + EMAC_BASIC_CTL1);
-
 	/* Without JUMBO_FRM_EN, frames longer than 1518 bytes (1522 with a
 	 * VLAN tag) are dropped as length errors.
 	 */
 	v = readl(ioaddr + EMAC_RX_CTL0);
 	v |= EMAC_RX_JUMBO_FRM_EN;
 	writel(v, ioaddr + EMAC_RX_CTL0);
+
+	if (!(priv->plat->flags & STMMAC_FLAG_MTU_ABOVE_TXFIFO))
+		return;
+
+	/* Without FRM_LEN_CTL, the receiver and the transmitter cut frames
+	 * off after 10240 bytes.
+	 */
+	v = readl(ioaddr + EMAC_RX_CTL0);
+	v |= EMAC_RX_FRM_LEN_CTL;
+	writel(v, ioaddr + EMAC_RX_CTL0);
+	v = readl(ioaddr + EMAC_TX_CTL0);
+	v |= EMAC_TX_FRM_LEN_CTL;
+	writel(v, ioaddr + EMAC_TX_CTL0);
 }
 
 static void sun8i_dwmac_set_mac(void __iomem *ioaddr, bool enable)
@@ -1286,7 +1349,13 @@ static int sun8i_dwmac_probe(struct platform_device *pdev)
 	plat_dat->mac_setup = sun8i_dwmac_setup;
 	plat_dat->tx_fifo_size = EMAC_TX_FIFO_SIZE;
 	plat_dat->rx_fifo_size = 16384;
-	plat_dat->maxmtu = EMAC_MAX_MTU;
+	sun8i_dwmac_set_burst_len(dev, gmac->variant, plat_dat->dma_cfg);
+	if (plat_dat->dma_cfg->pbl >= EMAC_JUMBO_MIN_BURSTLEN) {
+		plat_dat->flags |= STMMAC_FLAG_MTU_ABOVE_TXFIFO;
+		plat_dat->maxmtu = EMAC_MAX_MTU(EMAC_MAX_FRAME_LEN);
+	} else {
+		plat_dat->maxmtu = EMAC_MAX_MTU(EMAC_TX_FIFO_SIZE);
+	}
 
 	ret = sun8i_dwmac_set_syscon(&pdev->dev, plat_dat);
 	if (ret)
@@ -1374,6 +1443,8 @@ static const struct of_device_id sun8i_dwmac_match[] = {
 		.data = &emac_variant_a64 },
 	{ .compatible = "allwinner,sun50i-h6-emac",
 		.data = &emac_variant_h6 },
+	{ .compatible = "allwinner,sun50i-h616-emac0",
+		.data = &emac_variant_h616 },
 	{ .compatible = "allwinner,sun50i-h616-emac",
 		.data = &emac_variant_h6 },
 	{ .compatible = "allwinner,sun50i-h616-internal-emac",
diff --git a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
index 4ceef83..a385d5e 100644
--- a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
@@ -6259,7 +6259,8 @@ static int stmmac_change_mtu(struct net_device *dev, int new_mtu)
 	new_mtu = STMMAC_ALIGN(new_mtu);
 
 	/* If condition true, FIFO is too small or MTU too large */
-	if ((txfifosz < new_mtu) || (new_mtu > BUF_SIZE_16KiB))
+	if (!(priv->plat->flags & STMMAC_FLAG_MTU_ABOVE_TXFIFO) &&
+	    ((txfifosz < new_mtu) || (new_mtu > BUF_SIZE_16KiB)))
 		return -EINVAL;
 
 	if (netif_running(dev)) {
@@ -8127,6 +8128,8 @@ static int __stmmac_dvr_probe(struct device *device,
 
 	if (priv->plat->core_type == DWMAC_CORE_XGMAC)
 		ndev->max_mtu = XGMAC_JUMBO_LEN;
+	else if (priv->plat->flags & STMMAC_FLAG_MTU_ABOVE_TXFIFO)
+		ndev->max_mtu = BUF_SIZE_16KiB;
 	else if (priv->plat->enh_desc || priv->synopsys_id >= DWMAC_CORE_4_00 ||
 		 priv->descriptor_mode == STMMAC_CHAIN_MODE)
 		ndev->max_mtu = JUMBO_LEN;
diff --git a/include/linux/stmmac.h b/include/linux/stmmac.h
index 4430b96..4e1af5a 100644
--- a/include/linux/stmmac.h
+++ b/include/linux/stmmac.h
@@ -211,6 +211,7 @@ enum dwmac_core_type {
 #define STMMAC_FLAG_HWTSTAMP_CORRECT_LATENCY	BIT(14)
 #define STMMAC_FLAG_KEEP_PREAMBLE_BEFORE_SFD	BIT(15)
 #define STMMAC_FLAG_SERDES_SUPPORTS_2500M	BIT(16)
+#define STMMAC_FLAG_MTU_ABOVE_TXFIFO		BIT(17)
 
 struct mac_device_info;
 
-- 
Armbian
