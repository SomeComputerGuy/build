From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 13 Nov 2026 10:00:00 +0000
Subject: [PATCH] net: stmmac: dwmac-sun8i: jumbo frames up to 16 KiB

The EMAC handles frames up to 16384 bytes (H616 UM 6.1, RX/TX_CTL0
bit 30 FRM_LEN_CTL), but the MTU stops at 4070, the largest frame that
fits the 4 KiB TX FIFO for store-and-forward.

Larger frames need TX threshold mode, and then the DMA must outrun the
line: with bursts of 8 words it does not, and the TX FIFO underflows
inside the frame. Bursts of 16 or 32 keep it full.

- BASIC_CTL1 BURST_LEN from the variant (32 on H616 EMAC0, else 8) or
  snps,pbl/txpbl/rxpbl (largest; one field for RX and TX);
- with a burst length >= 16 (STMMAC_FLAG_TX_THRESH_JUMBO): max MTU
  16358, FRM_LEN_CTL set, frames above the TX FIFO sent in threshold
  mode without checksum insertion, and stmmac_change_mtu() skips the
  aligned-MTU FIFO/16368 checks;
- fix the TX/RX threshold mappings (TX mode 256 selected 64);
- a TX underflow resumes the TX DMA instead of resetting the TX ring.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 .../net/ethernet/stmicro/stmmac/dwmac-sun8i.c | 116 +++++++++++++++---
 drivers/net/ethernet/stmicro/stmmac/stmmac.h  |   3 +
 .../net/ethernet/stmicro/stmmac/stmmac_main.c |  26 +++-
 include/linux/stmmac.h                        |   1 +
 4 files changed, 126 insertions(+), 20 deletions(-)

diff --git a/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c b/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c
index 6ad13e1..024449d 100644
--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c
@@ -46,6 +46,9 @@ extern int sunxi_get_soc_chipid(unsigned char *chipid);
  *				These two also indicate the bitmask for
  *				the RX and TX delay chain registers. A
  *				value of zero indicates this is not supported.
+ * @dma_burst_len:		DMA burst length in words (EMAC_BASIC_CTL1
+ *				BURST_LEN) when the DT has no snps,pbl;
+ *				0 = 8
  */
 struct emac_variant {
 	const struct reg_field *syscon_field;
@@ -55,6 +58,7 @@ struct emac_variant {
 	bool support_rgmii;
 	u8 rx_delay_max;
 	u8 tx_delay_max;
+	u8 dma_burst_len;
 };
 
 /* struct sunxi_priv_data - hold all sunxi private data
@@ -137,6 +141,20 @@ static const struct emac_variant emac_variant_a64 = {
 	.tx_delay_max = 7,
 };
 
+/* H616 EMAC0 (1 Gbit/s RGMII): bursts of 32 words keep the 4 KiB TX FIFO full
+ * at 1 Gbit/s, so frames larger than the FIFO can be sent (MTU up to 16358)
+ */
+static const struct emac_variant emac_variant_h616 = {
+	.syscon_field = &sun8i_syscon_reg_field,
+	.soc_has_internal_phy = false,
+	.support_mii = true,
+	.support_rmii = true,
+	.support_rgmii = true,
+	.rx_delay_max = 31,
+	.tx_delay_max = 7,
+	.dma_burst_len = 32,
+};
+
 static const struct emac_variant emac_variant_h616_internal = {
 	.syscon_field = &sun8i_syscon_reg_field,
 	.soc_has_internal_phy = true,
@@ -192,6 +210,12 @@ static const struct emac_variant emac_variant_h6 = {
 
 /* Use in EMAC_BASIC_CTL1 */
 #define EMAC_BURSTLEN_SHIFT		24
+/* BURST_LEN is a 6-bit field in words, one value for RX and TX, with no
+ * 8x mode (snps,no-pbl-x8 does not apply); the snps,pbl binding allows up
+ * to 32
+ */
+#define EMAC_BURSTLEN_DEFAULT		8
+#define EMAC_BURSTLEN_MAX		32
 
 /* Used in EMAC_RX_FRM_FLT */
 #define EMAC_FRM_FLT_RXALL              BIT(0)
@@ -222,19 +246,26 @@ static const struct emac_variant emac_variant_h6 = {
 
 /* Used in RX_CTL0 */
 #define EMAC_RX_RECEIVER_EN             BIT(31)
+#define EMAC_RX_FRM_LEN_CTL		BIT(30)
 #define EMAC_RX_JUMBO_FRM_EN		BIT(29)
 #define EMAC_RX_DO_CRC BIT(27)
 #define EMAC_RX_FLOW_CTL_EN             BIT(16)
 
 /* Used in TX_CTL0 */
 #define EMAC_TX_TRANSMITTER_EN  BIT(31)
-
-/* Frames must fit in the 4 KiB TX FIFO, to be sent in store-and-forward
- * mode, with two VLAN tags and the FCS.
+#define EMAC_TX_FRM_LEN_CTL	BIT(30)
+
+/* With FRM_LEN_CTL set in RX_CTL0 and TX_CTL0, the EMAC receives and sends
+ * frames of up to 16384 bytes (else 10240 with JUMBO_FRM_EN). Frames that
+ * fit in the 4 KiB TX FIFO are sent in store-and-forward mode, larger ones
+ * in threshold mode (STMMAC_FLAG_TX_THRESH_JUMBO). In threshold mode the
+ * DMA must fill the FIFO faster than a 1 Gbit/s link empties it, which
+ * takes bursts of at least 16 words.
  */
 #define EMAC_TX_FIFO_SIZE	4096
-#define EMAC_MAX_MTU		(EMAC_TX_FIFO_SIZE - ETH_HLEN - \
-				 2 * VLAN_HLEN - ETH_FCS_LEN)
+#define EMAC_MAX_FRAME_LEN	16384
+#define EMAC_MAX_MTU(len)	((len) - ETH_HLEN - 2 * VLAN_HLEN - ETH_FCS_LEN)
+#define EMAC_JUMBO_MIN_BURSTLEN	16
 
 /* Used in EMAC_TX_FLOW_CTL */
 #define EMAC_TX_FLOW_CTL_EN             BIT(0)
@@ -338,7 +369,9 @@ static int sun8i_dwmac_dma_reset(void __iomem *ioaddr)
 static void sun8i_dwmac_dma_init(void __iomem *ioaddr,
 				 struct stmmac_dma_cfg *dma_cfg)
 {
-	writel(EMAC_RX_INT | EMAC_TX_INT, ioaddr + EMAC_INT_EN);
+	writel(dma_cfg->pbl << EMAC_BURSTLEN_SHIFT, ioaddr + EMAC_BASIC_CTL1);
+	writel(EMAC_RX_INT | EMAC_TX_INT | EMAC_TX_UNDERFLOW_INT,
+	       ioaddr + EMAC_INT_EN);
 	writel(0x1FFFFFF, ioaddr + EMAC_INT_STA);
 }
 
@@ -505,8 +538,17 @@ static int sun8i_dwmac_dma_interrupt(struct stmmac_priv *priv,
 	if (v & EMAC_TX_TIMEOUT_INT)
 		ret |= tx_hard_error;
 
+	/* An underflow (threshold mode only) aborts one frame, which its
+	 * descriptor reports, and suspends the TX DMA: resume it instead of
+	 * resetting the whole TX ring, so the frames queued behind it go out
+	 * without waiting for the next xmit. TX_DMA_START reads as 0; the
+	 * other TX_CTL1 bits only change while the interface is opened or
+	 * closed, when this interrupt cannot race with them.
+	 */
 	if (v & EMAC_TX_UNDERFLOW_INT) {
-		ret |= tx_hard_error;
+		writel(readl(ioaddr + EMAC_TX_CTL1) | EMAC_TX_DMA_START,
+		       ioaddr + EMAC_TX_CTL1);
+		ret |= handle_tx;
 		x->tx_undeflow_irq++;
 	}
 
@@ -557,13 +599,14 @@ static void sun8i_dwmac_dma_operation_mode_rx(struct stmmac_priv *priv,
 	} else {
 		v &= ~EMAC_RX_MD;
 		v &= ~EMAC_RX_TH_MASK;
-		if (mode < 32)
+		/* the smallest threshold of at least @mode bytes */
+		if (mode <= 32)
 			v |= EMAC_RX_TH_32;
-		else if (mode < 64)
+		else if (mode <= 64)
 			v |= EMAC_RX_TH_64;
-		else if (mode < 96)
+		else if (mode <= 96)
 			v |= EMAC_RX_TH_96;
-		else if (mode < 128)
+		else
 			v |= EMAC_RX_TH_128;
 	}
 	writel(v, ioaddr + EMAC_RX_CTL1);
@@ -587,13 +630,14 @@ static void sun8i_dwmac_dma_operation_mode_tx(struct stmmac_priv *priv,
 	} else {
 		v &= ~EMAC_TX_MD;
 		v &= ~EMAC_TX_TH_MASK;
-		if (mode < 64)
+		/* the smallest threshold of at least @mode bytes */
+		if (mode <= 64)
 			v |= EMAC_TX_TH_64;
-		else if (mode < 128)
+		else if (mode <= 128)
 			v |= EMAC_TX_TH_128;
-		else if (mode < 192)
+		else if (mode <= 192)
 			v |= EMAC_TX_TH_192;
-		else if (mode < 256)
+		else
 			v |= EMAC_TX_TH_256;
 	}
 	writel(v, ioaddr + EMAC_TX_CTL1);
@@ -656,21 +700,47 @@ err_disable_regulator_phy_io:
 	return ret;
 }
 
+/* One BURST_LEN for RX and TX: the largest of snps,pbl, snps,txpbl and
+ * snps,rxpbl, else the variant's default; kept in dma_cfg->pbl
+ */
+static void sun8i_dwmac_set_burst_len(struct device *dev,
+				      const struct emac_variant *variant,
+				      struct stmmac_dma_cfg *dma_cfg)
+{
+	u32 bl = max3(dma_cfg->pbl, dma_cfg->txpbl, dma_cfg->rxpbl);
+
+	if (!of_property_present(dev->of_node, "snps,pbl") &&
+	    !dma_cfg->txpbl && !dma_cfg->rxpbl)
+		bl = variant->dma_burst_len ?: EMAC_BURSTLEN_DEFAULT;
+	dma_cfg->pbl = clamp(bl, 1U, (u32)EMAC_BURSTLEN_MAX);
+}
+
 static void sun8i_dwmac_core_init(struct mac_device_info *hw,
 				  struct net_device *dev)
 {
+	struct stmmac_priv *priv = netdev_priv(dev);
 	void __iomem *ioaddr = hw->pcsr;
 	u32 v;
 
-	v = (8 << EMAC_BURSTLEN_SHIFT); /* burst len */
-	writel(v, ioaddr + EMAC_BASIC_CTL1);
-
 	/* Without JUMBO_FRM_EN, frames longer than 1518 bytes (1522 with a
 	 * VLAN tag) are dropped as length errors.
 	 */
 	v = readl(ioaddr + EMAC_RX_CTL0);
 	v |= EMAC_RX_JUMBO_FRM_EN;
 	writel(v, ioaddr + EMAC_RX_CTL0);
+
+	if (!(priv->plat->flags & STMMAC_FLAG_TX_THRESH_JUMBO))
+		return;
+
+	/* Without FRM_LEN_CTL, the receiver and the transmitter cut frames
+	 * off after 10240 bytes.
+	 */
+	v = readl(ioaddr + EMAC_RX_CTL0);
+	v |= EMAC_RX_FRM_LEN_CTL;
+	writel(v, ioaddr + EMAC_RX_CTL0);
+	v = readl(ioaddr + EMAC_TX_CTL0);
+	v |= EMAC_TX_FRM_LEN_CTL;
+	writel(v, ioaddr + EMAC_TX_CTL0);
 }
 
 static void sun8i_dwmac_set_mac(void __iomem *ioaddr, bool enable)
@@ -1286,7 +1356,13 @@ static int sun8i_dwmac_probe(struct platform_device *pdev)
 	plat_dat->mac_setup = sun8i_dwmac_setup;
 	plat_dat->tx_fifo_size = EMAC_TX_FIFO_SIZE;
 	plat_dat->rx_fifo_size = 16384;
-	plat_dat->maxmtu = EMAC_MAX_MTU;
+	sun8i_dwmac_set_burst_len(dev, gmac->variant, plat_dat->dma_cfg);
+	if (plat_dat->dma_cfg->pbl >= EMAC_JUMBO_MIN_BURSTLEN) {
+		plat_dat->flags |= STMMAC_FLAG_TX_THRESH_JUMBO;
+		plat_dat->maxmtu = EMAC_MAX_MTU(EMAC_MAX_FRAME_LEN);
+	} else {
+		plat_dat->maxmtu = EMAC_MAX_MTU(EMAC_TX_FIFO_SIZE);
+	}
 
 	ret = sun8i_dwmac_set_syscon(&pdev->dev, plat_dat);
 	if (ret)
@@ -1374,6 +1450,8 @@ static const struct of_device_id sun8i_dwmac_match[] = {
 		.data = &emac_variant_a64 },
 	{ .compatible = "allwinner,sun50i-h6-emac",
 		.data = &emac_variant_h6 },
+	{ .compatible = "allwinner,sun50i-h616-emac0",
+		.data = &emac_variant_h616 },
 	{ .compatible = "allwinner,sun50i-h616-emac",
 		.data = &emac_variant_h6 },
 	{ .compatible = "allwinner,sun50i-h616-internal-emac",
diff --git a/drivers/net/ethernet/stmicro/stmmac/stmmac.h b/drivers/net/ethernet/stmicro/stmmac/stmmac.h
index d2d387f..ac1d9d8 100644
--- a/drivers/net/ethernet/stmicro/stmmac/stmmac.h
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac.h
@@ -217,6 +217,8 @@ struct stmmac_rfs_entry {
 
 struct stmmac_dma_conf {
 	unsigned int dma_buf_sz;
+	/* largest frame of the MTU: with two VLAN tags and the FCS */
+	unsigned int max_frame;
 
 	/* RX Queue */
 	struct stmmac_rx_queue rx_queue[MTL_MAX_RX_QUEUES];
@@ -266,6 +268,7 @@ struct stmmac_priv {
 
 	int hwts_tx_en;
 	bool tx_path_in_lpi_mode;
+	bool tx_thresh_jumbo;
 	bool sph_active;
 	bool sph_capable;
 	u32 sarc_type;
diff --git a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
index 4ceef83..e54e81c 100644
--- a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
@@ -2612,6 +2612,18 @@ static void stmmac_dma_operation_mode(struct stmmac_priv *priv)
 		rxmode = SF_DMA_MODE;
 	}
 
+	/* A frame larger than the TX FIFO cannot be sent in store-and-forward
+	 * mode: use the threshold mode with the largest threshold (checksums are
+	 * inserted in software, stmmac_fix_features()).
+	 */
+	priv->tx_thresh_jumbo =
+		(priv->plat->flags & STMMAC_FLAG_TX_THRESH_JUMBO) &&
+		priv->dma_conf.max_frame > txfifosz / tx_channels_count;
+	if (priv->tx_thresh_jumbo) {
+		txmode = max_t(u32, tc, 256);
+		priv->xstats.threshold = txmode;
+	}
+
 	/* configure all channels */
 	for (chan = 0; chan < rx_channels_count; chan++) {
 		struct stmmac_rx_queue *rx_q = &priv->dma_conf.rx_queue[chan];
@@ -4079,6 +4091,7 @@ stmmac_setup_dma_desc(struct stmmac_priv *priv, unsigned int mtu)
 	}
 
 	len = mtu + ETH_HLEN + 2 * VLAN_HLEN + ETH_FCS_LEN;
+	dma_conf->max_frame = len;
 
 	/* Returns 0 or BUF_SIZE_16KiB if len > 8KiB and dwmac4 or ring mode */
 	bfsize = stmmac_set_16kib_bfsize(priv, len);
@@ -6259,7 +6272,8 @@ static int stmmac_change_mtu(struct net_device *dev, int new_mtu)
 	new_mtu = STMMAC_ALIGN(new_mtu);
 
 	/* If condition true, FIFO is too small or MTU too large */
-	if ((txfifosz < new_mtu) || (new_mtu > BUF_SIZE_16KiB))
+	if (!(priv->plat->flags & STMMAC_FLAG_TX_THRESH_JUMBO) &&
+	    ((txfifosz < new_mtu) || (new_mtu > BUF_SIZE_16KiB)))
 		return -EINVAL;
 
 	if (netif_running(dev)) {
@@ -6304,6 +6318,14 @@ static netdev_features_t stmmac_fix_features(struct net_device *dev,
 	if (!priv->plat->tx_coe)
 		features &= ~NETIF_F_CSUM_MASK;
 
+	/* no checksum insertion in the TX threshold mode (frames larger than
+	 * the TX FIFO)
+	 */
+	if ((priv->plat->flags & STMMAC_FLAG_TX_THRESH_JUMBO) &&
+	    dev->mtu + ETH_HLEN + 2 * VLAN_HLEN + ETH_FCS_LEN >
+	    priv->plat->tx_fifo_size / priv->plat->tx_queues_to_use)
+		features &= ~NETIF_F_CSUM_MASK;
+
 	/* Some GMAC devices have a bugged Jumbo frame support that
 	 * needs to have the Tx COE disabled for oversized frames
 	 * (due to limited buffer sizes). In this case we disable
@@ -8127,6 +8149,8 @@ static int __stmmac_dvr_probe(struct device *device,
 
 	if (priv->plat->core_type == DWMAC_CORE_XGMAC)
 		ndev->max_mtu = XGMAC_JUMBO_LEN;
+	else if (priv->plat->flags & STMMAC_FLAG_TX_THRESH_JUMBO)
+		ndev->max_mtu = BUF_SIZE_16KiB;
 	else if (priv->plat->enh_desc || priv->synopsys_id >= DWMAC_CORE_4_00 ||
 		 priv->descriptor_mode == STMMAC_CHAIN_MODE)
 		ndev->max_mtu = JUMBO_LEN;
diff --git a/include/linux/stmmac.h b/include/linux/stmmac.h
index 4430b96..d21b50c 100644
--- a/include/linux/stmmac.h
+++ b/include/linux/stmmac.h
@@ -211,6 +211,7 @@ enum dwmac_core_type {
 #define STMMAC_FLAG_HWTSTAMP_CORRECT_LATENCY	BIT(14)
 #define STMMAC_FLAG_KEEP_PREAMBLE_BEFORE_SFD	BIT(15)
 #define STMMAC_FLAG_SERDES_SUPPORTS_2500M	BIT(16)
+#define STMMAC_FLAG_TX_THRESH_JUMBO		BIT(17)
 
 struct mac_device_info;
 
