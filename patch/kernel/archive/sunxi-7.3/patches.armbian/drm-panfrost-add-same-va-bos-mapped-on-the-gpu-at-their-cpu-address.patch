From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Tue, 10 Nov 2026 01:30:24 +0000
Subject: [PATCH] drm/panfrost: Add SAME_VA BOs mapped on the GPU at their CPU
 address

OpenCL 2.0 shared virtual memory needs a pointer that means the same
thing on the CPU and on the GPU. Arm's kbase driver gets that with
BASE_MEM_SAME_VA: the allocation gets no GPU address at creation, its
mmap() picks the CPU address below the end of the GPU VA space, and the
GPU mapping is inserted at that address. Do the same in panfrost:

- PANFROST_BO_SAME_VA (CREATE_BO): no GPU mapping per handle; the
  returned offset is 0. Requires NOEXEC, excludes HEAP.
- mmap() of such a BO through the DRM fd maps the whole BO on the GPU at
  vma->vm_start. The address must lie in the SAME_VA zone, from 4G (the
  ordinary BOs stay below 4G as before) to the end of the GPU VA space
  (2^va_bits, 8G on a Mali-G31). get_unmapped_area places the mapping
  top-down in that zone, or at the hint or MAP_FIXED address.
- The GPU mapping lives as long as the CPU mapping (fork copies count),
  not as long as the handle. Splitting or moving the CPU mapping is
  refused, and so is exporting the BO, so the two addresses cannot drift
  apart. One SAME_VA mapping per BO and DRM fd.
- DRM_PANFROST_PARAM_SAME_VA_START/_END report the zone; an empty zone
  means no SAME_VA support. Userspace detects the feature by these
  parameters, so the driver version is unchanged.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/gpu/drm/panfrost/panfrost_drv.c |  98 +++++++++++-
 drivers/gpu/drm/panfrost/panfrost_gem.c | 202 +++++++++++++++++++++++-
 drivers/gpu/drm/panfrost/panfrost_gem.h |   5 +
 drivers/gpu/drm/panfrost/panfrost_mmu.c |  19 ++-
 drivers/gpu/drm/panfrost/panfrost_mmu.h |  10 ++
 include/uapi/drm/panfrost_drm.h         |  15 +-
 6 files changed, 341 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/panfrost/panfrost_drv.c b/drivers/gpu/drm/panfrost/panfrost_drv.c
index 36cc2e6..72b1bb9 100644
--- a/drivers/gpu/drm/panfrost/panfrost_drv.c
+++ b/drivers/gpu/drm/panfrost/panfrost_drv.c
@@ -7,6 +7,8 @@
 #include <asm/arch_timer.h>
 #endif
 
+#include <linux/mm.h>
+#include <linux/mman.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/pagemap.h>
@@ -19,6 +21,7 @@
 #include <drm/drm_print.h>
 #include <drm/drm_syncobj.h>
 #include <drm/drm_utils.h>
+#include <drm/drm_vma_manager.h>
 
 #include "panfrost_device.h"
 #include "panfrost_drv.h"
@@ -98,6 +101,14 @@ static int panfrost_ioctl_get_param(struct drm_device *ddev, void *data, struct
 		PANFROST_FEATURE(THREAD_TLS_ALLOC, thread_tls_alloc);
 		PANFROST_FEATURE(SELECTED_COHERENCY, selected_coherency);
 
+	case DRM_PANFROST_PARAM_SAME_VA_START:
+		param->value = PANFROST_SAME_VA_START;
+		break;
+
+	case DRM_PANFROST_PARAM_SAME_VA_END:
+		param->value = panfrost_mmu_same_va_end(pfdev);
+		break;
+
 	case DRM_PANFROST_PARAM_SYSTEM_TIMESTAMP:
 		ret = panfrost_ioctl_query_timestamp(pfdev, &param->value);
 		if (ret)
@@ -129,7 +140,8 @@ static int panfrost_ioctl_get_param(struct drm_device *ddev, void *data, struct
 
 #define PANFROST_BO_FLAGS	(PANFROST_BO_NOEXEC | \
 				 PANFROST_BO_HEAP | \
-				 PANFROST_BO_WB_MMAP)
+				 PANFROST_BO_WB_MMAP | \
+				 PANFROST_BO_SAME_VA)
 
 static int panfrost_ioctl_create_bo(struct drm_device *dev, void *data,
 		struct drm_file *file)
@@ -148,6 +160,17 @@ static int panfrost_ioctl_create_bo(struct drm_device *dev, void *data,
 	    !(args->flags & PANFROST_BO_NOEXEC))
 		return -EINVAL;
 
+	/*
+	 * SAME_VA BOs are plain data and need GPU VA space above 4G; their
+	 * GPU address comes with the mmap().
+	 */
+	if ((args->flags & PANFROST_BO_SAME_VA) &&
+	    (!(args->flags & PANFROST_BO_NOEXEC) ||
+	     (args->flags & PANFROST_BO_HEAP) ||
+	     panfrost_mmu_same_va_end(to_panfrost_device(dev)) <=
+	     PANFROST_SAME_VA_START))
+		return -EINVAL;
+
 	bo = panfrost_gem_create(dev, args->size, args->flags);
 	if (IS_ERR(bo))
 		return PTR_ERR(bo);
@@ -156,6 +179,11 @@ static int panfrost_ioctl_create_bo(struct drm_device *dev, void *data,
 	if (ret)
 		goto out;
 
+	if (bo->same_va) {
+		args->offset = 0;
+		goto out;
+	}
+
 	mapping = panfrost_gem_mapping_get(bo, priv);
 	if (mapping) {
 		args->offset = mapping->mmnode.start << PAGE_SHIFT;
@@ -664,6 +692,9 @@ static int panfrost_ioctl_query_bo_info(struct drm_device *dev, void *data,
 
 		if (!bo->base.map_wc)
 			args->create_flags |= PANFROST_BO_WB_MMAP;
+
+		if (bo->same_va)
+			args->create_flags |= PANFROST_BO_SAME_VA;
 	}
 
 	drm_gem_object_put(gem_obj);
@@ -787,9 +818,72 @@ static void panfrost_show_fdinfo(struct drm_printer *p, struct drm_file *file)
 	drm_show_memory_stats(p, file);
 }
 
+/*
+ * mmap() of a PANFROST_BO_SAME_VA BO picks its CPU address, which becomes its
+ * GPU address, in the SAME_VA zone (the kbase SAME_VA model): top-down below
+ * the end of the GPU VA space, or at the caller's hint or MAP_FIXED address,
+ * which panfrost_gem_mmap() checks. Other BOs take the GEM default.
+ */
+static unsigned long
+panfrost_get_unmapped_area(struct file *filp, unsigned long addr,
+			   unsigned long len, unsigned long pgoff,
+			   unsigned long flags)
+{
+	MA_STATE(mas, &current->mm->mm_mt, 0, 0);
+	struct drm_file *file = filp->private_data;
+	struct drm_device *ddev = file->minor->dev;
+	struct drm_vma_offset_node *node;
+	unsigned long low = PANFROST_SAME_VA_START, high;
+	bool same_va = false;
+
+	/*
+	 * Freeing a BO removes its offset node under this lock first, so the
+	 * object stays valid while it is held.
+	 */
+	drm_vma_offset_lock_lookup(ddev->vma_offset_manager);
+	node = drm_vma_offset_exact_lookup_locked(ddev->vma_offset_manager,
+						  pgoff, len >> PAGE_SHIFT);
+	if (node)
+		same_va = to_panfrost_bo(container_of(node, struct drm_gem_object,
+						      vma_node))->same_va;
+	drm_vma_offset_unlock_lookup(ddev->vma_offset_manager);
+
+	if (!same_va)
+		return drm_gem_get_unmapped_area(filp, addr, len, pgoff, flags);
+
+	high = min_t(u64, panfrost_mmu_same_va_end(to_panfrost_device(ddev)),
+		     arch_get_mmap_end(addr, len, flags));
+	if (high <= low || len > high - low)
+		return -ENOMEM;
+
+	if (flags & MAP_FIXED)
+		return addr;
+
+	if (addr) {
+		addr = PAGE_ALIGN(addr);
+		if (addr >= low && len <= high - addr &&
+		    !find_vma_intersection(current->mm, addr, addr + len))
+			return addr;
+	}
+
+	if (mas_empty_area_rev(&mas, low, high - 1, len))
+		return -ENOMEM;
+
+	return mas.last + 1 - len;
+}
+
 static const struct file_operations panfrost_drm_driver_fops = {
 	.owner = THIS_MODULE,
-	DRM_GEM_FOPS,
+	.open = drm_open,
+	.release = drm_release,
+	.unlocked_ioctl = drm_ioctl,
+	.compat_ioctl = drm_compat_ioctl,
+	.poll = drm_poll,
+	.read = drm_read,
+	.llseek = noop_llseek,
+	.get_unmapped_area = panfrost_get_unmapped_area,
+	.mmap = drm_gem_mmap,
+	.fop_flags = FOP_UNSIGNED_OFFSET,
 	.show_fdinfo = drm_show_fdinfo,
 };
 
diff --git a/drivers/gpu/drm/panfrost/panfrost_gem.c b/drivers/gpu/drm/panfrost/panfrost_gem.c
index 3a7fce4..b735cf6 100644
--- a/drivers/gpu/drm/panfrost/panfrost_gem.c
+++ b/drivers/gpu/drm/panfrost/panfrost_gem.c
@@ -175,6 +175,10 @@ int panfrost_gem_open(struct drm_gem_object *obj, struct drm_file *file_priv)
 	struct panfrost_file_priv *priv = file_priv->driver_priv;
 	struct panfrost_gem_mapping *mapping;
 
+	/* SAME_VA BOs are mapped on the GPU by mmap(), not per handle. */
+	if (bo->same_va)
+		return 0;
+
 	mapping = kzalloc_obj(*mapping);
 	if (!mapping)
 		return -ENOMEM;
@@ -197,8 +201,10 @@ int panfrost_gem_open(struct drm_gem_object *obj, struct drm_file *file_priv)
 
 	mapping->mmu = panfrost_mmu_ctx_get(priv->mmu);
 	spin_lock(&mapping->mmu->mm_lock);
-	ret = drm_mm_insert_node_generic(&mapping->mmu->mm, &mapping->mmnode,
-					 size >> PAGE_SHIFT, align, color, 0);
+	ret = drm_mm_insert_node_in_range(&mapping->mmu->mm, &mapping->mmnode,
+					  size >> PAGE_SHIFT, align, color,
+					  0, PANFROST_SAME_VA_START >> PAGE_SHIFT,
+					  DRM_MM_INSERT_BEST);
 	spin_unlock(&mapping->mmu->mm_lock);
 	if (ret)
 		goto err;
@@ -226,6 +232,10 @@ void panfrost_gem_close(struct drm_gem_object *obj, struct drm_file *file_priv)
 	struct panfrost_gem_object *bo = to_panfrost_bo(obj);
 	struct panfrost_gem_mapping *mapping = NULL, *iter;
 
+	/* The CPU mapping owns the GPU mapping of a SAME_VA BO. */
+	if (bo->same_va)
+		return;
+
 	mutex_lock(&bo->mappings.lock);
 	list_for_each_entry(iter, &bo->mappings.list, node) {
 		if (iter->mmu == priv->mmu) {
@@ -379,6 +389,10 @@ panfrost_gem_prime_export(struct drm_gem_object *obj, int flags)
 		.resv = obj->resv,
 	};
 
+	/* The GPU address of a SAME_VA BO belongs to one CPU mapping. */
+	if (to_panfrost_bo(obj)->same_va)
+		return ERR_PTR(-EINVAL);
+
 	return drm_gem_dmabuf_export(dev, &exp_info);
 }
 
@@ -399,6 +413,187 @@ panfrost_gem_prime_import(struct drm_device *dev,
 	return drm_gem_prime_import(dev, dma_buf);
 }
 
+/*
+ * PANFROST_BO_SAME_VA: the BO is mapped on the GPU at the address of its CPU
+ * mapping, for as long as that CPU mapping exists (fork copies included). The
+ * mapping is found through the mmapping DRM file, of which there is one GPU
+ * mapping per BO at most.
+ */
+static struct panfrost_gem_mapping *
+panfrost_gem_same_va_find(struct panfrost_gem_object *bo,
+			  struct vm_area_struct *vma)
+{
+	struct drm_file *file = vma->vm_file->private_data;
+	struct panfrost_file_priv *priv = file->driver_priv;
+	struct panfrost_gem_mapping *iter;
+
+	lockdep_assert_held(&bo->mappings.lock);
+
+	list_for_each_entry(iter, &bo->mappings.list, node) {
+		if (iter->mmu == priv->mmu)
+			return iter;
+	}
+
+	return NULL;
+}
+
+static int panfrost_gem_same_va_map(struct panfrost_gem_object *bo,
+				    struct vm_area_struct *vma)
+{
+	struct drm_gem_object *obj = &bo->base.base;
+	struct panfrost_device *pfdev = to_panfrost_device(obj->dev);
+	struct drm_file *file = vma->vm_file->private_data;
+	struct panfrost_file_priv *priv = file->driver_priv;
+	struct panfrost_gem_mapping *mapping;
+	int ret;
+
+	/* The whole BO, inside the SAME_VA zone. */
+	if (vma->vm_end - vma->vm_start != obj->size ||
+	    vma->vm_start < PANFROST_SAME_VA_START ||
+	    vma->vm_end > panfrost_mmu_same_va_end(pfdev))
+		return -EINVAL;
+
+	mapping = kzalloc_obj(*mapping);
+	if (!mapping)
+		return -ENOMEM;
+
+	INIT_LIST_HEAD(&mapping->node);
+	kref_init(&mapping->refcount);
+	drm_gem_object_get(obj);
+	mapping->obj = bo;
+	mapping->mmu = panfrost_mmu_ctx_get(priv->mmu);
+	mapping->same_va_vmas = 1;
+	mapping->mmnode.start = vma->vm_start >> PAGE_SHIFT;
+	mapping->mmnode.size = obj->size >> PAGE_SHIFT;
+	mapping->mmnode.color = PANFROST_BO_NOEXEC;
+
+	spin_lock(&mapping->mmu->mm_lock);
+	ret = drm_mm_reserve_node(&mapping->mmu->mm, &mapping->mmnode);
+	spin_unlock(&mapping->mmu->mm_lock);
+	if (ret)
+		goto err;
+
+	ret = panfrost_mmu_map(mapping);
+	if (ret)
+		goto err;
+
+	mutex_lock(&bo->mappings.lock);
+	if (panfrost_gem_same_va_find(bo, vma))
+		ret = -EBUSY;
+	else
+		list_add_tail(&mapping->node, &bo->mappings.list);
+	mutex_unlock(&bo->mappings.lock);
+
+err:
+	if (ret)
+		panfrost_gem_mapping_put(mapping);
+	return ret;
+}
+
+static void panfrost_gem_same_va_unmap(struct vm_area_struct *vma)
+{
+	struct panfrost_gem_object *bo = to_panfrost_bo(vma->vm_private_data);
+	struct panfrost_gem_mapping *mapping;
+
+	mutex_lock(&bo->mappings.lock);
+	mapping = panfrost_gem_same_va_find(bo, vma);
+	if (WARN_ON(!mapping) || --mapping->same_va_vmas)
+		mapping = NULL;
+	else
+		list_del(&mapping->node);
+	mutex_unlock(&bo->mappings.lock);
+
+	/* Jobs still using the mapping hold their own reference. */
+	panfrost_gem_mapping_put(mapping);
+}
+
+static void panfrost_gem_same_va_vm_open(struct vm_area_struct *vma)
+{
+	struct panfrost_gem_object *bo = to_panfrost_bo(vma->vm_private_data);
+	struct panfrost_gem_mapping *mapping;
+
+	mutex_lock(&bo->mappings.lock);
+	mapping = panfrost_gem_same_va_find(bo, vma);
+	if (!WARN_ON(!mapping))
+		mapping->same_va_vmas++;
+	mutex_unlock(&bo->mappings.lock);
+
+	drm_gem_shmem_vm_ops.open(vma);
+}
+
+static void panfrost_gem_same_va_vm_close(struct vm_area_struct *vma)
+{
+	panfrost_gem_same_va_unmap(vma);
+
+	/* Drops the BO reference of the VMA: last. */
+	drm_gem_shmem_vm_ops.close(vma);
+}
+
+/* A part or a move of the CPU mapping would leave the GPU address behind. */
+static int panfrost_gem_same_va_may_split(struct vm_area_struct *vma,
+					  unsigned long addr)
+{
+	return -EINVAL;
+}
+
+static int panfrost_gem_same_va_mremap(struct vm_area_struct *vma)
+{
+	return -EINVAL;
+}
+
+static vm_fault_t panfrost_gem_same_va_fault(struct vm_fault *vmf)
+{
+	return drm_gem_shmem_vm_ops.fault(vmf);
+}
+
+#ifdef CONFIG_ARCH_SUPPORTS_PMD_PFNMAP
+static vm_fault_t panfrost_gem_same_va_huge_fault(struct vm_fault *vmf,
+						  unsigned int order)
+{
+	return drm_gem_shmem_vm_ops.huge_fault(vmf, order);
+}
+#endif
+
+static vm_fault_t panfrost_gem_same_va_pfn_mkwrite(struct vm_fault *vmf)
+{
+	return drm_gem_shmem_vm_ops.pfn_mkwrite(vmf);
+}
+
+static const struct vm_operations_struct panfrost_gem_same_va_vm_ops = {
+	.fault = panfrost_gem_same_va_fault,
+#ifdef CONFIG_ARCH_SUPPORTS_PMD_PFNMAP
+	.huge_fault = panfrost_gem_same_va_huge_fault,
+#endif
+	.open = panfrost_gem_same_va_vm_open,
+	.close = panfrost_gem_same_va_vm_close,
+	.may_split = panfrost_gem_same_va_may_split,
+	.mremap = panfrost_gem_same_va_mremap,
+	.pfn_mkwrite = panfrost_gem_same_va_pfn_mkwrite,
+};
+
+static int panfrost_gem_mmap(struct drm_gem_object *obj,
+			     struct vm_area_struct *vma)
+{
+	struct panfrost_gem_object *bo = to_panfrost_bo(obj);
+	int ret;
+
+	if (!bo->same_va)
+		return drm_gem_shmem_object_mmap(obj, vma);
+
+	ret = panfrost_gem_same_va_map(bo, vma);
+	if (ret)
+		return ret;
+
+	ret = drm_gem_shmem_object_mmap(obj, vma);
+	if (ret) {
+		panfrost_gem_same_va_unmap(vma);
+		return ret;
+	}
+
+	vma->vm_ops = &panfrost_gem_same_va_vm_ops;
+	return 0;
+}
+
 static const struct drm_gem_object_funcs panfrost_gem_funcs = {
 	.free = panfrost_gem_free_object,
 	.open = panfrost_gem_open,
@@ -410,7 +605,7 @@ static const struct drm_gem_object_funcs panfrost_gem_funcs = {
 	.export = panfrost_gem_prime_export,
 	.vmap = drm_gem_shmem_object_vmap,
 	.vunmap = drm_gem_shmem_object_vunmap,
-	.mmap = drm_gem_shmem_object_mmap,
+	.mmap = panfrost_gem_mmap,
 	.status = panfrost_gem_status,
 	.rss = panfrost_gem_rss,
 	.vm_ops = &drm_gem_shmem_vm_ops,
@@ -492,6 +687,7 @@ panfrost_gem_create(struct drm_device *dev, size_t size, u32 flags)
 	bo->noexec = !!(flags & PANFROST_BO_NOEXEC);
 	bo->is_heap = !!(flags & PANFROST_BO_HEAP);
 	bo->wb_mmap = !!(flags & PANFROST_BO_WB_MMAP);
+	bo->same_va = !!(flags & PANFROST_BO_SAME_VA);
 	bo->base.map_wc = should_map_wc(bo);
 
 	return bo;
diff --git a/drivers/gpu/drm/panfrost/panfrost_gem.h b/drivers/gpu/drm/panfrost/panfrost_gem.h
index 79d4377..df362da 100644
--- a/drivers/gpu/drm/panfrost/panfrost_gem.h
+++ b/drivers/gpu/drm/panfrost/panfrost_gem.h
@@ -103,6 +103,9 @@ struct panfrost_gem_object {
 	 */
 	bool wb_mmap		:1;
 
+	/* GPU-mapped at its CPU address when mmap()ed (PANFROST_BO_SAME_VA). */
+	bool same_va		:1;
+
 #ifdef CONFIG_DEBUG_FS
 	struct panfrost_gem_debugfs debugfs;
 #endif
@@ -114,6 +117,8 @@ struct panfrost_gem_mapping {
 	struct panfrost_gem_object *obj;
 	struct drm_mm_node mmnode;
 	struct panfrost_mmu *mmu;
+	/* SAME_VA mappings: CPU VMAs (fork copies included) that hold it. */
+	unsigned int same_va_vmas;
 	bool active		:1;
 };
 
diff --git a/drivers/gpu/drm/panfrost/panfrost_mmu.c b/drivers/gpu/drm/panfrost/panfrost_mmu.c
index 8a1a80c..4cb39f0 100644
--- a/drivers/gpu/drm/panfrost/panfrost_mmu.c
+++ b/drivers/gpu/drm/panfrost/panfrost_mmu.c
@@ -893,6 +893,17 @@ static void panfrost_drm_mm_color_adjust(const struct drm_mm_node *node,
 	}
 }
 
+u64 panfrost_mmu_same_va_end(struct panfrost_device *pfdev)
+{
+	u32 va_bits = GPU_MMU_FEATURES_VA_BITS(pfdev->features.mmu_features);
+
+	/* No SAME_VA zone without GPU VA space above 4 GB. */
+	if (va_bits <= 32)
+		return PANFROST_SAME_VA_START;
+
+	return BIT_ULL(min(va_bits, 48U));
+}
+
 struct panfrost_mmu *panfrost_mmu_ctx_create(struct panfrost_device *pfdev)
 {
 	u32 va_bits = GPU_MMU_FEATURES_VA_BITS(pfdev->features.mmu_features);
@@ -919,8 +930,12 @@ struct panfrost_mmu *panfrost_mmu_ctx_create(struct panfrost_device *pfdev)
 	mmu->pfdev = pfdev;
 	spin_lock_init(&mmu->mm_lock);
 
-	/* 4G enough for now. can be 48-bit */
-	drm_mm_init(&mmu->mm, SZ_32M >> PAGE_SHIFT, (SZ_4G - SZ_32M) >> PAGE_SHIFT);
+	/*
+	 * Ordinary BOs stay below 4G (panfrost_gem_open()); the rest of the VA
+	 * space is the SAME_VA zone.
+	 */
+	drm_mm_init(&mmu->mm, SZ_32M >> PAGE_SHIFT,
+		    (panfrost_mmu_same_va_end(pfdev) - SZ_32M) >> PAGE_SHIFT);
 	mmu->mm.color_adjust = panfrost_drm_mm_color_adjust;
 
 	INIT_LIST_HEAD(&mmu->list);
diff --git a/drivers/gpu/drm/panfrost/panfrost_mmu.h b/drivers/gpu/drm/panfrost/panfrost_mmu.h
index 27c3c65..1eace47 100644
--- a/drivers/gpu/drm/panfrost/panfrost_mmu.h
+++ b/drivers/gpu/drm/panfrost/panfrost_mmu.h
@@ -4,6 +4,9 @@
 #ifndef __PANFROST_MMU_H__
 #define __PANFROST_MMU_H__
 
+#include <linux/sizes.h>
+#include <linux/types.h>
+
 struct panfrost_device;
 struct panfrost_gem_mapping;
 struct panfrost_file_priv;
@@ -24,4 +27,11 @@ struct panfrost_mmu *panfrost_mmu_ctx_get(struct panfrost_mmu *mmu);
 void panfrost_mmu_ctx_put(struct panfrost_mmu *mmu);
 struct panfrost_mmu *panfrost_mmu_ctx_create(struct panfrost_device *pfdev);
 
+/*
+ * Ordinary BOs get a GPU address below 4 GB. PANFROST_BO_SAME_VA BOs are
+ * mapped at their CPU address, between 4 GB and the end of the GPU VA space.
+ */
+#define PANFROST_SAME_VA_START	SZ_4G
+u64 panfrost_mmu_same_va_end(struct panfrost_device *pfdev);
+
 #endif
diff --git a/include/uapi/drm/panfrost_drm.h b/include/uapi/drm/panfrost_drm.h
index 50d5337..64b4559 100644
--- a/include/uapi/drm/panfrost_drm.h
+++ b/include/uapi/drm/panfrost_drm.h
@@ -126,10 +126,20 @@ struct drm_panfrost_wait_bo {
 
 /* Valid flags to pass to drm_panfrost_create_bo.
  * PANFROST_BO_WB_MMAP can't be set if PANFROST_BO_HEAP is.
