diff -ruN a/drivers/gpu/drm/sun4i/sun50i_wb.c b/drivers/gpu/drm/sun4i/sun50i_wb.c
--- a/drivers/gpu/drm/sun4i/sun50i_wb.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/gpu/drm/sun4i/sun50i_wb.c	2026-11-06 00:32:37.581855865 +0000
@@ -0,0 +1,915 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Allwinner H616 DE33 real-time write-back unit (RT-WB) as a DRM writeback
+ * connector.
+ *
+ * The RT-WB sits behind a mux on the DE top block that selects the output
+ * of one of the blenders (the composed frame of a mixer, before the TCON),
+ * optionally scales it or converts it to YCbCr, and writes it to memory.
+ * One capture is one frame: writing the start bit while the beam is in the
+ * vertical blanking makes the unit record the frame that follows, and its
+ * FINISH status bit is set once that frame has been written out. The unit is
+ * then stopped and reset, as the vendor driver does after every capture.
+ *
+ * The jobs are driven from the mixer's TCON vblank interrupt
+ * (sun50i_mixer_vblank_quirk() -> sun50i_wb_vblank()), right after the
+ * mixer has written its latched registers for the frame: a job is started
+ * there, so the first frame scanned out with the committed state is the one
+ * captured, and its status is read at the next vblank, where the next queued
+ * job is started. The H616 has no separate write-back interrupt line and the
+ * DE interrupt is not wired up for the mixers; polling once per frame from
+ * the interrupt that is already there costs one register read.
+ *
+ * The RT-WB is a memory client of the display engine and shares its IOMMU
+ * master (master 0, "DE", with the planes). Its node therefore has no iommus
+ * property of its own: the framebuffers it writes are allocated by DRM
+ * through the planes device (the DRM DMA device) and mapped in that domain,
+ * and the addresses programmed here are the IOVAs of those buffers.
+ */
+
+#include <linux/clk.h>
+#include <linux/component.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/list.h>
+#include <linux/math64.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/reset.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_crtc.h>
+#include <drm/drm_device.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_encoder.h>
+#include <drm/drm_fb_dma_helper.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_print.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_vblank.h>
+#include <drm/drm_writeback.h>
+
+#include "sun4i_crtc.h"
+#include "sun50i_wb.h"
+#include "sun8i_csc.h"
+#include "sun8i_mixer.h"
+#include "sunxi_engine.h"
+
+/* RT-WB block layout (DE + 0x10000): the write-back core, then a CDC unit */
+#define SUN50I_WB_CORE_OFFSET		0x1000
+
+/* write-back core registers (vendor de_wb_type.h) */
+#define SUN50I_WB_GCTRL			0x00
+#define SUN50I_WB_GCTRL_CLK_GATE	BIT(29)
+#define SUN50I_WB_GCTRL_AUTO_GATE	BIT(28)
+#define SUN50I_WB_GCTRL_SOFT_RESET	BIT(4)
+#define SUN50I_WB_GCTRL_START		BIT(0)
+#define SUN50I_WB_SIZE			0x04
+#define SUN50I_WB_CROP_COORD		0x08
+#define SUN50I_WB_CROP_SIZE		0x0c
+#define SUN50I_WB_A_ADDR(n)		(0x10 + (n) * 4)
+#define SUN50I_WB_A_HIGH_ADDR		0x1c
+#define SUN50I_WB_PITCH0		0x30
+#define SUN50I_WB_PITCH1		0x34
+#define SUN50I_WB_ADDR_SWITCH		0x40
+#define SUN50I_WB_FORMAT		0x44
+#define SUN50I_WB_FORMAT_RGB888		0x0
+#define SUN50I_WB_FORMAT_BGR888		0x1
+#define SUN50I_WB_FORMAT_XRGB8888	0x4
+#define SUN50I_WB_FORMAT_XBGR8888	0x5
+#define SUN50I_WB_FORMAT_BGRX8888	0x6
+#define SUN50I_WB_FORMAT_RGBX8888	0x7
+#define SUN50I_WB_FORMAT_YUV420		0x8
+#define SUN50I_WB_FORMAT_NV12		0xc
+#define SUN50I_WB_FORMAT_NV21		0xd
+#define SUN50I_WB_FORMAT_10BIT		BIT(4)
+#define SUN50I_WB_INT			0x48
+#define SUN50I_WB_STATUS		0x4c
+#define SUN50I_WB_STATUS_BUSY		BIT(8)
+#define SUN50I_WB_STATUS_TIMEOUT	BIT(6)
+#define SUN50I_WB_STATUS_OVERFLOW	BIT(5)
+#define SUN50I_WB_STATUS_FINISH		BIT(4)
+#define SUN50I_WB_STATUS_IRQ		BIT(0)
+#define SUN50I_WB_STATUS_W1C		(SUN50I_WB_STATUS_TIMEOUT | \
+					 SUN50I_WB_STATUS_OVERFLOW | \
+					 SUN50I_WB_STATUS_FINISH | \
+					 SUN50I_WB_STATUS_IRQ)
+#define SUN50I_WB_SFTM			0x50
+#define SUN50I_WB_SFTM_VS_DEFAULT	0x20
+#define SUN50I_WB_BYPASS		0x54
+#define SUN50I_WB_BYPASS_CS_EN		BIT(1)
+#define SUN50I_WB_BYPASS_FS_EN		BIT(2)
+#define SUN50I_WB_CS_HORZ		0x70
+#define SUN50I_WB_CS_VERT		0x74
+#define SUN50I_WB_FS_INSIZE		0x80
+#define SUN50I_WB_FS_OUTSIZE		0x84
+#define SUN50I_WB_FS_HSTEP		0x88
+#define SUN50I_WB_FS_VSTEP		0x8c
+#define SUN50I_WB_FS_STEP_ONE		BIT(20)
+#define SUN50I_WB_CSC_CTL		0x90
+/* d0, d1, d2, c0[4], c1[4], c2[4]: same layout as the DE33 layer CSC */
+#define SUN50I_WB_CSC_COEFF(n)		(0x94 + (n) * 4)
+#define SUN50I_WB_CSC_COEFF_NUM		15
+#define SUN50I_WB_YHCOEFF(n)		(0x200 + (n) * 4)
+#define SUN50I_WB_CHCOEFF(n)		(0x280 + (n) * 4)
+#define SUN50I_WB_SCALER_PHASES		16
+
+/* DE top block (display_clocks syscon): RT-WB input routing and control */
+#define SUN50I_DE33_RTWB_MUX_REG	0x20
+#define SUN50I_DE33_RTWB_MUX_MASK	GENMASK(2, 0)
+#define SUN50I_DE33_RTWB_MUX_BLENDER(n)	((n) * 2)
+#define SUN50I_DE33_RTWB_START		BIT(4)
+#define SUN50I_DE33_RTWB_SELF_TIMING	BIT(5)
+
+#define SUN50I_WB_SIZE_REG(w, h)	((((h) - 1) << 16) | ((w) - 1))
+
+#define SUN50I_WB_MIN_WIDTH		8
+#define SUN50I_WB_MIN_HEIGHT		4
+#define SUN50I_WB_MAX_WIDTH		4096
+#define SUN50I_WB_MAX_HEIGHT		4096
+/* output line buffer (vendor LINE_BUF_LEN) */
+#define SUN50I_WB_MAX_OUT_WIDTH		2048
+#define SUN50I_WB_MAX_MIXERS		2
+/* vblanks a started capture may stay busy before the job is failed */
+#define SUN50I_WB_MAX_BUSY_FRAMES	4
+
+/* Lanczos2 scaler phases, vendor wb_lan2coefftab16 / wb_lan2coefftab16_down */
+static const u32 sun50i_wb_coeff_up[SUN50I_WB_SCALER_PHASES] = {
+	0x00004000, 0x00033ffe, 0x00063efc, 0x000a3bfb,
+	0xff0f37fb, 0xfe1433fb, 0xfd192ffb, 0xfd1f29fb,
+	0xfc2424fc, 0xfb291ffd, 0xfb2f19fd, 0xfb3314fe,
+	0xfb370fff, 0xfb3b0a00, 0xfc3e0600, 0xfe3f0300,
+};
+
+static const u32 sun50i_wb_coeff_down[SUN50I_WB_SCALER_PHASES] = {
+	0x000e240e, 0x0010240c, 0x0013230a, 0x00142309,
+	0x00162208, 0x01182106, 0x011a2005, 0x021b1f04,
+	0x031d1d03, 0x041e1c02, 0x05201a01, 0x06211801,
+	0x07221601, 0x09231400, 0x0a231300, 0x0c231100,
+};
+
+static const u32 sun50i_wb_formats[] = {
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_ARGB8888,
+	DRM_FORMAT_XBGR8888,
+	DRM_FORMAT_ABGR8888,
+	DRM_FORMAT_RGBX8888,
+	DRM_FORMAT_RGBA8888,
+	DRM_FORMAT_BGRX8888,
+	DRM_FORMAT_BGRA8888,
+	DRM_FORMAT_RGB888,
+	DRM_FORMAT_BGR888,
+	DRM_FORMAT_XRGB2101010,
+	DRM_FORMAT_NV12,
+	DRM_FORMAT_NV21,
+	DRM_FORMAT_YUV420,
+};
+
+/*
+ * One capture, built in the atomic commit and written to the hardware from
+ * the vblank interrupt. Everything the interrupt needs is precomputed.
+ */
+struct sun50i_wb_job {
+	struct list_head	list;
+	struct sun8i_mixer	*mixer;
+	struct drm_crtc		*crtc;
+	u32			size;		/* input = blender output */
+	u32			format;
+	u32			addr[3];
+	u32			addr_high;
+	u32			pitch[2];
+	u32			cs_horz, cs_vert;
+	u32			fs_insize, fs_outsize;
+	u32			fs_hstep, fs_vstep;
+	u32			bypass;
+	const u32		*y_coeff;	/* NULL: scaler coefficients untouched */
+	const u32		*c_coeff;
+	bool			csc;		/* csc_coeff programmed */
+	u32			csc_coeff[SUN50I_WB_CSC_COEFF_NUM];
+	unsigned int		busy_frames;
+};
+
+struct sun50i_wb {
+	struct drm_writeback_connector	connector;
+	struct device			*dev;
+	void __iomem			*regs;	/* write-back core */
+	struct regmap			*top;	/* DE top: RTWB mux */
+	struct clk			*mod_clk;
+	struct reset_control		*reset;
+	struct sun8i_mixer		*mixers[SUN50I_WB_MAX_MIXERS];
+
+	spinlock_t			lock;	/* pending, running */
+	struct list_head		pending;
+	struct sun50i_wb_job		*running;
+};
+
+/*
+ * Read-only diagnostics, /sys/module/sun8i_mixer/parameters/de33_wb_*:
+ * jobs queued, completed (FINISH), failed (overflow/timeout/never finished
+ * or cancelled), vblanks at which a started capture was not finished yet,
+ * and the last status word read.
+ */
+static unsigned int de33_wb_jobs;
+static unsigned int de33_wb_done;
+static unsigned int de33_wb_failed;
+static unsigned int de33_wb_busy_frames;
+static unsigned int de33_wb_status_last;
+module_param(de33_wb_jobs, uint, 0444);
+module_param(de33_wb_done, uint, 0444);
+module_param(de33_wb_failed, uint, 0444);
+module_param(de33_wb_busy_frames, uint, 0444);
+module_param(de33_wb_status_last, uint, 0444);
+
+static inline struct sun50i_wb *
+connector_to_sun50i_wb(struct drm_connector *connector)
+{
+	return container_of(drm_connector_to_writeback(connector),
+			    struct sun50i_wb, connector);
+}
+
+static inline struct sun50i_wb *
+encoder_to_sun50i_wb(struct drm_encoder *encoder)
+{
+	return container_of(container_of(encoder,
+					 struct drm_writeback_connector,
+					 encoder),
+			    struct sun50i_wb, connector);
+}
+
+static int sun50i_wb_hw_format(u32 format, u32 *hw)
+{
+	switch (format) {
+	case DRM_FORMAT_XRGB8888:
+	case DRM_FORMAT_ARGB8888:
+		*hw = SUN50I_WB_FORMAT_XRGB8888;
+		return 0;
+	case DRM_FORMAT_XBGR8888:
+	case DRM_FORMAT_ABGR8888:
+		*hw = SUN50I_WB_FORMAT_XBGR8888;
+		return 0;
+	case DRM_FORMAT_RGBX8888:
+	case DRM_FORMAT_RGBA8888:
+		*hw = SUN50I_WB_FORMAT_RGBX8888;
+		return 0;
+	case DRM_FORMAT_BGRX8888:
+	case DRM_FORMAT_BGRA8888:
+		*hw = SUN50I_WB_FORMAT_BGRX8888;
+		return 0;
+	case DRM_FORMAT_RGB888:
+		*hw = SUN50I_WB_FORMAT_RGB888;
+		return 0;
+	case DRM_FORMAT_BGR888:
+		*hw = SUN50I_WB_FORMAT_BGR888;
+		return 0;
+	case DRM_FORMAT_XRGB2101010:
+		*hw = SUN50I_WB_FORMAT_10BIT;
+		return 0;
+	case DRM_FORMAT_NV12:
+		*hw = SUN50I_WB_FORMAT_NV12;
+		return 0;
+	case DRM_FORMAT_NV21:
+		*hw = SUN50I_WB_FORMAT_NV21;
+		return 0;
+	case DRM_FORMAT_YUV420:
+		*hw = SUN50I_WB_FORMAT_YUV420;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int sun50i_wb_connector_get_modes(struct drm_connector *connector)
+{
+	return drm_add_modes_noedid(connector, SUN50I_WB_MAX_WIDTH,
+				    SUN50I_WB_MAX_HEIGHT);
+}
+
+static int sun50i_wb_encoder_atomic_check(struct drm_encoder *encoder,
+					  struct drm_crtc_state *crtc_state,
+					  struct drm_connector_state *conn_state)
+{
+	const struct drm_display_mode *mode = &crtc_state->adjusted_mode;
+	struct drm_device *drm = encoder->dev;
+	struct drm_framebuffer *fb;
+	u32 hw;
+	int ret;
+
+	if (!conn_state->writeback_job || !conn_state->writeback_job->fb)
+		return 0;
+
+	ret = drm_atomic_helper_check_wb_connector_state(conn_state->connector,
+							 conn_state->state);
+	if (ret)
+		return ret;
+
+	fb = conn_state->writeback_job->fb;
+	if (sun50i_wb_hw_format(fb->format->format, &hw))
+		return -EINVAL;
+
+	if (mode->hdisplay < SUN50I_WB_MIN_WIDTH ||
+	    mode->hdisplay > SUN50I_WB_MAX_WIDTH ||
+	    mode->vdisplay < SUN50I_WB_MIN_HEIGHT ||
+	    mode->vdisplay > SUN50I_WB_MAX_HEIGHT) {
+		drm_dbg_kms(drm, "writeback: mode %ux%u out of range\n",
+			    mode->hdisplay, mode->vdisplay);
+		return -EINVAL;
+	}
+
+	/* the unit scales down only, into a 2048 pixel output line buffer */
+	if (fb->width < SUN50I_WB_MIN_WIDTH ||
+	    fb->height < SUN50I_WB_MIN_HEIGHT ||
+	    fb->width > mode->hdisplay || fb->height > mode->vdisplay ||
+	    fb->width > SUN50I_WB_MAX_OUT_WIDTH) {
+		drm_dbg_kms(drm, "writeback: fb %ux%u not capturable from %ux%u\n",
+			    fb->width, fb->height, mode->hdisplay,
+			    mode->vdisplay);
+		return -EINVAL;
+	}
+
+	if (fb->width % fb->format->hsub || fb->height % fb->format->vsub)
+		return -EINVAL;
+
+	if (fb->format->format == DRM_FORMAT_YUV420 &&
+	    fb->pitches[1] != fb->pitches[2])
+		return -EINVAL;
+
+	/* 10-bit output: no scaler and no CSC on that path (vendor) */
+	if (fb->format->format == DRM_FORMAT_XRGB2101010 &&
+	    (fb->width != mode->hdisplay || fb->height != mode->vdisplay))
+		return -EINVAL;
+
+	return 0;
+}
+
+
+/* Coarse (integer, > 2:1) then fine (Lanczos2) down-scaling, as the vendor. */
+static void sun50i_wb_job_scaler(struct sun50i_wb_job *job,
+				 const struct drm_format_info *format,
+				 u32 in_w, u32 in_h, u32 out_w, u32 out_h)
+{
+	bool subsampled = format->hsub > 1 || format->vsub > 1;
+	u32 mid_w = in_w, mid_h = in_h;
+
+	if (in_w > 2 * out_w) {
+		job->cs_horz = in_w | (out_w << 17);
+		job->bypass |= SUN50I_WB_BYPASS_CS_EN;
+		mid_w = 2 * out_w;
+	}
+	if (in_h > 2 * out_h) {
+		job->cs_vert = in_h | (out_h << 17);
+		job->bypass |= SUN50I_WB_BYPASS_CS_EN;
+		mid_h = 2 * out_h;
+	}
+
+	if (mid_w != out_w || mid_h != out_h || subsampled) {
+		/* 18 fractional bits, stored at bit 2 */
+		job->fs_hstep = div_u64((u64)mid_w << 18, out_w) << 2;
+		job->fs_vstep = div_u64((u64)mid_h << 18, out_h) << 2;
+		job->bypass |= SUN50I_WB_BYPASS_FS_EN;
+		job->y_coeff = (mid_w > out_w || mid_h > out_h) ?
+			       sun50i_wb_coeff_down : sun50i_wb_coeff_up;
+		job->c_coeff = (mid_w > out_w / format->hsub ||
+				mid_h > out_h / format->vsub) ?
+			       sun50i_wb_coeff_down : sun50i_wb_coeff_up;
+	} else {
+		job->fs_hstep = SUN50I_WB_FS_STEP_ONE;
+		job->fs_vstep = SUN50I_WB_FS_STEP_ONE;
+	}
+
+	job->fs_insize = SUN50I_WB_SIZE_REG(mid_w, mid_h);
+	job->fs_outsize = SUN50I_WB_SIZE_REG(out_w, out_h);
+}
+
+/*
+ * The blender works in RGB, or in BT.601 limited-range YCbCr on the TV
+ * encoder path (sun50i_mixer_set_output_yuv()). Convert when the output
+ * format is in the other space.
+ */
+static void sun50i_wb_job_csc(struct sun50i_wb_job *job,
+			      const struct drm_format_info *format)
+{
+	bool in_yuv = job->mixer->output_yuv;
+
+	if (format->format == DRM_FORMAT_XRGB2101010 ||
+	    in_yuv == format->is_yuv)
+		return;
+
+	job->csc = true;
+	sun8i_de33_csc_get_table(format->is_yuv ? SUN8I_CSC_MODE_RGB2YUV :
+						  SUN8I_CSC_MODE_YUV2RGB,
+				 job->csc_coeff);
+}
+
+/* Stop and reset the unit (vendor de_wb_stop) and detach it from the mux. */
+static void sun50i_wb_stop(struct sun50i_wb *wb)
+{
+	writel_relaxed(SUN50I_WB_GCTRL_CLK_GATE | SUN50I_WB_GCTRL_SOFT_RESET,
+		       wb->regs + SUN50I_WB_GCTRL);
+	regmap_update_bits(wb->top, SUN50I_DE33_RTWB_MUX_REG,
+			   SUN50I_DE33_RTWB_START | SUN50I_DE33_RTWB_SELF_TIMING,
+			   0);
+}
+
+/*
+ * Program and start a capture. Runs from the vblank interrupt with wb->lock
+ * held, while the beam is in the vertical blanking; the capture covers the
+ * frame that follows.
+ */
+static void sun50i_wb_start(struct sun50i_wb *wb,
+			    const struct sun50i_wb_job *job)
+{
+	void __iomem *regs = wb->regs;
+	u32 mux = SUN50I_DE33_RTWB_MUX_BLENDER(job->mixer->engine.id);
+	unsigned int i;
+
+	/* source blender, frame timing from the TCON, not started yet */
+	regmap_update_bits(wb->top, SUN50I_DE33_RTWB_MUX_REG,
+			   SUN50I_DE33_RTWB_MUX_MASK | SUN50I_DE33_RTWB_START |
+			   SUN50I_DE33_RTWB_SELF_TIMING, mux);
+
+	/* out of the soft reset the last stop left it in */
+	writel(SUN50I_WB_GCTRL_AUTO_GATE, regs + SUN50I_WB_GCTRL);
+	readl(regs + SUN50I_WB_GCTRL);
+	udelay(1);
+
+	writel_relaxed(job->size, regs + SUN50I_WB_SIZE);
+	writel_relaxed(0, regs + SUN50I_WB_CROP_COORD);
+	writel_relaxed(job->size, regs + SUN50I_WB_CROP_SIZE);
+
+	for (i = 0; i < ARRAY_SIZE(job->addr); i++)
+		writel_relaxed(job->addr[i], regs + SUN50I_WB_A_ADDR(i));
+	writel_relaxed(job->addr_high, regs + SUN50I_WB_A_HIGH_ADDR);
+	writel_relaxed(job->pitch[0], regs + SUN50I_WB_PITCH0);
+	writel_relaxed(job->pitch[1], regs + SUN50I_WB_PITCH1);
+	/* address group A, no automatic switching */
+	writel_relaxed(0, regs + SUN50I_WB_ADDR_SWITCH);
+	writel_relaxed(job->format, regs + SUN50I_WB_FORMAT);
+	/* completion is polled from the vblank interrupt */
+	writel_relaxed(0, regs + SUN50I_WB_INT);
+	writel_relaxed(SUN50I_WB_SFTM_VS_DEFAULT, regs + SUN50I_WB_SFTM);
+
+	writel_relaxed(job->cs_horz, regs + SUN50I_WB_CS_HORZ);
+	writel_relaxed(job->cs_vert, regs + SUN50I_WB_CS_VERT);
+	writel_relaxed(job->fs_insize, regs + SUN50I_WB_FS_INSIZE);
+	writel_relaxed(job->fs_outsize, regs + SUN50I_WB_FS_OUTSIZE);
+	writel_relaxed(job->fs_hstep, regs + SUN50I_WB_FS_HSTEP);
+	writel_relaxed(job->fs_vstep, regs + SUN50I_WB_FS_VSTEP);
+	if (job->y_coeff)
+		for (i = 0; i < SUN50I_WB_SCALER_PHASES; i++) {
+			writel_relaxed(job->y_coeff[i],
+				       regs + SUN50I_WB_YHCOEFF(i));
+			writel_relaxed(job->c_coeff[i],
+				       regs + SUN50I_WB_CHCOEFF(i));
+		}
+	writel_relaxed(job->bypass, regs + SUN50I_WB_BYPASS);
+
+	if (job->csc)
+		for (i = 0; i < SUN50I_WB_CSC_COEFF_NUM; i++)
+			writel_relaxed(job->csc_coeff[i],
+				       regs + SUN50I_WB_CSC_COEFF(i));
+	writel_relaxed(job->csc ? 1 : 0, regs + SUN50I_WB_CSC_CTL);
+
+	writel_relaxed(SUN50I_WB_STATUS_W1C, regs + SUN50I_WB_STATUS);
+	/* the configuration is complete before the start bits */
+	writel(SUN50I_WB_GCTRL_AUTO_GATE | SUN50I_WB_GCTRL_START,
+	       regs + SUN50I_WB_GCTRL);
+	regmap_update_bits(wb->top, SUN50I_DE33_RTWB_MUX_REG,
+			   SUN50I_DE33_RTWB_START, SUN50I_DE33_RTWB_START);
+}
+
+/* Finish a job outside wb->lock: fence, vblank reference, memory. */
+static void sun50i_wb_job_complete(struct sun50i_wb *wb,
+				   struct sun50i_wb_job *job, int status)
+{
+	drm_writeback_signal_completion(&wb->connector, status);
+	drm_crtc_vblank_put(job->crtc);
+	kfree(job);
+}
+
+/*
+ * The mixer's TCON vblank interrupt, after the mixer wrote the frame's
+ * registers (sun50i_mixer_vblank_quirk()). Hard IRQ context.
+ */
+void sun50i_wb_vblank(struct sun50i_wb *wb, struct sun8i_mixer *mixer)
+{
+	struct sun50i_wb_job *done = NULL, *job;
+	unsigned long flags;
+	int status = 0;
+
+	spin_lock_irqsave(&wb->lock, flags);
+
+	job = wb->running;
+	if (job && job->mixer == mixer) {
+		u32 sts = readl(wb->regs + SUN50I_WB_STATUS);
+
+		de33_wb_status_last = sts;
+		if (sts & SUN50I_WB_STATUS_FINISH) {
+			status = 0;
+		} else if (sts & (SUN50I_WB_STATUS_OVERFLOW |
+				  SUN50I_WB_STATUS_TIMEOUT)) {
+			status = -EIO;
+		} else if (++job->busy_frames > SUN50I_WB_MAX_BUSY_FRAMES) {
+			status = -ETIMEDOUT;
+		} else {
+			/* the previous frame's write-out is not done yet */
+			de33_wb_busy_frames++;
+			job = NULL;
+		}
+
+		if (job) {
+			writel_relaxed(SUN50I_WB_STATUS_W1C,
+				       wb->regs + SUN50I_WB_STATUS);
+			sun50i_wb_stop(wb);
+			wb->running = NULL;
+			done = job;
+			if (status)
+				de33_wb_failed++;
+			else
+				de33_wb_done++;
+		}
+	}
+
+	if (!wb->running && !list_empty(&wb->pending)) {
+		job = list_first_entry(&wb->pending, struct sun50i_wb_job,
+				       list);
+		/* a job starts at the vblank of its own CRTC */
+		if (job->mixer == mixer) {
+			list_del(&job->list);
+			wb->running = job;
+			sun50i_wb_start(wb, job);
+		}
+	}
+
+	spin_unlock_irqrestore(&wb->lock, flags);
+
+	if (done)
+		sun50i_wb_job_complete(wb, done, status);
+}
+
+/*
+ * The CRTC the connector is attached to is turned off or re-modeset: its
+ * vblank interrupt stops, so captures still queued or running could never
+ * complete. Fail every job, not only this CRTC's:
+ * drm_writeback_signal_completion() completes the connector's oldest job,
+ * so the driver's queue must be cut in the same order.
+ */
+static void sun50i_wb_cancel(struct sun50i_wb *wb)
+{
+	struct sun50i_wb_job *job, *n;
+	unsigned long flags;
+	LIST_HEAD(list);
+
+	spin_lock_irqsave(&wb->lock, flags);
+	if (wb->running) {
+		writel_relaxed(SUN50I_WB_STATUS_W1C,
+			       wb->regs + SUN50I_WB_STATUS);
+		sun50i_wb_stop(wb);
+		list_add_tail(&wb->running->list, &list);
+		wb->running = NULL;
+	}
+	list_splice_tail_init(&wb->pending, &list);
+	spin_unlock_irqrestore(&wb->lock, flags);
+
+	list_for_each_entry_safe(job, n, &list, list) {
+		list_del(&job->list);
+		de33_wb_failed++;
+		sun50i_wb_job_complete(wb, job, -ECANCELED);
+	}
+}
+
+/*
+ * drm_atomic_helper_commit_modeset_disables(): the CRTC this connector is
+ * attached to goes inactive or through a modeset, before the CRTC itself
+ * is disabled. Jobs of this commit, if any, are queued later, after the
+ * enables.
+ */
+static void sun50i_wb_encoder_atomic_disable(struct drm_encoder *encoder,
+					     struct drm_atomic_commit *state)
+{
+	sun50i_wb_cancel(encoder_to_sun50i_wb(encoder));
+}
+
+static const struct drm_encoder_helper_funcs sun50i_wb_encoder_helper_funcs = {
+	.atomic_check	= sun50i_wb_encoder_atomic_check,
+	.atomic_disable	= sun50i_wb_encoder_atomic_disable,
+};
+
+/*
+ * drm_atomic_helper_commit_writebacks(): the planes of this commit are
+ * programmed (and, on the DE33, latched for the next vblank). Queue the
+ * capture; the vblank interrupt starts it.
+ */
+static void sun50i_wb_connector_atomic_commit(struct drm_connector *connector,
+					      struct drm_atomic_commit *state)
+{
+	struct drm_connector_state *conn_state =
+		drm_atomic_get_new_connector_state(state, connector);
+	struct sun50i_wb *wb = connector_to_sun50i_wb(connector);
+	struct drm_writeback_job *wb_job = conn_state->writeback_job;
+	struct drm_crtc *crtc = conn_state->crtc;
+	const struct drm_display_mode *mode;
+	struct sun50i_wb_job *job;
+	struct drm_framebuffer *fb;
+	struct sun4i_crtc *scrtc;
+	unsigned long flags;
+	unsigned int i;
+	int ret;
+
+	if (!wb_job || !wb_job->fb || !crtc)
+		return;
+
+	scrtc = drm_crtc_to_sun4i_crtc(crtc);
+	fb = wb_job->fb;
+	mode = &crtc->state->adjusted_mode;
+
+	job = kzalloc(sizeof(*job), GFP_KERNEL);
+	if (!job) {
+		ret = -ENOMEM;
+		goto fail;
+	}
+
+	job->mixer = engine_to_sun8i_mixer(scrtc->engine);
+	job->crtc = crtc;
+	job->size = SUN50I_WB_SIZE_REG(mode->hdisplay, mode->vdisplay);
+	sun50i_wb_hw_format(fb->format->format, &job->format);
+
+	for (i = 0; i < fb->format->num_planes; i++) {
+		struct drm_gem_dma_object *gem = drm_fb_dma_get_gem_obj(fb, i);
+		dma_addr_t addr = gem->dma_addr + fb->offsets[i];
+
+		job->addr[i] = lower_32_bits(addr);
+		job->addr_high |= (upper_32_bits(addr) & 0xff) << (8 * i);
+	}
+	job->pitch[0] = fb->pitches[0];
+	if (fb->format->num_planes > 1)
+		job->pitch[1] = fb->pitches[1];
+
+	sun50i_wb_job_scaler(job, fb->format, mode->hdisplay, mode->vdisplay,
+			     fb->width, fb->height);
+	sun50i_wb_job_csc(job, fb->format);
+
+	/*
+	 * Keep the vblank interrupt on until the capture is complete. The
+	 * atomic check rejected the job if the CRTC is not active in this
+	 * state, so this only fails when the CRTC is gone.
+	 */
+	ret = drm_crtc_vblank_get(crtc);
+	if (ret) {
+		kfree(job);
+		goto fail;
+	}
+
+	spin_lock_irqsave(&wb->lock, flags);
+	list_add_tail(&job->list, &wb->pending);
+	de33_wb_jobs++;
+	spin_unlock_irqrestore(&wb->lock, flags);
+
+	drm_writeback_queue_job(&wb->connector, conn_state);
+	return;
+
+fail:
+	drm_dbg_kms(connector->dev, "writeback: job not queued (%d)\n", ret);
+	drm_writeback_queue_job(&wb->connector, conn_state);
+	drm_writeback_signal_completion(&wb->connector, ret);
+}
+
+static const struct drm_connector_helper_funcs sun50i_wb_connector_helper_funcs = {
+	.get_modes	= sun50i_wb_connector_get_modes,
+	.atomic_commit	= sun50i_wb_connector_atomic_commit,
+};
+
+static const struct drm_connector_funcs sun50i_wb_connector_funcs = {
+	.fill_modes		= drm_helper_probe_single_connector_modes,
+	.destroy		= drm_connector_cleanup,
+	.reset			= drm_atomic_helper_connector_reset,
+	.atomic_duplicate_state	= drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state	= drm_atomic_helper_connector_destroy_state,
+};
+
+/*
+ * The write-back runs beside the display output of the same CRTC: tell
+ * user space the encoders can be active together.
+ */
+static void sun50i_wb_setup_clones(struct drm_device *drm,
+				   struct drm_encoder *wb_encoder)
+{
+	u32 wb_mask = drm_encoder_mask(wb_encoder);
+	struct drm_encoder *encoder;
+
+	wb_encoder->possible_clones = wb_mask;
+
+	drm_for_each_encoder(encoder, drm) {
+		if (encoder == wb_encoder ||
+		    !(encoder->possible_crtcs & wb_encoder->possible_crtcs))
+			continue;
+
+		encoder->possible_clones |= drm_encoder_mask(encoder) | wb_mask;
+		wb_encoder->possible_clones |= drm_encoder_mask(encoder);
+	}
+}
+
+static bool sun50i_wb_engine_is_de33(struct sunxi_engine *engine)
+{
+	struct sun8i_mixer *mixer;
+
+	if (!of_device_is_compatible(engine->node,
+				     "allwinner,sun50i-h616-de33-mixer-0"))
+		return false;
+
+	mixer = engine_to_sun8i_mixer(engine);
+
+	/* the RCQ backend commits differently and has its own write-back */
+	return mixer->cfg->de_type == SUN8I_MIXER_DE33 &&
+	       !mixer->cfg->uses_rcq && mixer->shadow &&
+	       mixer->engine.id >= 0 &&
+	       mixer->engine.id < SUN50I_WB_MAX_MIXERS;
+}
+
+/* Bound after the pipelines (sun4i_drv.c), so every CRTC exists. */
+static int sun50i_wb_bind(struct device *dev, struct device *master,
+			  void *data)
+{
+	struct sun50i_wb *wb = dev_get_drvdata(dev);
+	struct drm_device *drm = data;
+	u32 possible_crtcs = 0;
+	struct drm_crtc *crtc;
+	int ret;
+
+	drm_for_each_crtc(crtc, drm) {
+		struct sun4i_crtc *scrtc = drm_crtc_to_sun4i_crtc(crtc);
+
+		if (sun50i_wb_engine_is_de33(scrtc->engine))
+			possible_crtcs |= drm_crtc_mask(crtc);
+	}
+
+	if (!possible_crtcs) {
+		dev_warn(dev, "no DE33 mixer to capture from, writeback unused\n");
+		return 0;
+	}
+
+	drm_connector_helper_add(&wb->connector.base,
+				 &sun50i_wb_connector_helper_funcs);
+	ret = drm_writeback_connector_init(drm, &wb->connector,
+					   &sun50i_wb_connector_funcs,
+					   &sun50i_wb_encoder_helper_funcs,
+					   sun50i_wb_formats,
+					   ARRAY_SIZE(sun50i_wb_formats),
+					   possible_crtcs);
+	if (ret) {
+		/* the display output does not depend on the extra connector */
+		dev_warn(dev, "Couldn't create the writeback connector (%d), writeback unused\n",
+			 ret);
+		return 0;
+	}
+
+	sun50i_wb_setup_clones(drm, &wb->connector.encoder);
+
+	/* from here the mixers' vblank interrupts drive the jobs */
+	drm_for_each_crtc(crtc, drm) {
+		struct sun4i_crtc *scrtc = drm_crtc_to_sun4i_crtc(crtc);
+		struct sun8i_mixer *mixer;
+
+		if (!(possible_crtcs & drm_crtc_mask(crtc)))
+			continue;
+
+		mixer = engine_to_sun8i_mixer(scrtc->engine);
+		wb->mixers[mixer->engine.id] = mixer;
+		WRITE_ONCE(mixer->wb, wb);
+	}
+
+	return 0;
+}
+
+static void sun50i_wb_unbind(struct device *dev, struct device *master,
+			     void *data)
+{
+	struct sun50i_wb *wb = dev_get_drvdata(dev);
+	struct sun50i_wb_job *job, *n;
+	unsigned long flags;
+	LIST_HEAD(list);
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(wb->mixers); i++)
+		if (wb->mixers[i]) {
+			WRITE_ONCE(wb->mixers[i]->wb, NULL);
+			wb->mixers[i] = NULL;
+		}
+
+	/*
+	 * The CRTCs were disabled by the shutdown before this, which
+	 * cancelled every job through sun8i_mixer_commit(); the connector
+	 * is already destroyed, so anything left can only be dropped.
+	 */
+	spin_lock_irqsave(&wb->lock, flags);
+	if (wb->running) {
+		sun50i_wb_stop(wb);
+		list_add_tail(&wb->running->list, &list);
+		wb->running = NULL;
+	}
+	list_splice_tail_init(&wb->pending, &list);
+	spin_unlock_irqrestore(&wb->lock, flags);
+
+	list_for_each_entry_safe(job, n, &list, list) {
+		dev_warn(dev, "dropping a writeback job at unbind\n");
+		list_del(&job->list);
+		kfree(job);
+	}
+}
+
+static const struct component_ops sun50i_wb_component_ops = {
+	.bind	= sun50i_wb_bind,
+	.unbind	= sun50i_wb_unbind,
+};
+
+static int sun50i_wb_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct sun50i_wb *wb;
+	void __iomem *regs;
+	int ret;
+
+	wb = devm_kzalloc(dev, sizeof(*wb), GFP_KERNEL);
+	if (!wb)
+		return -ENOMEM;
+
+	wb->dev = dev;
+	spin_lock_init(&wb->lock);
+	INIT_LIST_HEAD(&wb->pending);
+
+	regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(regs))
+		return PTR_ERR(regs);
+	wb->regs = regs + SUN50I_WB_CORE_OFFSET;
+
+	wb->top = syscon_regmap_lookup_by_phandle(dev->of_node,
+						  "allwinner,top");
+	if (IS_ERR(wb->top))
+		return dev_err_probe(dev, PTR_ERR(wb->top),
+				     "Couldn't get the DE top regmap\n");
+
+	wb->reset = devm_reset_control_get(dev, NULL);
+	if (IS_ERR(wb->reset))
+		return dev_err_probe(dev, PTR_ERR(wb->reset),
+				     "Couldn't get our reset line\n");
+
+	ret = reset_control_deassert(wb->reset);
+	if (ret)
+		return dev_err_probe(dev, ret, "Couldn't deassert our reset line\n");
+
+	wb->mod_clk = devm_clk_get_enabled(dev, "mod");
+	if (IS_ERR(wb->mod_clk)) {
+		ret = dev_err_probe(dev, PTR_ERR(wb->mod_clk),
+				    "Couldn't get the write-back clock\n");
+		goto err_assert_reset;
+	}
+
+	/* idle, detached from the blenders, until the first job */
+	sun50i_wb_stop(wb);
+
+	dev_set_drvdata(dev, wb);
+
+	ret = component_add(dev, &sun50i_wb_component_ops);
+	if (ret)
+		goto err_assert_reset;
+
+	return 0;
+
+err_assert_reset:
+	reset_control_assert(wb->reset);
+	return ret;
+}
+
+static void sun50i_wb_remove(struct platform_device *pdev)
+{
+	struct sun50i_wb *wb = platform_get_drvdata(pdev);
+
+	component_del(&pdev->dev, &sun50i_wb_component_ops);
+	reset_control_assert(wb->reset);
+}
+
+static const struct of_device_id sun50i_wb_of_table[] = {
+	{ .compatible = "allwinner,sun50i-h616-de33-writeback" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sun50i_wb_of_table);
+
+static struct platform_driver sun50i_wb_platform_driver = {
+	.probe		= sun50i_wb_probe,
+	.remove		= sun50i_wb_remove,
+	.driver		= {
+		.name		= "sun50i-de33-writeback",
+		.of_match_table	= sun50i_wb_of_table,
+	},
+};
+module_platform_driver(sun50i_wb_platform_driver);
+
+MODULE_DESCRIPTION("Allwinner DE33 write-back connector");
+MODULE_LICENSE("GPL");
