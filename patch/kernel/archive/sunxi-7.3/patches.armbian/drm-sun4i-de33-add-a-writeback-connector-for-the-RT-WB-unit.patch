+/*
+ * The register image the DE33 write-back unit's CSC takes (same layout as
+ * the layer CSC): full-range RGB to limited-range BT.601 YCbCr, which is
+ * what the blender itself produces when it works in YUV, or the inverse.
+ */
+void sun8i_de33_csc_get_table(enum sun8i_csc_mode mode, u32 *dst)
+{
+	const u32 *table;
+
+	switch (mode) {
+	case SUN8I_CSC_MODE_RGB2YUV:
+		table = rgb2yuv_de3;
+		break;
+	case SUN8I_CSC_MODE_YUV2RGB:
+		table = yuv2rgb_de3[DRM_COLOR_YCBCR_LIMITED_RANGE]
+				   [DRM_COLOR_YCBCR_BT601];
+		break;
+	default:
+		table = identity_de3;
+		break;
+	}
+
+	sun8i_de33_convert_table(table, dst);
+}
