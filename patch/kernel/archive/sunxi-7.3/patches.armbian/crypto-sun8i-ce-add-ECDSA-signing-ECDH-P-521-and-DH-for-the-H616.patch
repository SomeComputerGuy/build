+/* Private key: the big endian scalar d, at most the curve size long */
+static int sun8i_ce_ecdsa_set_priv_key(struct crypto_sig *tfm, const void *key,
+				       unsigned int keylen)
+{
+	struct sun8i_ce_ecdsa_ctx *ctx = crypto_sig_ctx(tfm);
+	const struct ecc_curve *curve = ctx->curve;
+	unsigned int nd = ctx->ndigits, len = DIV_ROUND_UP(curve->nbits, 8);
+	struct ecc_point pk = ECC_POINT_INIT(ctx->x, ctx->y, nd);
+	u8 *pub;
+	int err;
+
+	ctx->pub_set = false;
+	ctx->priv_set = false;
+	memzero_explicit(ctx->d, sizeof(ctx->d));
+
+	if (!keylen || keylen > len)
+		return -EINVAL;
+	ecc_digits_from_bytes(key, keylen, ctx->d, nd);
+	if (vli_is_zero(ctx->d, nd) || vli_cmp(ctx->d, curve->n, nd) >= 0) {
+		err = -EINVAL;
+		goto err_clear;
+	}
+
+	memcpy(ctx->x, curve->g.x, nd * sizeof(u64));
+	memcpy(ctx->y, curve->g.y, nd * sizeof(u64));
+	err = sun8i_ce_ecc_mul(ctx->ce, curve, ctx->d, ctx->x, ctx->y);
+	if (!err)
+		err = ecc_is_pubkey_valid_full(curve, &pk);
+	if (err)
+		goto err_clear;
+
+	/* software check of each signature before it is given out */
+	pub = kmalloc(1 + 2 * len, GFP_KERNEL);
+	if (!pub) {
+		err = -ENOMEM;
+		goto err_clear;
+	}
+	pub[0] = 4;
+	ecc_digits_to_bytes(ctx->x, nd, pub + 1, len);
+	ecc_digits_to_bytes(ctx->y, nd, pub + 1 + len, len);
+	err = crypto_sig_set_pubkey(ctx->verifier, pub, 1 + 2 * len);
+	kfree(pub);
+	if (err)
+		goto err_clear;
+
+	ctx->pub_set = true;
+	ctx->priv_set = true;
+	return 0;
+
+err_clear:
+	memzero_explicit(ctx->d, sizeof(ctx->d));
+	return err;
+}
+
+/* bits2int() of RFC 6979 2.3.2: the leftmost nbits bits of @b */
+static void sun8i_ce_bits2int(u64 *v, unsigned int nd, const u8 *b,
+			      unsigned int blen, unsigned int nbits)
+{
+	unsigned int len = min(blen, DIV_ROUND_UP(nbits, 8)), shift, i;
+
+	ecc_digits_from_bytes(b, len, v, nd);
+	if (len * 8 <= nbits)
+		return;
+	shift = len * 8 - nbits;
+	for (i = 0; i < nd; i++)
+		v[i] = v[i] >> shift | (i + 1 < nd ? v[i + 1] << (64 - shift) : 0);
+}
+
+/*
+ * RFC 6979 HMAC_DRBG, with the SHA-2 (or SHA-1) of the digest's size, SHA-512
+ * for other sizes.
+ */
+struct sun8i_ce_drbg {
+	unsigned int hlen;
+	u8 k[SHA512_DIGEST_SIZE];
+	u8 v[SHA512_DIGEST_SIZE];
+	union {
+		struct hmac_sha1_ctx sha1;
+		struct hmac_sha224_ctx sha224;
+		struct hmac_sha256_ctx sha256;
+		struct hmac_sha384_ctx sha384;
+		struct hmac_sha512_ctx sha512;
+	} h;
+};
+
+static void sun8i_ce_drbg_init(struct sun8i_ce_drbg *g)
+{
+	switch (g->hlen) {
+	case SHA1_DIGEST_SIZE:
+		hmac_sha1_init_usingrawkey(&g->h.sha1, g->k, g->hlen);
+		break;
+	case SHA224_DIGEST_SIZE:
+		hmac_sha224_init_usingrawkey(&g->h.sha224, g->k, g->hlen);
+		break;
+	case SHA256_DIGEST_SIZE:
+		hmac_sha256_init_usingrawkey(&g->h.sha256, g->k, g->hlen);
+		break;
+	case SHA384_DIGEST_SIZE:
+		hmac_sha384_init_usingrawkey(&g->h.sha384, g->k, g->hlen);
+		break;
+	default:
+		hmac_sha512_init_usingrawkey(&g->h.sha512, g->k, g->hlen);
+	}
+}
+
+static void sun8i_ce_drbg_update(struct sun8i_ce_drbg *g, const u8 *data,
+				 unsigned int len)
+{
+	switch (g->hlen) {
+	case SHA1_DIGEST_SIZE:
+		hmac_sha1_update(&g->h.sha1, data, len);
+		break;
+	case SHA224_DIGEST_SIZE:
+		hmac_sha224_update(&g->h.sha224, data, len);
+		break;
+	case SHA256_DIGEST_SIZE:
+		hmac_sha256_update(&g->h.sha256, data, len);
+		break;
+	case SHA384_DIGEST_SIZE:
+		hmac_sha384_update(&g->h.sha384, data, len);
+		break;
+	default:
+		hmac_sha512_update(&g->h.sha512, data, len);
+	}
+}
+
+static void sun8i_ce_drbg_final(struct sun8i_ce_drbg *g, u8 *out)
+{
+	switch (g->hlen) {
+	case SHA1_DIGEST_SIZE:
+		hmac_sha1_final(&g->h.sha1, out);
+		break;
+	case SHA224_DIGEST_SIZE:
+		hmac_sha224_final(&g->h.sha224, out);
+		break;
+	case SHA256_DIGEST_SIZE:
+		hmac_sha256_final(&g->h.sha256, out);
+		break;
+	case SHA384_DIGEST_SIZE:
+		hmac_sha384_final(&g->h.sha384, out);
+		break;
+	default:
+		hmac_sha512_final(&g->h.sha512, out);
+	}
+}
+
+/* K = HMAC_K(V || @sep || @x || @h), V = HMAC_K(V); no @sep: K only */
+static void sun8i_ce_drbg_step(struct sun8i_ce_drbg *g, int sep, const u8 *x,
+			       const u8 *h, unsigned int len)
+{
+	u8 b = sep;
+
+	if (sep >= 0) {
+		sun8i_ce_drbg_init(g);
+		sun8i_ce_drbg_update(g, g->v, g->hlen);
+		sun8i_ce_drbg_update(g, &b, 1);
+		if (x) {
+			sun8i_ce_drbg_update(g, x, len);
+			sun8i_ce_drbg_update(g, h, len);
+		}
+		sun8i_ce_drbg_final(g, g->k);
+	}
+	sun8i_ce_drbg_init(g);
+	sun8i_ce_drbg_update(g, g->v, g->hlen);
+	sun8i_ce_drbg_final(g, g->v);
+}
+
+struct sun8i_ce_ecdsa_sign_buf {
+	struct sun8i_ce_drbg g;
+	u8 x[ECC_MAX_BYTES];
+	u8 h[ECC_MAX_BYTES];
+	u8 t[ECC_MAX_BYTES + SHA512_DIGEST_SIZE];
+	u64 e[ECC_MAX_DIGITS];
+	u64 k[ECC_MAX_DIGITS];
+	u8 ops[CE_ECDSA_SIGN_OPS * CE_ECC_MAX_BYTES];
+	u8 res[2 * CE_ECC_MAX_BYTES];
+	struct ecdsa_raw_sig sig;
+};
+
+/*
+ * Output: struct ecdsa_raw_sig, as ecdsa-generic takes it for verification.
+ * Nonce: RFC 6979 (deterministic), so signing does not depend on the quality
+ * of a random source at that moment; each signature is checked in software
+ * before it is returned, as a wrong (faulted) signature with a deterministic
+ * nonce can give the key away.
+ */
+static int sun8i_ce_ecdsa_sign(struct crypto_sig *tfm, const void *src,
+			       unsigned int slen, void *dst, unsigned int dlen)
+{
+	struct sun8i_ce_ecdsa_ctx *ctx = crypto_sig_ctx(tfm);
+	struct sun8i_ce_pkc_alg *a = sig_tmpl(tfm);
+	const struct ecc_curve *curve = ctx->curve;
+	unsigned int nd = ctx->ndigits, w = sun8i_ce_ecc_width(curve);
+	unsigned int len = DIV_ROUND_UP(curve->nbits, 8), tlen, i;
+	struct sun8i_ce_ecdsa_sign_buf *b;
+	const u64 *ops[CE_ECDSA_SIGN_OPS];
+	int err;
+
+	if (!ctx->priv_set || !slen || slen > SHA512_DIGEST_SIZE ||
+	    dlen < sizeof(struct ecdsa_raw_sig))
+		return -EINVAL;
+
+	b = kzalloc_obj(*b);
+	if (!b)
+		return -ENOMEM;
+
+	sun8i_ce_bits2int(b->e, nd, src, slen, curve->nbits);
+	if (vli_cmp(b->e, curve->n, nd) >= 0)
+		vli_sub(b->e, b->e, curve->n, nd);
+	ecc_digits_to_bytes(b->e, nd, b->h, len);
+	ecc_digits_to_bytes(ctx->d, nd, b->x, len);
+
+	switch (slen) {
+	case SHA1_DIGEST_SIZE:
+	case SHA224_DIGEST_SIZE:
+	case SHA256_DIGEST_SIZE:
+	case SHA384_DIGEST_SIZE:
+		b->g.hlen = slen;
+		break;
+	default:
+		b->g.hlen = SHA512_DIGEST_SIZE;
+	}
+	memset(b->g.v, 0x01, b->g.hlen);
+	sun8i_ce_drbg_step(&b->g, 0, b->x, b->h, len);
+	sun8i_ce_drbg_step(&b->g, 1, b->x, b->h, len);
+
+	ops[0] = b->k;
+	ops[1] = curve->p;
+	ops[2] = curve->a;
+	ops[3] = curve->g.x;
+	ops[4] = curve->g.y;
+	ops[5] = curve->n;
+	ops[6] = ctx->d;
+	ops[7] = b->e;
+
+	for (;;) {
+		for (tlen = 0; tlen < len; tlen += b->g.hlen) {
+			sun8i_ce_drbg_step(&b->g, -1, NULL, NULL, 0);
+			memcpy(b->t + tlen, b->g.v, b->g.hlen);
+		}
+		sun8i_ce_bits2int(b->k, nd, b->t, tlen, curve->nbits);
+		if (!vli_is_zero(b->k, nd) && vli_cmp(b->k, curve->n, nd) < 0) {
+			for (i = 0; i < CE_ECDSA_SIGN_OPS; i++)
+				sun8i_ce_digits_to_le(b->ops + i * w, w, ops[i],
+						      nd);
+			a->stat_req++;
+			err = sun8i_ce_pkc_run(ctx->ce, CE_ALG_ECC, CE_ECC_SIGN,
+					       b->ops, CE_ECDSA_SIGN_OPS, w,
+					       b->res, 2 * w, "ECDSA");
+			if (err)
+				goto out;
+			sun8i_ce_le_to_digits(b->sig.r, nd, b->res, w);
+			sun8i_ce_le_to_digits(b->sig.s, nd, b->res + w, w);
+			break;
+		}
+		sun8i_ce_drbg_step(&b->g, 0, NULL, NULL, 0);
+	}
+
+	/* r = 0 or s = 0 (odds 2^-nbits) fails this check too */
+	err = crypto_sig_verify(ctx->verifier, &b->sig, sizeof(b->sig), src,
+				slen);
+	if (err) {
+		dev_err_ratelimited(ctx->ce->dev,
+				    "ECDSA signature failed its check: %d\n",
+				    err);
+		err = -EIO;
+		goto out;
+	}
+	memcpy(dst, &b->sig, sizeof(b->sig));
+	err = sizeof(b->sig);
+out:
+	kfree_sensitive(b);
+	return err;
+}
