+/* @x, @y = k * (@x, @y) on @curve; 0 or an error */
+static int sun8i_ce_ecc_mul(struct sun8i_ce_dev *ce,
+			    const struct ecc_curve *curve, const u64 *k,
+			    u64 *x, u64 *y)
+{
+	unsigned int nd = curve->g.ndigits, w = sun8i_ce_ecc_width(curve);
+	struct ecc_point pk = ECC_POINT_INIT(x, y, nd);
+	u8 *src, *dst;
+	int err;
+
+	src = kzalloc(5 * w, GFP_KERNEL);
+	dst = kzalloc(2 * w, GFP_KERNEL);
+	if (!src || !dst) {
+		err = -ENOMEM;
+		goto out;
+	}
+
+	sun8i_ce_digits_to_le(src, w, curve->p, nd);
+	sun8i_ce_digits_to_le(src + w, w, k, nd);
+	sun8i_ce_digits_to_le(src + 2 * w, w, curve->a, nd);
+	sun8i_ce_digits_to_le(src + 3 * w, w, x, nd);
+	sun8i_ce_digits_to_le(src + 4 * w, w, y, nd);
+
+	err = sun8i_ce_pkc_run(ce, CE_ALG_ECC, CE_ECC_POINT_MUL, src, 5, w,
+			       dst, 2 * w, "ECC");
+	if (err)
+		goto out;
+
+	sun8i_ce_le_to_digits(x, nd, dst, w);
+	sun8i_ce_le_to_digits(y, nd, dst + w, w);
+	if (ecc_point_is_zero(&pk))
+		err = -EFAULT;
+out:
+	kfree_sensitive(src);
+	kfree_sensitive(dst);
+	return err;
+}
