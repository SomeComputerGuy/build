+/* DH */
+
+static void sun8i_ce_dh_free_key(struct sun8i_ce_dh_ctx *ctx)
+{
+	kfree(ctx->p);
+	kfree_sensitive(ctx->x);
+	kfree(ctx->g);
+	ctx->p = NULL;
+	ctx->x = NULL;
+	ctx->g = NULL;
+	ctx->p_sz = 0;
+	ctx->hw = false;
+}
+
+static int sun8i_ce_dh_set_secret(struct crypto_kpp *tfm, const void *buf,
+				  unsigned int len)
+{
+	struct sun8i_ce_dh_ctx *ctx = kpp_tfm_ctx(tfm);
+	struct dh params;
+	size_t p_sz, g_sz;
+	const u8 *p, *g;
+	int err;
+
+	sun8i_ce_dh_free_key(ctx);
+
+	/* the fallback checks the parameters as for software DH */
+	err = crypto_kpp_set_secret(ctx->fallback, buf, len);
+	if (err)
+		return err;
+	if (crypto_dh_decode_key(buf, len, &params) < 0)
+		return -EINVAL;
+
+	p_sz = params.p_size;
+	p = sun8i_ce_strip(params.p, &p_sz);
+	g_sz = params.g_size;
+	g = sun8i_ce_strip(params.g, &g_sz);
+	if (!sun8i_ce_rsa_hw_size(p_sz * 8) || g_sz > p_sz ||
+	    (g_sz == p_sz && memcmp(g, p, p_sz) >= 0))
+		return 0;
+
+	ctx->p = kmemdup(p, p_sz, GFP_KERNEL);
+	if (!ctx->p)
+		return -ENOMEM;
+	ctx->p_sz = p_sz;
+	ctx->g = sun8i_ce_rsa_le(g, g_sz, p_sz);
+	if (IS_ERR(ctx->g)) {
+		err = PTR_ERR(ctx->g);
+		ctx->g = NULL;
+		goto err_free;
+	}
+	ctx->x = sun8i_ce_rsa_le(params.key, params.key_size, p_sz);
+	if (IS_ERR(ctx->x)) {
+		err = PTR_ERR(ctx->x);
+		ctx->x = NULL;
+		sun8i_ce_dh_free_key(ctx);
+		/* a key longer than p stays with the fallback */
+		return err == -EINVAL ? 0 : err;
+	}
+	ctx->hw = true;
+	return 0;
+
+err_free:
+	sun8i_ce_dh_free_key(ctx);
+	return err;
+}
+
+static int sun8i_ce_dh_fallback(struct kpp_request *req, bool shared)
+{
+	struct crypto_kpp *tfm = crypto_kpp_reqtfm(req);
+	struct sun8i_ce_dh_ctx *ctx = kpp_tfm_ctx(tfm);
+	struct sun8i_ce_pkc_alg *a = kpp_tmpl(tfm);
+	int err;
+
+	a->stat_fb++;
+	kpp_request_set_tfm(req, ctx->fallback);
+	err = shared ? crypto_kpp_compute_shared_secret(req) :
+		       crypto_kpp_generate_public_key(req);
+	kpp_request_set_tfm(req, tfm);
+	return err;
+}
+
+/* FIPS mode: the fallback does the SP800-56A checks */
+static int sun8i_ce_dh_queue(struct kpp_request *req, bool shared)
+{
+	struct crypto_kpp *tfm = crypto_kpp_reqtfm(req);
+	struct sun8i_ce_dh_ctx *ctx = kpp_tfm_ctx(tfm);
+	struct sun8i_ce_dh_reqctx *rctx = kpp_request_ctx(req);
+
+	if (!ctx->hw || fips_enabled || (shared && req->src_len > ctx->p_sz))
+		return sun8i_ce_dh_fallback(req, shared);
+
+	rctx->shared = shared;
+	return crypto_transfer_kpp_request_to_engine(ctx->ce->chanlist[CE_PKC_FLOW].engine,
+						     req);
+}
+
+static int sun8i_ce_dh_generate_public_key(struct kpp_request *req)
+{
+	return sun8i_ce_dh_queue(req, false);
+}
+
+static int sun8i_ce_dh_compute_shared_secret(struct kpp_request *req)
+{
+	return sun8i_ce_dh_queue(req, true);
+}
+
+static int sun8i_ce_dh_do(struct kpp_request *req, bool shared)
+{
+	struct crypto_kpp *tfm = crypto_kpp_reqtfm(req);
+	struct sun8i_ce_dh_ctx *ctx = kpp_tfm_ctx(tfm);
+	struct sun8i_ce_pkc_alg *a = kpp_tmpl(tfm);
+	unsigned int w = ctx->p_sz;
+	int nents, err;
+	u8 *src, *dst;
+
+	src = kzalloc(3 * w, GFP_KERNEL);
+	dst = kzalloc(w, GFP_KERNEL);
+	if (!src || !dst) {
+		err = -ENOMEM;
+		goto out;
+	}
+
+	memcpy(src, ctx->x, w);
+	sun8i_ce_be_to_le(src + w, w, ctx->p, w);
+	if (shared) {
+		/* the peer's value, big endian right aligned in dst */
+		nents = sg_nents_for_len(req->src, req->src_len);
+		if (nents < 0) {
+			err = nents;
+			goto out;
+		}
+		sg_copy_to_buffer(req->src, nents, dst + w - req->src_len,
+				  req->src_len);
+		if (memcmp(dst, ctx->p, w) >= 0) {
+			kfree_sensitive(src);
+			kfree_sensitive(dst);
+			return sun8i_ce_dh_fallback(req, shared);
+		}
+		sun8i_ce_be_to_le(src + 2 * w, w, dst, w);
+	} else {
+		memcpy(src + 2 * w, ctx->g, w);
+	}
+
+	a->stat_req++;
+	err = sun8i_ce_pkc_run(ctx->ce, CE_ALG_RSA, CE_PKC_MOD_EXP, src, 3, w,
+			       dst, w, "DH");
+	if (err)
+		goto out;
+
+	err = sun8i_ce_write_be(req->dst, req->dst_len, src, dst, w);
+out:
+	kfree_sensitive(src);
+	kfree_sensitive(dst);
+	return err;
+}
+
+static int sun8i_ce_dh_run(struct crypto_engine *engine, void *areq)
+{
+	struct kpp_request *req = container_of(areq, struct kpp_request, base);
+	struct sun8i_ce_dh_reqctx *rctx = kpp_request_ctx(req);
+	int err = sun8i_ce_dh_do(req, rctx->shared);
+
+	local_bh_disable();
+	crypto_finalize_kpp_request(engine, req, err);
+	local_bh_enable();
+	return 0;
+}
+
+static unsigned int sun8i_ce_dh_max_size(struct crypto_kpp *tfm)
+{
+	struct sun8i_ce_dh_ctx *ctx = kpp_tfm_ctx(tfm);
+
+	return crypto_kpp_maxsize(ctx->fallback);
+}
+
+static int sun8i_ce_dh_init(struct crypto_kpp *tfm)
+{
+	struct sun8i_ce_dh_ctx *ctx = kpp_tfm_ctx(tfm);
+	struct sun8i_ce_pkc_alg *a = kpp_tmpl(tfm);
+
+	memset(ctx, 0, sizeof(*ctx));
+	ctx->ce = a->ce;
+	ctx->fallback = crypto_alloc_kpp("dh", 0, CRYPTO_ALG_ASYNC |
+					 CRYPTO_ALG_NEED_FALLBACK);
+	if (IS_ERR(ctx->fallback))
+		return PTR_ERR(ctx->fallback);
+	kpp_set_reqsize(tfm, max(sizeof(struct sun8i_ce_dh_reqctx),
+				 crypto_kpp_reqsize(ctx->fallback)));
+	return 0;
+}
+
+static void sun8i_ce_dh_exit(struct crypto_kpp *tfm)
+{
+	struct sun8i_ce_dh_ctx *ctx = kpp_tfm_ctx(tfm);
+
+	sun8i_ce_dh_free_key(ctx);
+	crypto_free_kpp(ctx->fallback);
+}
