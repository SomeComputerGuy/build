+/*
+ * Little endian @le of @w bytes -> big endian in @sg, zero padded to @len, as
+ * rsa-generic and dh-generic. @tmp: @w bytes of scratch.
+ */
+static int sun8i_ce_write_be(struct scatterlist *sg, unsigned int len, u8 *tmp,
+			     const u8 *le, unsigned int w)
+{
+	unsigned int used, pad;
+	int nents;
+
+	sun8i_ce_reverse(tmp, le, w);
+	for (used = w; used && !tmp[w - used]; used--)
+		;
+	if (len < used)
+		return -EOVERFLOW;
+	nents = sg_nents_for_len(sg, len);
+	if (nents < 0)
+		return nents;
+	pad = len > w ? len - w : 0;
+	used = min(len, w);
+	sg_zero_buffer(sg, nents, pad, 0);
+	sg_pcopy_from_buffer(sg, nents, tmp + w - used, used, pad);
+	return 0;
+}
