From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 13 Nov 2026 12:00:00 +0000
Subject: crypto: ecdh - Add NIST P-521

The ECC code has P-521 since ECDSA got it, but ECDH does not offer it.
Register ecdh-nist-p521, with the RFC 5903 section 8.3 test vector, a
small-key vector and a key generation vector. As for the other curves,
points and the shared secret are ndigits * 8 = 72 bytes per coordinate,
big endian; the private key is 66 or 72 bytes.
Clear the whole key buffer when a key is refused: on big endian a
66-byte key does not fill its top digit.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 crypto/Kconfig   |   2 +-
 crypto/ecdh.c    |  35 +++++++-
 crypto/testmgr.c |   7 ++
 crypto/testmgr.h | 207 +++++++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 249 insertions(+), 2 deletions(-)

diff --git a/crypto/Kconfig b/crypto/Kconfig
index 981d5dc..fcc9d9e 100644
--- a/crypto/Kconfig
+++ b/crypto/Kconfig
@@ -313,7 +313,7 @@ config CRYPTO_ECDH
 	select CRYPTO_KPP
 	help
 	  ECDH (Elliptic Curve Diffie-Hellman) key exchange algorithm
-	  using curves P-192, P-256, and P-384 (FIPS 186)
+	  using curves P-192, P-256, P-384 and P-521 (FIPS 186)
 
 config CRYPTO_ECDSA
 	tristate "ECDSA (Elliptic Curve Digital Signature Algorithm)"
diff --git a/crypto/ecdh.c b/crypto/ecdh.c
index 9f0b93b..6558df4 100644
--- a/crypto/ecdh.c
+++ b/crypto/ecdh.c
@@ -45,7 +45,7 @@ static int ecdh_set_secret(struct crypto_kpp *tfm, const void *buf,
 
 	if (ecc_is_key_valid(ctx->curve_id, ctx->ndigits,
 			     ctx->private_key, params.key_size) < 0) {
-		memzero_explicit(ctx->private_key, params.key_size);
+		memzero_explicit(ctx->private_key, sizeof(ctx->private_key));
 		ret = -EINVAL;
 	}
 
@@ -203,6 +203,31 @@ static struct kpp_alg ecdh_nist_p384 = {
 	},
 };
 
+static int ecdh_nist_p521_init_tfm(struct crypto_kpp *tfm)
+{
+	struct ecdh_ctx *ctx = ecdh_get_ctx(tfm);
+
+	ctx->curve_id = ECC_CURVE_NIST_P521;
+	ctx->ndigits = ECC_CURVE_NIST_P521_DIGITS;
+
+	return 0;
+}
+
+static struct kpp_alg ecdh_nist_p521 = {
+	.set_secret = ecdh_set_secret,
+	.generate_public_key = ecdh_compute_value,
+	.compute_shared_secret = ecdh_compute_value,
+	.max_size = ecdh_max_size,
+	.init = ecdh_nist_p521_init_tfm,
+	.base = {
+		.cra_name = "ecdh-nist-p521",
+		.cra_driver_name = "ecdh-nist-p521-generic",
+		.cra_priority = 100,
+		.cra_module = THIS_MODULE,
+		.cra_ctxsize = sizeof(struct ecdh_ctx),
+	},
+};
+
 static bool ecdh_nist_p192_registered;
 
 static int __init ecdh_init(void)
@@ -221,8 +246,15 @@ static int __init ecdh_init(void)
 	if (ret)
 		goto nist_p384_error;
 
+	ret = crypto_register_kpp(&ecdh_nist_p521);
+	if (ret)
+		goto nist_p521_error;
+
 	return 0;
 
+nist_p521_error:
+	crypto_unregister_kpp(&ecdh_nist_p384);
+
 nist_p384_error:
 	crypto_unregister_kpp(&ecdh_nist_p256);
 
@@ -238,6 +270,7 @@ static void __exit ecdh_exit(void)
 		crypto_unregister_kpp(&ecdh_nist_p192);
 	crypto_unregister_kpp(&ecdh_nist_p256);
 	crypto_unregister_kpp(&ecdh_nist_p384);
+	crypto_unregister_kpp(&ecdh_nist_p521);
 }
 
 module_init(ecdh_init);
