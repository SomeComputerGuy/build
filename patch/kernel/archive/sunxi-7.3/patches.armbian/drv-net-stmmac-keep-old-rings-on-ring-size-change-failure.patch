From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 20 Nov 2026 08:27:12 +0000
Subject: [PATCH 5/5] net: stmmac: keep the old rings if a ring size change
 fails

stmmac_reinit_ringparam() frees the rings before it allocates the new
ones, so a failed allocation leaves the interface down. Allocate first
and swap, as stmmac_change_mtu() does.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 .../net/ethernet/stmicro/stmmac/stmmac_main.c | 36 +++++++++++++++----
 1 file changed, 29 insertions(+), 7 deletions(-)

diff --git a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
index 29644d1..c7b3ef9 100644
--- a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
@@ -7837,18 +7837,40 @@ int stmmac_reinit_queues(struct net_device *dev, u8 rx_cnt, u8 tx_cnt)
 int stmmac_reinit_ringparam(struct net_device *dev, u32 rx_size, u32 tx_size)
 {
 	struct stmmac_priv *priv = netdev_priv(dev);
-	int ret = 0;
-
-	if (netif_running(dev))
-		stmmac_release(dev);
+	u32 old_rx = priv->dma_conf.dma_rx_frames;
+	u32 old_tx = priv->dma_conf.dma_tx_frames;
+	struct stmmac_dma_conf *dma_conf;
+	int ret;
 
 	priv->dma_conf.dma_rx_frames = rx_size;
 	priv->dma_conf.dma_tx_frames = tx_size;
 
-	if (netif_running(dev))
-		ret = stmmac_open(dev);
+	if (!netif_running(dev))
+		return 0;
 
-	return ret;
+	/* As for an MTU change: keep the old rings if the new ones fail */
+	dma_conf = stmmac_setup_dma_desc(priv, dev->mtu);
+	if (IS_ERR(dma_conf)) {
+		priv->dma_conf.dma_rx_frames = old_rx;
+		priv->dma_conf.dma_tx_frames = old_tx;
+		return PTR_ERR(dma_conf);
+	}
+
+	__stmmac_release(dev);
+
+	ret = __stmmac_open(dev, dma_conf);
+	if (ret) {
+		free_dma_desc_resources(priv, dma_conf);
+		kfree(dma_conf);
+		netdev_err(priv->dev, "failed reopening the interface after a ring size change\n");
+		return ret;
+	}
+
+	kfree(dma_conf);
+
+	stmmac_set_rx_mode(dev);
+
+	return 0;
 }
 
 static int stmmac_xdp_rx_timestamp(const struct xdp_md *_ctx, u64 *timestamp)
