+/* send the events of a written-out snapshot, outside the latch lock */
+static void sun50i_mixer_send_events(struct drm_crtc *crtc,
+				     struct list_head *events)
+{
+	struct drm_pending_vblank_event *e, *n;
+	unsigned int count = 0;
+	unsigned long flags;
+
+	if (list_empty(events))
+		return;
+
+	spin_lock_irqsave(&crtc->dev->event_lock, flags);
+	list_for_each_entry_safe(e, n, events, base.link) {
+		list_del_init(&e->base.link);
+		drm_crtc_send_vblank_event(crtc, e);
+		count++;
+	}
+	spin_unlock_irqrestore(&crtc->dev->event_lock, flags);
+
+	while (count--)
+		drm_crtc_vblank_put(crtc);
+}
