 /**
+ * sunxi_engine_hold_event() - let the engine send a commit's vblank event
+ * @engine:	pointer to the engine
+ * @crtc:	pointer to crtc the engine is associated with
+ * @event:	the event, with a vblank reference held for it
+ *
+ * Returns: true if the engine took the event.
+ */
+static inline bool
+sunxi_engine_hold_event(struct sunxi_engine *engine, struct drm_crtc *crtc,
+			struct drm_pending_vblank_event *event)
+{
+	if (engine->ops && engine->ops->hold_event)
+		return engine->ops->hold_event(engine, crtc, event);
+	return false;
+}
