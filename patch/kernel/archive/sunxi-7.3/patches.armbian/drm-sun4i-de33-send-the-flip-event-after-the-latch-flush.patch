+/*
+ * atomic_flush, right after sun8i_mixer_commit(): the event goes with the
+ * snapshot just taken and is sent when that snapshot is written out. If the
+ * vblank interrupt already wrote it (it came between the two calls), the
+ * frame has been on screen since that vblank: send the event now, with that
+ * vblank's count and time.
+ */
+static bool sun50i_mixer_hold_event(struct sunxi_engine *engine,
+				    struct drm_crtc *crtc,
+				    struct drm_pending_vblank_event *event)
+{
+	struct sun8i_mixer *mixer = engine_to_sun8i_mixer(engine);
+	unsigned long flags;
+	bool held = false;
+	LIST_HEAD(now);
+
+	if (!mixer->shadow)
+		return false;
+
+	spin_lock_irqsave(&mixer->latch_lock, flags);
+	if (mixer->latch_pending && mixer->latch_crtc == crtc) {
+		list_add_tail(&event->base.link, &mixer->latch_events);
+		held = true;
+	} else {
+		de33_latch_events_now++;
+	}
+	spin_unlock_irqrestore(&mixer->latch_lock, flags);
+
+	if (!held) {
+		list_add_tail(&event->base.link, &now);
+		sun50i_mixer_send_events(crtc, &now);
+	}
+	return true;
+}
+
+/* CRTC going off: nothing scans out, write at once and send the events */
+static void sun50i_mixer_drain(struct sunxi_engine *engine)
+{
+	struct sun8i_mixer *mixer = engine_to_sun8i_mixer(engine);
+
+	if (mixer->shadow && READ_ONCE(mixer->latch_pending))
+		sun50i_mixer_latch_flush(mixer, -1);
+}
