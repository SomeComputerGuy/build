From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 20 Nov 2026 08:27:00 +0000
Subject: [PATCH 4/5] net: stmmac: size the rings in frames of the MTU

Normal descriptors in chain mode carry one buffer of at most 2032
bytes, so a jumbo frame spans several descriptors and a ring of 512
holds 56 frames at MTU 16356. Let the ring parameters count frames:
each ring gets frames x descriptors per frame, rounded down to a power
of two. Nothing changes where a frame fits one descriptor.

Allocate the initial RX buffers with the caller's GFP_KERNEL instead of
GFP_ATOMIC, as such a ring takes thousands of pages.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/net/ethernet/stmicro/stmmac/stmmac.h  |  3 ++
 .../ethernet/stmicro/stmmac/stmmac_ethtool.c  |  4 +--
 .../net/ethernet/stmicro/stmmac/stmmac_main.c | 35 ++++++++++++++-----
 3 files changed, 31 insertions(+), 11 deletions(-)

diff --git a/drivers/net/ethernet/stmicro/stmmac/stmmac.h b/drivers/net/ethernet/stmicro/stmmac/stmmac.h
index 8ad6b57..409b031 100644
--- a/drivers/net/ethernet/stmicro/stmmac/stmmac.h
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac.h
@@ -223,10 +223,13 @@ struct stmmac_dma_conf {
 	/* RX Queue */
 	struct stmmac_rx_queue rx_queue[MTL_MAX_RX_QUEUES];
 	unsigned int dma_rx_size;
+	/* ring size in frames of the MTU (ethtool) */
+	unsigned int dma_rx_frames;
 
 	/* TX Queue */
 	struct stmmac_tx_queue tx_queue[MTL_MAX_TX_QUEUES];
 	unsigned int dma_tx_size;
+	unsigned int dma_tx_frames;
 };
 
 #define EST_GCL         1024
diff --git a/drivers/net/ethernet/stmicro/stmmac/stmmac_ethtool.c b/drivers/net/ethernet/stmicro/stmmac/stmmac_ethtool.c
index 1be5310..cd93b9f 100644
--- a/drivers/net/ethernet/stmicro/stmmac/stmmac_ethtool.c
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac_ethtool.c
@@ -396,8 +396,8 @@ static void stmmac_get_ringparam(struct net_device *netdev,
 
 	ring->rx_max_pending = DMA_MAX_RX_SIZE;
 	ring->tx_max_pending = DMA_MAX_TX_SIZE;
-	ring->rx_pending = priv->dma_conf.dma_rx_size;
-	ring->tx_pending = priv->dma_conf.dma_tx_size;
+	ring->rx_pending = priv->dma_conf.dma_rx_frames;
+	ring->tx_pending = priv->dma_conf.dma_tx_frames;
 }
 
 static int stmmac_set_ringparam(struct net_device *netdev,
diff --git a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
index 081d61a..29644d1 100644
--- a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
@@ -1660,7 +1660,7 @@ static int stmmac_init_rx_buffers(struct stmmac_priv *priv,
 {
 	struct stmmac_rx_queue *rx_q = &dma_conf->rx_queue[queue];
 	struct stmmac_rx_buffer *buf = &rx_q->buf_pool[i];
-	gfp_t gfp = (GFP_ATOMIC | __GFP_NOWARN);
+	gfp_t gfp = flags | __GFP_NOWARN;
 
 	if (priv->dma_cap.host_dma_width <= 32)
 		gfp |= GFP_DMA32;
@@ -2011,6 +2011,16 @@ static bool stmmac_tx_split_bufs(struct stmmac_priv *priv)
 	       priv->hw->desc == &ndesc_ops;
 }
 
+/* Descriptors a frame of the MTU takes on either ring */
+static unsigned int stmmac_bufs_per_frame(struct stmmac_priv *priv,
+					  struct stmmac_dma_conf *dma_conf)
+{
+	if (!stmmac_tx_split_bufs(priv))
+		return 1;
+
+	return DIV_ROUND_UP(dma_conf->max_frame, dma_conf->dma_buf_sz);
+}
+
 /* Descriptors needed by @skb in stmmac_xmit() */
 static unsigned int stmmac_tx_descs(struct stmmac_priv *priv,
 				    struct sk_buff *skb)
@@ -4142,6 +4152,7 @@ stmmac_setup_dma_desc(struct stmmac_priv *priv, unsigned int mtu)
 {
 	struct stmmac_dma_conf *dma_conf;
 	int bfsize, len, ret;
+	unsigned int nbufs;
 	u8 chan;
 
 	dma_conf = kzalloc_obj(*dma_conf);
@@ -4174,13 +4185,19 @@ stmmac_setup_dma_desc(struct stmmac_priv *priv, unsigned int mtu)
 	/* Chose the tx/rx size from the already defined one in the
 	 * priv struct. (if defined)
 	 */
-	dma_conf->dma_tx_size = priv->dma_conf.dma_tx_size;
-	dma_conf->dma_rx_size = priv->dma_conf.dma_rx_size;
+	dma_conf->dma_tx_frames = priv->dma_conf.dma_tx_frames ?:
+				  DMA_DEFAULT_TX_SIZE;
+	dma_conf->dma_rx_frames = priv->dma_conf.dma_rx_frames ?:
+				  DMA_DEFAULT_RX_SIZE;
 
-	if (!dma_conf->dma_tx_size)
-		dma_conf->dma_tx_size = DMA_DEFAULT_TX_SIZE;
-	if (!dma_conf->dma_rx_size)
-		dma_conf->dma_rx_size = DMA_DEFAULT_RX_SIZE;
+	/* The rings hold that many frames of the MTU, rounded down to a
+	 * power of two descriptors.
+	 */
+	nbufs = stmmac_bufs_per_frame(priv, dma_conf);
+	dma_conf->dma_tx_size = rounddown_pow_of_two(dma_conf->dma_tx_frames *
+						     nbufs);
+	dma_conf->dma_rx_size = rounddown_pow_of_two(dma_conf->dma_rx_frames *
+						     nbufs);
 
 	/* Earlier check for TBS */
 	for (chan = 0; chan < priv->plat->tx_queues_to_use; chan++) {
@@ -7825,8 +7842,8 @@ int stmmac_reinit_ringparam(struct net_device *dev, u32 rx_size, u32 tx_size)
 	if (netif_running(dev))
 		stmmac_release(dev);
 
-	priv->dma_conf.dma_rx_size = rx_size;
-	priv->dma_conf.dma_tx_size = tx_size;
+	priv->dma_conf.dma_rx_frames = rx_size;
+	priv->dma_conf.dma_tx_frames = tx_size;
 
 	if (netif_running(dev))
 		ret = stmmac_open(dev);
-- 
