diff --git a/drivers/crypto/allwinner/sun8i-ce/sun8i-ce-hash.c b/drivers/crypto/allwinner/sun8i-ce/sun8i-ce-hash.c
index 80ae476..e32344c 100644
--- a/drivers/crypto/allwinner/sun8i-ce/sun8i-ce-hash.c
+++ b/drivers/crypto/allwinner/sun8i-ce/sun8i-ce-hash.c
@@ -5,12 +5,13 @@
  *
  * Copyright (C) 2015-2020 Corentin Labbe <clabbe@baylibre.com>
  *
- * This file add support for MD5 and SHA1/SHA224/SHA256/SHA384/SHA512, and
- * for the AES CBC-MAC.
+ * This file add support for MD5 and SHA1/SHA224/SHA256/SHA384/SHA512, for
+ * the AES CBC-MAC, and for HMAC-SHA1/HMAC-SHA256.
  *
  * You could find the datasheet in Documentation/arch/arm/sunxi.rst
  */
 
+#include <crypto/hmac.h>
 #include <crypto/internal/hash.h>
 #include <crypto/md5.h>
 #include <crypto/sha1.h>
@@ -698,3 +699,250 @@ int sun8i_ce_cbcmac_run(struct crypto_engine *engine, void *async_req)
 
 	return 0;
 }
+
+int sun8i_ce_hmac_setkey(struct crypto_ahash *tfm, const u8 *key,
+			 unsigned int keylen)
+{
+	struct sun8i_ce_hash_tfm_ctx *op = crypto_ahash_ctx(tfm);
+	struct ahash_alg *alg = crypto_ahash_alg(tfm);
+	unsigned int bs = crypto_ahash_blocksize(tfm);
+	struct sun8i_ce_alg_template *algt;
+	unsigned int i;
+	u8 *k;
+
+	algt = container_of(alg, struct sun8i_ce_alg_template, alg.hash.base);
+
+	/*
+	 * Two blocks: the key (hashed if longer than a block, 0-padded), which
+	 * the engine reads for the outer hash, and the key XOR ipad, which the
+	 * driver feeds in front of the message for the inner hash.
+	 */
+	k = kzalloc(2 * bs, GFP_KERNEL | GFP_DMA);
+	if (!k)
+		return -ENOMEM;
+	if (keylen > bs) {
+		if (algt->ce_algo_id == CE_ID_HASH_HMAC_SHA1)
+			sha1(key, keylen, k);
+		else
+			sha256(key, keylen, k);
+	} else {
+		memcpy(k, key, keylen);
+	}
+	for (i = 0; i < bs; i++)
+		k[bs + i] = k[i] ^ HMAC_IPAD_VALUE;
+
+	kfree_sensitive(op->key);
+	op->key = (u32 *)k;
+	op->keylen = 2 * bs;
+
+	crypto_ahash_clear_flags(op->fallback_tfm, CRYPTO_TFM_REQ_MASK);
+	crypto_ahash_set_flags(op->fallback_tfm,
+			       crypto_ahash_get_flags(tfm) & CRYPTO_TFM_REQ_MASK);
+
+	return crypto_ahash_setkey(op->fallback_tfm, key, keylen);
+}
+
+/*
+ * The engine pads the message itself (last package) and reads the source by
+ * words: every SG but the last must be a whole number of words, and the last
+ * word may be a partial one.
+ */
+static bool sun8i_ce_hmac_need_fallback(struct ahash_request *areq)
+{
+	struct crypto_ahash *tfm = crypto_ahash_reqtfm(areq);
+	struct ahash_alg *alg = crypto_ahash_alg(tfm);
+	struct sun8i_ce_alg_template *algt;
+	unsigned int len = areq->nbytes;
+	struct scatterlist *sg;
+	int nents;
+
+	algt = container_of(alg, struct sun8i_ce_alg_template, alg.hash.base);
+
+	if (len == 0) {
+		if (IS_ENABLED(CONFIG_CRYPTO_DEV_SUN8I_CE_DEBUG))
+			algt->stat_fb_len0++;
+		return true;
+	}
+	/* The data length (with the ipad block) is in bits, in 32 bits */
+	if (len > U32_MAX / 8 - crypto_ahash_blocksize(tfm)) {
+		if (IS_ENABLED(CONFIG_CRYPTO_DEV_SUN8I_CE_DEBUG))
+			algt->stat_fb_srclen++;
+		return true;
+	}
+	/* The first source SG is the ipad block */
+	nents = sg_nents_for_len(areq->src, len);
+	if (nents < 0 || nents > MAX_SG - 1) {
+		if (IS_ENABLED(CONFIG_CRYPTO_DEV_SUN8I_CE_DEBUG))
+			algt->stat_fb_maxsg++;
+		return true;
+	}
+	for (sg = areq->src; sg && len; sg = sg_next(sg)) {
+		if (!IS_ALIGNED(sg->offset, sizeof(u32))) {
+			if (IS_ENABLED(CONFIG_CRYPTO_DEV_SUN8I_CE_DEBUG))
+				algt->stat_fb_srcali++;
+			return true;
+		}
+		if (len > sg->length && sg->length % 4) {
+			if (IS_ENABLED(CONFIG_CRYPTO_DEV_SUN8I_CE_DEBUG))
+				algt->stat_fb_srclen++;
+			return true;
+		}
+		len -= min(len, sg->length);
+	}
+	return false;
+}
+
+int sun8i_ce_hmac_digest(struct ahash_request *areq)
+{
+	struct crypto_ahash *tfm = crypto_ahash_reqtfm(areq);
+	struct sun8i_ce_hash_tfm_ctx *ctx = crypto_ahash_ctx(tfm);
+	struct sun8i_ce_hash_reqctx *rctx = ahash_request_ctx_dma(areq);
+	struct sun8i_ce_dev *ce = ctx->ce;
+	struct crypto_engine *engine;
+	int e;
+
+	if (sun8i_ce_hmac_need_fallback(areq))
+		return sun8i_ce_hash_digest_fb(areq);
+
+	e = sun8i_ce_get_engine_number(ce);
+	rctx->flow = e;
+	engine = ce->chanlist[e].engine;
+
+	return crypto_transfer_hash_request_to_engine(engine, areq);
+}
+
+/*
+ * HMAC in one task, as the last package. The engine hashes the source as is
+ * (it does not add the key XOR ipad block itself), pads it to the length the
+ * key address points to, then hashes the key XOR opad block with that inner
+ * digest, taking the key from the ctr address. So the source is the key XOR
+ * ipad block followed by the message, and the data length and the length
+ * word are both that whole length in bits.
+ */
+static int sun8i_ce_hmac_prepare(struct ahash_request *areq,
+				 struct ce_task *cet)
+{
+	struct crypto_ahash *tfm = crypto_ahash_reqtfm(areq);
+	struct sun8i_ce_hash_tfm_ctx *ctx = crypto_ahash_ctx(tfm);
+	struct sun8i_ce_hash_reqctx *rctx = ahash_request_ctx_dma(areq);
+	struct ahash_alg *alg = crypto_ahash_alg(tfm);
+	struct sun8i_ce_alg_template *algt;
+	struct sun8i_ce_dev *ce = ctx->ce;
+	unsigned int bs = crypto_ahash_blocksize(tfm);
+	struct scatterlist *sg;
+	unsigned int len, todo;
+	int nr_sgs, i, err;
+	__le32 *bitlen;
+	u32 common;
+
+	algt = container_of(alg, struct sun8i_ce_alg_template, alg.hash.base);
+
+	if (IS_ENABLED(CONFIG_CRYPTO_DEV_SUN8I_CE_DEBUG))
+		algt->stat_req++;
+
+	memset(cet, 0, sizeof(struct ce_task));
+
+	cet->t_id = cpu_to_le32(rctx->flow);
+	common = ce->variant->alg_hash[algt->ce_algo_id];
+	common |= CE_COMM_HASH_LAST | CE_COMM_INT;
+	cet->t_common_ctl = cpu_to_le32(common);
+	cet->t_sym_ctl = 0;
+	cet->t_asym_ctl = 0;
+	cet->t_dlen = cpu_to_le32((bs + areq->nbytes) * 8);
+
+	bitlen = (__le32 *)rctx->pad;
+	bitlen[0] = cpu_to_le32((bs + areq->nbytes) * 8);
+	bitlen[1] = 0;
+	rctx->pad_len = 2 * sizeof(u32);
+	rctx->addr_pad = dma_map_single(ce->dev, rctx->pad, rctx->pad_len,
+					DMA_TO_DEVICE);
+	if (dma_mapping_error(ce->dev, rctx->addr_pad)) {
+		dev_err(ce->dev, "Cannot DMA MAP length\n");
+		return -EFAULT;
+	}
+	cet->t_key = desc_addr_val_le32(ce, rctx->addr_pad);
+
+	rctx->addr_key = dma_map_single(ce->dev, ctx->key, ctx->keylen,
+					DMA_TO_DEVICE);
+	if (dma_mapping_error(ce->dev, rctx->addr_key)) {
+		dev_err(ce->dev, "Cannot DMA MAP KEY\n");
+		err = -EFAULT;
+		goto err_unmap_pad;
+	}
+	cet->t_ctr = desc_addr_val_le32(ce, rctx->addr_key);
+	cet->t_src[0].addr = desc_addr_val_le32(ce, rctx->addr_key + bs);
+	cet->t_src[0].len = cpu_to_le32(bs / 4);
+
+	rctx->nr_sgs = sg_nents_for_len(areq->src, areq->nbytes);
+	nr_sgs = dma_map_sg(ce->dev, areq->src, rctx->nr_sgs, DMA_TO_DEVICE);
+	if (nr_sgs <= 0 || nr_sgs > MAX_SG - 1) {
+		dev_err(ce->dev, "Invalid sg number %d\n", nr_sgs);
+		err = -EINVAL;
+		goto err_unmap_key;
+	}
+
+	len = areq->nbytes;
+	for_each_sg(areq->src, sg, nr_sgs, i) {
+		cet->t_src[i + 1].addr = desc_addr_val_le32(ce, sg_dma_address(sg));
+		todo = min(len, sg_dma_len(sg));
+		cet->t_src[i + 1].len = cpu_to_le32(DIV_ROUND_UP(todo, 4));
+		len -= todo;
+	}
+	if (len > 0) {
+		dev_err(ce->dev, "remaining len %d\n", len);
+		err = -EINVAL;
+		goto err_unmap_src;
+	}
+
+	rctx->result_len = crypto_ahash_digestsize(tfm);
+	rctx->addr_res = dma_map_single(ce->dev, rctx->result, rctx->result_len,
+					DMA_FROM_DEVICE);
+	if (dma_mapping_error(ce->dev, rctx->addr_res)) {
+		dev_err(ce->dev, "DMA map dest\n");
+		err = -EINVAL;
+		goto err_unmap_src;
+	}
+	cet->t_dst[0].addr = desc_addr_val_le32(ce, rctx->addr_res);
+	cet->t_dst[0].len = cpu_to_le32(rctx->result_len / 4);
+
+	return 0;
+
+err_unmap_src:
+	dma_unmap_sg(ce->dev, areq->src, rctx->nr_sgs, DMA_TO_DEVICE);
+err_unmap_key:
+	dma_unmap_single(ce->dev, rctx->addr_key, ctx->keylen, DMA_TO_DEVICE);
+err_unmap_pad:
+	dma_unmap_single(ce->dev, rctx->addr_pad, rctx->pad_len, DMA_TO_DEVICE);
+	return err;
+}
+
+int sun8i_ce_hmac_run(struct crypto_engine *engine, void *async_req)
+{
+	struct ahash_request *areq = ahash_request_cast(async_req);
+	struct crypto_ahash *tfm = crypto_ahash_reqtfm(areq);
+	struct sun8i_ce_hash_tfm_ctx *ctx = crypto_ahash_ctx(tfm);
+	struct sun8i_ce_hash_reqctx *rctx = ahash_request_ctx_dma(areq);
+	struct sun8i_ce_dev *ce = ctx->ce;
+	int err;
+
+	err = sun8i_ce_hmac_prepare(areq, ce->chanlist[rctx->flow].tl);
+	if (err)
+		return err;
+
+	err = sun8i_ce_run_task(ce, rctx->flow, crypto_ahash_alg_name(tfm));
+
+	dma_unmap_single(ce->dev, rctx->addr_res, rctx->result_len,
+			 DMA_FROM_DEVICE);
+	dma_unmap_sg(ce->dev, areq->src, rctx->nr_sgs, DMA_TO_DEVICE);
+	dma_unmap_single(ce->dev, rctx->addr_key, ctx->keylen, DMA_TO_DEVICE);
+	dma_unmap_single(ce->dev, rctx->addr_pad, rctx->pad_len, DMA_TO_DEVICE);
+
+	if (!err)
+		memcpy(areq->result, rctx->result, rctx->result_len);
+
+	local_bh_disable();
+	crypto_finalize_hash_request(engine, async_req, err);
+	local_bh_enable();
+
+	return 0;
+}
