diff -ruN a/drivers/gpu/drm/sun4i/sun50i_planes.c b/drivers/gpu/drm/sun4i/sun50i_planes.c
--- a/drivers/gpu/drm/sun4i/sun50i_planes.c
+++ b/drivers/gpu/drm/sun4i/sun50i_planes.c
@@ -14,6 +14,7 @@
 #include <linux/regmap.h>
 
 #include "sun50i_planes.h"
+#include "sun50i_shadow.h"
 #include "sun8i_ui_layer.h"
 #include "sun8i_vi_layer.h"
 
@@ -119,6 +120,50 @@
 }
 EXPORT_SYMBOL(sun50i_planes_setup);
 
+/*
+ * The plane registers are not double-buffered by the hardware, so they are
+ * written through a shadow (sun50i_shadow.h). The mixer of display @mixer
+ * commits the channels mapped to it at the end of its atomic flush and
+ * writes them out from its vblank interrupt, while the beam is in the
+ * vertical blanking. Each channel owns the DE33_CH_SIZE window at
+ * channel * DE33_CH_SIZE (CSC, overlay, scaler, decompressor).
+ */
+static unsigned int sun50i_planes_for_each_channel(struct device *dev,
+						   unsigned int mixer,
+						   unsigned int (*fn)(struct sun50i_shadow *,
+								      unsigned int,
+								      unsigned int))
+{
+	struct sun50i_planes *planes = dev_get_drvdata(dev);
+	const struct default_map *map;
+	unsigned int i, n = 0;
+
+	if (!planes || mixer >= MAX_DISP)
+		return 0;
+
+	map = &planes->quirks->def_map[mixer];
+	for (i = 0; i < map->num_ch; i++) {
+		unsigned int start = map->map[i] * DE33_CH_SIZE;
+
+		n += fn(planes->shadow, start, start + DE33_CH_SIZE);
+	}
+
+	return n;
+}
+
+unsigned int sun50i_planes_commit(struct device *dev, unsigned int mixer)
+{
+	return sun50i_planes_for_each_channel(dev, mixer, sun50i_shadow_commit);
+}
+EXPORT_SYMBOL(sun50i_planes_commit);
+
+/* Runs from the TCON vblank interrupt. */
+unsigned int sun50i_planes_flush(struct device *dev, unsigned int mixer)
+{
+	return sun50i_planes_for_each_channel(dev, mixer, sun50i_shadow_flush);
+}
+EXPORT_SYMBOL(sun50i_planes_flush);
