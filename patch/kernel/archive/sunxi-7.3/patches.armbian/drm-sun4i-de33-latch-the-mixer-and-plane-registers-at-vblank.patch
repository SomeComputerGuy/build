diff -ruN a/drivers/gpu/drm/sun4i/sun50i_shadow.c b/drivers/gpu/drm/sun4i/sun50i_shadow.c
--- a/drivers/gpu/drm/sun4i/sun50i_shadow.c
+++ b/drivers/gpu/drm/sun4i/sun50i_shadow.c
@@ -0,0 +1,275 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Register shadow with a commit/flush split, see sun50i_shadow.h.
+ *
+ * Pages of 1024 registers (4 KiB) are allocated the first time a register
+ * in them is written, so a sparse register space costs only the pages the
+ * driver uses. reg_write runs in process context under the regmap mutex;
+ * commit and flush take the shadow spinlock and may run from a hard IRQ.
+ */
+
+#include <linux/bitmap.h>
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+
+#include "sun50i_shadow.h"
+
+#define SHADOW_PAGE_WORDS	1024
+#define SHADOW_PAGE_SHIFT	10
+#define SHADOW_PAGE_BYTES	(SHADOW_PAGE_WORDS * 4)
+
+struct sun50i_shadow_page {
+	u32		stage[SHADOW_PAGE_WORDS];	/* driver writes */
+	u32		latch[SHADOW_PAGE_WORDS];	/* committed values */
+	DECLARE_BITMAP(stage_dirty, SHADOW_PAGE_WORDS);
+	DECLARE_BITMAP(latch_dirty, SHADOW_PAGE_WORDS);
+};
+
+struct sun50i_shadow {
+	struct device			*dev;
+	void __iomem			*base;
+	unsigned int			npages;
+	struct regmap			*map;
+	spinlock_t			lock;
+	struct sun50i_shadow_page	**pages;
+	unsigned long			*stage_pages;	/* pages with staged words */
+	unsigned long			*latch_pages;	/* pages with latched words */
+};
+
+static struct sun50i_shadow_page *
+sun50i_shadow_get_page(struct sun50i_shadow *shadow, unsigned int p)
+{
+	struct sun50i_shadow_page *page, *old;
+	unsigned long flags;
+
+	page = READ_ONCE(shadow->pages[p]);
+	if (page)
+		return page;
+
+	page = kzalloc(sizeof(*page), GFP_KERNEL);
+	if (!page)
+		return NULL;
+
+	spin_lock_irqsave(&shadow->lock, flags);
+	old = shadow->pages[p];
+	if (!old)
+		shadow->pages[p] = page;
+	spin_unlock_irqrestore(&shadow->lock, flags);
+
+	if (old) {
+		kfree(page);
+		page = old;
+	}
+
+	return page;
+}
+
+static int sun50i_shadow_reg_write(void *context, unsigned int reg,
+				   unsigned int val)
+{
+	struct sun50i_shadow *shadow = context;
+	unsigned int word = reg >> 2, p = word >> SHADOW_PAGE_SHIFT;
+	unsigned int w = word & (SHADOW_PAGE_WORDS - 1);
+	struct sun50i_shadow_page *page;
+	unsigned long flags;
+
+	if (p >= shadow->npages)
+		return -EINVAL;
+
+	page = sun50i_shadow_get_page(shadow, p);
+	if (!page)
+		return -ENOMEM;
+
+	spin_lock_irqsave(&shadow->lock, flags);
+	page->stage[w] = val;
+	__set_bit(w, page->stage_dirty);
+	__set_bit(p, shadow->stage_pages);
+	spin_unlock_irqrestore(&shadow->lock, flags);
+
+	return 0;
+}
+
+static int sun50i_shadow_reg_read(void *context, unsigned int reg,
+				  unsigned int *val)
+{
+	struct sun50i_shadow *shadow = context;
+	unsigned int word = reg >> 2, p = word >> SHADOW_PAGE_SHIFT;
+	unsigned int w = word & (SHADOW_PAGE_WORDS - 1);
+	struct sun50i_shadow_page *page;
+	unsigned long flags;
+
+	if (p >= shadow->npages)
+		return -EINVAL;
+
+	page = READ_ONCE(shadow->pages[p]);
+	if (!page) {
+		*val = 0;
+		return 0;
+	}
+
+	spin_lock_irqsave(&shadow->lock, flags);
+	*val = page->stage[w];
+	spin_unlock_irqrestore(&shadow->lock, flags);
+
+	return 0;
+}
+
+static void sun50i_shadow_range(struct sun50i_shadow *shadow,
+				unsigned int start, unsigned int end,
+				unsigned int *first, unsigned int *last)
+{
+	*first = start / SHADOW_PAGE_BYTES;
+	if (end == SUN50I_SHADOW_ALL || end / SHADOW_PAGE_BYTES > shadow->npages)
+		*last = shadow->npages;
+	else
+		*last = DIV_ROUND_UP(end, SHADOW_PAGE_BYTES);
+}
+
+/**
+ * sun50i_shadow_commit - snapshot the staged registers of a range
+ * @shadow: the shadow
+ * @start: first register offset of the range (page aligned)
+ * @end: end of the range (exclusive, page aligned) or SUN50I_SHADOW_ALL
+ *
+ * Everything written since the previous commit of the range becomes the
+ * state the next flush applies. Writes after this call stay staged for the
+ * following commit, so a flush never applies a half-written update.
+ *
+ * Returns: the number of registers latched.
+ */
+unsigned int sun50i_shadow_commit(struct sun50i_shadow *shadow,
+				  unsigned int start, unsigned int end)
+{
+	unsigned int first, last, p, w, n = 0;
+	unsigned long flags;
+
+	sun50i_shadow_range(shadow, start, end, &first, &last);
+
+	spin_lock_irqsave(&shadow->lock, flags);
+	for_each_set_bit_from(first, shadow->stage_pages, last) {
+		struct sun50i_shadow_page *page = shadow->pages[first];
+
+		p = first;
+		for_each_set_bit(w, page->stage_dirty, SHADOW_PAGE_WORDS) {
+			page->latch[w] = page->stage[w];
+			__set_bit(w, page->latch_dirty);
+			n++;
+		}
+		bitmap_zero(page->stage_dirty, SHADOW_PAGE_WORDS);
+		__clear_bit(p, shadow->stage_pages);
+		__set_bit(p, shadow->latch_pages);
+	}
+	spin_unlock_irqrestore(&shadow->lock, flags);
+
+	return n;
+}
+
+/**
+ * sun50i_shadow_flush - write the latched registers of a range to the hardware
+ * @shadow: the shadow
+ * @start: first register offset of the range (page aligned)
+ * @end: end of the range (exclusive, page aligned) or SUN50I_SHADOW_ALL
+ *
+ * May be called from a hard IRQ. The caller decides when: the point of the
+ * shadow is to issue this inside the vertical blanking.
+ *
+ * Returns: the number of registers written.
+ */
+unsigned int sun50i_shadow_flush(struct sun50i_shadow *shadow,
+				 unsigned int start, unsigned int end)
+{
+	unsigned int first, last, p, w, n = 0;
+	unsigned long flags;
+
+	sun50i_shadow_range(shadow, start, end, &first, &last);
+
+	spin_lock_irqsave(&shadow->lock, flags);
+	for_each_set_bit_from(first, shadow->latch_pages, last) {
+		struct sun50i_shadow_page *page = shadow->pages[first];
+		void __iomem *base;
+
+		p = first;
+		base = shadow->base + ((size_t)p << (SHADOW_PAGE_SHIFT + 2));
+		for_each_set_bit(w, page->latch_dirty, SHADOW_PAGE_WORDS) {
+			writel_relaxed(page->latch[w], base + (w << 2));
+			n++;
+		}
+		bitmap_zero(page->latch_dirty, SHADOW_PAGE_WORDS);
+		__clear_bit(p, shadow->latch_pages);
+	}
+	/* order the posted register writes before whatever follows */
+	wmb();
+	spin_unlock_irqrestore(&shadow->lock, flags);
+
+	return n;
+}
+
+static void sun50i_shadow_release(void *data)
+{
+	struct sun50i_shadow *shadow = data;
+	unsigned int p;
+
+	for (p = 0; p < shadow->npages; p++)
+		kfree(shadow->pages[p]);
+}
+
+/**
+ * sun50i_shadow_create - set up a shadow in front of a register block
+ * @dev: owning device (devres)
+ * @base: ioremapped register block
+ * @size: size of the block in bytes
+ * @name: regmap name (debugfs)
+ *
+ * Returns: the shadow, or an ERR_PTR.
+ */
+struct sun50i_shadow *sun50i_shadow_create(struct device *dev,
+					   void __iomem *base,
+					   resource_size_t size,
+					   const char *name)
+{
+	struct regmap_config config = {
+		.name		= name,
+		.reg_bits	= 32,
+		.val_bits	= 32,
+		.reg_stride	= 4,
+		.reg_read	= sun50i_shadow_reg_read,
+		.reg_write	= sun50i_shadow_reg_write,
+	};
+	struct sun50i_shadow *shadow;
+	int ret;
+
+	shadow = devm_kzalloc(dev, sizeof(*shadow), GFP_KERNEL);
+	if (!shadow)
+		return ERR_PTR(-ENOMEM);
+
+	shadow->dev = dev;
+	shadow->base = base;
+	shadow->npages = DIV_ROUND_UP(size, SHADOW_PAGE_BYTES);
+	spin_lock_init(&shadow->lock);
+
+	shadow->pages = devm_kcalloc(dev, shadow->npages, sizeof(*shadow->pages),
+				     GFP_KERNEL);
+	shadow->stage_pages = devm_bitmap_zalloc(dev, shadow->npages, GFP_KERNEL);
+	shadow->latch_pages = devm_bitmap_zalloc(dev, shadow->npages, GFP_KERNEL);
+	if (!shadow->pages || !shadow->stage_pages || !shadow->latch_pages)
+		return ERR_PTR(-ENOMEM);
+
+	ret = devm_add_action_or_reset(dev, sun50i_shadow_release, shadow);
+	if (ret)
+		return ERR_PTR(ret);
+
+	config.max_register = shadow->npages * SHADOW_PAGE_BYTES - 4;
+	shadow->map = devm_regmap_init(dev, NULL, shadow, &config);
+	if (IS_ERR(shadow->map))
+		return ERR_CAST(shadow->map);
+
+	return shadow;
+}
+
+struct regmap *sun50i_shadow_regmap(struct sun50i_shadow *shadow)
+{
+	return shadow->map;
+}
diff -ruN a/drivers/gpu/drm/sun4i/sun50i_shadow.h b/drivers/gpu/drm/sun4i/sun50i_shadow.h
--- a/drivers/gpu/drm/sun4i/sun50i_shadow.h
+++ b/drivers/gpu/drm/sun4i/sun50i_shadow.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Register shadow for display engines whose registers are not
+ * double-buffered by hardware (the H616 DE33 driven over plain MMIO).
+ *
+ * Driver writes go through a regmap into a staging copy. A commit snapshots
+ * the staged words of a register range into the latch copy, and a flush,
+ * issued from the vblank interrupt while the beam is in the vertical
+ * blanking, writes the latched words to the hardware. This gives the
+ * frame-coherent register update that the DE2/DE3 GLB_DBUFF bit provides in
+ * hardware.
+ */
+
+#ifndef _SUN50I_SHADOW_H_
+#define _SUN50I_SHADOW_H_
+
+#include <linux/types.h>
+
+struct device;
+struct regmap;
+struct sun50i_shadow;
+
+/* register range in bytes, [start, end); end = SUN50I_SHADOW_ALL for everything */
+#define SUN50I_SHADOW_ALL	(~0u)
+
+struct sun50i_shadow *sun50i_shadow_create(struct device *dev,
+					   void __iomem *base,
+					   resource_size_t size,
+					   const char *name);
+struct regmap *sun50i_shadow_regmap(struct sun50i_shadow *shadow);
+
+unsigned int sun50i_shadow_commit(struct sun50i_shadow *shadow,
+				  unsigned int start, unsigned int end);
+unsigned int sun50i_shadow_flush(struct sun50i_shadow *shadow,
+				 unsigned int start, unsigned int end);
+
+#endif /* _SUN50I_SHADOW_H_ */
diff -ruN a/drivers/gpu/drm/sun4i/sun8i_mixer.c b/drivers/gpu/drm/sun4i/sun8i_mixer.c
--- a/drivers/gpu/drm/sun4i/sun8i_mixer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_mixer.c
@@ -9,6 +9,7 @@
 
 #include <linux/component.h>
 #include <linux/delay.h>
+#include <linux/ktime.h>
 #include <linux/dma-mapping.h>
 #include <linux/module.h>
 #include <linux/of.h>
@@ -26,9 +27,11 @@
 #include <drm/drm_gem_dma_helper.h>
 #include <drm/drm_print.h>
 #include <drm/drm_probe_helper.h>
+#include <drm/drm_vblank.h>
 
 #include "sun4i_drv.h"
 #include "sun50i_planes.h"
+#include "sun50i_shadow.h"
 #include "sun4i_tcon.h"
 #include "sun8i_csc.h"
 #include "sun8i_mixer.h"
@@ -269,6 +272,159 @@
 	return -EINVAL;
 }
 
+/*
+ * H616 DE33 over plain MMIO: the blender and plane registers are not
+ * double-buffered (there is no GLB_DBUFF; the hardware way is the RCQ DMA,
+ * which is not used here). A register written from the commit worker takes
+ * effect at whatever scan line the beam is on, so a page flip tears at that
+ * line and a pipe enable flashes the background colour. Instead, every write
+ * goes to a shadow (sun50i_shadow.h); sun8i_mixer_commit() snapshots the
+ * frame's registers and keeps the vblank interrupt on, and the TCON vblank
+ * interrupt writes the snapshot out through vblank_quirk, while the beam is
+ * in the leading vertical blanking. This is what the vendor driver's AHB path
+ * does (sync_event_proc -> de_rtmx_update_reg_ahb in its vsync interrupt)
+ * and what DE2/DE3 do in hardware with GLB_DBUFF. While the CRTC is off
+ * nothing scans out and there is no vblank, so the writes go out at once.
+ *
+ * The counters are read-only diagnostics: a frame-coherent update needs
+ * de33_latch_flushes_late == 0 and de33_latch_line_max < de33_latch_line_active.
+ */
+static unsigned int de33_latch_commits;
+static unsigned int de33_latch_coalesced;	/* commits before the previous one flushed */
+static unsigned int de33_latch_flushes;
+static unsigned int de33_latch_flushes_sync;	/* written at once, CRTC off */
+static unsigned int de33_latch_flushes_late;	/* vblank IRQ found the beam in active video */
+static unsigned int de33_latch_words_max;	/* most registers written by one flush */
+static unsigned int de33_latch_ns_max;		/* longest flush */
+static int de33_latch_line_min = -1;		/* TCON line at flush, min/max */
+static int de33_latch_line_max = -1;
+static int de33_latch_line_active = -1;		/* first active TCON line of the mode */
+module_param(de33_latch_commits, uint, 0444);
+module_param(de33_latch_coalesced, uint, 0444);
+module_param(de33_latch_flushes, uint, 0444);
+module_param(de33_latch_flushes_sync, uint, 0444);
+module_param(de33_latch_flushes_late, uint, 0444);
+module_param(de33_latch_words_max, uint, 0444);
+module_param(de33_latch_ns_max, uint, 0444);
+module_param(de33_latch_line_min, int, 0444);
+module_param(de33_latch_line_max, int, 0444);
+module_param(de33_latch_line_active, int, 0444);
+
+static void sun50i_mixer_latch_mode_set(struct sun8i_mixer *mixer,
+					const struct drm_display_mode *mode)
+{
+	/*
+	 * The TCON TV line counter that sun4i_tcon_handler() passes as
+	 * cur_line is zeroed at the start of the vertical sync and counts up
+	 * to vtotal; active video starts vsync + back porch lines later.
+	 */
+	mixer->line_total = mode->crtc_vtotal;
+	mixer->line_active = mode->crtc_vtotal - mode->crtc_vsync_start;
+	de33_latch_line_active = mixer->line_active;
+	de33_latch_line_min = -1;
+	de33_latch_line_max = -1;
+}
+
+/*
+ * Write the snapshot out. @cur_line is the TCON scan line at the vblank
+ * interrupt, or -1 for an immediate write with the CRTC off.
+ */
+static void sun50i_mixer_latch_flush(struct sun8i_mixer *mixer, int cur_line)
+{
+	struct drm_crtc *crtc = NULL;
+	unsigned long flags;
+	unsigned int words;
+	u64 ns;
+
+	spin_lock_irqsave(&mixer->latch_lock, flags);
+	if (!mixer->latch_pending) {
+		spin_unlock_irqrestore(&mixer->latch_lock, flags);
+		return;
+	}
+
+	ns = ktime_get_ns();
+	words = sun50i_planes_flush(mixer->planes_dev, mixer->engine.id);
+	words += sun50i_shadow_flush(mixer->shadow, 0, SUN50I_SHADOW_ALL);
+	ns = ktime_get_ns() - ns;
+
+	mixer->latch_pending = false;
+	if (mixer->latch_vblank_ref) {
+		mixer->latch_vblank_ref = false;
+		crtc = mixer->latch_crtc;
+	}
+
+	de33_latch_flushes++;
+	if (words > de33_latch_words_max)
+		de33_latch_words_max = words;
+	if (ns > de33_latch_ns_max)
+		de33_latch_ns_max = ns;
+	if (cur_line < 0) {
+		de33_latch_flushes_sync++;
+	} else {
+		if (de33_latch_line_min < 0 || cur_line < de33_latch_line_min)
+			de33_latch_line_min = cur_line;
+		if (cur_line > de33_latch_line_max)
+			de33_latch_line_max = cur_line;
+		if ((unsigned int)cur_line >= mixer->line_active)
+			de33_latch_flushes_late++;
+	}
+	spin_unlock_irqrestore(&mixer->latch_lock, flags);
+
+	if (crtc)
+		drm_crtc_vblank_put(crtc);
+}
+
+/* End of an atomic flush: snapshot the frame and wait for the vblank. */
+static void sun50i_mixer_latch_commit(struct sun8i_mixer *mixer,
+				      struct drm_crtc *crtc)
+{
+	bool now = false, put = false;
+	unsigned long flags;
+
+	sun50i_shadow_commit(mixer->shadow, 0, SUN50I_SHADOW_ALL);
+	sun50i_planes_commit(mixer->planes_dev, mixer->engine.id);
+
+	spin_lock_irqsave(&mixer->latch_lock, flags);
+	de33_latch_commits++;
+	if (mixer->latch_pending)
+		de33_latch_coalesced++;
+	mixer->latch_pending = true;
+	mixer->latch_crtc = crtc;
+
+	/*
+	 * Keep the vblank interrupt on until the flush: a commit without a
+	 * page-flip event (legacy cursor update) does not enable it itself.
+	 * drm_crtc_vblank_get() fails while the CRTC is off (the planes of a
+	 * modeset are programmed before the CRTC is enabled, and after it is
+	 * disabled): nothing scans out then, write at once. That also drops
+	 * a reference left from a commit whose vblank never came.
+	 */
+	if (drm_crtc_vblank_get(crtc) == 0) {
+		if (mixer->latch_vblank_ref)
+			put = true;
+		else
+			mixer->latch_vblank_ref = true;
+	} else {
+		now = true;
+	}
+	spin_unlock_irqrestore(&mixer->latch_lock, flags);
+
+	if (put)
+		drm_crtc_vblank_put(crtc);
+	if (now)
+		sun50i_mixer_latch_flush(mixer, -1);
+}
+
+/* TCON vblank interrupt, hard IRQ context */
+static void sun50i_mixer_vblank_quirk(struct sunxi_engine *engine,
+				      unsigned int cur_line)
+{
+	struct sun8i_mixer *mixer = engine_to_sun8i_mixer(engine);
+
+	if (READ_ONCE(mixer->latch_pending))
+		sun50i_mixer_latch_flush(mixer, cur_line);
+}
