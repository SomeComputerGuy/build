From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Sat, 14 Nov 2026 17:00:00 +0000
Subject: clk: sunxi-ng: h616: Keep the HDMI clock on the TCON TV0 PLL

The HDMI controller clock has to run at the pixel clock that TCON TV0
sends it, but the two clocks can end up on different PLLs at different
rates. TCON TV0 has an M and a P divider and re-rates pll-video0, the
HDMI clock only has an M divider and may pick any of its four parents.
For 640x480 at 59.94 Hz (25.175 MHz), TCON TV0 sets pll-video0 to
453 MHz and divides by 9 * 2 = 18 (25.167 MHz). 18 is out of reach of
the HDMI divider, so the HDMI clock moves to pll-video2 (powering it up)
and runs at 297 MHz / 12 = 24.75 MHz, 1.7 % off the pixel clock.

On an Orange Pi Zero2 with a TV attached this mode set corrupts memory
within a second: oopses on valid kernel code ("Undefined instruction" on
a NOP or a str), page allocator lists with flipped bits, hangs. It
happens on every first switch to that mode, with the CPU at 480 MHz or
1.5 GHz, and on the stock 7.3.3 kernel as well. 640x480 at 60 Hz and
every other mode of the TV, where both clocks come out equal on
pll-video0, run clean.

Give TCON TV0 the same divider set as the HDMI clock (M only, P cleared
at probe) and keep the HDMI clock on its reset parent pll-video0, the
PLL that TCON TV0 is assigned to. The HDMI clock can then always follow
the pixel clock exactly: 640x480 at 59.94 Hz now gets pll-video0 at
327 MHz / 13 = 25.154 MHz for both.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
diff --git a/drivers/clk/sunxi-ng/ccu-sun50i-h616.c b/drivers/clk/sunxi-ng/ccu-sun50i-h616.c
--- a/drivers/clk/sunxi-ng/ccu-sun50i-h616.c
+++ b/drivers/clk/sunxi-ng/ccu-sun50i-h616.c
@@ -613,11 +613,16 @@
 
 static const char * const hdmi_parents[] = { "pll-video0", "pll-video0-4x",
 					     "pll-video2", "pll-video2-4x" };
+/*
+ * The HDMI controller clock must run at the TCON TV0 pixel clock. Keep it on
+ * the TCON's PLL (pll-video0, the reset parent): a rate the M divider cannot
+ * reach from there must not move it to pll-video2 at a different rate.
+ */
 static SUNXI_CCU_M_WITH_MUX_GATE(hdmi_clk, "hdmi", hdmi_parents, 0xb00,
 				 0, 4,		/* M */
 				 24, 2,		/* mux */
 				 BIT(31),	/* gate */
-				 0);
+				 CLK_SET_RATE_NO_REPARENT);
 
 static SUNXI_CCU_GATE(hdmi_slow_clk, "hdmi-slow", "osc24M", 0xb04, BIT(31), 0);
 
@@ -627,6 +632,7 @@
 };
 
 #define SUN50I_H616_HDMI_CEC_CLK_REG		0xb10
+#define SUN50I_H616_TCON_TV0_CLK_REG		0xb80
 static struct ccu_mux hdmi_cec_clk = {
 	.enable		= BIT(31) | BIT(30),
 
@@ -677,14 +683,18 @@
  * parent so that a mode set on one output can never re-rate the PLL that
  * drives the other.
  */
-static SUNXI_CCU_MP_WITH_MUX_GATE(tcon_tv0_clk, "tcon-tv0",
-				  tcon_tv_parents, 0xb80,
-				  0, 4,		/* M */
-				  8, 2,		/* P */
-				  24, 3,	/* mux */
-				  BIT(31),	/* gate */
-				  CLK_SET_RATE_PARENT |
-				  CLK_SET_RATE_NO_REPARENT);
+/*
+ * TCON TV0 drives HDMI, whose controller clock (above) only has an M
+ * divider: use the same divider set here (P stays at 0, cleared at probe)
+ * so that the HDMI clock can always follow the pixel clock exactly.
+ */
+static SUNXI_CCU_M_WITH_MUX_GATE(tcon_tv0_clk, "tcon-tv0",
+				 tcon_tv_parents, 0xb80,
+				 0, 4,		/* M */
+				 24, 3,		/* mux */
+				 BIT(31),	/* gate */
+				 CLK_SET_RATE_PARENT |
+				 CLK_SET_RATE_NO_REPARENT);
 static SUNXI_CCU_MP_WITH_MUX_GATE(tcon_tv1_clk, "tcon-tv1",
 				  tcon_tv_parents, 0xb84,
 				  0, 4,		/* M */
@@ -1252,6 +1262,11 @@
 	val |= BIT(24);
 	writel(val, reg + SUN50I_H616_HDMI_CEC_CLK_REG);
 
+	/* TCON TV0 is modelled without its P divider (see above): set it to 1 */
+	val = readl(reg + SUN50I_H616_TCON_TV0_CLK_REG);
+	val &= ~GENMASK(9, 8);
+	writel(val, reg + SUN50I_H616_TCON_TV0_CLK_REG);
+
 	ret = devm_sunxi_ccu_probe(&pdev->dev, reg, &sun50i_h616_ccu_desc);
 	if (ret)
 		return ret;
