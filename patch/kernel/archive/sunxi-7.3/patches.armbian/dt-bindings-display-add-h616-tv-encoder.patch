From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Sun, 1 Nov 2026 22:45:46 +0000
Subject: dt-bindings: display: Add Allwinner H616 TV encoder

The H616 TV encoder is the same core as the A10 one, but the analog DAC
controls (bias calibration, cable detection) live in a separate TVE TOP
register block with its own bus clock and reset, and the encoder has a
module clock of its own. Describe both register ranges, the three
clocks, the two resets and the SID calibration cell.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 .../allwinner,sun50i-h616-tv-encoder.yaml     | 103 ++++++++++++++++++
 1 file changed, 103 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/allwinner,sun50i-h616-tv-encoder.yaml

diff --git a/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-tv-encoder.yaml b/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-tv-encoder.yaml
new file mode 100644
index 000000000000..222222222222
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-tv-encoder.yaml
@@ -0,0 +1,103 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/allwinner,sun50i-h616-tv-encoder.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner H616 TV Encoder
+
+maintainers:
+  - Arun Iyengar <aiyengar1990@gmail.com>
+
+description:
+  The H616 TV encoder produces a composite (CVBS) signal in NTSC or PAL
+  from one of the TCON TV channels. The analog DAC it drives lives in a
+  separate "TVE TOP" register block, together with the DAC bias
+  calibration and cable detection logic.
+
+properties:
+  compatible:
+    const: allwinner,sun50i-h616-tv-encoder
+
+  reg:
+    items:
+      - description: TV encoder registers
+      - description: TVE TOP (DAC control) registers
+
+  reg-names:
+    items:
+      - const: tve
+      - const: top
+
+  clocks:
+    items:
+      - description: TV encoder bus clock
+      - description: TV encoder module clock
+      - description: TVE TOP bus clock
+
+  clock-names:
+    items:
+      - const: bus
+      - const: mod
+      - const: top
+
+  resets:
+    items:
+      - description: TV encoder reset
+      - description: TVE TOP reset
+
+  reset-names:
+    items:
+      - const: tve
+      - const: top
+
+  nvmem-cells:
+    maxItems: 1
+    description: DAC bias current calibration value from the SID efuse
+
+  nvmem-cell-names:
+    items:
+      - const: calibration
+
+  port:
+    $ref: /schemas/graph.yaml#/properties/port
+    description:
+      Input endpoint, coming from the TCON TV channel that drives the
+      encoder.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/sun50i-h616-ccu.h>
+    #include <dt-bindings/reset/sun50i-h616-ccu.h>
+
+    tv-encoder@6524000 {
+        compatible = "allwinner,sun50i-h616-tv-encoder";
+        reg = <0x06524000 0x4000>, <0x06520000 0x4000>;
+        reg-names = "tve", "top";
+        clocks = <&ccu CLK_BUS_TVE0>, <&ccu CLK_TVE0>, <&ccu CLK_BUS_TVE_TOP>;
+        clock-names = "bus", "mod", "top";
+        resets = <&ccu RST_BUS_TVE0>, <&ccu RST_BUS_TVE_TOP>;
+        reset-names = "tve", "top";
+        nvmem-cells = <&tve_calibration>;
+        nvmem-cell-names = "calibration";
+
+        port {
+            endpoint {
+                remote-endpoint = <&tcon_tv1_out_tve>;
+            };
+        };
+    };
+
+...
