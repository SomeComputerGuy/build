From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Thu, 12 Nov 2026 23:35:44 +0000
Subject: [PATCH] net: stmmac: dwmac-sun8i: TEST ONLY TX underflow hooks

TEST ONLY, never for the image or upstream: knobs and counters for the
TX FIFO underflow analysis (work-list item 37).

stmmac module parameters: test_tx_chunk (TX bytes per normal descriptor,
read at open), test_uf_retries (re-sends of a frame lost to a TX
underflow, <= 0 = off, the default; the retry code lives only here
since round 4), test_uf_log,
counters test_uf_frames/retried/dropped, test_tx_err_frames,
test_tx_len_err, test_tx_frames; every TX error frame (up to
test_uf_log) is logged with its descriptors.
dwmac_sun8i: test_uf_irq_log + counter test_uf_irq (TX DMA state,
current descriptor and buffer at the underflow interrupt),
test_coe_jumbo (keep TX checksum insertion above MTU 1500, read at
open).
RX checksum offload proof (job 185): counters test_rx_frames,
test_rx_pl_err (RDES0 bit 0 RX_PAYLOAD_ERR), test_rx_crc_err (bit 1),
test_rx_hdr_err (bit 7 RX_HEADER_ERR), test_rx_es (bit 15),
test_rx_discard, test_rx_unnec (frames passed up as
CHECKSUM_UNNECESSARY), test_rx_unnec_err (... with bit 0 or 7 set),
test_rx_err_d0 (RDES0 of the last such frame); knob
test_rx_err_csum_none (bit 0 -> CHECKSUM_NONE, off by default).

Assisted-by: Claude
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 drivers/net/ethernet/stmicro/stmmac/chain_mode.c  |   7 +-
 drivers/net/ethernet/stmicro/stmmac/common.h      |   1 +
 drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c |  33 ++++
 drivers/net/ethernet/stmicro/stmmac/norm_desc.c   |   3 +-
 drivers/net/ethernet/stmicro/stmmac/stmmac.h      |   5 +
 drivers/net/ethernet/stmicro/stmmac/stmmac_main.c | 187 +++++++++++++++++++++-
 6 files changed, 229 insertions(+), 7 deletions(-)

diff --git a/drivers/net/ethernet/stmicro/stmmac/chain_mode.c b/drivers/net/ethernet/stmicro/stmmac/chain_mode.c
index 42bf7a5..33cc03d 100644
--- a/drivers/net/ethernet/stmicro/stmmac/chain_mode.c
+++ b/drivers/net/ethernet/stmicro/stmmac/chain_mode.c
@@ -14,6 +14,9 @@
 
 #include "stmmac.h"
 
+/* TEST ONLY (work-list item 37): TX buffer size per normal descriptor */
+unsigned int stmmac_test_ndesc_bmax = BUF_SIZE_NDESC;
+
 static int jumbo_frm(struct stmmac_tx_queue *tx_q, struct sk_buff *skb,
 		     int csum)
 {
@@ -30,7 +33,7 @@ static int jumbo_frm(struct stmmac_tx_queue *tx_q, struct sk_buff *skb,
 	if (priv->plat->enh_desc)
 		bmax = BUF_SIZE_8KiB;
 	else
-		bmax = BUF_SIZE_NDESC;
+		bmax = stmmac_test_ndesc_bmax;
 
 	buf_len = min_t(unsigned int, nopaged_len, bmax);
 	len = nopaged_len - buf_len;
@@ -90,7 +93,7 @@ static bool is_jumbo_frm(unsigned int len, bool enh_desc)
 	bool ret = false;
 
 	if ((enh_desc && (len > BUF_SIZE_8KiB)) ||
-	    (!enh_desc && (len > BUF_SIZE_NDESC)))
+	    (!enh_desc && (len > stmmac_test_ndesc_bmax)))
 		ret = true;
 
 	return ret;
diff --git a/drivers/net/ethernet/stmicro/stmmac/common.h b/drivers/net/ethernet/stmicro/stmmac/common.h
index 20a7260..bf9ce5b 100644
--- a/drivers/net/ethernet/stmicro/stmmac/common.h
+++ b/drivers/net/ethernet/stmicro/stmmac/common.h
@@ -370,6 +370,7 @@ enum tx_frame_status {
 	tx_err = 0x2,
 	tx_dma_own = 0x4,
 	tx_err_bump_tc = 0x8,
+	tx_err_underflow = 0x10,
 };
 
 enum dma_irq_status {
diff --git a/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c b/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c
index 6a438dd..c2ad866 100644
--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c
@@ -321,6 +321,14 @@ static const struct emac_variant emac_variant_h6 = {
 #define SYSCON_ETCS_EXT_GMII	0x1
 #define SYSCON_ETCS_INT_GMII	0x2
 
+/* TEST ONLY (work-list item 37, harness/research/emac-tx-underflow) */
+static int test_uf_irq_log = 30;	/* underflow interrupts still to log */
+module_param(test_uf_irq_log, int, 0644);
+static unsigned long test_uf_irq;
+module_param(test_uf_irq, ulong, 0444);
+static bool test_coe_jumbo;		/* keep TX COE above MTU 1500; read at open */
+module_param(test_coe_jumbo, bool, 0644);
+
 static int sun8i_dwmac_reset(void __iomem *ioaddr)
 {
 	u32 v;
@@ -538,6 +546,28 @@ static int sun8i_dwmac_dma_interrupt(struct stmmac_priv *priv,
 	 * Other TX_CTL1 writers run only at open/close.
 	 */
 	if (v & EMAC_TX_UNDERFLOW_INT) {
+		test_uf_irq++;
+		if (test_uf_irq_log > 0) {
+			struct stmmac_tx_queue *q = &priv->dma_conf.tx_queue[0];
+			u32 sta = readl(ioaddr + EMAC_TX_DMA_STA);
+			u32 cd = readl(ioaddr + EMAC_TX_CUR_DESC);
+			u32 cb = readl(ioaddr + EMAC_TX_CUR_BUF);
+			u32 idx = (cd - lower_32_bits(q->dma_tx_phy)) /
+				  sizeof(struct dma_desc);
+			struct dma_desc *d = NULL;
+
+			if (q->dma_tx && idx < priv->dma_conf.dma_tx_size)
+				d = q->dma_tx + idx;
+			test_uf_irq_log--;
+			pr_info("sun8i-test: uf irq int_sta %08x tx_dma_sta %u cur_desc %08x idx %u cur_buf %08x tx_ctl1 %08x basic1 %08x tx_ctl0 %08x desc %08x/%08x/%08x cur_tx %u dirty_tx %u\n",
+				readl(ioaddr + EMAC_INT_STA), sta & 7, cd, idx, cb,
+				readl(ioaddr + EMAC_TX_CTL1),
+				readl(ioaddr + EMAC_BASIC_CTL1),
+				readl(ioaddr + EMAC_TX_CTL0),
+				d ? le32_to_cpu(d->des0) : 0,
+				d ? le32_to_cpu(d->des1) : 0,
+				d ? le32_to_cpu(d->des2) : 0, q->cur_tx, q->dirty_tx);
+		}
 		writel(readl(ioaddr + EMAC_TX_CTL1) | EMAC_TX_DMA_START,
 		       ioaddr + EMAC_TX_CTL1);
 		ret |= handle_tx;
@@ -714,6 +744,9 @@ static void sun8i_dwmac_core_init(struct mac_device_info *hw,
 	void __iomem *ioaddr = hw->pcsr;
 	u32 v;
 
+	/* TEST ONLY: TX COE above MTU 1500 (fix_features runs after open) */
+	priv->plat->bugged_jumbo = !test_coe_jumbo;
+
 	/* Without JUMBO_FRM_EN, frames longer than 1518 bytes (1522 with a
 	 * VLAN tag) are dropped as length errors.
 	 */
diff --git a/drivers/net/ethernet/stmicro/stmmac/norm_desc.c b/drivers/net/ethernet/stmicro/stmmac/norm_desc.c
index 562177f..ee6b7d6 100644
--- a/drivers/net/ethernet/stmicro/stmmac/norm_desc.c
+++ b/drivers/net/ethernet/stmicro/stmmac/norm_desc.c
@@ -30,6 +30,7 @@ static int ndesc_get_tx_status(struct stmmac_extra_stats *x,
 	if (unlikely(tdes0 & TDES0_ERROR_SUMMARY)) {
 		if (unlikely(tdes0 & TDES0_UNDERFLOW_ERROR)) {
 			x->tx_underflow++;
+			ret |= tx_err_underflow;
 		}
 		if (unlikely(tdes0 & TDES0_NO_CARRIER)) {
 			x->tx_carrier++;
@@ -43,7 +44,7 @@ static int ndesc_get_tx_status(struct stmmac_extra_stats *x,
 			x->tx_collision +=
 				FIELD_GET(TDES0_COLLISION_COUNT_MASK, tdes0);
 		}
-		ret = tx_err;
+		ret |= tx_err;
 	}
 
 	if (tdes0 & TDES0_VLAN_FRAME)
diff --git a/drivers/net/ethernet/stmicro/stmmac/stmmac.h b/drivers/net/ethernet/stmicro/stmmac/stmmac.h
index d2d387f..3c23246 100644
--- a/drivers/net/ethernet/stmicro/stmmac/stmmac.h
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac.h
@@ -80,6 +80,9 @@ struct stmmac_tx_queue {
 	unsigned int dirty_tx;
 	dma_addr_t dma_tx_phy;
 	u32 mss;
+	/* TEST ONLY: frame that is sent again after a TX FIFO underflow */
+	struct sk_buff *uf_skb;
+	unsigned int uf_tries;
 };
 
 struct stmmac_rx_buffer {
@@ -215,6 +218,8 @@ struct stmmac_rfs_entry {
 	int tc;
 };
 
+extern unsigned int stmmac_test_ndesc_bmax;
+
 struct stmmac_dma_conf {
 	unsigned int dma_buf_sz;
 
diff --git a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
index a385d5e..be2d544 100644
--- a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
@@ -106,6 +106,135 @@ MODULE_PARM_DESC(pause, "Flow Control Pause Time (units of 512 bit times)");
 #define TC_DEFAULT 64
 static int tc = TC_DEFAULT;
 module_param(tc, int, 0644);
+
+/* TEST ONLY (work-list item 37, harness/research/emac-tx-underflow): knobs and
+ * counters for the TX FIFO underflow analysis of the sun8i EMAC.
+ */
+static unsigned int test_tx_chunk;	/* TX bytes per normal descriptor, 0 = 2032; read at open */
+module_param(test_tx_chunk, uint, 0644);
+static int test_uf_retries = -1;	/* re-sends after an underflow, <= 0 = off */
+module_param(test_uf_retries, int, 0644);
+static int test_uf_log = 30;		/* frames with a TX error still to log */
+module_param(test_uf_log, int, 0644);
+static unsigned long test_uf_frames;	/* frames with TDES0 underflow */
+module_param(test_uf_frames, ulong, 0444);
+static unsigned long test_uf_retried;
+module_param(test_uf_retried, ulong, 0444);
+static unsigned long test_uf_dropped;
+module_param(test_uf_dropped, ulong, 0444);
+static unsigned long test_tx_err_frames;	/* frames with any TX error */
+module_param(test_tx_err_frames, ulong, 0444);
+static unsigned long test_tx_len_err;	/* TDES0 bit 14 (jabber / TX_LENGTH_ERR) */
+module_param(test_tx_len_err, ulong, 0444);
+static unsigned long test_tx_frames;	/* frames completed (last segment) */
+module_param(test_tx_frames, ulong, 0444);
+
+/* TEST ONLY (item 37, RX checksum offload proof): RDES0 bits of every
+ * received frame (last descriptor) and what the driver made of it.
+ * RX_PAYLOAD_ERR (bit 0) and RX_HEADER_ERR (bit 7) per H616 UM 6.3.6.1;
+ * bit 15 is the Synopsys error summary (reserved in the H616 UM).
+ * test_rx_err_csum_none = 1: a frame with RX_PAYLOAD_ERR goes up as
+ * CHECKSUM_NONE instead of CHECKSUM_UNNECESSARY (the stack checks it).
+ */
+static unsigned long test_rx_frames;
+module_param(test_rx_frames, ulong, 0444);
+static unsigned long test_rx_pl_err;		/* bit 0 RX_PAYLOAD_ERR */
+module_param(test_rx_pl_err, ulong, 0444);
+static unsigned long test_rx_crc_err;		/* bit 1 RX_CRC_ERR */
+module_param(test_rx_crc_err, ulong, 0444);
+static unsigned long test_rx_hdr_err;		/* bit 7 RX_HEADER_ERR */
+module_param(test_rx_hdr_err, ulong, 0444);
+static unsigned long test_rx_es;		/* bit 15 error summary */
+module_param(test_rx_es, ulong, 0444);
+static unsigned long test_rx_discard;		/* discarded by the driver */
+module_param(test_rx_discard, ulong, 0444);
+static unsigned long test_rx_unnec;		/* up as CHECKSUM_UNNECESSARY */
+module_param(test_rx_unnec, ulong, 0444);
+static unsigned long test_rx_unnec_err;		/* ... with bit 0 or 7 set */
+module_param(test_rx_unnec_err, ulong, 0444);
+static u32 test_rx_err_d0;			/* RDES0 of the last bit 0/7 frame */
+module_param(test_rx_err_d0, uint, 0444);
+static bool test_rx_err_csum_none;
+module_param(test_rx_err_csum_none, bool, 0644);
+
+/* last descriptor of a frame: count its RDES0 bits, returns RDES0 */
+static u32 stmmac_test_rx_desc(struct dma_desc *p, int *status)
+{
+	u32 d0 = le32_to_cpu(p->des0);
+
+	test_rx_frames++;
+	if (d0 & BIT(0))
+		test_rx_pl_err++;
+	if (d0 & BIT(1))
+		test_rx_crc_err++;
+	if (d0 & BIT(7))
+		test_rx_hdr_err++;
+	if (d0 & BIT(15))
+		test_rx_es++;
+	if (d0 & (BIT(0) | BIT(7)))
+		test_rx_err_d0 = d0;
+	if (*status == discard_frame)
+		test_rx_discard++;
+	else if (test_rx_err_csum_none && (d0 & BIT(0)))
+		*status |= csum_none;
+	return d0;
+}
+
+#define TEST_SEGS	12
+static struct {
+	unsigned int n, first;
+	u32 d0[TEST_SEGS], d1[TEST_SEGS];
+	dma_addr_t buf[TEST_SEGS];
+} test_fr;
+
+/* every cleaned descriptor, before its buffer is unmapped */
+static void stmmac_test_seg(struct stmmac_tx_queue *tx_q, unsigned int entry,
+			    struct dma_desc *p)
+{
+	u32 d1 = le32_to_cpu(p->des1);
+
+	if (d1 & BIT(29)) {			/* TDES1 first segment */
+		test_fr.n = 0;
+		test_fr.first = entry;
+	}
+	if (test_fr.n < TEST_SEGS) {
+		test_fr.d0[test_fr.n] = le32_to_cpu(p->des0);
+		test_fr.d1[test_fr.n] = d1;
+		test_fr.buf[test_fr.n] = tx_q->tx_skbuff_dma[entry].buf;
+		test_fr.n++;
+	}
+}
+
+/* the last segment of a frame */
+static void stmmac_test_frame(unsigned int entry, struct dma_desc *p,
+			      int status, struct sk_buff *skb, bool retried)
+{
+	u32 d0 = le32_to_cpu(p->des0);
+	char b[TEST_SEGS * 40], *s = b;
+	unsigned int i;
+
+	test_tx_frames++;
+	if (!(status & tx_err))
+		return;
+	test_tx_err_frames++;
+	if (d0 & BIT(14))
+		test_tx_len_err++;
+	if (status & tx_err_underflow) {
+		test_uf_frames++;
+		if (retried)
+			test_uf_retried++;
+		else
+			test_uf_dropped++;
+	}
+	if (test_uf_log <= 0)
+		return;
+	test_uf_log--;
+	for (i = 0; i < test_fr.n; i++)
+		s += scnprintf(s, b + sizeof(b) - s, " %08x/%08x/%pad", test_fr.d0[i],
+			       test_fr.d1[i], &test_fr.buf[i]);
+	pr_info("stmmac-test: txerr len %u first %u last %u segs %u retried %d d0/d1/buf:%s\n",
+		skb ? skb->len : 0, test_fr.first, entry, test_fr.n, retried, b);
+}
 MODULE_PARM_DESC(tc, "DMA threshold control value");
 
 /* This is unused */
@@ -2810,6 +2939,29 @@ static void stmmac_bump_dma_threshold(struct stmmac_priv *priv, u32 chan)
 	}
 }
 
+/* TEST ONLY (item 37, kept for the user's decision on an underflow retry): a
+ * frame aborted by a TX FIFO underflow is queued again, up to test_uf_retries
+ * times. Returns true if the caller must queue @skb again.
+ */
+static bool stmmac_tx_underflow_retry(struct stmmac_priv *priv,
+				      struct stmmac_tx_queue *tx_q,
+				      struct sk_buff *skb)
+{
+	if (!(priv->plat->flags & STMMAC_FLAG_MTU_ABOVE_TXFIFO) || test_uf_retries <= 0)
+		return false;
+
+	if (tx_q->uf_skb != skb) {
+		tx_q->uf_skb = skb;
+		tx_q->uf_tries = 0;
+	}
+	if (tx_q->uf_tries >= test_uf_retries) {
+		tx_q->uf_skb = NULL;
+		return false;
+	}
+	tx_q->uf_tries++;
+	return true;
+}
+
 /**
  * stmmac_tx_clean - to manage the transmission completion
  * @priv: driver private structure
@@ -2828,10 +2980,13 @@ static int stmmac_tx_clean(struct stmmac_priv *priv, int budget, u32 queue,
 	unsigned int bytes_compl = 0, pkts_compl = 0;
 	unsigned int entry, xmits = 0, count = 0;
 	u32 tx_packets = 0, tx_errors = 0;
+	struct sk_buff_head uf_list;
+	struct sk_buff *uf_skb;
 
 	__netif_tx_lock_bh(netdev_get_tx_queue(priv->dev, queue));
 
 	tx_q->xsk_frames_done = 0;
+	__skb_queue_head_init(&uf_list);
 
 	entry = tx_q->dirty_tx;
 
@@ -2867,6 +3022,8 @@ static int stmmac_tx_clean(struct stmmac_priv *priv, int budget, u32 queue,
 		 */
 		dma_rmb();
 
+		stmmac_test_seg(tx_q, entry, p);
+
 		/* Just consider the last segment and ...*/
 		if (likely(!(status & tx_not_ls))) {
 			/* ... verify the status error condition */
@@ -2936,7 +3093,16 @@ static int stmmac_tx_clean(struct stmmac_priv *priv, int budget, u32 queue,
 			if (likely(skb)) {
 				pkts_compl++;
 				bytes_compl += skb->len;
-				dev_consume_skb_any(skb);
+				if (unlikely(status & tx_err_underflow) &&
+				    stmmac_tx_underflow_retry(priv, tx_q, skb)) {
+					stmmac_test_frame(entry, p, status, skb, true);
+					__skb_queue_tail(&uf_list, skb);
+				} else {
+					stmmac_test_frame(entry, p, status, skb, false);
+					if (unlikely(skb == tx_q->uf_skb))
+						tx_q->uf_skb = NULL;
+					dev_consume_skb_any(skb);
+				}
 				tx_q->tx_skbuff[entry] = NULL;
 			}
 		}
@@ -2998,6 +3164,9 @@ static int stmmac_tx_clean(struct stmmac_priv *priv, int budget, u32 queue,
 
 	__netif_tx_unlock_bh(netdev_get_tx_queue(priv->dev, queue));
 
+	while ((uf_skb = __skb_dequeue(&uf_list)))
+		dev_queue_xmit(uf_skb);
+
 	/* Combine decisions from TX clean and XSK TX */
 	return max(count, xmits);
 }
@@ -4162,6 +4331,9 @@ static int __stmmac_open(struct net_device *dev,
 			dma_conf->tx_queue[i].tbs = priv->dma_conf.tx_queue[i].tbs;
 	memcpy(&priv->dma_conf, dma_conf, sizeof(*dma_conf));
 
+	stmmac_test_ndesc_bmax = (test_tx_chunk >= 256 && test_tx_chunk <= 2044) ?
+				 ALIGN_DOWN(test_tx_chunk, 4) : BUF_SIZE_NDESC;
+
 	/* The PHY is suspended when the interface is reopened without
 	 * disconnecting the PHY, e.g. on MTU change. IEEE 802.3 allows PHYs
 	 * to stop their receive clock while powered down, but the DMA
@@ -4854,7 +5026,7 @@ static netdev_tx_t stmmac_xmit(struct sk_buff *skb, struct net_device *dev)
 	 */
 	if (priv->descriptor_mode == STMMAC_CHAIN_MODE &&
 	    priv->hw->desc == &ndesc_ops && nfrags &&
-	    skb->len > BUF_SIZE_NDESC) {
+	    skb->len > stmmac_test_ndesc_bmax) {
 		if (skb_linearize(skb))
 			goto max_sdu_err;
 		nfrags = 0;
@@ -5790,6 +5962,7 @@ static int stmmac_rx(struct stmmac_priv *priv, int limit, u32 queue)
 	bool fcs_stripped = false;
 	int xdp_status = 0;
 	int bufsz;
+	u32 test_d0 = 0;
 
 	dma_dir = page_pool_get_dma_dir(rx_q->page_pool);
 	bufsz = DIV_ROUND_UP(priv->dma_conf.dma_buf_sz, PAGE_SIZE) * PAGE_SIZE;
@@ -5838,6 +6011,8 @@ read_again:
 		/* check if managed by the DMA otherwise go ahead */
 		if (unlikely(status & dma_own))
 			break;
+		if (!(status & rx_not_ls))
+			test_d0 = stmmac_test_rx_desc(p, &status);
 
 		next_entry = STMMAC_NEXT_ENTRY(rx_q->cur_rx,
 					       priv->dma_conf.dma_rx_size);
@@ -6040,10 +6215,14 @@ drain_data:
 		skb->protocol = eth_type_trans(skb, priv->dev);
 
 		if (unlikely(!coe) || !stmmac_has_ip_ethertype(skb) ||
-		    (status & csum_none))
+		    (status & csum_none)) {
 			skb_checksum_none_assert(skb);
-		else
+		} else {
 			skb->ip_summed = CHECKSUM_UNNECESSARY;
+			test_rx_unnec++;
+			if (test_d0 & (BIT(0) | BIT(7)))
+				test_rx_unnec_err++;
+		}
 
 		if (!stmmac_get_rx_hash(priv, p, &hash, &hash_type))
 			skb_set_hash(skb, hash, hash_type);
-- 
Armbian
