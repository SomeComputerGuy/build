+	if (of_device_is_compatible(pd->dev.of_node, "allwinner,sun50i-h616-i2c")) {
+		rc = mv64xxx_i2c_dma_init(drv_data, &pd->dev, res->start);
+		if (rc == -EPROBE_DEFER)
