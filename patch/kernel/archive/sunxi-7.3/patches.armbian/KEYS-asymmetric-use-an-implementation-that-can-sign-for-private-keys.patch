From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Fri, 13 Nov 2026 21:00:00 +0000
Subject: KEYS: asymmetric - Use an implementation that can sign for private
 keys

A private key needs set_priv_key, also for query and verify, but the
highest priority implementation may verify only (ecdsa-generic).  Ask
for CRYPTO_SIG_ALG_CAN_SIGN when the key is private.  Public keys still
get the highest priority implementation.

Assisted-by: LLM
Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 crypto/asymmetric_keys/public_key.c | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/crypto/asymmetric_keys/public_key.c b/crypto/asymmetric_keys/public_key.c
index 09a0b83..ec7e6d9 100644
--- a/crypto/asymmetric_keys/public_key.c
+++ b/crypto/asymmetric_keys/public_key.c
@@ -161,6 +161,18 @@ software_key_determine_akcipher(const struct public_key *pkey,
 	return 0;
 }
 
+/*
+ * A private key needs an implementation that can sign, even to verify: the
+ * fastest one may only verify.
+ */
+static struct crypto_sig *public_key_alloc_sig(const struct public_key *pkey,
+					       const char *alg_name)
+{
+	u32 type = pkey->key_is_private ? CRYPTO_SIG_ALG_CAN_SIGN : 0;
+
+	return crypto_alloc_sig(alg_name, type, type);
+}
+
 static u8 *pkey_pack_u32(u8 *dst, u32 val)
 {
 	memcpy(dst, &val, sizeof(val));
@@ -201,7 +213,7 @@ static int software_key_query(const struct kernel_pkey_params *params,
 	if (issig) {
 		struct crypto_sig *sig;
 
-		sig = crypto_alloc_sig(alg_name, 0, 0);
+		sig = public_key_alloc_sig(pkey, alg_name);
 		if (IS_ERR(sig)) {
 			ret = PTR_ERR(sig);
 			goto error_free_key;
@@ -305,7 +317,7 @@ static int software_key_eds_op(struct kernel_pkey_params *params,
 	memcpy(ptr, pkey->params, pkey->paramlen);
 
 	if (issig) {
-		sig = crypto_alloc_sig(alg_name, 0, 0);
+		sig = public_key_alloc_sig(pkey, alg_name);
 		if (IS_ERR(sig)) {
 			ret = PTR_ERR(sig);
 			goto error_free_key;
@@ -411,7 +423,7 @@ int public_key_verify_signature(const struct public_key *pkey,
 	if (ret < 0)
 		return ret;
 
-	tfm = crypto_alloc_sig(alg_name, 0, 0);
+	tfm = public_key_alloc_sig(pkey, alg_name);
 	if (IS_ERR(tfm))
 		return PTR_ERR(tfm);
 
