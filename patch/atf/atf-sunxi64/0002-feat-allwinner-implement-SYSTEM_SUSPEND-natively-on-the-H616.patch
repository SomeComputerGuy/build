From 6e711aa9c4e67e4d04e68fee7d7d7abb81845e39 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Mon, 2 Nov 2026 02:57:02 +0000
Subject: [PATCH 2/3] feat(allwinner): implement SYSTEM_SUSPEND natively on the
 H616

The H616 has no management processor, so nothing but the CPUs themselves
can take the system through suspend-to-RAM. Implement SYSTEM_SUSPEND for
the native PSCI ops by keeping the last CPU alive in SRAM:

 - PSCI's generic power-down preparation has already cleaned the L1 and
   L2 caches and disabled the data cache when the platform pwr_down hook
   runs; the other cores were powered off by the OS via CPU_OFF.
 - The CPU is switched to the 24 MHz oscillator and PLL_CPUX is stopped.
 - A small position independent routine is copied to SRAM A1 (unused
   after the SPL has run). The CPU turns its MMU and caches off and jumps
   there, so that no DRAM access happens while the DRAM controller is put
   into self-refresh: with the MBUS masters disabled (as crust does on
   the H6), PWRCTL.selfref_sw is set and STAT.operating_mode polled for
   self-refresh. On this controller selfref_sw is quasi-dynamic, so it is
   changed inside a SWCTL.sw_done/SWSTAT.sw_done_ack handshake, as
   U-Boot's DRAM init does when it leaves self-refresh (with a plain
   write, STAT was seen to stay at 0xaa, power-down, and self-refresh
   was never reached). All waits are bounded by the generic counter (20 ms
   each); the routine reports timeouts and the STAT/PWRCTL values seen.
 - The routine waits in WFI. The GIC CPU interface stays enabled and IRQs
   are routed to EL3 but masked, so every interrupt the OS left enabled
   in the GIC (RTC alarm, GPIO, ...) is a wakeup source without any
   platform specific wakeup source bookkeeping.
 - On wakeup the routine takes the DRAM out of self-refresh, records the
   outcome, and branches to bl31_warm_entrypoint, so the CPU resumes
   through the regular PSCI warm boot path as if it had been powered off.
 - The suspend finisher restarts PLL_CPUX, waits for it to lock, restores
   the CPU clock selection and reports whether self-refresh was reached.

The GIC distributor, the cluster and the DRAM supplies remain powered;
reducing the CPU voltage or stopping the DRAM clocks and PLLs during
standby are possible follow-ups once this baseline is proven.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 plat/allwinner/common/allwinner-common.mk     |  15 ++
 plat/allwinner/common/include/sunxi_private.h |   5 +
 plat/allwinner/common/sunxi_native_pm.c       |  48 ++++-
 plat/allwinner/common/sunxi_native_suspend.c  | 134 ++++++++++++++
 plat/allwinner/common/sunxi_standby_sram.S    | 172 ++++++++++++++++++
 .../allwinner/sun50i_h616/include/sunxi_ccu.h |   2 +
 .../sun50i_h616/include/sunxi_mmap.h          |   2 +
 plat/allwinner/sun50i_h616/platform.mk        |   2 +
 8 files changed, 379 insertions(+), 1 deletion(-)
 create mode 100644 plat/allwinner/common/sunxi_native_suspend.c
 create mode 100644 plat/allwinner/common/sunxi_standby_sram.S

diff --git a/plat/allwinner/common/allwinner-common.mk b/plat/allwinner/common/allwinner-common.mk
index 3faa44a..88541a0 100644
--- a/plat/allwinner/common/allwinner-common.mk
+++ b/plat/allwinner/common/allwinner-common.mk
@@ -67,6 +67,21 @@ ifeq (${SUNXI_NATIVE_CPU_SUSPEND}${SUNXI_PSCI_USE_NATIVE},10)
 $(error "Native CPU suspend requires the native PSCI ops")
 endif
 
+# Without an SCP, SYSTEM_SUSPEND keeps the boot CPU alive in SRAM while the
+# DRAM is in self-refresh and the CPU PLL is stopped (see sunxi_native_suspend.c).
+SUNXI_NATIVE_SYSTEM_SUSPEND	?=	0
+$(eval $(call assert_boolean,SUNXI_NATIVE_SYSTEM_SUSPEND))
+$(eval $(call add_define,SUNXI_NATIVE_SYSTEM_SUSPEND))
+
+ifeq (${SUNXI_NATIVE_SYSTEM_SUSPEND}${SUNXI_NATIVE_CPU_SUSPEND},10)
+$(error "Native system suspend requires native CPU suspend")
+endif
+
+ifeq (${SUNXI_NATIVE_SYSTEM_SUSPEND},1)
+BL31_SOURCES		+=	${AW_PLAT}/common/sunxi_native_suspend.c \
+				${AW_PLAT}/common/sunxi_standby_sram.S
+endif
+
 ifeq (${SUNXI_PSCI_USE_SCPI},1)
 BL31_SOURCES		+=	drivers/allwinner/sunxi_msgbox.c	\
 				drivers/arm/css/scpi/css_scpi.c		\
