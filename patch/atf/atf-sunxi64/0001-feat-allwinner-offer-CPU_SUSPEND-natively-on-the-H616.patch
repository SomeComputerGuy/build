From be4caffb22ddfabca658ff05b2fc32cc5751e319 Mon Sep 17 00:00:00 2001
From: Arun Iyengar <aiyengar1990@gmail.com>
Date: Mon, 2 Nov 2026 02:54:41 +0000
Subject: [PATCH 1/3] feat(allwinner): offer CPU_SUSPEND natively on the H616

The H616 has no management processor, so its PSCI implementation falls
back to the native ops, which only implement CPU_ON/CPU_OFF and leave
the rich OS without any cpuidle state beyond WFI ("PSCI: Suspend is
unavailable").

The native CPU_OFF path already relies on the CPUIDLE hardware block
(R_CPUCFG + 0x100): a core that executes WFI with its CORE_CLOSE flag
set is isolated and powered off by hardware. The same block can power
the core back up when the GIC has an interrupt pending for it, provided
the core's bit is set in its CPUIDLE_WAKE register; the core then resets
into the BL31 warm boot entry point. This is the mechanism needed for a
core power-down idle state and is what the vendor firmware uses for its
"cpu-sleep" state (psci-suspend-param 0x0010000 in the sun50iw9 vendor
device tree).

Add a SUNXI_NATIVE_CPU_SUSPEND build option that lets the native ops
implement CPU_SUSPEND for the core level only: the standby type maps to
a WFI in EL3, the power-down type disables the GIC CPU interface and
hands the core to the CPUIDLE block, and the warm boot finisher only
re-enables the CPU interface. Power state IDs use the same encoding as
the SCPI ops, so the idle state table is shared between both
implementations.

CPUIDLE_WAKE is shared by all cores, and CPU_SUSPEND at the core level
takes no PSCI lock, so it must not be modified on the idle path: a
read-modify-write racing with another core entering or leaving idle
drops that core's bit, and a core gated without its bit is never woken
again (observed after a few minutes of idle as an RCU stall, with the
lost core's CPUIDLE_PEND bit set for good). Instead, a core's bit is
set when it comes online (CPU_ON finisher; for the boot CPU when the
ops are set up) and cleared by CPU_OFF, both of which run under the
PSCI system level lock, so an offline core is still never woken by a
stray interrupt. The CPUIDLE block itself is enabled once at setup
rather than by every core on every power-down, as concurrent cores
would interleave its two-word unlock sequence.

The GIC CPU interface has to be off while the core is gated, exactly
as for CPU_OFF, so that nothing but the CPUIDLE block can end the WFI.
With the interface left enabled, an interrupt that arrives while the
block powers the core down terminates the WFI and the core is lost in a
half powered down state (observed within seconds).

The boot CPU needs one more preparation: the BROM starts it in AArch32
and the SPL switches it to AArch64 through RMR_EL3, which leaves its
AA64nAA32 configuration bit in CPUCFG clear. CPU_ON sets that bit for
the secondary cores, but a power-cycled core 0 would otherwise come back
in AArch32 at the reset vector, i.e. in the BROM (observed: the SPL
re-running underneath the live kernel). Program AArch64 for every core
when the PSCI ops are set up.

Describe the resulting "cpu-sleep" state in the H616 idle state table
and add it to the DTB whenever the PSCI ops implement CPU_SUSPEND, not
only when SCPI is used. Skip the DTB amendment when the DTB already
carries an idle-states node, so firmware and OS descriptions can coexist.

The latencies are initial estimates for the TF-A round trip, to be
refined with measurements; the residency is more conservative than the
3.57 ms the vendor firmware advertises.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
 plat/allwinner/common/allwinner-common.mk     |  11 ++
 .../common/include/sunxi_cpucfg_ncat.h        |   3 +
 plat/allwinner/common/include/sunxi_private.h |   3 +
 plat/allwinner/common/sunxi_cpu_ops.c         |  24 ++-
 plat/allwinner/common/sunxi_native_pm.c       | 153 +++++++++++++++++-
 plat/allwinner/common/sunxi_pm.c              |  24 ++-
 plat/allwinner/common/sunxi_prepare_dtb.c     |   7 +-
 plat/allwinner/sun50i_h616/platform.mk        |   2 +
 .../allwinner/sun50i_h616/sunxi_idle_states.c |  19 +++
 plat/allwinner/sun50i_h616/sunxi_power.c      |  15 +-
 10 files changed, 250 insertions(+), 11 deletions(-)

diff --git a/plat/allwinner/common/allwinner-common.mk b/plat/allwinner/common/allwinner-common.mk
index bc91c47..3faa44a 100644
--- a/plat/allwinner/common/allwinner-common.mk
+++ b/plat/allwinner/common/allwinner-common.mk
@@ -56,6 +56,17 @@ BL31_SOURCES		+=	${AW_PLAT}/common/sunxi_cpu_ops.c	\
 				${AW_PLAT}/common/sunxi_native_pm.c
 endif
 
+# SoCs with the hardware CPUIDLE block (H6 and newer) can power a core down
+# from EL3 and have it brought back up by hardware when an interrupt for it
+# becomes pending, so native PSCI ops can offer CPU_SUSPEND without any SCP.
+SUNXI_NATIVE_CPU_SUSPEND	?=	0
+$(eval $(call assert_boolean,SUNXI_NATIVE_CPU_SUSPEND))
+$(eval $(call add_define,SUNXI_NATIVE_CPU_SUSPEND))
+
+ifeq (${SUNXI_NATIVE_CPU_SUSPEND}${SUNXI_PSCI_USE_NATIVE},10)
+$(error "Native CPU suspend requires the native PSCI ops")
+endif
+
 ifeq (${SUNXI_PSCI_USE_SCPI},1)
 BL31_SOURCES		+=	drivers/allwinner/sunxi_msgbox.c	\
 				drivers/arm/css/scpi/css_scpi.c		\
diff --git a/plat/allwinner/common/include/sunxi_cpucfg_ncat.h b/plat/allwinner/common/include/sunxi_cpucfg_ncat.h
index 22828c2..18a7654 100644
--- a/plat/allwinner/common/include/sunxi_cpucfg_ncat.h
+++ b/plat/allwinner/common/include/sunxi_cpucfg_ncat.h
@@ -34,6 +34,9 @@
 
 #define SUNXI_CPUIDLE_EN_REG		(SUNXI_R_CPUCFG_BASE + 0x0100)
 #define SUNXI_CORE_CLOSE_REG		(SUNXI_R_CPUCFG_BASE + 0x0104)
+#define SUNXI_CPUIDLE_PEND_REG		(SUNXI_R_CPUCFG_BASE + 0x0108)
+#define SUNXI_CPUIDLE_WAKE_REG		(SUNXI_R_CPUCFG_BASE + 0x010c)
+#define SUNXI_CPUIDLE_STAT_REG		(SUNXI_R_CPUCFG_BASE + 0x0110)
 #define SUNXI_PWR_SW_DELAY_REG		(SUNXI_R_CPUCFG_BASE + 0x0140)
 #define SUNXI_CONFIG_DELAY_REG		(SUNXI_R_CPUCFG_BASE + 0x0144)
 
diff --git a/plat/allwinner/common/include/sunxi_private.h b/plat/allwinner/common/include/sunxi_private.h
index b9ca3f6..f2d7633 100644
--- a/plat/allwinner/common/include/sunxi_private.h
+++ b/plat/allwinner/common/include/sunxi_private.h
@@ -16,8 +16,10 @@ extern const struct psci_cpu_idle_state sunxi_idle_states[];
 void sunxi_configure_mmu_el3(int flags);
 
 void sunxi_cpu_on(u_register_t mpidr);
+void sunxi_cpu_set_aarch64(u_register_t mpidr);
 void sunxi_cpu_power_off_others(void);
 void sunxi_cpu_power_off_self(void);
+void sunxi_cpuidle_enable(void);
 void sunxi_power_down(void);
 
 #if SUNXI_PSCI_USE_NATIVE
@@ -41,6 +43,7 @@ static inline int sunxi_set_scpi_psci_ops(const plat_psci_ops_t **psci_ops)
 }
 #endif
 int sunxi_validate_ns_entrypoint(uintptr_t ns_entrypoint);
+bool sunxi_psci_has_cpu_suspend(void);
 
 int sunxi_pmic_setup(uint16_t socid, const void *fdt);
 void sunxi_security_setup(void);
diff --git a/plat/allwinner/common/sunxi_cpu_ops.c b/plat/allwinner/common/sunxi_cpu_ops.c
index 30841e2..7184713 100644
--- a/plat/allwinner/common/sunxi_cpu_ops.c
+++ b/plat/allwinner/common/sunxi_cpu_ops.c
@@ -85,6 +85,25 @@ static void sunxi_cpu_off(u_register_t mpidr)
 	}
 }
 
+/*
+ * Make the core start in AArch64 mode after its next power-on reset. The boot
+ * CPU is switched to AArch64 by the SPL through RMR_EL3, which leaves its
+ * configuration bit clear, so this must be done for it explicitly before it
+ * is ever powered down (e.g. by the CPUIDLE block): otherwise it would come
+ * back in AArch32 at the reset vector, i.e. in the BROM.
+ */
+void sunxi_cpu_set_aarch64(u_register_t mpidr)
+{
+	unsigned int core = MPIDR_AFFLVL0_VAL(mpidr);
+
+	if (sunxi_cpucfg_has_per_cluster_regs()) {
+		mmio_setbits_32(SUNXI_AA64nAA32_REG(MPIDR_AFFLVL1_VAL(mpidr)),
+				BIT(SUNXI_AA64nAA32_OFFSET + core));
+	} else {
+		mmio_setbits_32(SUNXI_CPU_CTRL_REG(core), BIT(0));
+	}
+}
+
 void sunxi_cpu_on(u_register_t mpidr)
 {
 	unsigned int cluster = MPIDR_AFFLVL1_VAL(mpidr);
@@ -98,8 +117,7 @@ void sunxi_cpu_on(u_register_t mpidr)
 		/* Assert CPU power-on reset */
 		mmio_clrbits_32(SUNXI_POWERON_RST_REG(cluster), BIT(core));
 		/* Set CPU to start in AArch64 mode */
-		mmio_setbits_32(SUNXI_AA64nAA32_REG(cluster),
-				BIT(SUNXI_AA64nAA32_OFFSET + core));
+		sunxi_cpu_set_aarch64(mpidr);
 		/* Apply power to the CPU */
 		sunxi_cpu_enable_power(cluster, core);
 		/* Release the core output clamps */
@@ -117,7 +135,7 @@ void sunxi_cpu_on(u_register_t mpidr)
 		mmio_clrbits_32(SUNXI_CPU_UNK_REG(core), BIT(0));
 
 		/* Set CPU to start in AArch64 mode */
-		mmio_setbits_32(SUNXI_CPU_CTRL_REG(core), BIT(0));
+		sunxi_cpu_set_aarch64(mpidr);
 
 		/* Apply power to the CPU */
 		sunxi_cpu_enable_power(cluster, core);
diff --git a/plat/allwinner/common/sunxi_native_pm.c b/plat/allwinner/common/sunxi_native_pm.c
index 28abd3c..de8d70f 100644
--- a/plat/allwinner/common/sunxi_native_pm.c
+++ b/plat/allwinner/common/sunxi_native_pm.c
@@ -4,13 +4,17 @@
  * SPDX-License-Identifier: BSD-3-Clause
  */
 
+#include <assert.h>
+
 #include <arch_helpers.h>
 #include <common/debug.h>
 #include <drivers/arm/gicv2.h>
 #include <drivers/delay_timer.h>
 #include <lib/mmio.h>
 #include <lib/psci/psci.h>
+#include <plat/common/platform.h>
 
+#include <sunxi_cpucfg.h>
 #include <sunxi_mmap.h>
 #include <sunxi_private.h>
 
@@ -18,6 +22,48 @@
 #define SUNXI_WDOG0_CFG_REG		(SUNXI_R_WDOG_BASE + 0x0014)
 #define SUNXI_WDOG0_MODE_REG		(SUNXI_R_WDOG_BASE + 0x0018)
 
+/*
+ * The power state ID uses the same encoding as the SCPI ops, so that the same
+ * idle state descriptions work for both: 4 bits of platform local state per
+ * power level, lowest level first.
+ */
+#define PLAT_LOCAL_PSTATE_WIDTH		U(4)
+#define PLAT_LOCAL_PSTATE_MASK		((U(1) << PLAT_LOCAL_PSTATE_WIDTH) - 1)
+
+#define CPU_PWR_LVL			MPIDR_AFFLVL0
+
+#define CPU_PWR_STATE(state) \
+	((state)->pwr_domain_state[CPU_PWR_LVL])
+
+static void sunxi_gic_cpu_init(void)
+{
+	gicv2_pcpu_distif_init();
+	gicv2_cpuif_enable();
+}
+
+#if SUNXI_NATIVE_CPU_SUSPEND
+/*
+ * CPUIDLE_WAKE bit n allows the CPUIDLE block to power core n up again when
+ * the GIC has an interrupt pending for it. The register is shared by all
+ * cores, so it is only ever changed while the PSCI system level lock is held:
+ * on the way online (CPU_ON finisher, or setup for the boot CPU) and offline
+ * (CPU_OFF). CPU_SUSPEND at the core level takes no PSCI lock and several
+ * cores enter and leave it concurrently, so it must not touch the register:
+ * a read-modify-write racing with another core's would drop that core's bit,
+ * and a core gated without its bit is never woken again.
+ */
+static void sunxi_cpuidle_wake_enable(bool enable)
+{
+	uint32_t bit = BIT_32(plat_my_core_pos());
+
+	if (enable) {
+		mmio_setbits_32(SUNXI_CPUIDLE_WAKE_REG, bit);
+	} else {
+		mmio_clrbits_32(SUNXI_CPUIDLE_WAKE_REG, bit);
+	}
+}
+#endif
+
 static int sunxi_pwr_domain_on(u_register_t mpidr)
 {
 	sunxi_cpu_on(mpidr);
@@ -27,6 +73,11 @@ static int sunxi_pwr_domain_on(u_register_t mpidr)
 
 static void sunxi_pwr_domain_off(const psci_power_state_t *target_state)
 {
+#if SUNXI_NATIVE_CPU_SUSPEND
+	/* An offline core must stay off whatever interrupts target it. */
+	sunxi_cpuidle_wake_enable(false);
+#endif
+
 	gicv2_cpuif_disable();
 
 	sunxi_cpu_power_off_self();
@@ -34,10 +85,91 @@ static void sunxi_pwr_domain_off(const psci_power_state_t *target_state)
 
 static void sunxi_pwr_domain_on_finish(const psci_power_state_t *target_state)
 {
-	gicv2_pcpu_distif_init();
-	gicv2_cpuif_enable();
+#if SUNXI_NATIVE_CPU_SUSPEND
+	/* From now on the CPUIDLE block may wake this core from cpu-sleep. */
+	sunxi_cpuidle_wake_enable(true);
+#endif
+
+	sunxi_gic_cpu_init();
 }
 
+#if SUNXI_NATIVE_CPU_SUSPEND
+static void sunxi_cpu_standby(plat_local_state_t cpu_state)
+{
+	u_register_t scr = read_scr_el3();
+
+	assert(is_local_state_retn(cpu_state));
+
+	write_scr_el3(scr | SCR_IRQ_BIT);
+	wfi();
+	write_scr_el3(scr);
+}
+
+/*
+ * Power this core down. The CPUIDLE hardware block takes over once the core
+ * executes WFI with its CORE_CLOSE flag set: it isolates the core and removes
+ * its power. As the core's CPUIDLE_WAKE bit is set while it is online, the
+ * block also reverses that as soon as the GIC has an interrupt pending for the
+ * core (CPUIDLE_PEND). The core then resets into the BL31 warm boot entry
+ * point. Nothing above the core level is powered down, so the GIC distributor
+ * state and the L2 cache are retained.
+ *
+ * The GIC CPU interface must be disabled first, exactly as for CPU_OFF, so
+ * that nothing but the CPUIDLE block can end the WFI. With the interface left
+ * enabled, an interrupt arriving while the block gates the core terminates
+ * the WFI under its feet and the core is lost half powered down.
+ */
+static void sunxi_pwr_domain_suspend(const psci_power_state_t *target_state)
+{
+	assert(is_local_state_off(CPU_PWR_STATE(target_state)));
+
+	gicv2_cpuif_disable();
+
+	sunxi_cpu_power_off_self();
+}
+
+static void sunxi_pwr_domain_suspend_finish(const psci_power_state_t *target_state)
+{
+	/* The CPUIDLE_WAKE bit stays set, see sunxi_cpuidle_wake_enable(). */
+	sunxi_gic_cpu_init();
+}
+
+static int sunxi_validate_power_state(unsigned int power_state,
+				      psci_power_state_t *req_state)
+{
+	unsigned int power_level = psci_get_pstate_pwrlvl(power_state);
+	unsigned int state_id = psci_get_pstate_id(power_state);
+	unsigned int type = psci_get_pstate_type(power_state);
+	unsigned int cpu_state = state_id & PLAT_LOCAL_PSTATE_MASK;
+	unsigned int i;
+
+	assert(req_state != NULL);
+
+	/* Without a management processor, only the CPU level can be changed. */
+	if (power_level != CPU_PWR_LVL ||
+	    (state_id >> PLAT_LOCAL_PSTATE_WIDTH) != 0U) {
+		return PSCI_E_INVALID_PARAMS;
+	}
+
+	if (type == PSTATE_TYPE_STANDBY) {
+		if (!is_local_state_retn(cpu_state)) {
+			return PSCI_E_INVALID_PARAMS;
+		}
+	} else {
+		if (!is_local_state_off(cpu_state)) {
+			return PSCI_E_INVALID_PARAMS;
+		}
+	}
+
+	req_state->pwr_domain_state[CPU_PWR_LVL] = cpu_state;
+	for (i = CPU_PWR_LVL + 1U; i <= PLAT_MAX_PWR_LVL; ++i) {
+		req_state->pwr_domain_state[i] = PSCI_LOCAL_STATE_RUN;
+	}
+
+	return PSCI_E_SUCCESS;
+}
+#endif /* SUNXI_NATIVE_CPU_SUSPEND */
+
 static void sunxi_system_off(void)
 {
 	gicv2_cpuif_disable();
@@ -69,6 +201,12 @@ static const plat_psci_ops_t sunxi_native_psci_ops = {
 	.pwr_domain_on			= sunxi_pwr_domain_on,
 	.pwr_domain_off			= sunxi_pwr_domain_off,
 	.pwr_domain_on_finish		= sunxi_pwr_domain_on_finish,
+#if SUNXI_NATIVE_CPU_SUSPEND
+	.cpu_standby			= sunxi_cpu_standby,
+	.pwr_domain_suspend		= sunxi_pwr_domain_suspend,
+	.pwr_domain_suspend_finish	= sunxi_pwr_domain_suspend_finish,
+	.validate_power_state		= sunxi_validate_power_state,
+#endif
 	.system_off			= sunxi_system_off,
 	.system_reset			= sunxi_system_reset,
 	.validate_ns_entrypoint		= sunxi_validate_ns_entrypoint,
@@ -76,5 +214,16 @@ static const plat_psci_ops_t sunxi_native_psci_ops = {
 
 void sunxi_set_native_psci_ops(const plat_psci_ops_t **psci_ops)
 {
+#if SUNXI_NATIVE_CPU_SUSPEND
+	/*
+	 * Called on the boot CPU before any other core runs: enable the
+	 * CPUIDLE block once (cores entering cpu-sleep concurrently would
+	 * otherwise interleave its two-word unlock sequence) and let it wake
+	 * the boot CPU; the secondaries are armed by their CPU_ON finisher.
+	 */
+	sunxi_cpuidle_enable();
+	sunxi_cpuidle_wake_enable(true);
+#endif
+
 	*psci_ops = &sunxi_native_psci_ops;
 }
diff --git a/plat/allwinner/common/sunxi_pm.c b/plat/allwinner/common/sunxi_pm.c
index ebc406b..13bf549 100644
--- a/plat/allwinner/common/sunxi_pm.c
+++ b/plat/allwinner/common/sunxi_pm.c
@@ -30,6 +30,15 @@ bool sunxi_psci_is_scpi(void)
 #define SUNXI_ALT_RVBAR_HI_REG(n)	0
 #endif
 
+/*
+ * Whether the selected PSCI ops implement CPU_SUSPEND, i.e. whether the idle
+ * states in sunxi_idle_states[] can be offered to the rich OS.
+ */
+bool sunxi_psci_has_cpu_suspend(void)
+{
+	return psci_is_scpi || (SUNXI_NATIVE_CPU_SUSPEND != 0);
+}
+
 int sunxi_validate_ns_entrypoint(uintptr_t ns_entrypoint)
 {
 	/* The non-secure entry point must be in DRAM */
@@ -45,8 +54,15 @@ int plat_setup_psci_ops(uintptr_t sec_entrypoint,
 {
 	assert(psci_ops);
 
-	/* Program all CPU entry points. */
+	/* Program all CPU entry points, and have every core reset into AArch64. */
 	for (unsigned int cpu = 0; cpu < PLATFORM_CORE_COUNT; ++cpu) {
+		if (SUNXI_PSCI_USE_NATIVE != 0) {
+			u_register_t mpidr =
+				((cpu / PLATFORM_MAX_CPUS_PER_CLUSTER) << MPIDR_AFF1_SHIFT) |
+				((cpu % PLATFORM_MAX_CPUS_PER_CLUSTER) << MPIDR_AFF0_SHIFT);
+
+			sunxi_cpu_set_aarch64(mpidr);
+		}
 		if (sunxi_cpucfg_has_per_cluster_regs()) {
 			mmio_write_32(SUNXI_CPUCFG_RVBAR_LO_REG(cpu),
 				      sec_entrypoint & 0xffffffff);
@@ -64,7 +80,11 @@ int plat_setup_psci_ops(uintptr_t sec_entrypoint,
 		INFO("PSCI: Suspend is available via SCPI\n");
 		psci_is_scpi = true;
 	} else {
-		INFO("PSCI: Suspend is unavailable\n");
+		if (SUNXI_NATIVE_CPU_SUSPEND != 0) {
+			INFO("PSCI: CPU suspend is available natively\n");
+		} else {
+			INFO("PSCI: Suspend is unavailable\n");
+		}
 		sunxi_set_native_psci_ops(psci_ops);
 	}
 
diff --git a/plat/allwinner/common/sunxi_prepare_dtb.c b/plat/allwinner/common/sunxi_prepare_dtb.c
index 0f68974..7072d51 100644
--- a/plat/allwinner/common/sunxi_prepare_dtb.c
+++ b/plat/allwinner/common/sunxi_prepare_dtb.c
@@ -36,7 +36,12 @@ void sunxi_prepare_dtb(void *fdt)
 
 	sunxi_soc_fdt_fixup(fdt);
 
-	if (sunxi_psci_is_scpi()) {
+	/*
+	 * Describe the CPU idle states if the PSCI ops implement CPU_SUSPEND
+	 * and the DTB does not already carry its own description of them.
+	 */
+	if (sunxi_psci_has_cpu_suspend() &&
+	    fdt_path_offset(fdt, "/cpus/idle-states") < 0) {
 		ret = fdt_add_cpu_idle_states(fdt, sunxi_idle_states);
 		if (ret < 0) {
 			WARN("Failed to add idle states to DT: %d\n", ret);
diff --git a/plat/allwinner/sun50i_h616/platform.mk b/plat/allwinner/sun50i_h616/platform.mk
index 6f44e8c..5610234 100644
--- a/plat/allwinner/sun50i_h616/platform.mk
+++ b/plat/allwinner/sun50i_h616/platform.mk
@@ -9,6 +9,8 @@ SUNXI_BL31_IN_DRAM	:=	1
 # Without a management processor there is no SCPI support.
 SUNXI_PSCI_USE_SCPI	:=	0
 SUNXI_PSCI_USE_NATIVE	:=	1
+# The CPUIDLE hardware block powers cores off and back on autonomously.
+SUNXI_NATIVE_CPU_SUSPEND :=	1
 
 # The differences between the platforms are covered by the include files.
 include plat/allwinner/common/allwinner-common.mk
diff --git a/plat/allwinner/sun50i_h616/sunxi_idle_states.c b/plat/allwinner/sun50i_h616/sunxi_idle_states.c
index 4339bcd..2665a36 100644
--- a/plat/allwinner/sun50i_h616/sunxi_idle_states.c
+++ b/plat/allwinner/sun50i_h616/sunxi_idle_states.c
@@ -6,6 +6,25 @@
 
 #include <sunxi_private.h>
 
+/*
+ * The only idle state beyond WFI that the H616 can implement without a
+ * management processor is powering a single core off: the CPUIDLE hardware
+ * block gates the core when it enters WFI with its CORE_CLOSE flag set, and
+ * powers it back up (resetting into BL31) once the GIC has an interrupt
+ * pending for it. The cluster, its L2 cache and the GIC stay on.
+ *
+ * The latencies are the TF-A round trip (SMC, L1 clean, CPUIDLE power-down
+ * sequence, reset into the warm boot path, context restore). The residency
+ * is set conservatively; the vendor firmware advertises 3.57 ms.
+ */
 const struct psci_cpu_idle_state sunxi_idle_states[] = {
+	{
+		.name			= "cpu-sleep",
+		.power_state		= 0x00010003,
+		.local_timer_stop	= true,
+		.entry_latency_us	= 100,
+		.exit_latency_us	= 150,
+		.min_residency_us	= 4000
+	},
 	{}
 };
