 				${AW_PLAT}/common/sunxi_standby_sram.S
 endif
 
+# Bring-up only: event trace + experiment knob in the last page of the BL31
+# DRAM reservation, readable from the OS via /dev/mem and from U-Boot via md.
+SUNXI_PM_DEBUG_TRACE	?=	0
+$(eval $(call assert_boolean,SUNXI_PM_DEBUG_TRACE))
+$(eval $(call add_define,SUNXI_PM_DEBUG_TRACE))
+ifeq (${SUNXI_PM_DEBUG_TRACE},1)
+BL31_SOURCES		+=	${AW_PLAT}/common/sunxi_pm_trace.c
+endif
+
 ifeq (${SUNXI_PSCI_USE_SCPI},1)
 BL31_SOURCES		+=	drivers/allwinner/sunxi_msgbox.c	\
 				drivers/arm/css/scpi/css_scpi.c		\
