diff --git a/plat/allwinner/common/sunxi_pm_trace.c b/plat/allwinner/common/sunxi_pm_trace.c
new file mode 100644
index 0000000..6028d70
--- /dev/null
+++ b/plat/allwinner/common/sunxi_pm_trace.c
@@ -0,0 +1,118 @@
+/*
+ * Copyright (c) 2026, Arun Iyengar <aiyengar1990@gmail.com>
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <arch_helpers.h>
+#include <common/debug.h>
+#include <lib/mmio.h>
+#include <plat/common/platform.h>
+#include <platform_def.h>
+
+#include <sunxi_cpucfg.h>
+#include <sunxi_pm_trace.h>
+
+#define TRACE_HDR_MAGIC		(SUNXI_PM_TRACE_BASE + 0x00)
+#define TRACE_HDR_GEN		(SUNXI_PM_TRACE_BASE + 0x04)
+#define TRACE_HDR_KNOB		(SUNXI_PM_TRACE_BASE + 0x08)
+#define TRACE_HDR_FREEZE	(SUNXI_PM_TRACE_BASE + 0x0c)
+#define TRACE_HDR_LAYOUT	(SUNXI_PM_TRACE_BASE + 0x10)
+#define TRACE_SYS_RING		(SUNXI_PM_TRACE_BASE + 0x40)
+#define TRACE_SYS_RECORDS	58U
+#define TRACE_CORE_RING(c)	(SUNXI_PM_TRACE_BASE + 0x400 + (c) * 0x300)
+#define TRACE_CORE_RECORDS	46U
+
+static bool is_system_event(unsigned int event)
+{
+	switch (event) {
+	case SUNXI_PM_EV_CPU_ON:
+	case SUNXI_PM_EV_CPU_OFF:
+	case SUNXI_PM_EV_SLEEP_ENTER:
+	case SUNXI_PM_EV_SLEEP_WAKE:
+	case SUNXI_PM_EV_SLEEP_WFI_RET:
+	case SUNXI_PM_EV_STANDBY:
+		return false;
+	default:
+		return true;
+	}
+}
+
+/*
+ * Lock-free: system events are only ever recorded by the single running CPU
+ * (boot, SYSTEM_SUSPEND/RESET/OFF), every other event goes to the ring of the
+ * recording core. Callers may run with caches off.
+ */
+void sunxi_pm_trace(unsigned int event, uint32_t d0, uint32_t d1)
+{
+	unsigned int core = plat_my_core_pos();
+	uintptr_t ring;
+	uint32_t count, records;
+
+	if (is_system_event(event)) {
+		ring = TRACE_SYS_RING;
+		records = TRACE_SYS_RECORDS;
+	} else {
+		if (mmio_read_32(TRACE_HDR_FREEZE) != 0U) {
+			return;
+		}
+		ring = TRACE_CORE_RING(core);
+		records = TRACE_CORE_RECORDS;
+	}
+	count = mmio_read_32(ring);
+	ring += 0x10 + (count % records) * 0x10;
+
+	mmio_write_32(ring + 0x0, (uint32_t)read_cntpct_el0());
+	mmio_write_32(ring + 0x4, (event & 0xffU) | (core << 24));
+	mmio_write_32(ring + 0x8, d0);
+	mmio_write_32(ring + 0xc, d1);
+	mmio_write_32(ring - 0x10 - (count % records) * 0x10, count + 1U);
+	dsbsy();
+}
+
+/* CPUIDLE_PEND | CPUIDLE_WAKE << 8, the usual d1 of the sleep events */
+uint32_t sunxi_pm_trace_pend_wake(void)
+{
+	return (mmio_read_32(SUNXI_CPUIDLE_PEND_REG) & 0xffU) |
+	       ((mmio_read_32(SUNXI_CPUIDLE_WAKE_REG) & 0xffU) << 8);
+}
+
+uint32_t sunxi_pm_knob(void)
+{
+	return mmio_read_32(TRACE_HDR_KNOB);
+}
+
+void sunxi_pm_trace_init(void)
+{
+	uint32_t gen = 0;
+	unsigned int c;
+
+	if (mmio_read_32(TRACE_HDR_MAGIC) == SUNXI_PM_TRACE_MAGIC &&
+	    mmio_read_32(TRACE_HDR_LAYOUT) == SUNXI_PM_TRACE_LAYOUT) {
+		/* Warm reset: keep the records, they may explain the reset. */
+		gen = mmio_read_32(TRACE_HDR_GEN) + 1U;
+		if (mmio_read_32(TRACE_SYS_RING) > 0x10000U) {
+			mmio_write_32(TRACE_SYS_RING, 0);
+		}
+		for (c = 0; c < PLATFORM_CORE_COUNT; c++) {
+			if (mmio_read_32(TRACE_CORE_RING(c)) > 0x10000U) {
+				mmio_write_32(TRACE_CORE_RING(c), 0);
+			}
+		}
+		mmio_write_32(TRACE_HDR_FREEZE, 1);
+	} else {
+		for (uintptr_t p = SUNXI_PM_TRACE_BASE;
+		     p < SUNXI_PM_TRACE_BASE + PAGE_SIZE; p += 4) {
+			mmio_write_32(p, 0);
+		}
+		mmio_write_32(TRACE_HDR_MAGIC, SUNXI_PM_TRACE_MAGIC);
+		mmio_write_32(TRACE_HDR_LAYOUT, SUNXI_PM_TRACE_LAYOUT);
+	}
+	mmio_write_32(TRACE_HDR_GEN, gen);
+	/* Experiments never survive a reset. */
+	mmio_write_32(TRACE_HDR_KNOB, 0);
+	sunxi_pm_trace(SUNXI_PM_EV_BOOT, gen, 0);
+	INFO("PM trace page at 0x%lx, boot generation %u%s\n",
+	     (unsigned long)SUNXI_PM_TRACE_BASE, gen,
+	     gen != 0U ? " (per-core rings frozen)" : "");
+}
