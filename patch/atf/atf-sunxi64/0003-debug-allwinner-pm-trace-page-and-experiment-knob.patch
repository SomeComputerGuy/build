@@ -190,6 +279,7 @@ static void sunxi_system_off(void)
 
 static void __dead2 sunxi_system_reset(void)
 {
+	sunxi_pm_trace(SUNXI_PM_EV_SYSTEM_RESET, 0, 0);
 	gicv2_cpuif_disable();
 
 	/* Reset the whole system when the watchdog times out */
