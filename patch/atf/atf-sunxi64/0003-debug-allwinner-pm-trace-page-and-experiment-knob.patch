 plat/allwinner/common/sunxi_native_suspend.c  |  97 ++++++++++++--
 plat/allwinner/common/sunxi_pm_trace.c        | 118 ++++++++++++++++++
 plat/allwinner/common/sunxi_standby_sram.S    |  20 +++
 plat/allwinner/sun50i_h616/platform.mk        |   1 +
 10 files changed, 392 insertions(+), 14 deletions(-)
 create mode 100644 plat/allwinner/common/include/sunxi_pm_trace.h
