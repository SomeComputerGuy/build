@@ -10,6 +10,7 @@
 	.globl	sunxi_standby_jump
 	.globl	sunxi_standby_sram_start
 	.globl	sunxi_standby_sram_end
+	.globl	sunxi_warm_restart
 
 /* DesignWare uMCTL2 DDR controller registers */
 #define MCTL_STATR			0x004
@@ -53,6 +54,25 @@ func sunxi_standby_jump
 	br	x6
 endfunc sunxi_standby_jump
 
+/*
+ * void sunxi_warm_restart(void): turn MMU and caches off and re-enter BL31
+ * through the warm boot entry point, as a core that was powered off would.
+ */
+func sunxi_warm_restart
+	mrs	x7, sctlr_el3
+	bic	x7, x7, #SCTLR_M_BIT
+	bic	x7, x7, #SCTLR_C_BIT
+	bic	x7, x7, #SCTLR_I_BIT
+	msr	sctlr_el3, x7
+	isb
+	ic	iallu
+	dsb	sy
+	isb
+	adrp	x0, bl31_warm_entrypoint
+	add	x0, x0, :lo12:bl31_warm_entrypoint
+	br	x0
+endfunc sunxi_warm_restart
+
 /*
  * The standby routine. Position independent, uses neither stack nor memory
  * other than the given MMIO registers, runs with MMU and caches off.
