@@ -79,6 +81,8 @@ static void sunxi_pwr_domain_off(const psci_power_state_t *target_state)
 #if SUNXI_NATIVE_CPU_SUSPEND
 	/* An offline core must stay off whatever interrupts target it. */
 	sunxi_cpuidle_wake_enable(false);
+	sunxi_pm_trace(SUNXI_PM_EV_CPU_OFF, mmio_read_32(SUNXI_CPUIDLE_STAT_REG),
+		       sunxi_pm_trace_pend_wake());
 #endif
 
 	gicv2_cpuif_disable();
@@ -103,11 +107,45 @@ static void sunxi_cpu_standby(plat_local_state_t cpu_state)
 
 	assert(is_local_state_retn(cpu_state));
 
+	sunxi_pm_trace(SUNXI_PM_EV_STANDBY, cpu_state, 0);
 	write_scr_el3(scr | SCR_IRQ_BIT);
 	wfi();
 	write_scr_el3(scr);
 }
 
+#if SUNXI_PM_DEBUG_TRACE
+/*
+ * Bring-up experiments, selected at runtime through the knob (bits 2:0):
+ *  0: no power-down at all: WFI in EL3, then restart through the warm boot
+ *     entry point (always safe, exercises the resume path)
+ *  1: the regular sequence: CORE_CLOSE + WFI with the GIC CPU interface
+ *     disabled
+ *  3: like 1, but core 0 is never gated (behaves as in mode 0)
+ * Any other value behaves as 0. The former modes 2 and 4 (GIC CPU interface
+ * left enabled) are gone: an interrupt can then end the WFI while the
+ * CPUIDLE block is gating the core, which loses the core.
+ */
+static unsigned int sleep_mode[PLATFORM_CORE_COUNT];
+
+/* Sampled once per entry so that a knob change cannot split one cycle in two modes. */
+static unsigned int sunxi_sleep_mode(bool sample)
+{
+	unsigned int core = plat_my_core_pos();
+
+	if (sample) {
+		unsigned int mode = sunxi_pm_knob() & SUNXI_PM_KNOB_SLEEP_MODE_MASK;
+
+		if (mode == 3U) {
+			mode = (core == 0U) ? 0U : 1U;
+		} else if (mode != 1U) {
+			mode = 0U;
+		}
+		sleep_mode[core] = mode;
+	}
+	return sleep_mode[core];
+}
+#endif
+
 /*
  * Power this core down. The CPUIDLE hardware block takes over once the core
  * executes WFI with its CORE_CLOSE flag set: it isolates the core and removes
@@ -134,6 +172,19 @@ static void sunxi_pwr_domain_suspend(const psci_power_state_t *target_state)
 		return;
 	}
 
+#if SUNXI_PM_DEBUG_TRACE
+	{
+		unsigned int mode = sunxi_sleep_mode(true);
+
+		sunxi_pm_trace(SUNXI_PM_EV_SLEEP_ENTER,
+			       mode | (mmio_read_32(SUNXI_CPUIDLE_STAT_REG) << 8),
+			       sunxi_pm_trace_pend_wake());
+		if (mode == 0U) {
+			return;
+		}
+	}
+#endif
+
 	gicv2_cpuif_disable();
 
 	sunxi_cpu_power_off_self();
@@ -144,8 +195,13 @@ static void sunxi_pwr_domain_suspend_finish(const psci_power_state_t *target_sta
 #if SUNXI_NATIVE_SYSTEM_SUSPEND
 	if (is_local_state_off(SYSTEM_PWR_STATE(target_state))) {
 		sunxi_native_system_suspend_finish();
-	}
+	} else
 #endif
+	{
+		sunxi_pm_trace(SUNXI_PM_EV_SLEEP_WAKE,
+			       mmio_read_32(SUNXI_CPUIDLE_STAT_REG),
+			       sunxi_pm_trace_pend_wake());
+	}
 
 	/*
 	 * The CPUIDLE_WAKE bit stays set, see sunxi_cpuidle_wake_enable().
@@ -162,6 +218,24 @@ static void sunxi_pwr_domain_pwr_down(const psci_power_state_t *target_state)
 	if (is_local_state_off(SYSTEM_PWR_STATE(target_state))) {
 		sunxi_native_system_suspend_pwr_down();
 	}
+
+#if SUNXI_PM_DEBUG_TRACE
+	/*
+	 * Mode 0: no power-down. Do the WFI here and restart the core through
+	 * the warm boot path, as if it had been powered off; the generic code
+	 * would panic on a returning WFI.
+	 */
+	if (sunxi_sleep_mode(false) == 0U) {
+		write_scr_el3(read_scr_el3() | SCR_IRQ_BIT);
+		isb();
+		dsbsy();
+		wfi();
+		sunxi_pm_trace(SUNXI_PM_EV_SLEEP_WFI_RET,
+			       mmio_read_32(SUNXI_CPUIDLE_STAT_REG),
+			       sunxi_pm_trace_pend_wake());
+		sunxi_warm_restart();
+	}
+#endif
 }
 
 static void sunxi_get_sys_suspend_power_state(psci_power_state_t *req_state)
diff --git a/plat/allwinner/common/sunxi_native_suspend.c b/plat/allwinner/common/sunxi_native_suspend.c
index 32941fb..1ef01ef 100644
--- a/plat/allwinner/common/sunxi_native_suspend.c
+++ b/plat/allwinner/common/sunxi_native_suspend.c
@@ -15,6 +15,7 @@
 
 #include <sunxi_ccu.h>
 #include <sunxi_mmap.h>
+#include <sunxi_pm_trace.h>
 #include <sunxi_private.h>
 
 /* PLL_CPUX control register */
@@ -52,6 +53,29 @@ static uint32_t saved_cpux_axi_cfg;
 static uint32_t saved_pll_cpux;
 static struct sunxi_standby_report standby_report;
 
+#if SUNXI_PM_DEBUG_TRACE
+#define MCTL_PWRCTL		(SUNXI_DRAM_CTL_BASE + 0x030)
+#define MCTL_SWCTL		(SUNXI_DRAM_CTL_BASE + 0x320)
+#define MCTL_SWSTAT		(SUNXI_DRAM_CTL_BASE + 0x324)
+
+static uint32_t debug_saved_pwrctl;
+static bool debug_pwrctl_changed;
+
+/* Quasi-dynamic PWRCTL write with the SWCTL handshake; returns SWSTAT. */
+static uint32_t debug_write_pwrctl(uint32_t value)
+{
+	unsigned int timeout = 1000;
+
+	mmio_write_32(MCTL_SWCTL, 0);
+	mmio_write_32(MCTL_PWRCTL, value);
+	mmio_write_32(MCTL_SWCTL, 1);
+	while ((mmio_read_32(MCTL_SWSTAT) & 1U) == 0U && --timeout != 0U) {
+		udelay(1);
+	}
+	return mmio_read_32(MCTL_SWSTAT);
+}
+#endif
+
 /*
  * Final step of SYSTEM_SUSPEND, running on the last CPU with the data cache
  * already disabled and the L2 cache cleaned by the generic PSCI code.
@@ -68,31 +92,67 @@ void __dead2 sunxi_native_system_suspend_pwr_down(void)
 {
 	const uint32_t *src = sunxi_standby_sram_start;
 	uintptr_t dst = SUNXI_SRAM_A1_BASE;
+	uintptr_t entry = SUNXI_SRAM_A1_BASE;
+	uint32_t knob = sunxi_pm_knob();
+	uint32_t poll_limit = STANDBY_POLL_LIMIT;
 
-	/* Run the CPU from the 24 MHz oscillator and stop its PLL. */
 	saved_cpux_axi_cfg = mmio_read_32(SUNXI_CCU_CPUX_AXI_CFG_REG);
-	mmio_write_32(SUNXI_CCU_CPUX_AXI_CFG_REG,
-		      (saved_cpux_axi_cfg & ~CPUX_CLK_SRC_MASK) |
-		      CPUX_CLK_SRC_OSC24M);
-	udelay(1);
 	saved_pll_cpux = mmio_read_32(SUNXI_CCU_PLL_CPUX_REG);
-	mmio_write_32(SUNXI_CCU_PLL_CPUX_REG, saved_pll_cpux & ~PLL_CPUX_ENABLE);
+	sunxi_pm_trace(SUNXI_PM_EV_SYS_SUSPEND, saved_cpux_axi_cfg, saved_pll_cpux);
+	/* DRAM controller state before anything is changed: STATR, PWRCTL. */
+	sunxi_pm_trace(SUNXI_PM_EV_SYS_DRAM,
+		       mmio_read_32(SUNXI_DRAM_CTL_BASE + 0x004),
+		       mmio_read_32(SUNXI_DRAM_CTL_BASE + 0x030));
+#if SUNXI_PM_DEBUG_TRACE
+	/* Experiment: no automatic power-down while self-refresh is requested. */
+	debug_pwrctl_changed = false;
+	if ((knob & SUNXI_PM_KNOB_SR_NO_PD) != 0U) {
+		uint32_t swstat;
+
+		debug_saved_pwrctl = mmio_read_32(MCTL_PWRCTL);
+		swstat = debug_write_pwrctl(debug_saved_pwrctl & ~BIT_32(1));
+		debug_pwrctl_changed = true;
+		sunxi_pm_trace(SUNXI_PM_EV_SYS_DRAM,
+			       mmio_read_32(SUNXI_DRAM_CTL_BASE + 0x004),
+			       mmio_read_32(MCTL_PWRCTL) | (swstat << 16));
+	}
+#endif
 
-	/* SRAM is mapped as device memory, so copy it word by word. */
-	while (src < sunxi_standby_sram_end) {
-		mmio_write_32(dst, *src++);
-		dst += sizeof(uint32_t);
+	/* Run the CPU from the 24 MHz oscillator and stop its PLL. */
+	if ((knob & SUNXI_PM_KNOB_SKIP_CPU_CLK) == 0U) {
+		mmio_write_32(SUNXI_CCU_CPUX_AXI_CFG_REG,
+			      (saved_cpux_axi_cfg & ~CPUX_CLK_SRC_MASK) |
+			      CPUX_CLK_SRC_OSC24M);
+		udelay(1);
+		mmio_write_32(SUNXI_CCU_PLL_CPUX_REG,
+			      saved_pll_cpux & ~PLL_CPUX_ENABLE);
+	}
+
+	if ((knob & SUNXI_PM_KNOB_STANDBY_IN_DRAM) != 0U) {
+		/* Experiment: run the routine in place, DRAM must stay active. */
+		entry = (uintptr_t)sunxi_standby_sram_start;
+		poll_limit = 0;
+	} else {
+		/* SRAM is mapped as device memory, so copy it word by word. */
+		while (src < sunxi_standby_sram_end) {
+			mmio_write_32(dst, *src++);
+			dst += sizeof(uint32_t);
+		}
+	}
+	if ((knob & SUNXI_PM_KNOB_SKIP_SELFREF) != 0U) {
+		poll_limit = 0;
 	}
 	dsbsy();
+	sunxi_pm_trace(SUNXI_PM_EV_SYS_JUMP, knob, (uint32_t)entry);
 
 	/* A pending Non-secure interrupt must terminate the WFI in SRAM. */
 	write_scr_el3(read_scr_el3() | SCR_IRQ_BIT);
 	isb();
 
 	standby_report.result = 0;
-	sunxi_standby_jump(SUNXI_SRAM_A1_BASE, SUNXI_DRAM_CTL_BASE,
+	sunxi_standby_jump(entry, SUNXI_DRAM_CTL_BASE,
 			   SUNXI_DRAM_COM_BASE, (uintptr_t)bl31_warm_entrypoint,
-			   STANDBY_POLL_LIMIT, &standby_report);
+			   poll_limit, &standby_report);
 }
 
 /* Called from the warm boot path on the CPU that resumes the system. */
@@ -100,6 +160,7 @@ void sunxi_native_system_suspend_finish(void)
 {
 	uint32_t result = standby_report.result;
 	unsigned int timeout = 1000;
+	uint32_t locked = 1;
 
 	/* Restart the PLL and wait for it to lock before switching back. */
 	if ((saved_pll_cpux & PLL_CPUX_ENABLE) != 0U) {
@@ -108,6 +169,7 @@ void sunxi_native_system_suspend_finish(void)
 		while ((mmio_read_32(SUNXI_CCU_PLL_CPUX_REG) & PLL_CPUX_LOCK) == 0U) {
 			if (--timeout == 0U) {
 				WARN("PSCI: PLL_CPUX failed to lock\n");
+				locked = 0;
 				break;
 			}
 			udelay(1);
@@ -115,6 +177,17 @@ void sunxi_native_system_suspend_finish(void)
 		mmio_write_32(SUNXI_CCU_PLL_CPUX_REG, saved_pll_cpux);
 	}
 	mmio_write_32(SUNXI_CCU_CPUX_AXI_CFG_REG, saved_cpux_axi_cfg);
+	sunxi_pm_trace(SUNXI_PM_EV_SYS_RESUME, result, locked);
+	sunxi_pm_trace(SUNXI_PM_EV_SYS_SR, standby_report.statr_entry,
+		       standby_report.statr_exit);
+	sunxi_pm_trace(SUNXI_PM_EV_SYS_PWRCTL, standby_report.pwrctl,
+		       mmio_read_32(SUNXI_DRAM_CTL_BASE + 0x004));
+#if SUNXI_PM_DEBUG_TRACE
+	if (debug_pwrctl_changed) {
+		(void)debug_write_pwrctl(debug_saved_pwrctl);
+		debug_pwrctl_changed = false;
+	}
+#endif
 
 	if ((result & STANDBY_RESULT_VALID) == 0U) {
