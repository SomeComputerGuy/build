@@ -70,11 +74,45 @@ static void sunxi_cpu_standby(plat_local_state_t cpu_state)
 
 	assert(is_local_state_retn(cpu_state));
 
+	sunxi_pm_trace(SUNXI_PM_EV_STANDBY, cpu_state, 0);
 	write_scr_el3(scr | SCR_IRQ_BIT);
 	wfi();
 	write_scr_el3(scr);
 }
 
+#if SUNXI_PM_DEBUG_TRACE
+/*
+ * Bring-up experiments, selected at runtime through the knob (bits 2:0):
+ *  0: no power-down at all: WFI in EL3, then restart through the warm boot
+ *     entry point (always safe, exercises the resume path)
+ *  1: the regular sequence: CPUIDLE_WAKE armed, CORE_CLOSE + WFI with the
+ *     GIC CPU interface disabled
+ *  2: like 1 but with the GIC CPU interface left enabled
+ *  3: like 1, but core 0 is never gated (behaves as in mode 0)
+ *  4: like 2, but core 0 is never gated
+ */
+static unsigned int sleep_mode[PLATFORM_CORE_COUNT];
+
+/* Sampled once per entry so that a knob change cannot split one cycle in two modes. */
+static unsigned int sunxi_sleep_mode(bool sample)
+{
+	unsigned int core = plat_my_core_pos();
+
+	if (sample) {
+		unsigned int mode = sunxi_pm_knob() & SUNXI_PM_KNOB_SLEEP_MODE_MASK;
+
+		if (mode > 4U) {
+			mode = 0U;
+		}
+		if (mode >= 3U) {
+			mode = (core == 0U) ? 0U : mode - 2U;
+		}
+		sleep_mode[core] = mode;
+	}
+	return sleep_mode[core];
+}
+#endif
+
 /*
  * Power this core down. The CPUIDLE hardware block takes over once the core
  * executes WFI with its CORE_CLOSE flag set: it isolates the core and removes
@@ -97,6 +135,25 @@ static void sunxi_pwr_domain_suspend(const psci_power_state_t *target_state)
 		return;
 	}
 
+#if SUNXI_PM_DEBUG_TRACE
+	{
+		unsigned int mode = sunxi_sleep_mode(true);
+
+		sunxi_pm_trace(SUNXI_PM_EV_SLEEP_ENTER,
+			       mode | (mmio_read_32(SUNXI_CPUIDLE_STAT_REG) << 8),
+			       mmio_read_32(SUNXI_CPUIDLE_PEND_REG));
+		if (mode == 0U) {
+			return;
+		}
+		mmio_setbits_32(SUNXI_CPUIDLE_WAKE_REG, BIT_32(plat_my_core_pos()));
+		if (mode == 1U) {
+			gicv2_cpuif_disable();
+		}
+		sunxi_cpu_power_off_self();
+		return;
+	}
+#endif
+
 	mmio_setbits_32(SUNXI_CPUIDLE_WAKE_REG, BIT_32(plat_my_core_pos()));
 
 	gicv2_cpuif_disable();
@@ -113,6 +170,9 @@ static void sunxi_pwr_domain_suspend_finish(const psci_power_state_t *target_sta
 #endif
 	{
 		mmio_clrbits_32(SUNXI_CPUIDLE_WAKE_REG, BIT_32(plat_my_core_pos()));
+		sunxi_pm_trace(SUNXI_PM_EV_SLEEP_WAKE,
+			       mmio_read_32(SUNXI_CPUIDLE_STAT_REG),
+			       mmio_read_32(SUNXI_CPUIDLE_PEND_REG));
 	}
 
 	/* The GIC distributor never loses power, only the CPU interface needs setup. */
@@ -126,6 +186,34 @@ static void sunxi_pwr_domain_pwr_down(const psci_power_state_t *target_state)
 	if (is_local_state_off(SYSTEM_PWR_STATE(target_state))) {
 		sunxi_native_system_suspend_pwr_down();
 	}
+
+#if SUNXI_PM_DEBUG_TRACE
+	{
+		unsigned int mode = sunxi_sleep_mode(false);
+
+		/*
+		 * In the modes where the WFI can return (no power-down, or the
+		 * GIC CPU interface left on), do it here and restart the core
+		 * through the warm boot path, as if it had been powered off;
+		 * the generic code would panic on a returning WFI.
+		 */
+		if (mode == 0U || mode == 2U) {
+			write_scr_el3(read_scr_el3() | SCR_IRQ_BIT);
+			isb();
+			dsbsy();
+			wfi();
+			if (mode != 0U) {
+				mmio_write_32(SUNXI_CORE_CLOSE_REG, 0);
+				mmio_clrbits_32(SUNXI_CPUIDLE_WAKE_REG,
+						BIT_32(plat_my_core_pos()));
+			}
+			sunxi_pm_trace(SUNXI_PM_EV_SLEEP_WFI_RET,
+				       mmio_read_32(SUNXI_CPUIDLE_STAT_REG),
+				       mmio_read_32(SUNXI_CPUIDLE_PEND_REG));
+			sunxi_warm_restart();
+		}
+	}
+#endif
 }
 
 static void sunxi_get_sys_suspend_power_state(psci_power_state_t *req_state)
@@ -178,6 +266,7 @@ static int sunxi_validate_power_state(unsigned int power_state,
 
 static void sunxi_system_off(void)
 {
+	sunxi_pm_trace(SUNXI_PM_EV_SYSTEM_OFF, 0, 0);
