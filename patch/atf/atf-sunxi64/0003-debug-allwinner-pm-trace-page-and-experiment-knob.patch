 plat/allwinner/common/sunxi_bl31_setup.c      |  2 +
 plat/allwinner/common/sunxi_common.c          |  4 +
 plat/allwinner/common/sunxi_native_pm.c       | 90 +++++++++++++++++
 plat/allwinner/common/sunxi_native_suspend.c  | 46 ++++++---
 plat/allwinner/common/sunxi_pm_trace.c        | 97 +++++++++++++++++++
 plat/allwinner/common/sunxi_standby_sram.S    | 20 ++++
 plat/allwinner/sun50i_h616/platform.mk        |  1 +
 10 files changed, 326 insertions(+), 13 deletions(-)
 create mode 100644 plat/allwinner/common/include/sunxi_pm_trace.h
