diff --git a/plat/allwinner/common/include/sunxi_pm_trace.h b/plat/allwinner/common/include/sunxi_pm_trace.h
new file mode 100644
index 0000000..dc4e5b4
--- /dev/null
+++ b/plat/allwinner/common/include/sunxi_pm_trace.h
@@ -0,0 +1,74 @@
+/*
+ * Copyright (c) 2026, Arun Iyengar <aiyengar1990@gmail.com>
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Bring-up aid: PM event trace and experiment knob in a non-cacheable page
+ * (SUNXI_PM_TRACE_BASE). Layout:
+ *   0x00 magic "SXPM" (0x4d505853)   0x04 boot generation
+ *   0x08 knob (reset to 0 at every boot)
+ *   0x0c freeze: set by BL31 after a warm reset, per-core rings stop
+ *        recording until the OS clears it (the pre-reset events survive)
+ *   0x10 layout version (SUNXI_PM_TRACE_LAYOUT); a page with another
+ *        version, e.g. left behind by an older BL31 across a warm reset,
+ *        is cleared instead of being reinterpreted
+ *   0x40 system ring (BOOT, SYS_*, SYSTEM_*): u32 count, 3 x u32 reserved,
+ *        then 58 records
+ *   0x400 + core * 0x300: per-core ring (CPU_ON/OFF, SLEEP_*, STANDBY):
+ *        u32 count, 3 x u32 reserved, then 46 records
+ *   record: {u32 cntpct_lo, u32 event | core << 24, u32 d0, u32 d1}
+ */
+
+#ifndef SUNXI_PM_TRACE_H
+#define SUNXI_PM_TRACE_H
+
+#include <stdint.h>
+
+#define SUNXI_PM_TRACE_MAGIC		0x4d505853U
+#define SUNXI_PM_TRACE_LAYOUT		3U
+
+enum sunxi_pm_event {
+	SUNXI_PM_EV_BOOT = 1,		/* d0: generation */
+	SUNXI_PM_EV_CPU_ON,		/* d0: mpidr */
+	SUNXI_PM_EV_CPU_OFF,		/* d0: CPUIDLE_STAT, d1: CPUIDLE_PEND */
+	SUNXI_PM_EV_SLEEP_ENTER,	/* d0: mode | CPUIDLE_STAT << 8, d1: PEND | WAKE << 8 */
+	SUNXI_PM_EV_SLEEP_WAKE,		/* d0: CPUIDLE_STAT, d1: PEND | WAKE << 8 */
+	SUNXI_PM_EV_SLEEP_WFI_RET,	/* WFI returned, core was not gated */
+	SUNXI_PM_EV_STANDBY,		/* cpu_standby (retention) */
+	SUNXI_PM_EV_SYS_SUSPEND,	/* d0: CPUX_AXI_CFG, d1: PLL_CPUX */
+	SUNXI_PM_EV_SYS_JUMP,		/* d0: knob, d1: entry address */
+	SUNXI_PM_EV_SYS_RESUME,		/* d0: standby result, d1: PLL locked */
+	SUNXI_PM_EV_SYSTEM_RESET,
+	SUNXI_PM_EV_SYSTEM_OFF,
+	SUNXI_PM_EV_SYS_DRAM,		/* before suspend, d0: STATR, d1: PWRCTL */
+	SUNXI_PM_EV_SYS_SR,		/* d0: STATR in self-refresh, d1: STATR after */
+	SUNXI_PM_EV_SYS_PWRCTL,		/* d0: PWRCTL after the request, d1: STATR now */
+};
+
+/* knob bits */
+#define SUNXI_PM_KNOB_SLEEP_MODE_MASK	0x7U	/* see sunxi_native_pm.c */
+#define SUNXI_PM_KNOB_SR_NO_PD		(1U << 3)	/* suspend: PWRCTL.powerdown_en off first */
+#define SUNXI_PM_KNOB_SKIP_SELFREF	(1U << 4)
+#define SUNXI_PM_KNOB_SKIP_CPU_CLK	(1U << 5)
+#define SUNXI_PM_KNOB_STANDBY_IN_DRAM	(1U << 6)
+
+#if SUNXI_PM_DEBUG_TRACE
+void sunxi_pm_trace_init(void);
+void sunxi_pm_trace(unsigned int event, uint32_t d0, uint32_t d1);
+uint32_t sunxi_pm_trace_pend_wake(void);
+uint32_t sunxi_pm_knob(void);
+void __dead2 sunxi_warm_restart(void);
+#else
+static inline void sunxi_pm_trace_init(void)
+{
+}
+static inline void sunxi_pm_trace(unsigned int event, uint32_t d0, uint32_t d1)
+{
+}
+static inline uint32_t sunxi_pm_knob(void)
+{
+	return 0;
+}
+#endif
+
+#endif /* SUNXI_PM_TRACE_H */
