From: Arun Iyengar <aiyengar1990@gmail.com>
Subject: [PATCH] sunxi: dram: retry transient DRAM training failures

mctl_auto_detect_rank_width() takes the first bus width / rank
combination whose PHY training succeeds and panics if none does. That
assumes training of the real geometry never fails. On an Orange Pi Zero2
(H616, 1 GiB DDR3, 32-bit, single rank) a watchdog reset of a system
that had been thrashing under OOM for minutes produced:

  DRAM:This DRAM setup is currently not supported.
  resetting ...
  U-Boot SPL ...
  DRAM: 512 MiB

i.e. in the first pass none of the four combinations trained, and in the
pass after the panic induced reset the 32-bit one still failed while a
16-bit one trained, so the board ran with half of its RAM until the next
reboot. Idle resets of any kind never fail. Hardware watchdog resets
taken while the DRAM is saturated (stress-ng cpu+vm+bigheap, real OOM
kills, SoC ~75 C) reproduce it: in 21 such resets, two needed a
retry and one failed all of 3 back-to-back passes (a few ms in total)
again, so the transient lasts longer than back-to-back attempts.

Make the scan robust against such transient failures:
- keep the most demanding combination that trained in any pass; once
  something trained, two more passes retry only the more demanding
  combinations, so a healthy board pays only for a couple of quickly
  failing attempts (as before),
- while nothing trained, retry with an exponential backoff (20 ms
  doubling up to 320 ms, 12 passes, about 2.5 s) before panicking; after
  a delay was needed, the passes for the more demanding combinations are
  delayed as well,
- the size probe and the final init used to ignore mctl_core_init()'s
  result; retry them with the same backoff (the outcome on a persistent
  failure is unchanged).

Every mctl_core_init() already resets and re-initializes the controller,
PHY and DRAM PLL and runs the DRAM reset/init sequence. If any retry was
needed the SPL prints " (training retried: pass N, M ms)" in the DRAM
line, so the event and the duration of the transient remain visible.
Nothing changes in timing unless a retry is needed.

Signed-off-by: Arun Iyengar <aiyengar1990@gmail.com>
---
diff --git a/arch/arm/include/asm/arch-sunxi/dram_dw_helpers.h b/arch/arm/include/asm/arch-sunxi/dram_dw_helpers.h
index bc9e0d86..da73c353 100644
--- a/arch/arm/include/asm/arch-sunxi/dram_dw_helpers.h
+++ b/arch/arm/include/asm/arch-sunxi/dram_dw_helpers.h
@@ -13,6 +13,8 @@
 
 bool mctl_core_init(const struct dram_para *para,
 		    const struct dram_config *config);
+bool mctl_core_init_retry(const struct dram_para *para,
+			  const struct dram_config *config);
 void mctl_auto_detect_rank_width(const struct dram_para *para,
 				 struct dram_config *config);
 void mctl_auto_detect_dram_size(const struct dram_para *para,
diff --git a/arch/arm/mach-sunxi/dram_dw_helpers.c b/arch/arm/mach-sunxi/dram_dw_helpers.c
index d2af2d57..22b127f2 100644
--- a/arch/arm/mach-sunxi/dram_dw_helpers.c
+++ b/arch/arm/mach-sunxi/dram_dw_helpers.c
@@ -7,48 +7,157 @@
  */
 
 #include <init.h>
+#include <log.h>
+#include <time.h>
+#include <linux/delay.h>
+#include <linux/kernel.h>
 #include <asm/arch/dram_dw_helpers.h>
 
+/*
+ * Bus width / rank combinations, most demanding first. Testing in this
+ * order matters, otherwise HW might not be fully utilized. For example,
+ * half bus width and rank = 1 combination would also work on HW with full
+ * bus width and rank = 2, but only 1/4 RAM would be visible.
+ */
+static const struct {
+	u8 bus_full_width;
+	u8 ranks;
+} mctl_geometries[] = {
+	{ 1, 2 },
+	{ 1, 1 },
+	{ 0, 2 },
+	{ 0, 1 },
+};
+
+/*
+ * PHY training can occasionally fail for a geometry the board really has.
+ * On an H616 board (Orange Pi Zero2, DDR3) a hardware watchdog reset of a
+ * system that was saturating the DRAM under OOM produced:
+ *
+ *   DRAM:This DRAM setup is currently not supported.
+ *   resetting ...
+ *   DRAM: 512 MiB
+ *
+ * i.e. no combination trained in the first SPL run and only a 16-bit one
+ * trained in the run after the panic induced reset. The failure is a
+ * transient: it outlasts several back-to-back attempts (all within a few
+ * ms), but is gone some hundred ms later. Hence:
+ *
+ * - Keep the most demanding combination that trained in any pass instead
+ *   of the first one, so a narrower bus or a single rank is not silently
+ *   chosen over the real geometry. Once something trained, two more
+ *   passes retry only the more demanding combinations. Those are quick
+ *   (combinations the board does not have fail training reliably) and
+ *   are the only cost on a healthy board.
+ * - While nothing trained, do not give up after back-to-back attempts:
+ *   retry with an exponential backoff (20 ms doubling up to 320 ms,
+ *   MCTL_MAX_PASSES passes, about 2.5 s in total) before panicking.
+ *   After such a delay was needed, the passes for the more demanding
+ *   combinations are delayed as well.
+ * - Each mctl_core_init() resets and re-initializes the controller, PHY
+ *   and DRAM PLL and runs the DRAM reset/init sequence, so every attempt
+ *   starts from scratch.
+ *
+ * If a retry was needed, " (training retried: pass N, M ms)" is printed in
+ * the DRAM line, so the event (and how long the transient lasted) remains
+ * visible.
+ */
+#define MCTL_FAST_PASSES	3
+#define MCTL_MAX_PASSES		12
+#define MCTL_BACKOFF_MS_MIN	20
+#define MCTL_BACKOFF_MS_MAX	320
+
+static void mctl_backoff(unsigned int *ms)
+{
+	mdelay(*ms);
+	*ms = min(*ms * 2, (unsigned int)MCTL_BACKOFF_MS_MAX);
+}
+
+static void mctl_report_retry(unsigned int pass, ulong start)
+{
+	printf(" (training retried: pass %u, %lu ms)", pass, get_timer(start));
+}
+
+bool mctl_core_init_retry(const struct dram_para *para,
+			  const struct dram_config *config)
+{
+	unsigned int ms = MCTL_BACKOFF_MS_MIN;
+	ulong start = get_timer(0);
+	int i;
+
+	for (i = 0; i < MCTL_MAX_PASSES; i++) {
+		if (i)
+			mctl_backoff(&ms);
+		if (mctl_core_init(para, config)) {
+			if (i)
+				mctl_report_retry(i + 1, start);
+			return true;
+		}
+	}
+
+	debug("DRAM training failed %d times\n", MCTL_MAX_PASSES);
+
+	return false;
+}
+
 void mctl_auto_detect_rank_width(const struct dram_para *para,
 				 struct dram_config *config)
 {
+	const unsigned int none = ARRAY_SIZE(mctl_geometries);
+	unsigned int best = none, first = none, best_pass = 0;
+	unsigned int ms = MCTL_BACKOFF_MS_MIN;
+	unsigned int pass, i, extra = 0;
+	ulong start = get_timer(0);
+	bool delayed = false;
+
 	/* this is minimum size that it's supported */
 	config->cols = 8;
 	config->rows = 13;
 
-	/*
-	 * Strategy here is to test most demanding combination first and least
-	 * demanding last, otherwise HW might not be fully utilized. For
-	 * example, half bus width and rank = 1 combination would also work
-	 * on HW with full bus width and rank = 2, but only 1/4 RAM would be
-	 * visible.
-	 */
+	for (pass = 0; best > 0; pass++) {
+		if (best == none) {
+			/* nothing trained yet: back off and try again */
+			if (pass == MCTL_MAX_PASSES)
+				break;
+			if (pass) {
+				mctl_backoff(&ms);
+				delayed = true;
+			}
+		} else {
+			/* retry the more demanding combinations a few times */
+			if (!extra)
+				break;
+			extra--;
+			if (delayed)
+				mctl_backoff(&ms);
+		}
+
+		for (i = 0; i < best; i++) {
+			config->bus_full_width = mctl_geometries[i].bus_full_width;
+			config->ranks = mctl_geometries[i].ranks;
+			debug("testing %d-bit width, rank = %d\n",
+			      config->bus_full_width ? 32 : 16, config->ranks);
+			if (mctl_core_init(para, config)) {
+				if (pass == 0)
+					first = i;
+				if (best == none)
+					extra = MCTL_FAST_PASSES - 1;
+				best = i;
+				best_pass = pass;
+				break;
+			}
+		}
+	}
+
+	if (best == none)
+		panic("This DRAM setup is currently not supported.\n");
+
+	/* tell the user that the DRAM did not train on the first attempt */
+	if (best != first)
+		mctl_report_retry(best_pass + 1, start);
 
-	debug("testing 32-bit width, rank = 2\n");
-	config->bus_full_width = 1;
-	config->ranks = 2;
-	if (mctl_core_init(para, config))
-		return;
-
-	debug("testing 32-bit width, rank = 1\n");
-	config->bus_full_width = 1;
-	config->ranks = 1;
-	if (mctl_core_init(para, config))
-		return;
-
-	debug("testing 16-bit width, rank = 2\n");
-	config->bus_full_width = 0;
-	config->ranks = 2;
-	if (mctl_core_init(para, config))
-		return;
-
-	debug("testing 16-bit width, rank = 1\n");
-	config->bus_full_width = 0;
-	config->ranks = 1;
-	if (mctl_core_init(para, config))
-		return;
-
-	panic("This DRAM setup is currently not supported.\n");
+	config->bus_full_width = mctl_geometries[best].bus_full_width;
+	config->ranks = mctl_geometries[best].ranks;
 }
 
 static void mctl_write_pattern(void)
@@ -93,7 +202,7 @@ void mctl_auto_detect_dram_size(const struct dram_para *para,
 	/* max. config for columns, but not rows */
 	config->cols = 11;
 	config->rows = 13;
-	mctl_core_init(para, config);
+	mctl_core_init_retry(para, config);
 
 	/*
 	 * Store content so it can be restored later. This is important
@@ -119,7 +228,7 @@ void mctl_auto_detect_dram_size(const struct dram_para *para,
 	/* reconfigure to make sure that all active rows are accessible */
 	config->cols = 8;
 	config->rows = 17;
-	mctl_core_init(para, config);
+	mctl_core_init_retry(para, config);
 
 	/* store data again as it might be moved */
 	memcpy(buffer, (u32 *)CFG_SYS_SDRAM_BASE, sizeof(buffer));
diff --git a/arch/arm/mach-sunxi/dram_sun50i_h616.c b/arch/arm/mach-sunxi/dram_sun50i_h616.c
index 42a0550e..a019dcf6 100644
--- a/arch/arm/mach-sunxi/dram_sun50i_h616.c
+++ b/arch/arm/mach-sunxi/dram_sun50i_h616.c
@@ -1352,7 +1352,7 @@ unsigned long sunxi_dram_init(void)
 	mctl_auto_detect_rank_width(&para, &config);
 	mctl_auto_detect_dram_size(&para, &config);
 
-	mctl_core_init(&para, &config);
+	mctl_core_init_retry(&para, &config);
 
 	size = mctl_calc_size(&config);
 
